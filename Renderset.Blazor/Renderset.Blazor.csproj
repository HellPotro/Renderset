<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>


	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<!--
    El CSS del documento se sirve como asset de la RCL para el diseñador y,
    además, se embebe para que la API pueda incrustarlo en el HTML generado
    sin depender de wwwroot.
  -->
	<ItemGroup>
		<EmbeddedResource Include="wwwroot\css\report-document.css" LogicalName="Renderset.Blazor.report-document.css" />
		<EmbeddedResource Include="wwwroot\css\document-bundle.css" LogicalName="Renderset.Blazor.document-bundle.css" />
		<EmbeddedResource Include="wwwroot\css\document-viewer.css" LogicalName="Renderset.Blazor.document-viewer.css" />
		<EmbeddedResource Include="wwwroot\js\document-viewer.js" LogicalName="Renderset.Blazor.document-viewer.js" />

		<!-- Tipografías incluidas: el documento emitido lleva incrustada la de
		     su tema (ReportFontFaces), así que la API las lee del ensamblado. -->
		<EmbeddedResource Include="wwwroot\fonts\*.woff2" LogicalName="Renderset.Blazor.fonts.%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
		<!-- QR de la cabecera. Sólo se usa su matriz de módulos; el SVG se
		     dibuja en ReportQrSvg. MIT. -->
		<PackageReference Include="QRCoder" Version="1.8.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Renderset.Core\Renderset.Core.csproj" />
	</ItemGroup>

</Project>