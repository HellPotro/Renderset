@using Renderset.Core.Sharing

@*
    Visor público de un bundle. Se pinta en estático (HtmlRenderer), sin
    circuito: la navegación entre documentos es un enlace con target al
    iframe, y el script del renderer sólo actualiza el estado visual. Si el
    script no carga, la página sigue funcionando.

    La barra del documento es DocumentViewerToolbar, la misma del visor
    interno de Web.
*@

<div class="@(IsSingle ? "rs-share is-single" : "rs-share")">

    <header class="rs-share-header">

        <div class="rs-share-brand">
            @if (!string.IsNullOrWhiteSpace(View.Branding.LogoUrl))
            {
                <img class="rs-share-logo"
                     src="@View.Branding.LogoUrl"
                     alt="@View.Branding.DisplayName" />
            }
            else
            {
                <span class="rs-share-company">@View.Branding.DisplayName</span>
            }
        </div>

        <div class="rs-share-heading">
            <h1 class="rs-share-title">@View.Title</h1>
            <p class="rs-share-meta">
                @View.Texts.FormatSharedBy(View.Branding.DisplayName)
                @if (View.ShowExpiry)
                {
                    <span aria-hidden="true"> · </span>
                    @View.Texts.FormatAvailableUntil(View.ExpiresAtUtc)
                }
            </p>
        </div>

        @if (View.Documents.Count > 1)
        {
            <div class="rs-share-header-actions">

                @if (!string.IsNullOrWhiteSpace(View.DownloadAllPdfUrl))
                {
                    <a class="rs-share-button"
                       href="@View.DownloadAllUrl"
                       download>
                        @View.Texts.DownloadZip
                    </a>

                    <a class="rs-share-button is-primary"
                       href="@View.DownloadAllPdfUrl"
                       download>
                        @View.Texts.DownloadAllPdf
                    </a>
                }
                else
                {
                    <a class="rs-share-button is-primary"
                       href="@View.DownloadAllUrl"
                       download>
                        @View.Texts.DownloadAll
                    </a>
                }

            </div>
        }

    </header>

    @if (!string.IsNullOrWhiteSpace(View.Message))
    {
        <p class="rs-share-message">@View.Message</p>
    }

    <div class="rs-share-body">

        @* Con un solo documento (enlace del QR) no hay lista que elegir: el
           documento ocupa todo el ancho. *@
        @if (!IsSingle)
        {
        <nav class="rs-share-list" aria-label="@View.Texts.Documents">

            <h2 class="rs-share-list-title">
                @View.Texts.Documents (@View.Documents.Count)
            </h2>

            <ol>
                @foreach (var document in View.Documents)
                {
                    <li>
                        <a class="rs-share-item @(document == First ? "is-active" : null)"
                           href="@document.ViewUrl"
                           target="@FrameName"
                           aria-current="@(document == First ? "true" : null)"
                           data-share-item
                           data-title="@document.Title"
                           data-download="@document.DownloadUrl">
                            <span class="rs-share-item-index">@document.Position</span>
                            <span class="rs-share-item-name">@document.Title</span>
                        </a>
                    </li>
                }
            </ol>

            @if (!string.IsNullOrWhiteSpace(View.FooterText))
            {
                <p class="rs-share-footer">@View.FooterText</p>
            }

        </nav>
        }

        <section class="rs-share-viewer"
                 data-rs-viewer
                 data-culture="@View.Culture">

            <DocumentViewerToolbar Texts="View.Texts"
                                   Title="@First.Title"
                                   OpenUrl="@First.ViewUrl"
                                   DownloadUrl="@First.DownloadUrl"
                                   DownloadIsPdf="View.PdfAvailable"
                                   AllowData="View.AllowDataDownload" />

            <iframe class="rs-share-frame"
                    name="@FrameName"
                    title="@First.Title"
                    src="@First.ViewUrl"
                    data-rs-viewer-frame></iframe>

        </section>

    </div>

</div>

@code {

    public const string FrameName = "rs-share-frame";

    [Parameter, EditorRequired]
    public DocumentBundleView View { get; set; } = default!;

    private DocumentBundleViewItem First =>
        View.Documents[0];

    /// <summary>
    /// Enlace público de un solo documento (QR): sin lista lateral.
    /// </summary>
    private bool IsSingle =>
        View.Documents.Count == 1 &&
        !View.ShowExpiry;
}
