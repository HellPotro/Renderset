    private async Task RemovePlacedFieldAsync(
        ReportSectionConfiguration section,
        string fieldId)
    {
        Configuration.FieldPlacements.RemoveAll(x =>
            string.Equals(x.SectionId, section.SectionId, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(x.FieldId, fieldId, StringComparison.OrdinalIgnoreCase));

        section.Fields.RemoveAll(x =>
            string.Equals(x.FieldId, fieldId, StringComparison.OrdinalIgnoreCase));

        await ConfigurationUpdated();
    }

    private (string SectionId, string FieldId)? _placedDrag;

    private void StartPlacedDrag(
        ReportSectionConfiguration section,
        string fieldId) =>
        _placedDrag = (section.SectionId, fieldId);

    private bool IsDraggingPlaced(
        ReportSectionConfiguration section,
        string fieldId) =>
        _placedDrag is { } drag &&
        string.Equals(drag.SectionId, section.SectionId, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(drag.FieldId, fieldId, StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Reordenar arrastrando dentro de la sección, como en las de datos:
    /// el campo arrastrado ocupa el sitio del de destino.
    /// </summary>
    private async Task DropPlacedFieldAsync(
        ReportSectionConfiguration section,
        string targetFieldId)
    {
        if (_placedDrag is not { } drag ||
            !string.Equals(drag.SectionId, section.SectionId, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(drag.FieldId, targetFieldId, StringComparison.OrdinalIgnoreCase))
        {
            _placedDrag = null;
            return;
        }

        var placements =
            Configuration.FieldPlacements
                .Where(x => string.Equals(x.SectionId, section.SectionId, StringComparison.OrdinalIgnoreCase))
                .OrderBy(x => x.Order)
                .ToList();

        var dragged = placements.FirstOrDefault(x =>
            string.Equals(x.FieldId, drag.FieldId, StringComparison.OrdinalIgnoreCase));

        var targetIndex = placements.FindIndex(x =>
            string.Equals(x.FieldId, targetFieldId, StringComparison.OrdinalIgnoreCase));

        _placedDrag = null;

        if (dragged is null || targetIndex < 0)
            return;

        placements.Remove(dragged);
        placements.Insert(Math.Min(targetIndex, placements.Count), dragged);

        for (var i = 0; i < placements.Count; i++)
            placements[i].Order = (i + 1) * 10;

        await ConfigurationUpdated();
    }

    private void NormalizeBodyOrders()
    {
        var ordered = Configuration.Body;

        for (var i = 0; i < ordered.Count; i++)
        {
            var order = (i + 1) * 10;
            var item = ordered[i];

            item.Order = order;

            // El primero no puede continuar la fila de nadie. Si acaba
            // arriba por un movimiento o por un borrado, se limpia la
            // bandera para que la configuración guardada diga la verdad.
            if (i == 0)
                item.SameRow = null;

            if (item.Type == ReportBodyItemType.Section &&
                !string.IsNullOrWhiteSpace(item.SectionId))
            {
                var section =
                    FindSectionConfiguration(item.SectionId);

                if (section is not null)
                    section.Order = order;
            }
        }

        Configuration.Body =
            ordered;
    }

    private int GetNextBodyOrder() =>
        Configuration.Body.Count == 0
            ? 10
            : Configuration.Body.Max(x => x.Order) + 10;

    private void CloseAddContentMenu()
    {
        _showAddContentMenu = false;
        _showExistingBlocks = false;
    }

    private static string GetBlockTypeLabel(ReportBlockType type) =>
        type switch
        {
            ReportBlockType.Text => "Texto",
            ReportBlockType.Image => "Imagen",
            ReportBlockType.Fields => "Campos",
            _ => type.ToString()
        };

    private static string GetBlockIcon(ReportBlockType type) =>
        type switch
        {
            ReportBlockType.Text => "fa-align-left",
            ReportBlockType.Image => "fa-image",
            ReportBlockType.Fields => "fa-table-cells",
            ReportBlockType.Header => "fa-heading",
            ReportBlockType.Footer => "fa-window-minimize",
            _ => "fa-cube"
        };

    private async Task ExportPresetAsync()
    {
        var preset = new ReportPreset
        {
            Id = Configuration.Id,
            Version = 1,
            Configuration = Configuration,
            Theme = Theme
        };

        var json =
            JsonSerializer.Serialize(
                preset,
                JsonOptions);

        var fileName =
            $"report-{Configuration.ReportId}-{Configuration.Id}.json";

        await JS.InvokeVoidAsync(
            "renderSet.downloadText",
            fileName,
            json,
            "application/json;charset=utf-8");
    }

    private async Task ImportPresetAsync(
        InputFileChangeEventArgs args)
    {
        var file = args.File;

        await using var stream =
            file.OpenReadStream(MaxPresetFileSize);

        using var reader =
            new StreamReader(stream, Encoding.UTF8);

        var json =
            await reader.ReadToEndAsync();

        var preset =
            JsonSerializer.Deserialize<ReportPreset>(json, JsonOptions)
            ?? throw new InvalidOperationException(
                "El archivo no contiene un preset válido.");

        if (!string.Equals(
                preset.Configuration.ReportId,
                Definition.Id,
                StringComparison.OrdinalIgnoreCase))
        {
            throw new InvalidOperationException(
                $"La configuración pertenece al report '{preset.Configuration.ReportId}' " +
                $"y no a '{Definition.Id}'.");
        }

        Configuration = preset.Configuration;
        Theme = preset.Theme;

        Resolve();

        await ConfigurationChanged.InvokeAsync(Configuration);
        await ThemeChanged.InvokeAsync(Theme);
    }

    private int GetSectionOrder(
        ReportSectionDefinition definition)
    {
        var configuration = FindSectionConfiguration(definition.Id);

        return configuration?.Order
            ?? definition.Order;
    }

    private ReportSectionConfiguration? FindSectionConfiguration(
        string sectionId) =>
        Configuration.Sections.FirstOrDefault(x =>
            string.Equals(
                x.SectionId,
                sectionId,
                StringComparison.OrdinalIgnoreCase));

    private void OpenSectionComposer()
    {
        CloseAddContentMenu();

        _composerRequest =
            new SectionCompositionRequest
            {
                Name = "",
                Layout = ReportSectionLayout.List,
                SelectedFieldIds = []
            };

        _showComposer = true;
    }

    private void OpenSectionComposer(string sectionId)
    {
        CloseAddContentMenu();

        var sectionConfiguration =
            FindSectionConfiguration(sectionId);

        if (sectionConfiguration is null)
            return;

        var selectedFieldIds =
            Configuration.FieldPlacements
                .Where(x =>
                    string.Equals(
                        x.SectionId,
                        sectionId,
                        StringComparison.OrdinalIgnoreCase))
                .OrderBy(x => x.Order)
                .Select(x => x.FieldId)
                .ToList();

        var grid =
            ReportSectionGrid.Normalize(
                sectionConfiguration.Layout,
                sectionConfiguration.Columns);

        _composerRequest =
            new SectionCompositionRequest
            {
                SectionId = sectionId,
                Name = GetSectionName(sectionConfiguration),
                Layout = grid.Layout,
                Columns = grid.Columns,
                SelectedFieldIds = selectedFieldIds
            };

        _showComposer = true;
    }

    private void CloseSectionComposer()
    {
        _showComposer = false;
        _composerRequest = null;
    }


    private async Task SaveComposedSectionAsync(
    SectionCompositionRequest request)
    {
        if (string.IsNullOrWhiteSpace(request.Name) ||
            request.SelectedFieldIds.Count == 0)
        {
            return;
        }

        EnsureBodyInitialized();

        var isNew =
            string.IsNullOrWhiteSpace(request.SectionId);

        var sectionId =
            isNew
                ? $"custom-{Guid.NewGuid():N}"
                : request.SectionId!;

        var section =
            FindSectionConfiguration(sectionId);

        if (section is null)
        {
            section =
                new ReportSectionConfiguration
                {
                    SectionId = sectionId,
                    SourceSectionId = null,
                    Fields = []
                };

            Configuration.Sections.Add(section);
        }

        Texts.SetText(
            ReportTextKeys.Section(sectionId),
            request.Name);

        var grid =
            ReportSectionGrid.Normalize(
                request.Layout,
                request.Columns);

        section.Layout = grid.Layout;
        section.Columns = grid.StoredColumns;

        section.Visible =
            true;

        if (section.Order is null)
            section.Order = GetNextBodyOrder();

        var bodyItem =
            Configuration.Body.FirstOrDefault(x =>
                x.Type == ReportBodyItemType.Section &&
                string.Equals(
                    x.SectionId,
                    sectionId,
                    StringComparison.OrdinalIgnoreCase));

        if (bodyItem is null)
        {
            bodyItem =
                new ReportBodyItemConfiguration
                {
                    Id = $"body-{sectionId}",
                    Type = ReportBodyItemType.Section,
                    SectionId = sectionId,
                    Order = GetNextBodyOrder()
                };

            Configuration.Body.Add(bodyItem);
        }

        /*
         * Quitamos todos los placements actuales de esta sección.
         * Esto permite editar la composición y desmarcar campos.
         */
        Configuration.FieldPlacements.RemoveAll(x =>
            string.Equals(
                x.SectionId,
                sectionId,
                StringComparison.OrdinalIgnoreCase));

        /*
         * Quitamos también cualquier placement anterior de los campos
         * seleccionados, por si venían de otra sección custom.
         */
        foreach (var fieldId in request.SelectedFieldIds)
        {
            Configuration.FieldPlacements.RemoveAll(x =>
                string.Equals(
                    x.FieldId,
                    fieldId,
                    StringComparison.OrdinalIgnoreCase));
        }

        for (var i = 0; i < request.SelectedFieldIds.Count; i++)
        {
            Configuration.FieldPlacements.Add(
                new ReportFieldPlacementConfiguration
                {
                    FieldId = request.SelectedFieldIds[i],
                    SectionId = sectionId,
                    Order = (i + 1) * 10
                });
        }

        CloseSectionComposer();

        NormalizeBodyOrders();

        await ConfigurationUpdated();
    }

    private void RemoveExistingFieldPlacement(
        string fieldId)
    {
        var existing =
            Configuration.FieldPlacements.FirstOrDefault(x =>
                string.Equals(
                    x.FieldId,
                    fieldId,
                    StringComparison.OrdinalIgnoreCase));

        if (existing is not null)
            Configuration.FieldPlacements.Remove(existing);
    }
}
