@using System.IO
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using Renderset.Blazor.Components.Rendering
@using Renderset.Core.Blocks
@using Renderset.Core.Composer
@using Renderset.Core.Configurations
@using Renderset.Core.Definitions
@using Renderset.Core.Persistence
@using Renderset.Core.Resolved
@using Renderset.Core.Services
@using Renderset.Core.Themes

@inject IJSRuntime JS
@inject IReportConfigurationComposer ConfigurationComposer

<div class="report-editor" @ref="_root">

    <aside class="report-editor-sidebar">

        <div class="report-editor-header">

            <div class="report-editor-eyebrow">
                Configuración
            </div>

            <h2>@Configuration.Name</h2>

            @if (Cultures.Count > 1)
            {
                <div class="report-editor-culture">

                    <i class="fa-solid fa-language"></i>

                    <select value="@Texts.Culture"
                            @onchange="CultureSelectedAsync">

                        @foreach (var culture in Cultures)
                        {
                            <option value="@culture.Culture">
                                @culture.DisplayName
                            </option>
                        }

                    </select>

                </div>
            }

            <div class="report-editor-actions">

                @if (ShowSaveButton)
                {
                    <button type="button"
                            class="secondary-button"
                            @onclick="SaveRequested">
                        <i class="fa-solid fa-save"></i>
                        Guardar
                    </button>
                }

                <button type="button"
                        class="secondary-button"
                        @onclick="() => _showData = !_showData">
                    <i class="fa-solid fa-database"></i>
                    Datos
                </button>

                <button type="button"
                        class="report-editor-action-button"
                        @onclick="ExportPresetAsync">
                    Exportar JSON
                </button>

                <label class="report-editor-action-button report-editor-import-button">
                    Importar JSON

                    <InputFile OnChange="ImportPresetAsync"
                               accept=".json,application/json" />
                </label>

            </div>

        </div>

        <div class="report-editor-tabs">

            <button type="button"
                    class="report-editor-tab @(_activeTab == StructureTab ? "active" : null)"
                    @onclick="ShowStructure">
                Estructura
            </button>

            <button type="button"
                    class="report-editor-tab @(_activeTab == HeaderFooterTab ? "active" : null)"
                    @onclick="ShowHeaderFooter">
                Cabecera y pie
            </button>

            <button type="button"
                    class="report-editor-tab @(_activeTab == LayoutTab ? "active" : null)"
                    @onclick="ShowLayout">
                Layout
            </button>

            <button type="button"
                    class="report-editor-tab @(_activeTab == ThemeTab ? "active" : null)"
                    @onclick="ShowTheme">
                Tema
            </button>

        </div>

        @if (_activeTab == StructureTab)
        {
            <div class="report-editor-block">

                <div class="report-editor-block-title-row">
                    <div class="report-editor-block-title">
                        Estructura
                    </div>

                    <div class="report-editor-add-content">

                        <button type="button"
                                class="report-editor-add-content-button"
                                @onclick="ToggleAddContentMenu">

                            <i class="fa-solid fa-plus"></i>

                            Añadir contenido

                        </button>

                        @if (_showAddContentMenu)
                        {
                            <div class="report-editor-add-content-menu">

                                <button type="button"
                                        @onclick="OpenSectionComposer">

                                    <i class="fa-solid fa-layer-group"></i>

                                    Nueva sección

                                </button>

                                <button type="button"
                                        @onclick="AddTextBlockAsync">

                                    <i class="fa-solid fa-align-left"></i>

                                    Texto

                                </button>

                                <button type="button"
                                        @onclick="ToggleExistingBlocks">

                                    <i class="fa-solid fa-cubes"></i>

                                    Bloque existente

                                </button>

                                @if (_showExistingBlocks)
                                {
                                    <div class="report-editor-existing-blocks">

                                        @if (ReusableBodyBlocks.Count == 0)
                                        {
                                            <div class="report-editor-empty-menu">
                                                No hay bloques reutilizables.
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var block in ReusableBodyBlocks)
                                            {
                                                <button type="button"
                                                        @onclick="() => AddExistingBlockAsync(block)">

                                                    <i class="fa-solid @GetBlockIcon(block.Type)"></i>

                                                    <span>
                                                        <strong>@block.Name</strong>
                                                        <small>@GetBlockTypeLabel(block.Type)</small>
                                                    </span>

                                                </button>
                                            }
                                        }

                                    </div>
                                }

                            </div>
                        }

                    </div>
                </div>

                @{
                    var bodyItems = GetOrderedBodyItems();
                }

                @for (var i = 0; i < bodyItems.Count; i++)
                {
                    var item = bodyItems[i];
                    var canMoveUp = i > 0;
                    var canMoveDown = i < bodyItems.Count - 1;

                    if (item.Type == ReportBodyItemType.Section &&
                        !string.IsNullOrWhiteSpace(item.SectionId))
                    {
                        // Las subsecciones las dibuja su padre. Si una llega
                        // aquí por un body antiguo, se ignora en vez de
                        // salir dos veces.
                        if (IsNestedSection(item.SectionId))
                            continue;

                        var sectionDefinition = Definition.Sections.FirstOrDefault(x =>
                            string.Equals(x.Id, item.SectionId, StringComparison.OrdinalIgnoreCase));

                        var resolvedSection = _resolved?.GetSection(item.SectionId);

                        if (resolvedSection is null)
                            continue;

                        if (sectionDefinition is not null)
                        {
                            <ReportSectionEditor @key="item.Id"
                                                 Definition="sectionDefinition"
                                                 Resolved="resolvedSection"
                                                 Configuration="Configuration"
                                                 CanMoveUp="canMoveUp"
                                                 CanMoveDown="canMoveDown"
                                                 MoveUp="() => MoveBodyItemAsync(item.Id, -1)"
                                                 MoveDown="() => MoveBodyItemAsync(item.Id, 1)"
                                                 Texts="Texts"
                                                 Changed="ConfigurationUpdated" />
                        }
                        else
                        {
                            var sectionConfiguration = FindSectionConfiguration(item.SectionId);

                            if (sectionConfiguration is not null)
                            {
                                <div class="report-editor-content-item report-editor-custom-section"
                                     @key="item.Id">

                                    <div class="report-editor-content-item-header">

                                        <div class="report-editor-content-item-heading">

                                            <span class="report-editor-content-item-icon">
                                                <i class="fa-regular fa-square"></i>
                                            </span>

                                            <div>
                                                <strong>@resolvedSection.Name</strong>
                                                <span>Sección personalizada</span>
                                            </div>

                                        </div>

                                        <div class="report-editor-section-actions"
                                             @onclick:stopPropagation="true">

                                            <button type="button"
                                                    class="report-editor-section-order-button"
                                                    title="Mover sección arriba"
                                                    disabled="@(!canMoveUp)"
                                                    @onclick="() => MoveBodyItemAsync(item.Id, -1)">

                                                <i class="fa-solid fa-arrow-up"></i>

                                            </button>

                                            <button type="button"
                                                    class="report-editor-section-order-button"
                                                    title="Mover sección abajo"
                                                    disabled="@(!canMoveDown)"
                                                    @onclick="() => MoveBodyItemAsync(item.Id, 1)">

                                                <i class="fa-solid fa-arrow-down"></i>

                                            </button>

                                            <button type="button"
                                                    class="report-editor-section-order-button"
                                                    title="Editar composición"
                                                    @onclick="() => OpenSectionComposer(item.SectionId!)">

                                                <i class="fa-solid fa-pen"></i>

                                            </button>

                                            <button type="button"
                                                    class="report-editor-section-order-button report-editor-danger-button"
                                                    title="Eliminar sección"
                                                    @onclick="() => RemoveBodyItemAsync(item.Id)">

                                                <i class="fa-solid fa-trash"></i>

                                            </button>

                                            <button type="button"
                                                    class="icon-button"
                                                    title="@(IsCollapsed(item.Id) ? "Desplegar" : "Plegar")"
                                                    @onclick="() => ToggleCollapsed(item.Id)">
                                                <i class="@(IsCollapsed(item.Id)
                                                    ? "fa-solid fa-chevron-down"
                                                    : "fa-solid fa-chevron-up")"></i>
                                            </button>

                                        </div>

                                    </div>

                                    <div class="report-editor-content-item-body">

                                        <div class="report-editor-property">

                                            <label>Nombre</label>

                                            <input type="text"
                                                   value="@GetSectionName(sectionConfiguration)"
                                                   @onchange="e => SetCustomSectionNameAsync(sectionConfiguration, e.Value?.ToString())"
                                                    placeholder="Nombre de la sección" />
                                        </div>

                                        <div class="report-editor-section-layout">

                                            <label>Layout</label>

                                            <select value="@resolvedSection.Layout"
                                                    @onchange="e => SetCustomSectionLayoutAsync(
                                                                                sectionConfiguration,
                                                                                e)">

                                                <option value="@ReportSectionLayout.List">
                                                    Lista
                                                </option>

                                                <option value="@ReportSectionLayout.Columns2">
                                                    2 columnas
                                                </option>

                                                <option value="@ReportSectionLayout.Columns3">
                                                    3 columnas
                                                </option>

                                                <option value="@ReportSectionLayout.Columns4">
                                                    4 columnas
                                                </option>

                                            </select>

                                        </div>

                                        @if (resolvedSection.Fields.Count == 0)
                                        {
                                            <div class="report-editor-custom-section-placeholder">

                                                <i class="fa-solid fa-arrow-pointer"></i>

                                                <span>Sección vacía</span>

                                                <small>
                                                    Usa editar composición para añadir campos.
                                                </small>

                                            </div>
                                        }
                                        else
                                        {
                                            <div class="report-editor-placed-fields">

                                                @foreach (var field in resolvedSection.Fields
                                                    .Where(x => x.Visible)
                                                    .OrderBy(x => x.Order))
                                                {
                                                    <div class="report-editor-item">

                                                        <div class="report-editor-item-header">

                                                            <div class="report-editor-item-main">

                                                                <span class="report-editor-drag-handle">
                                                                    ⋮⋮
                                                                </span>

                                                                <span class="report-editor-toggle-label report-editor-item-title">
                                                                    @field.Label
                                                                </span>

                                                            </div>

                                                        </div>

                                                    </div>
                                                }

                                            </div>
                                        }

                                    </div>

                                </div>
                            }
                        }
                    }
                    else if (item.Type == ReportBodyItemType.Block)
                    {
                        if (item.LocalBlock?.Type == ReportBlockType.Text)
                        {
                            <ReportTextBlockEditor @key="item.Id"
                                                   Item="item"
                                                   CanMoveUp="canMoveUp"
                                                   CanMoveDown="canMoveDown"
                                                   MoveUp="() => MoveBodyItemAsync(item.Id, -1)"
                                                   MoveDown="() => MoveBodyItemAsync(item.Id, 1)"
                                                   Remove="() => RemoveBodyItemAsync(item.Id)"
                                                   Changed="ConfigurationUpdated" />
                        }
                        else
                        {
                            var reusableBlock = FindBodyBlock(item.BlockId);

                            if (reusableBlock is not null)
                            {
                                <div class="report-editor-content-item" @key="item.Id">
                                    <div class="report-editor-content-item-header">
                                        <div class="report-editor-content-item-heading">
                                            <span class="report-editor-content-item-icon">
                                                <i class="fa-solid fa-cube"></i>
                                            </span>
                                            <div>
                                                <strong>@reusableBlock.Name</strong>
                                                <span>Bloque reutilizable · @GetBlockTypeLabel(reusableBlock.Type)</span>
                                            </div>
                                        </div>

                                        <div class="report-editor-section-actions">
                                            <button type="button"
                                                    class="report-editor-section-order-button"
                                                    title="Mover arriba"
                                                    disabled="@(!canMoveUp)"
                                                    @onclick="() => MoveBodyItemAsync(item.Id, -1)">
                                                <i class="fa-solid fa-arrow-up"></i>
                                            </button>
                                            <button type="button"
                                                    class="report-editor-section-order-button"
                                                    title="Mover abajo"
                                                    disabled="@(!canMoveDown)"
                                                    @onclick="() => MoveBodyItemAsync(item.Id, 1)">
                                                <i class="fa-solid fa-arrow-down"></i>
                                            </button>
                                            <button type="button"
                                                    class="report-editor-section-order-button report-editor-danger-button"
                                                    title="Quitar del report"
                                                    @onclick="() => RemoveBodyItemAsync(item.Id)">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
                }

            </div>
        }

        @if (_activeTab == HeaderFooterTab)
        {
            <div class="report-editor-block">

                <div class="report-editor-block-title">
                    Cabecera y pie
                </div>

                @if (Definition.Header is not null)
                {
                    <ReportHeaderEditor Definition="Definition.Header"
                                        Resolved="_resolved?.Header"
                                        Configuration="Configuration"
                                        Blocks="HeaderBlocks"
                                        Texts="Texts"
                                        Changed="ConfigurationUpdated" />
                }

                @if (Definition.Footer is not null)
                {
                    <ReportFooterEditor Definition="Definition.Footer"
                                        Resolved="_resolved?.Footer"
                                        Configuration="Configuration"
                                        Blocks="FooterBlocks"
                                        Texts="Texts"
                                        Changed="ConfigurationUpdated" />
                }

            </div>
        }

        @if (_activeTab == LayoutTab)
        {
            <ReportLayoutEditor Items="GetLayoutItems()"
                                SameRowToggled="change => SetBodyItemSameRowAsync(change.Id, change.SameRow)"
                                SpanSelected="change => SetBodyItemSpanAsync(change.Id, change.Span)"
                                MoveRequested="change => MoveBodyItemAsync(change.Id, change.Direction)" />
        }

        @if (_activeTab == ThemeTab)
        {
            <ReportThemeEditor Theme="Theme"
                               Changed="ThemeUpdated" />
        }

    </aside>

    @* Arrastra para cambiar el ancho; doble clic vuelve al de por defecto.
       El ancho lo aplica JS sobre una variable CSS, sin pasar por el
       servidor: un pointermove por render dejaría el editor a rastras. *@
    <div class="report-editor-resizer"
         role="separator"
         aria-orientation="vertical"
         title="Arrastra para cambiar el ancho. Doble clic para el ancho por defecto.">
        <span></span>
    </div>

    <main class="report-editor-preview">

        <div class="report-editor-preview-toolbar">
            <div>
                <strong>Vista previa</strong>
                <span>@Definition.Name</span>
            </div>

            <div class="report-editor-preview-badge">
                Tiempo real
            </div>
        </div>

        <div class="report-editor-preview-canvas">
            @if (_resolved is not null)
            {
                <div class="report-editor-paper">
                    <DynamicReportRenderer Report="@_resolved"
                                           Data="@_previewData"
                                           Theme="@Theme" />
                </div>
            }
        </div>

    </main>

</div>

@if (_showComposer && _composerRequest is not null)
{
    <ReportSectionComposerModal Definition="Definition"
                                Request="_composerRequest"
                                Saved="SaveComposedSectionAsync"
                                Cancelled="CloseSectionComposer" />
}

<ReportDataPanel Visible="_showData"
                 Data="_previewData"
                 DataChanged="PreviewDataChangedAsync"
                 Closed="() => _showData = false" />

@code {
    private const string StructureTab = "structure";
    private const string HeaderFooterTab = "header-footer";
    private const string LayoutTab = "layout";
    private const string ThemeTab = "theme";
    private const long MaxPresetFileSize = 1024 * 1024;

    [Parameter]
    public EventCallback<JsonElement> DataChanged { get; set; }

    private bool _showData;
    private JsonElement _previewData;
    private string? _previewDataSignature;

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        WriteIndented = true,
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        PropertyNameCaseInsensitive = true,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
        Converters = { new JsonStringEnumConverter() }
    };

    [Parameter, EditorRequired]
    public ReportDefinition Definition { get; set; } = default!;

    [Parameter, EditorRequired]
    public ReportConfiguration Configuration { get; set; } = default!;

    [Parameter]
    public IReadOnlyCollection<ReportBlock> HeaderBlocks { get; set; } = [];

    [Parameter]
    public IReadOnlyCollection<ReportBlock> FooterBlocks { get; set; } = [];

    [Parameter]
    public IReadOnlyCollection<ReportBlock> BodyBlocks { get; set; } = [];

    [Parameter]
    public EventCallback<ReportConfiguration> ConfigurationChanged { get; set; }

    [Parameter, EditorRequired]
    public ReportTheme Theme { get; set; } = default!;

    [Parameter]
    public bool ShowSaveButton { get; set; } = true;

    [Parameter]
    public EventCallback<ReportTheme> ThemeChanged { get; set; }

    [Parameter, EditorRequired]
    public JsonElement Data { get; set; }

    [Parameter]
    public EventCallback SaveRequested { get; set; }

    /// <summary>
    /// Diccionario en edición para el ámbito del preset. El editor escribe
    /// aquí los textos y la página anfitriona los persiste al guardar.
    /// </summary>
    [Parameter]
    public ReportTextWorkspace Texts { get; set; } =
        ReportTextWorkspace.Detached();

    /// <summary>
    /// Culturas disponibles para previsualizar. Con menos de dos, el selector
    /// no se pinta.
    /// </summary>
    [Parameter]
    public IReadOnlyCollection<TenantCulture> Cultures { get; set; } = [];

    /// <summary>
    /// Cambio de cultura de edición. La página recarga el diccionario y
    /// reconstruye el workspace.
    /// </summary>
    [Parameter]
    public EventCallback<string> CultureChanged { get; set; }

    private readonly ReportConfigurationResolver _resolver = new();

    private bool _showComposer;
    private SectionCompositionRequest? _composerRequest;

    private ResolvedReportDefinition? _resolved;
    private string _activeTab = StructureTab;
    private bool _showAddContentMenu;
    private bool _showExistingBlocks;

    private IReadOnlyList<ReportBlock> ReusableBodyBlocks =>
        BodyBlocks
            .Where(x => x.Type is ReportBlockType.Text or ReportBlockType.Image or ReportBlockType.Fields)
            .OrderBy(x => x.Name)
            .ToList();

    private readonly HashSet<string> _collapsedItems = new(StringComparer.OrdinalIgnoreCase);

    private bool IsCollapsed(string itemId) =>
        _collapsedItems.Contains(itemId);

    private void ToggleCollapsed(string itemId)
    {
        if (!_collapsedItems.Remove(itemId))
            _collapsedItems.Add(itemId);
    }

    private ElementReference _root;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await JS.InvokeVoidAsync(
            "renderSet.initEditorResizer",
            _root);
    }

    protected override void OnParametersSet()
    {
        RebuildNestedSectionIndex();
        SyncPreviewDataFromParameter();
        Resolve();
    }

    /// <summary>
    /// Ids de las secciones que cuelgan de otra sección. El body sólo pinta
    /// raíces: de las anidadas se encarga el ReportSectionEditor del padre.
    /// </summary>
    private HashSet<string> _nestedSectionIds =
        new(StringComparer.OrdinalIgnoreCase);

    private bool IsNestedSection(string? sectionId) =>
        !string.IsNullOrWhiteSpace(sectionId) &&
        _nestedSectionIds.Contains(sectionId);

    private void RebuildNestedSectionIndex()
    {
        _nestedSectionIds =
            new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var section in Definition.Sections)
            CollectNestedSectionIds(section, _nestedSectionIds);
    }

    private static void CollectNestedSectionIds(
        ReportSectionDefinition section,
        HashSet<string> target)
    {
        foreach (var child in section.Sections)
        {
            target.Add(child.Id);
            CollectNestedSectionIds(child, target);
        }
    }

    private void SyncPreviewDataFromParameter()
    {
        var signature =
            Data.ValueKind == JsonValueKind.Undefined
                ? string.Empty
                : JsonSerializer.Serialize(Data);

        if (string.Equals(
                signature,
                _previewDataSignature,
                StringComparison.Ordinal))
        {
            return;
        }

        _previewDataSignature = signature;
        _previewData = Data.ValueKind == JsonValueKind.Undefined
            ? default
            : Data.Clone();
    }

    private async Task PreviewDataChangedAsync(
        JsonElement data)
    {
        _previewData = data.Clone();
        _previewDataSignature = JsonSerializer.Serialize(_previewData);

        await DataChanged.InvokeAsync(_previewData);
    }

    private void Resolve()
    {
        var headerBlock = FindSelectedBlock(
            HeaderBlocks,
            Configuration.Header?.BlockId);

        var footerBlock = FindSelectedBlock(
            FooterBlocks,
            Configuration.Footer?.BlockId);

        var effectiveConfiguration =
            ConfigurationComposer.Compose(
                Configuration,
                headerBlock,
                footerBlock);

        // El catálogo sale del workspace, no de base de datos: así el preview
        // refleja al instante lo que se está escribiendo.
        _resolved =
            _resolver.Resolve(
                Definition,
                effectiveConfiguration,
                BodyBlocks,
                Texts.ToCatalog());
    }

    private static ReportBlock? FindSelectedBlock(
        IReadOnlyCollection<ReportBlock> blocks,
        string? blockId)
    {
        if (string.IsNullOrWhiteSpace(blockId))
            return null;

        return blocks.FirstOrDefault(x =>
            string.Equals(
                x.Id,
                blockId,
                StringComparison.OrdinalIgnoreCase));
    }

    private ReportBlock? FindBodyBlock(string? blockId) =>
        string.IsNullOrWhiteSpace(blockId)
            ? null
            : BodyBlocks.FirstOrDefault(x =>
                string.Equals(x.Id, blockId, StringComparison.OrdinalIgnoreCase));

    private async Task ConfigurationUpdated()
    {
        Resolve();
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private Task ThemeUpdated() =>
        ThemeChanged.InvokeAsync(Theme);

    private void ShowStructure() =>
        _activeTab = StructureTab;

    private void ShowHeaderFooter() =>
        _activeTab = HeaderFooterTab;

    private void ShowLayout() =>
        _activeTab = LayoutTab;

    private void ShowTheme() =>
        _activeTab = ThemeTab;

    private void ToggleAddContentMenu()
    {
        _showAddContentMenu = !_showAddContentMenu;

        if (!_showAddContentMenu)
            _showExistingBlocks = false;
    }

    private void ToggleExistingBlocks() =>
        _showExistingBlocks = !_showExistingBlocks;

    private IReadOnlyList<ReportBodyItemConfiguration> GetOrderedBodyItems()
    {
        if (Configuration.Body.Count > 0)
            return Configuration.Body.ToList();

        return Definition.Sections
            .OrderBy(GetSectionOrder)
            .ThenBy(x => x.Id, StringComparer.OrdinalIgnoreCase)
            .Select((section, index) => new ReportBodyItemConfiguration
            {
                Id = $"section-{section.Id}",
                Type = ReportBodyItemType.Section,
                SectionId = section.Id,
                Order = (index + 1) * 10
            })
            .ToList();
    }

    private void EnsureBodyInitialized()
    {
        if (Configuration.Body.Count > 0)
            return;

        Configuration.Body = GetOrderedBodyItems()
            .Select(x => new ReportBodyItemConfiguration
            {
                Id = x.Id,
                Type = x.Type,
                SectionId = x.SectionId,
                BlockId = x.BlockId,
                LocalBlock = x.LocalBlock,
                Order = x.Order,
                SameRow = x.SameRow,
                Span = x.Span
            })
            .ToList();
    }

    private async Task AddCustomSectionAsync()
    {
        EnsureBodyInitialized();

        var sectionId = $"custom-section-{Guid.NewGuid():N}";

        Configuration.Sections.Add(
            new ReportSectionConfiguration
            {
                SectionId = sectionId,
                SourceSectionId = null,
                Visible = true,
                Layout = ReportSectionLayout.List
            });

        Texts.SetText(
            ReportTextKeys.Section(sectionId),
            "Nueva sección");

        Configuration.Body.Add(
            new ReportBodyItemConfiguration
            {
                Id = $"body-{Guid.NewGuid():N}",
                Type = ReportBodyItemType.Section,
                SectionId = sectionId,
                Order = GetNextBodyOrder()
            });

        CloseAddContentMenu();
        NormalizeBodyOrders();
        await ConfigurationUpdated();
    }

    private async Task AddTextBlockAsync()
    {
        EnsureBodyInitialized();

        var textConfiguration = new ReportTextBlockConfiguration
        {
            Title = "Nota",
            Text = "Escribe aquí el contenido del bloque."
        };

        Configuration.Body.Add(
            new ReportBodyItemConfiguration
            {
                Id = $"body-{Guid.NewGuid():N}",
                Type = ReportBodyItemType.Block,
                Order = GetNextBodyOrder(),
                LocalBlock = new ReportBodyBlockConfiguration
                {
                    Type = ReportBlockType.Text,
                    Name = "Nota",
                    ConfigurationJson = JsonSerializer.Serialize(
                        textConfiguration,
                        JsonOptions)
                }
            });

        CloseAddContentMenu();
        NormalizeBodyOrders();
        await ConfigurationUpdated();
    }

    private async Task AddExistingBlockAsync(ReportBlock block)
    {
        EnsureBodyInitialized();

        Configuration.Body.Add(
            new ReportBodyItemConfiguration
            {
                Id = $"body-{Guid.NewGuid():N}",
                Type = ReportBodyItemType.Block,
                BlockId = block.Id,
                Order = GetNextBodyOrder()
            });

        CloseAddContentMenu();
        NormalizeBodyOrders();
        await ConfigurationUpdated();
    }

    private async Task MoveBodyItemAsync(
        string itemId,
        int direction)
    {
        EnsureBodyInitialized();

        var ordered =
            Configuration.Body
                .OrderBy(x => x.Order)
                .ToList();

        var currentIndex =
            ordered.FindIndex(x =>
                string.Equals(
                    x.Id,
                    itemId,
                    StringComparison.OrdinalIgnoreCase));

        if (currentIndex < 0)
            return;

        var targetIndex =
            currentIndex + direction;

        if (targetIndex < 0 ||
            targetIndex >= ordered.Count)
        {
            return;
        }

        (ordered[currentIndex], ordered[targetIndex]) =
            (ordered[targetIndex], ordered[currentIndex]);

        Configuration.Body = ordered;

        NormalizeBodyOrders();

        await ConfigurationUpdated();
    }

    /// <summary>
    /// Traduce el cuerpo a lo que necesita la pestaña de disposición.
    ///
    /// Se aplican los mismos descartes que en la pestaña de estructura: las
    /// subsecciones las coloca su padre, y lo que no se puede resolver no se
    /// puede colocar. Así las dos pestañas enseñan siempre la misma lista.
    /// </summary>
    private IReadOnlyList<ReportLayoutItem> GetLayoutItems()
    {
        var items = new List<ReportLayoutItem>();

        foreach (var item in GetOrderedBodyItems())
        {
            if (item.Type == ReportBodyItemType.Section)
            {
                if (string.IsNullOrWhiteSpace(item.SectionId) ||
                    IsNestedSection(item.SectionId))
                {
                    continue;
                }

                var section = _resolved?.GetSection(item.SectionId);

                if (section is null)
                    continue;

                items.Add(
                    new ReportLayoutItem(
                        item.Id,
                        section.Name,
                        section.Table is not null ? "Sección con tabla" : "Sección",
                        "fa-solid fa-layer-group",
                        item.SameRow,
                        item.Span));

                continue;
            }

            if (item.LocalBlock is not null)
            {
                items.Add(
                    new ReportLayoutItem(
                        item.Id,
                        string.IsNullOrWhiteSpace(item.LocalBlock.Name)
                            ? GetBlockTypeLabel(item.LocalBlock.Type)
                            : item.LocalBlock.Name,
                        $"{GetBlockTypeLabel(item.LocalBlock.Type)} local",
                        $"fa-solid {GetBlockIcon(item.LocalBlock.Type)}",
                        item.SameRow,
                        item.Span));

                continue;
            }

            var block = FindBodyBlock(item.BlockId);

            if (block is null)
                continue;

            items.Add(
                new ReportLayoutItem(
                    item.Id,
                    block.Name,
                    $"Bloque · {GetBlockTypeLabel(block.Type)}",
                    $"fa-solid {GetBlockIcon(block.Type)}",
                    item.SameRow,
                    item.Span));
        }

        return items;
    }

    /// <summary>
    /// Une el elemento a la fila del anterior o lo baja a la suya propia.
    ///
    /// Pasa por EnsureBodyInitialized porque un preset antiguo puede no
    /// tener Body todavía: sin esto se estaría marcando una copia de trabajo
    /// que no se guarda en ningún sitio.
    /// </summary>
    private async Task SetBodyItemSameRowAsync(
        string itemId,
        bool sameRow)
    {
        EnsureBodyInitialized();

        var item = FindBodyItem(itemId);

        if (item is null)
            return;

        // Nulo y no false: la configuración sólo guarda lo que se aparta del
        // comportamiento por defecto.
        item.SameRow = sameRow ? true : null;

        // Al bajar a fila propia el ancho deja de significar nada, y dejarlo
        // guardado haría que reapareciera raro al volver a unirlo.
        if (!sameRow)
            item.Span = null;

        await ConfigurationUpdated();
    }

    private async Task SetBodyItemSpanAsync(
        string itemId,
        int? span)
    {
        EnsureBodyInitialized();

        var item = FindBodyItem(itemId);

        if (item is null)
            return;

        item.Span = span;

        await ConfigurationUpdated();
    }

    private ReportBodyItemConfiguration? FindBodyItem(
        string itemId) =>
        Configuration.Body.FirstOrDefault(x =>
            string.Equals(
                x.Id,
                itemId,
                StringComparison.OrdinalIgnoreCase));

    private async Task RemoveBodyItemAsync(string itemId)
    {
        EnsureBodyInitialized();

        var item = Configuration.Body.FirstOrDefault(x =>
            string.Equals(x.Id, itemId, StringComparison.OrdinalIgnoreCase));

        if (item is null)
            return;

        Configuration.Body.Remove(item);

        if (item.Type == ReportBodyItemType.Section &&
            !string.IsNullOrWhiteSpace(item.SectionId) &&
            Definition.Sections.All(x =>
                !string.Equals(x.Id, item.SectionId, StringComparison.OrdinalIgnoreCase)))
        {
            var customSection = FindSectionConfiguration(item.SectionId);

            if (customSection is not null)
            {
                Configuration.Sections.Remove(customSection);

                Configuration.FieldPlacements.RemoveAll(x =>
                    string.Equals(
                        x.SectionId,
                        item.SectionId,
                        StringComparison.OrdinalIgnoreCase));
            }
        }

        NormalizeBodyOrders();
        await ConfigurationUpdated();
    }

    private async Task SetCustomSectionNameAsync(
        ReportSectionConfiguration section,
        string? name)
    {
        Texts.SetText(
            ReportTextKeys.Section(section.SectionId),
            string.IsNullOrWhiteSpace(name)
                ? "Nueva sección"
                : name);

        await ConfigurationUpdated();
    }

    private string GetSectionName(
        ReportSectionConfiguration section) =>
        Texts.GetText(
            ReportTextKeys.Section(section.SectionId),
            section.SectionId);

    private async Task CultureSelectedAsync(
        ChangeEventArgs e)
    {
        var culture = e.Value?.ToString();

        if (string.IsNullOrWhiteSpace(culture))
            return;

        await CultureChanged.InvokeAsync(culture);
    }

    private async Task SetCustomSectionLayoutAsync(
        ReportSectionConfiguration section,
        ChangeEventArgs e)
    {
        if (!Enum.TryParse<ReportSectionLayout>(e.Value?.ToString(), out var layout))
            return;

        section.Layout = layout;
        await ConfigurationUpdated();
    }

    private void NormalizeBodyOrders()
    {
        var ordered = Configuration.Body;

        for (var i = 0; i < ordered.Count; i++)
        {
            var order = (i + 1) * 10;
            var item = ordered[i];

            item.Order = order;

            // El primero no puede continuar la fila de nadie. Si acaba
            // arriba por un movimiento o por un borrado, se limpia la
            // bandera para que la configuración guardada diga la verdad.
            if (i == 0)
                item.SameRow = null;

            if (item.Type == ReportBodyItemType.Section &&
                !string.IsNullOrWhiteSpace(item.SectionId))
            {
                var section =
                    FindSectionConfiguration(item.SectionId);

                if (section is not null)
                    section.Order = order;
            }
        }

        Configuration.Body =
            ordered;
    }

    private int GetNextBodyOrder() =>
        Configuration.Body.Count == 0
            ? 10
            : Configuration.Body.Max(x => x.Order) + 10;

    private void CloseAddContentMenu()
    {
        _showAddContentMenu = false;
        _showExistingBlocks = false;
    }

    private static string GetBlockTypeLabel(ReportBlockType type) =>
        type switch
        {
            ReportBlockType.Text => "Texto",
            ReportBlockType.Image => "Imagen",
            ReportBlockType.Fields => "Campos",
            _ => type.ToString()
        };

    private static string GetBlockIcon(ReportBlockType type) =>
        type switch
        {
            ReportBlockType.Text => "fa-align-left",
            ReportBlockType.Image => "fa-image",
            ReportBlockType.Fields => "fa-table-cells",
            ReportBlockType.Header => "fa-heading",
            ReportBlockType.Footer => "fa-window-minimize",
            _ => "fa-cube"
        };

    private async Task ExportPresetAsync()
    {
        var preset = new ReportPreset
        {
            Id = Configuration.Id,
            Version = 1,
            Configuration = Configuration,
            Theme = Theme
        };

        var json =
            JsonSerializer.Serialize(
                preset,
                JsonOptions);

        var fileName =
            $"report-{Configuration.ReportId}-{Configuration.Id}.json";

        await JS.InvokeVoidAsync(
            "renderSet.downloadText",
            fileName,
            json,
            "application/json;charset=utf-8");
    }

    private async Task ImportPresetAsync(
        InputFileChangeEventArgs args)
    {
        var file = args.File;

        await using var stream =
            file.OpenReadStream(MaxPresetFileSize);

        using var reader =
            new StreamReader(stream, Encoding.UTF8);

        var json =
            await reader.ReadToEndAsync();

        var preset =
            JsonSerializer.Deserialize<ReportPreset>(json, JsonOptions)
            ?? throw new InvalidOperationException(
                "El archivo no contiene un preset válido.");

        if (!string.Equals(
                preset.Configuration.ReportId,
                Definition.Id,
                StringComparison.OrdinalIgnoreCase))
        {
            throw new InvalidOperationException(
                $"La configuración pertenece al report '{preset.Configuration.ReportId}' " +
                $"y no a '{Definition.Id}'.");
        }

        Configuration = preset.Configuration;
        Theme = preset.Theme;

        Resolve();

        await ConfigurationChanged.InvokeAsync(Configuration);
        await ThemeChanged.InvokeAsync(Theme);
    }

    private int GetSectionOrder(
        ReportSectionDefinition definition)
    {
        var configuration = FindSectionConfiguration(definition.Id);

        return configuration?.Order
            ?? definition.Order;
    }

    private ReportSectionConfiguration? FindSectionConfiguration(
        string sectionId) =>
        Configuration.Sections.FirstOrDefault(x =>
            string.Equals(
                x.SectionId,
                sectionId,
                StringComparison.OrdinalIgnoreCase));

    private void OpenSectionComposer()
    {
        CloseAddContentMenu();

        _composerRequest =
            new SectionCompositionRequest
            {
                Name = "",
                Layout = ReportSectionLayout.List,
                SelectedFieldIds = []
            };

        _showComposer = true;
    }

    private void OpenSectionComposer(string sectionId)
    {
        CloseAddContentMenu();

        var sectionConfiguration =
            FindSectionConfiguration(sectionId);

        if (sectionConfiguration is null)
            return;

        var selectedFieldIds =
            Configuration.FieldPlacements
                .Where(x =>
                    string.Equals(
                        x.SectionId,
                        sectionId,
                        StringComparison.OrdinalIgnoreCase))
                .OrderBy(x => x.Order)
                .Select(x => x.FieldId)
                .ToList();

        _composerRequest =
            new SectionCompositionRequest
            {
                SectionId = sectionId,
                Name = GetSectionName(sectionConfiguration),
                Layout = sectionConfiguration.Layout
                    ?? ReportSectionLayout.List,
                SelectedFieldIds = selectedFieldIds
            };

        _showComposer = true;
    }

    private void CloseSectionComposer()
    {
        _showComposer = false;
        _composerRequest = null;
    }


    private async Task SaveComposedSectionAsync(
    SectionCompositionRequest request)
    {
        if (string.IsNullOrWhiteSpace(request.Name) ||
            request.SelectedFieldIds.Count == 0)
        {
            return;
        }

        EnsureBodyInitialized();

        var isNew =
            string.IsNullOrWhiteSpace(request.SectionId);

        var sectionId =
            isNew
                ? $"custom-{Guid.NewGuid():N}"
                : request.SectionId!;

        var section =
            FindSectionConfiguration(sectionId);

        if (section is null)
        {
            section =
                new ReportSectionConfiguration
                {
                    SectionId = sectionId,
                    SourceSectionId = null,
                    Fields = []
                };

            Configuration.Sections.Add(section);
        }

        Texts.SetText(
            ReportTextKeys.Section(sectionId),
            request.Name);

        section.Layout =
            request.Layout;

        section.Visible =
            true;

        if (section.Order is null)
            section.Order = GetNextBodyOrder();

        var bodyItem =
            Configuration.Body.FirstOrDefault(x =>
                x.Type == ReportBodyItemType.Section &&
                string.Equals(
                    x.SectionId,
                    sectionId,
                    StringComparison.OrdinalIgnoreCase));

        if (bodyItem is null)
        {
            bodyItem =
                new ReportBodyItemConfiguration
                {
                    Id = $"body-{sectionId}",
                    Type = ReportBodyItemType.Section,
                    SectionId = sectionId,
                    Order = GetNextBodyOrder()
                };

            Configuration.Body.Add(bodyItem);
        }

        /*
         * Quitamos todos los placements actuales de esta sección.
         * Esto permite editar la composición y desmarcar campos.
         */
        Configuration.FieldPlacements.RemoveAll(x =>
            string.Equals(
                x.SectionId,
                sectionId,
                StringComparison.OrdinalIgnoreCase));

        /*
         * Quitamos también cualquier placement anterior de los campos
         * seleccionados, por si venían de otra sección custom.
         */
        foreach (var fieldId in request.SelectedFieldIds)
        {
            Configuration.FieldPlacements.RemoveAll(x =>
                string.Equals(
                    x.FieldId,
                    fieldId,
                    StringComparison.OrdinalIgnoreCase));
        }

        for (var i = 0; i < request.SelectedFieldIds.Count; i++)
        {
            Configuration.FieldPlacements.Add(
                new ReportFieldPlacementConfiguration
                {
                    FieldId = request.SelectedFieldIds[i],
                    SectionId = sectionId,
                    Order = (i + 1) * 10
                });
        }

        CloseSectionComposer();

        NormalizeBodyOrders();

        await ConfigurationUpdated();
    }

    private void RemoveExistingFieldPlacement(
        string fieldId)
    {
        var existing =
            Configuration.FieldPlacements.FirstOrDefault(x =>
                string.Equals(
                    x.FieldId,
                    fieldId,
                    StringComparison.OrdinalIgnoreCase));

        if (existing is not null)
            Configuration.FieldPlacements.Remove(existing);
    }
