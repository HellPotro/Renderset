@using System.IO
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using Renderset.Blazor.Components.Rendering
@using Renderset.Core.Blocks
@using Renderset.Core.Configurations
@using Renderset.Core.Definitions
@using Renderset.Core.Persistence
@using Renderset.Core.Resolved
@using Renderset.Core.Services
@using Renderset.Core.Themes

@inject IJSRuntime JS
@inject IReportConfigurationComposer ConfigurationComposer

<div class="report-editor">

    <aside class="report-editor-sidebar">

        <div class="report-editor-header">

            <div class="report-editor-eyebrow">
                Configuración
            </div>

            <h2>@Configuration.Name</h2>

            <div class="report-editor-actions">

                @if (ShowSaveButton)
                {
                    <button type="button"
                            class="report-editor-action-button report-editor-action-primary"
                            @onclick="SaveRequested">
                        Guardar
                    </button>
                }

                <button type="button"
                        class="report-editor-action-button"
                        @onclick="ExportPresetAsync">
                    Exportar JSON
                </button>

                <label class="report-editor-action-button report-editor-import-button">
                    Importar JSON

                    <InputFile OnChange="ImportPresetAsync"
                               accept=".json,application/json" />
                </label>

            </div>

        </div>

        <div class="report-editor-tabs">

            <button type="button"
                    class="report-editor-tab @(_activeTab == StructureTab ? "active" : null)"
                    @onclick="ShowStructure">
                Estructura
            </button>

            <button type="button"
                    class="report-editor-tab @(_activeTab == HeaderFooterTab ? "active" : null)"
                    @onclick="ShowHeaderFooter">
                Cabecera y pie
            </button>

            <button type="button"
                    class="report-editor-tab @(_activeTab == ThemeTab ? "active" : null)"
                    @onclick="ShowTheme">
                Tema
            </button>

        </div>

        @if (_activeTab == StructureTab)
        {
            <div class="report-editor-block">

                <div class="report-editor-block-title-row">
                    <div class="report-editor-block-title">
                        Estructura
                    </div>

                    <button type="button"
                            class="report-editor-add-content-button"
                            @onclick="ToggleAddContentMenu">
                        <i class="fa-solid fa-plus"></i>
                        Añadir contenido
                    </button>
                </div>

                @if (_showAddContentMenu)
                {
                    <div class="report-editor-add-content-menu">

                        <button type="button"
                                class="report-editor-add-content-option"
                                @onclick="AddCustomSectionAsync">
                            <span class="report-editor-add-content-icon">
                                <i class="fa-regular fa-square"></i>
                            </span>
                            <span>
                                <strong>Nueva sección</strong>
                                <small>Agrupa contenido bajo un nuevo título</small>
                            </span>
                        </button>

                        <button type="button"
                                class="report-editor-add-content-option"
                                @onclick="AddTextBlockAsync">
                            <span class="report-editor-add-content-icon">
                                <i class="fa-solid fa-align-left"></i>
                            </span>
                            <span>
                                <strong>Texto</strong>
                                <small>Añade instrucciones, notas o contenido fijo</small>
                            </span>
                        </button>

                        <button type="button"
                                class="report-editor-add-content-option"
                                @onclick="ToggleExistingBlocks">
                            <span class="report-editor-add-content-icon">
                                <i class="fa-solid fa-cubes"></i>
                            </span>
                            <span>
                                <strong>Bloque existente</strong>
                                <small>Reutiliza contenido guardado</small>
                            </span>
                        </button>

                        @if (_showExistingBlocks)
                        {
                            <div class="report-editor-existing-blocks">
                                @if (ReusableBodyBlocks.Count == 0)
                                {
                                    <div class="report-editor-empty-state">
                                        No hay bloques de contenido reutilizables.
                                    </div>
                                }
                                else
                                {
                                    @foreach (var block in ReusableBodyBlocks)
                                    {
                                        <button type="button"
                                                class="report-editor-existing-block"
                                                @onclick="() => AddExistingBlockAsync(block)">
                                            <span>@block.Name</span>
                                            <small>@GetBlockTypeLabel(block.Type)</small>
                                        </button>
                                    }
                                }
                            </div>
                        }

                    </div>
                }

                @{
                    var bodyItems = GetOrderedBodyItems();
                }

                @for (var i = 0; i < bodyItems.Count; i++)
                {
                    var item = bodyItems[i];
                    var canMoveUp = i > 0;
                    var canMoveDown = i < bodyItems.Count - 1;

                    if (item.Type == ReportBodyItemType.Section &&
                        !string.IsNullOrWhiteSpace(item.SectionId))
                    {
                        var sectionDefinition = Definition.Sections.FirstOrDefault(x =>
                            string.Equals(x.Id, item.SectionId, StringComparison.OrdinalIgnoreCase));

                        var resolvedSection = _resolved?.GetSection(item.SectionId);

                        if (resolvedSection is null)
                            continue;

                        if (sectionDefinition is not null)
                        {
                            <ReportSectionEditor @key="item.Id"
                                                 Definition="sectionDefinition"
                                                 Resolved="resolvedSection"
                                                 Configuration="Configuration"
                                                 CanMoveUp="canMoveUp"
                                                 CanMoveDown="canMoveDown"
                                                 MoveUp="() => MoveBodyItemAsync(item.Id, -1)"
                                                 MoveDown="() => MoveBodyItemAsync(item.Id, 1)"
                                                 Changed="ConfigurationUpdated" />
                        }
                        else
                        {
                            var sectionConfiguration = FindSectionConfiguration(item.SectionId);

                            if (sectionConfiguration is not null)
                            {
                                <div class="report-editor-content-item report-editor-custom-section" @key="item.Id">

                                    <div class="report-editor-content-item-header">
                                        <div class="report-editor-content-item-heading">
                                            <span class="report-editor-content-item-icon">
                                                <i class="fa-regular fa-square"></i>
                                            </span>
                                            <div>
                                                <strong>@resolvedSection.Name</strong>
                                                <span>Sección personalizada</span>
                                            </div>
                                        </div>

                                        <div class="report-editor-section-actions">
                                            <button type="button"
                                                    class="report-editor-section-order-button"
                                                    title="Mover sección arriba"
                                                    disabled="@(!canMoveUp)"
                                                    @onclick="() => MoveBodyItemAsync(item.Id, -1)">
                                                <i class="fa-solid fa-arrow-up"></i>
                                            </button>

                                            <button type="button"
                                                    class="report-editor-section-order-button"
                                                    title="Mover sección abajo"
                                                    disabled="@(!canMoveDown)"
                                                    @onclick="() => MoveBodyItemAsync(item.Id, 1)">
                                                <i class="fa-solid fa-arrow-down"></i>
                                            </button>

                                            <button type="button"
                                                    class="report-editor-section-order-button report-editor-danger-button"
                                                    title="Eliminar sección"
                                                    @onclick="() => RemoveBodyItemAsync(item.Id)">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="report-editor-content-item-body">
                                        <div class="report-editor-property">
                                            <label>Nombre</label>
                                            <input type="text"
                                                   value="@sectionConfiguration.NameOverride"
                                                   @onchange="e => SetCustomSectionNameAsync(sectionConfiguration, e.Value?.ToString())"
                                                   placeholder="Nombre de la sección" />
                                        </div>

                                        <div class="report-editor-section-layout">
                                            <label>Layout</label>
                                            <select value="@resolvedSection.Layout"
                                                    @onchange="e => SetCustomSectionLayoutAsync(sectionConfiguration, e)">
                                                <option value="@ReportSectionLayout.List">Lista</option>
                                                <option value="@ReportSectionLayout.Columns2">2 columnas</option>
                                                <option value="@ReportSectionLayout.Columns3">3 columnas</option>
                                                <option value="@ReportSectionLayout.Columns4">4 columnas</option>
                                            </select>
                                        </div>

                                        <div class="report-editor-custom-section-placeholder">
                                            <i class="fa-solid fa-arrow-pointer"></i>
                                            <span>Sección vacía</span>
                                            <small>En el siguiente paso podrás mover campos aquí.</small>
                                        </div>
                                    </div>

                                </div>
                            }
                        }
                    }
                    else if (item.Type == ReportBodyItemType.Block)
                    {
                        if (item.LocalBlock?.Type == ReportBlockType.Text)
                        {
                            <ReportTextBlockEditor @key="item.Id"
                                                   Item="item"
                                                   CanMoveUp="canMoveUp"
                                                   CanMoveDown="canMoveDown"
                                                   MoveUp="() => MoveBodyItemAsync(item.Id, -1)"
                                                   MoveDown="() => MoveBodyItemAsync(item.Id, 1)"
                                                   Remove="() => RemoveBodyItemAsync(item.Id)"
                                                   Changed="ConfigurationUpdated" />
                        }
                        else
                        {
                            var reusableBlock = FindBodyBlock(item.BlockId);

                            if (reusableBlock is not null)
                            {
                                <div class="report-editor-content-item" @key="item.Id">
                                    <div class="report-editor-content-item-header">
                                        <div class="report-editor-content-item-heading">
                                            <span class="report-editor-content-item-icon">
                                                <i class="fa-solid fa-cube"></i>
                                            </span>
                                            <div>
                                                <strong>@reusableBlock.Name</strong>
                                                <span>Bloque reutilizable · @GetBlockTypeLabel(reusableBlock.Type)</span>
                                            </div>
                                        </div>

                                        <div class="report-editor-section-actions">
                                            <button type="button"
                                                    class="report-editor-section-order-button"
                                                    title="Mover arriba"
                                                    disabled="@(!canMoveUp)"
                                                    @onclick="() => MoveBodyItemAsync(item.Id, -1)">
                                                <i class="fa-solid fa-arrow-up"></i>
                                            </button>
                                            <button type="button"
                                                    class="report-editor-section-order-button"
                                                    title="Mover abajo"
                                                    disabled="@(!canMoveDown)"
                                                    @onclick="() => MoveBodyItemAsync(item.Id, 1)">
                                                <i class="fa-solid fa-arrow-down"></i>
                                            </button>
                                            <button type="button"
                                                    class="report-editor-section-order-button report-editor-danger-button"
                                                    title="Quitar del report"
                                                    @onclick="() => RemoveBodyItemAsync(item.Id)">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
                }

            </div>
        }

        @if (_activeTab == HeaderFooterTab)
        {
            <div class="report-editor-block">

                <div class="report-editor-block-title">
                    Cabecera y pie
                </div>

                @if (Definition.Header is not null)
                {
                    <ReportHeaderEditor Definition="Definition.Header"
                                        Resolved="_resolved?.Header"
                                        Configuration="Configuration"
                                        Blocks="HeaderBlocks"
                                        Changed="ConfigurationUpdated" />
                }

                @if (Definition.Footer is not null)
                {
                    <ReportFooterEditor Definition="Definition.Footer"
                                        Resolved="_resolved?.Footer"
                                        Configuration="Configuration"
                                        Blocks="FooterBlocks"
                                        Changed="ConfigurationUpdated" />
                }

            </div>
        }

        @if (_activeTab == ThemeTab)
        {
            <ReportThemeEditor Theme="Theme"
                               Changed="ThemeUpdated" />
        }

    </aside>

    <main class="report-editor-preview">

        <div class="report-editor-preview-toolbar">
            <div>
                <strong>Vista previa</strong>
                <span>@Definition.Name</span>
            </div>

            <div class="report-editor-preview-badge">
                Tiempo real
            </div>
        </div>

        <div class="report-editor-preview-canvas">
            @if (_resolved is not null)
            {
                <div class="report-editor-paper">
                    <DynamicReportRenderer Report="@_resolved"
                                           Data="@Data"
                                           Theme="@Theme" />
                </div>
            }
        </div>

    </main>

</div>

@code {
    private const string StructureTab = "structure";
    private const string HeaderFooterTab = "header-footer";
    private const string ThemeTab = "theme";
    private const long MaxPresetFileSize = 1024 * 1024;

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        WriteIndented = true,
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        PropertyNameCaseInsensitive = true,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
        Converters = { new JsonStringEnumConverter() }
    };

    [Parameter, EditorRequired]
    public ReportDefinition Definition { get; set; } = default!;

    [Parameter, EditorRequired]
    public ReportConfiguration Configuration { get; set; } = default!;

    [Parameter]
    public IReadOnlyCollection<ReportBlock> HeaderBlocks { get; set; } = [];

    [Parameter]
    public IReadOnlyCollection<ReportBlock> FooterBlocks { get; set; } = [];

    [Parameter]
    public IReadOnlyCollection<ReportBlock> BodyBlocks { get; set; } = [];

    [Parameter]
    public EventCallback<ReportConfiguration> ConfigurationChanged { get; set; }

    [Parameter, EditorRequired]
    public ReportTheme Theme { get; set; } = default!;

    [Parameter]
    public bool ShowSaveButton { get; set; } = true;

    [Parameter]
    public EventCallback<ReportTheme> ThemeChanged { get; set; }

    [Parameter, EditorRequired]
    public JsonElement Data { get; set; }

    [Parameter]
    public EventCallback SaveRequested { get; set; }

    private readonly ReportConfigurationResolver _resolver = new();

    private ResolvedReportDefinition? _resolved;
    private string _activeTab = StructureTab;
    private bool _showAddContentMenu;
    private bool _showExistingBlocks;

    private IReadOnlyList<ReportBlock> ReusableBodyBlocks =>
        BodyBlocks
            .Where(x => x.Type is ReportBlockType.Text or ReportBlockType.Image or ReportBlockType.Fields)
            .OrderBy(x => x.Name)
            .ToList();

    protected override void OnParametersSet()
    {
        Resolve();
    }

    private void Resolve()
    {
        var headerBlock = FindSelectedBlock(
            HeaderBlocks,
            Configuration.Header?.BlockId);

        var footerBlock = FindSelectedBlock(
            FooterBlocks,
            Configuration.Footer?.BlockId);

        var effectiveConfiguration =
            ConfigurationComposer.Compose(
                Configuration,
                headerBlock,
                footerBlock);

        _resolved =
            _resolver.Resolve(
                Definition,
                effectiveConfiguration,
                BodyBlocks);
    }

    private static ReportBlock? FindSelectedBlock(
        IReadOnlyCollection<ReportBlock> blocks,
        string? blockId)
    {
        if (string.IsNullOrWhiteSpace(blockId))
            return null;

        return blocks.FirstOrDefault(x =>
            string.Equals(
                x.Id,
                blockId,
                StringComparison.OrdinalIgnoreCase));
    }

    private ReportBlock? FindBodyBlock(string? blockId) =>
        string.IsNullOrWhiteSpace(blockId)
            ? null
            : BodyBlocks.FirstOrDefault(x =>
                string.Equals(x.Id, blockId, StringComparison.OrdinalIgnoreCase));

    private async Task ConfigurationUpdated()
    {
        Resolve();
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    private Task ThemeUpdated() =>
        ThemeChanged.InvokeAsync(Theme);

    private void ShowStructure() =>
        _activeTab = StructureTab;

    private void ShowHeaderFooter() =>
        _activeTab = HeaderFooterTab;

    private void ShowTheme() =>
        _activeTab = ThemeTab;

    private void ToggleAddContentMenu()
    {
        _showAddContentMenu = !_showAddContentMenu;

        if (!_showAddContentMenu)
            _showExistingBlocks = false;
    }

    private void ToggleExistingBlocks() =>
        _showExistingBlocks = !_showExistingBlocks;

    private IReadOnlyList<ReportBodyItemConfiguration> GetOrderedBodyItems()
    {
        if (Configuration.Body.Count > 0)
        {
            return Configuration.Body
                .OrderBy(x => x.Order)
                .ToList();
        }

        return Definition.Sections
            .OrderBy(GetSectionOrder)
            .ThenBy(x => x.Order)
            .Select((section, index) => new ReportBodyItemConfiguration
            {
                Id = $"section-{section.Id}",
                Type = ReportBodyItemType.Section,
                SectionId = section.Id,
                Order = (index + 1) * 10
            })
            .ToList();
    }

    private void EnsureBodyInitialized()
    {
        if (Configuration.Body.Count > 0)
            return;

        Configuration.Body = GetOrderedBodyItems()
            .Select(x => new ReportBodyItemConfiguration
            {
                Id = x.Id,
                Type = x.Type,
                SectionId = x.SectionId,
                BlockId = x.BlockId,
                LocalBlock = x.LocalBlock,
                Order = x.Order
            })
            .ToList();
    }

    private async Task AddCustomSectionAsync()
    {
        EnsureBodyInitialized();

        var sectionId = $"custom-section-{Guid.NewGuid():N}";

        Configuration.Sections.Add(
            new ReportSectionConfiguration
            {
                SectionId = sectionId,
                SourceSectionId = null,
                NameOverride = "Nueva sección",
                Visible = true,
                Layout = ReportSectionLayout.List
            });

        Configuration.Body.Add(
            new ReportBodyItemConfiguration
            {
                Id = $"body-{Guid.NewGuid():N}",
                Type = ReportBodyItemType.Section,
                SectionId = sectionId,
                Order = GetNextBodyOrder()
            });

        CloseAddContentMenu();
        NormalizeBodyOrders();
        await ConfigurationUpdated();
    }

    private async Task AddTextBlockAsync()
    {
        EnsureBodyInitialized();

        var textConfiguration = new ReportTextBlockConfiguration
        {
            Title = "Nota",
            Text = "Escribe aquí el contenido del bloque."
        };

        Configuration.Body.Add(
            new ReportBodyItemConfiguration
            {
                Id = $"body-{Guid.NewGuid():N}",
                Type = ReportBodyItemType.Block,
                Order = GetNextBodyOrder(),
                LocalBlock = new ReportBodyBlockConfiguration
                {
                    Type = ReportBlockType.Text,
                    Name = "Nota",
                    ConfigurationJson = JsonSerializer.Serialize(
                        textConfiguration,
                        JsonOptions)
                }
            });

        CloseAddContentMenu();
        NormalizeBodyOrders();
        await ConfigurationUpdated();
    }

    private async Task AddExistingBlockAsync(ReportBlock block)
    {
        EnsureBodyInitialized();

        Configuration.Body.Add(
            new ReportBodyItemConfiguration
            {
                Id = $"body-{Guid.NewGuid():N}",
                Type = ReportBodyItemType.Block,
                BlockId = block.Id,
                Order = GetNextBodyOrder()
            });

        CloseAddContentMenu();
        NormalizeBodyOrders();
        await ConfigurationUpdated();
    }

    private async Task MoveBodyItemAsync(
        string itemId,
        int direction)
    {
        EnsureBodyInitialized();

        var ordered = Configuration.Body
            .OrderBy(x => x.Order)
            .ToList();

        var currentIndex = ordered.FindIndex(x =>
            string.Equals(x.Id, itemId, StringComparison.OrdinalIgnoreCase));

        if (currentIndex < 0)
            return;

        var targetIndex = currentIndex + direction;

        if (targetIndex < 0 || targetIndex >= ordered.Count)
            return;

        (ordered[currentIndex], ordered[targetIndex]) =
            (ordered[targetIndex], ordered[currentIndex]);

        Configuration.Body = ordered;
        NormalizeBodyOrders();

        await ConfigurationUpdated();
    }

    private async Task RemoveBodyItemAsync(string itemId)
    {
        EnsureBodyInitialized();

        var item = Configuration.Body.FirstOrDefault(x =>
            string.Equals(x.Id, itemId, StringComparison.OrdinalIgnoreCase));

        if (item is null)
            return;

        Configuration.Body.Remove(item);

        if (item.Type == ReportBodyItemType.Section &&
            !string.IsNullOrWhiteSpace(item.SectionId) &&
            Definition.Sections.All(x =>
                !string.Equals(x.Id, item.SectionId, StringComparison.OrdinalIgnoreCase)))
        {
            var customSection = FindSectionConfiguration(item.SectionId);

            if (customSection is not null)
                Configuration.Sections.Remove(customSection);
        }

        NormalizeBodyOrders();
        await ConfigurationUpdated();
    }

    private async Task SetCustomSectionNameAsync(
        ReportSectionConfiguration section,
        string? name)
    {
        section.NameOverride = string.IsNullOrWhiteSpace(name)
            ? "Nueva sección"
            : name.Trim();

        await ConfigurationUpdated();
    }

    private async Task SetCustomSectionLayoutAsync(
        ReportSectionConfiguration section,
        ChangeEventArgs e)
    {
        if (!Enum.TryParse<ReportSectionLayout>(e.Value?.ToString(), out var layout))
            return;

        section.Layout = layout;
        await ConfigurationUpdated();
    }

    private void NormalizeBodyOrders()
    {
        var ordered = Configuration.Body
            .OrderBy(x => x.Order)
            .ToList();

        for (var i = 0; i < ordered.Count; i++)
            ordered[i].Order = (i + 1) * 10;

        Configuration.Body = ordered;
    }

    private int GetNextBodyOrder() =>
        Configuration.Body.Count == 0
            ? 10
            : Configuration.Body.Max(x => x.Order) + 10;

    private void CloseAddContentMenu()
    {
        _showAddContentMenu = false;
        _showExistingBlocks = false;
    }

    private static string GetBlockTypeLabel(ReportBlockType type) =>
        type switch
        {
            ReportBlockType.Text => "Texto",
            ReportBlockType.Image => "Imagen",
            ReportBlockType.Fields => "Campos",
            _ => type.ToString()
        };

    private async Task ExportPresetAsync()
    {
        var preset = new ReportPreset
        {
            Id = Configuration.Id,
            Version = 1,
            Configuration = Configuration,
            Theme = Theme
        };

        var json =
            JsonSerializer.Serialize(
                preset,
                JsonOptions);

        var fileName =
            $"report-{Configuration.ReportId}-{Configuration.Id}.json";

        await JS.InvokeVoidAsync(
            "renderSet.downloadText",
            fileName,
            json,
            "application/json;charset=utf-8");
    }

    private async Task ImportPresetAsync(
        InputFileChangeEventArgs args)
    {
        var file = args.File;

        await using var stream =
            file.OpenReadStream(MaxPresetFileSize);

        using var reader =
            new StreamReader(stream, Encoding.UTF8);

        var json =
            await reader.ReadToEndAsync();

        var preset =
            JsonSerializer.Deserialize<ReportPreset>(json, JsonOptions)
            ?? throw new InvalidOperationException(
                "El archivo no contiene un preset válido.");

        if (!string.Equals(
                preset.Configuration.ReportId,
                Definition.Id,
                StringComparison.OrdinalIgnoreCase))
        {
            throw new InvalidOperationException(
                $"La configuración pertenece al report '{preset.Configuration.ReportId}' " +
                $"y no a '{Definition.Id}'.");
        }

        Configuration = preset.Configuration;
        Theme = preset.Theme;

        Resolve();

        await ConfigurationChanged.InvokeAsync(Configuration);
        await ThemeChanged.InvokeAsync(Theme);
    }

    private int GetSectionOrder(
        ReportSectionDefinition definition)
    {
        var configuration = FindSectionConfiguration(definition.Id);

        return configuration?.Order
            ?? definition.Order;
    }

    private ReportSectionConfiguration? FindSectionConfiguration(
        string sectionId) =>
        Configuration.Sections.FirstOrDefault(x =>
            string.Equals(
                x.SectionId,
                sectionId,
                StringComparison.OrdinalIgnoreCase));
}
