    /// <summary>
    /// Visibilidad del campo dentro de esta sección. Se guarda en la
    /// sección, igual que el tipo: el mismo campo puede verse aquí y no en
    /// otro sitio.
    /// </summary>
    private async Task SetPlacedFieldVisibleAsync(
        ReportSectionConfiguration section,
        string fieldId,
        bool visible)
    {
        // Sparse respecto a la definición: nulo cuando coincide con lo que
        // el campo trae por defecto.
        var byDefault =
            FindFieldDefinition(fieldId)?.VisibleByDefault ?? true;

        var value =
            visible == byDefault
                ? (bool?)null
                : visible;

        var field =
            section.Fields.FirstOrDefault(x =>
                string.Equals(x.FieldId, fieldId, StringComparison.OrdinalIgnoreCase));

        if (field is null)
        {
            if (value is null)
                return;

            field = new ReportFieldConfiguration { FieldId = fieldId };
            section.Fields.Add(field);
        }

        field.Visible = value;
        await ConfigurationUpdated();
    }

