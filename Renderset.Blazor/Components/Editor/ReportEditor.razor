    private ReportFieldDefinition? FindFieldDefinition(
        string fieldId)
    {
        static IEnumerable<ReportFieldDefinition> Walk(IEnumerable<ReportSectionDefinition> sections) =>
            sections.SelectMany(section => section.Fields.Concat(Walk(section.Sections)));

        return Walk(Definition.Sections)
            .FirstOrDefault(x =>
                string.Equals(x.Id, fieldId, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>
    /// El tipo de un campo colocado en una sección personalizada se guarda en
    /// esa sección: el mismo campo puede verse como número en su sección de
    /// origen y como texto aquí.
    /// </summary>
    private async Task SetPlacedFieldTypeAsync(
        ReportSectionConfiguration section,
        string fieldId,
        ReportFieldType? type)
    {
        var field =
            section.Fields.FirstOrDefault(x =>
                string.Equals(x.FieldId, fieldId, StringComparison.OrdinalIgnoreCase));

        if (field is null)
        {
            if (type is null)
                return;

            field = new ReportFieldConfiguration { FieldId = fieldId };
            section.Fields.Add(field);
        }

        field.Type = type;
        await ConfigurationUpdated();
    }

