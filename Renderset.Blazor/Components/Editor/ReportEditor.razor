@using System.IO
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using Renderset.Blazor.Components.Localization
@using Renderset.Blazor.Components.Rendering
@using Renderset.Core.Blocks
@using Renderset.Core.Composer
@using Renderset.Core.Configurations
@using Renderset.Core.Definitions
@using Renderset.Core.Persistence
@using Renderset.Core.Reports
@using Renderset.Core.Resolved
@using Renderset.Core.Services
@using Renderset.Core.Themes

@inject IJSRuntime JS
@inject IReportConfigurationComposer ConfigurationComposer

<div class="report-editor" @ref="_root">

    <aside class="report-editor-sidebar">

        <div class="report-editor-header">

            <div class="report-editor-eyebrow">
                Configuración
            </div>

            <h2>@Configuration.Name</h2>

            @if (Cultures.Count > 1)
            {
                <div class="report-editor-culture">

                    <i class="fa-solid fa-language"></i>                    

                    <select value="@Texts.Culture"
                            @onchange="CultureSelectedAsync">

                        @foreach (var culture in Cultures)
                        {
                            <option value="@culture.Culture">                                
                                @CultureFlag.For(culture.Culture) @culture.DisplayName
                            </option>
                        }

                    </select>

                </div>
            }

            <div class="report-editor-actions">

                @if (ShowSaveButton)
                {
                    <button type="button"
                            class="@(HasUnsavedChanges ? "primary-button" : "secondary-button") report-editor-save"
                            title="@(HasUnsavedChanges ? "Hay cambios sin guardar" : "Todo guardado")"
                            @onclick="SaveRequested">
                        <i class="fa-solid fa-save"></i>
                        Guardar
                        @if (HasUnsavedChanges)
                        {
                            <span class="report-editor-save-dot" aria-hidden="true"></span>
                        }
                    </button>
                }

                <button type="button"
                        class="secondary-button"
                        @onclick="() => _showData = !_showData">
                    <i class="fa-solid fa-database"></i>
                    Datos
                </button>

                <button type="button"
                        class="report-editor-action-button"
                        @onclick="ExportPresetAsync">
                    Exportar JSON
                </button>

                <label class="report-editor-action-button report-editor-import-button">
                    Importar JSON

                    <InputFile OnChange="ImportPresetAsync"
                               accept=".json,application/json" />
                </label>

            </div>

        </div>

        @* Cuatro pestañas en una fila, con icono: antes eran tres columnas
           para cuatro botones y "Tema" caía sola a una segunda línea. *@
        <nav class="report-editor-tabs" role="tablist">

            @foreach (var tab in Tabs)
            {
                <button type="button"
                        role="tab"
                        aria-selected="@(_activeTab == tab.Id)"
                        class="report-editor-tab @(_activeTab == tab.Id ? "active" : null)"
                        @onclick="() => SelectTab(tab.Id)">
                    <i class="@tab.Icon"></i>
                    <span>@tab.Label</span>
                </button>
            }

        </nav>

        <p class="report-editor-tab-hint">@ActiveTabHint</p>

        @if (_activeTab == StructureTab)
        {
            <div class="report-editor-block">

                @if (_focusPath.Count == 0)
                {
                    <div class="report-editor-block-title-row">
                        <div class="report-editor-block-title">
                            Estructura
                        </div>

                        <div class="report-editor-add-content">

                            <button type="button"
                                    class="report-editor-add-content-button"
                                    @onclick="ToggleAddContentMenu">

                                <i class="fa-solid fa-plus"></i>

                                Añadir contenido

                            </button>

                            @if (_showAddContentMenu)
                            {
                                <div class="report-editor-add-content-menu">

                                    <button type="button"
                                            @onclick="OpenSectionComposer">

                                        <i class="fa-solid fa-layer-group"></i>

                                        Nueva sección

                                    </button>

                                    <button type="button"
                                            @onclick="AddTextBlockAsync">

                                        <i class="fa-solid fa-align-left"></i>

                                        Texto

                                    </button>

                                    <button type="button"
                                            @onclick="ToggleExistingBlocks">

                                        <i class="fa-solid fa-cubes"></i>

                                        Bloque existente

                                    </button>

                                    @if (_showExistingBlocks)
                                    {
                                        <div class="report-editor-existing-blocks">

                                            @if (ReusableBodyBlocks.Count == 0)
                                            {
                                                <div class="report-editor-empty-menu">
                                                    No hay bloques reutilizables.
                                                </div>
                                            }
                                            else
                                            {
                                                @foreach (var block in ReusableBodyBlocks)
                                                {
                                                    <button type="button"
                                                            @onclick="() => AddExistingBlockAsync(block)">

                                                        <i class="fa-solid @GetBlockIcon(block.Type)"></i>

                                                        <span>
                                                            <strong>@block.Name</strong>
                                                            <small>@GetBlockTypeLabel(block.Type)</small>
                                                        </span>

                                                    </button>
                                                }
                                            }

                                        </div>
                                    }

                                </div>
                            }

                        </div>
                    </div>
                }
                else
                {
                    @* Editando una subsección: sólo se ve ella, con el camino
                       para volver a cualquier nivel. *@
                    <nav class="report-editor-breadcrumb" aria-label="Sección que se edita">

                        <button type="button"
                                class="report-editor-breadcrumb-back"
                                @onclick="ExitFocus">
                            <i class="fa-solid fa-arrow-left"></i>
                            Estructura
                        </button>

                        @{
                            var crumbs = FocusCrumbs();
                        }

                        @for (var c = 0; c < crumbs.Count; c++)
                        {
                            var depth = c + 1;
                            var isLast = c == crumbs.Count - 1;

                            <i class="fa-solid fa-chevron-right report-editor-breadcrumb-sep"></i>

                            if (isLast)
                            {
                                <strong>@crumbs[c]</strong>
                            }
                            else
                            {
                                <button type="button" @onclick="() => FocusTo(depth)">@crumbs[c]</button>
                            }
                        }

                    </nav>
                }

                @{
                    var bodyItems = GetOrderedBodyItems();
                }

                @for (var i = 0; i < bodyItems.Count; i++)
                {
                    var item = bodyItems[i];
                    var canMoveUp = i > 0;
                    var canMoveDown = i < bodyItems.Count - 1;

                    // Con una subsección abierta sólo se pinta la sección de
                    // la que cuelga, y ésa hace de camino hasta ella.
                    if (_focusPath.Count > 0 &&
                        !string.Equals(item.SectionId, _focusPath[0], StringComparison.OrdinalIgnoreCase))
                    {
                        continue;
                    }

                    if (item.Type == ReportBodyItemType.Section &&
                        !string.IsNullOrWhiteSpace(item.SectionId))
                    {
                        // Las subsecciones las dibuja su padre. Si una llega
                        // aquí por un body antiguo, se ignora en vez de
                        // salir dos veces.
                        if (IsNestedSection(item.SectionId))
                            continue;

                        var sectionDefinition = Definition.Sections.FirstOrDefault(x =>
                            string.Equals(x.Id, item.SectionId, StringComparison.OrdinalIgnoreCase));

                        var resolvedSection = _resolved?.GetSection(item.SectionId);

                        if (resolvedSection is null)
                            continue;

                        if (sectionDefinition is not null)
                        {
                            @* La clave cambia al entrar o salir de una subsección:
                               así el editor se recrea abierto en el nivel elegido. *@
                            <ReportSectionEditor @key="@($"{item.Id}|{string.Join('/', _focusPath)}")"
                                                 Definition="sectionDefinition"
                                                 Resolved="resolvedSection"
                                                 Configuration="Configuration"
                                                 CanMoveUp="canMoveUp"
                                                 CanMoveDown="canMoveDown"
                                                 MoveUp="() => MoveBodyItemAsync(item.Id, -1)"
                                                 MoveDown="() => MoveBodyItemAsync(item.Id, 1)"
                                                 Texts="Texts"
                                                 Changed="ConfigurationUpdated"
                                                 EditSection="EditSection"
                                                 FocusPath="FocusBelowRoot"
                                                 StartExpanded="@(_focusPath.Count > 0)" />
                        }
                        else
                        {
                            var sectionConfiguration = FindSectionConfiguration(item.SectionId);

                            if (sectionConfiguration is not null)
                            {
                                @* Misma cabecera, mismas opciones y mismas filas de campo
                                   que las secciones que salen de los datos
                                   (ReportSectionEditor): sólo cambian las acciones
                                   propias (composición, eliminar) y el nombre. *@
                                <div class="report-editor-section is-depth-0 is-custom"
                                     @key="item.Id">

                                    <div class="report-editor-section-header">

                                        <label class="report-editor-toggle-row">
                                            <input type="checkbox"
                                                   class="report-editor-toggle-input"
                                                   checked="@resolvedSection.Visible"
                                                   @onchange="e => SetCustomSectionVisibleAsync(sectionConfiguration, e.Value is bool on && on)" />

                                            <span class="report-editor-toggle"></span>

                                            <span class="report-editor-section-name">
                                                @resolvedSection.Name
                                            </span>
                                        </label>

                                        <div class="report-editor-section-chips">
                                            <span class="report-editor-section-chip is-custom"
                                                  title="Sección creada en el diseñador con campos de otras secciones">
                                                Personalizada
                                            </span>
                                        </div>

                                        <div class="report-editor-section-actions"
                                             @onclick:stopPropagation="true">

                                            <button type="button"
                                                    class="report-editor-section-order-button"
                                                    title="Mover sección arriba"
                                                    disabled="@(!canMoveUp)"
                                                    @onclick="() => MoveBodyItemAsync(item.Id, -1)">
                                                <i class="fa-solid fa-arrow-up"></i>
                                            </button>

                                            <button type="button"
                                                    class="report-editor-section-order-button"
                                                    title="Mover sección abajo"
                                                    disabled="@(!canMoveDown)"
                                                    @onclick="() => MoveBodyItemAsync(item.Id, 1)">
                                                <i class="fa-solid fa-arrow-down"></i>
                                            </button>

                                            <button type="button"
                                                    class="report-editor-section-order-button"
                                                    title="Elegir campos"
                                                    @onclick="() => OpenSectionComposer(item.SectionId!)">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>

                                            <button type="button"
                                                    class="report-editor-section-order-button report-editor-danger-button"
                                                    title="Eliminar sección"
                                                    @onclick="() => RemoveBodyItemAsync(item.Id)">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>

                                            <button type="button"
                                                    class="report-editor-collapse-button"
                                                    title="@(IsCollapsed(item.Id) ? "Desplegar" : "Plegar")"
                                                    @onclick="() => ToggleCollapsed(item.Id)">
                                                <span class="report-editor-chevron @(IsCollapsed(item.Id) ? null : "expanded")"></span>
                                            </button>

                                        </div>

                                    </div>

                                    @if (resolvedSection.Visible && !IsCollapsed(item.Id))
                                    {
                                        <div class="report-editor-section-content">

                                            <div class="report-editor-property">
                                                <label>Nombre</label>
                                                <input type="text"
                                                       value="@GetSectionName(sectionConfiguration)"
                                                       @onchange="e => SetCustomSectionNameAsync(sectionConfiguration, e.Value?.ToString())"
                                                       placeholder="Nombre de la sección" />
                                            </div>

                                            <label class="report-editor-section-option">
                                                <input type="checkbox"
                                                       checked="@(sectionConfiguration.ShowName ?? true)"
                                                       @onchange="e => SetCustomSectionShowNameAsync(sectionConfiguration, e.Value is bool on && on)" />
                                                <span>Mostrar el título de la sección</span>
                                            </label>

                                            <ReportSectionLayoutPicker Layout="resolvedSection.Layout"
                                                                       Columns="resolvedSection.Columns"
                                                                       Changed="layout => SetCustomSectionLayoutAsync(
                                                                                            sectionConfiguration,
                                                                                            layout)" />

                                            @if (resolvedSection.Fields.Count == 0)
                                            {
                                                <div class="report-editor-custom-section-placeholder">
                                                    <i class="fa-solid fa-arrow-pointer"></i>
                                                    <span>Sección vacía</span>
                                                    <small>Usa el lápiz para elegir sus campos.</small>
                                                </div>
                                            }
                                            else
                                            {
                                                @foreach (var field in resolvedSection.Fields.OrderBy(x => x.Order))
                                                {
                                                    var fieldDefinition = FindFieldDefinition(field.Id);

                                                    <ReportFieldRow @key="field.Id"
                                                                    Title="@field.Label"
                                                                    Label="@Texts.GetText(ReportTextKeys.Field(field.Id), fieldDefinition?.Label ?? field.Label)"
                                                                    DefaultLabel="@(fieldDefinition?.Label ?? field.Label)"
                                                                    LabelHint="La etiqueta es la del campo: cambia también donde más aparezca."
                                                                    Visible="field.Visible"
                                                                    Type="field.Type"
                                                                    InferredType="@(fieldDefinition?.Type ?? field.Type)"
                                                                    CssClass="@(IsDraggingPlaced(sectionConfiguration, field.Id) ? "report-editor-item-dragging" : null)"
                                                                    VisibleChanged="visible => SetPlacedFieldVisibleAsync(sectionConfiguration, field.Id, visible)"
                                                                    LabelChanged="label => SetPlacedFieldLabelAsync(field.Id, label)"
                                                                    TypeChanged="type => SetPlacedFieldTypeAsync(sectionConfiguration, field.Id, type)"
                                                                    DragStart="() => StartPlacedDrag(sectionConfiguration, field.Id)"
                                                                    Drop="() => DropPlacedFieldAsync(sectionConfiguration, field.Id)"
                                                                    DragEnd="() => _placedDrag = null">
                                                        <Actions>
                                                            <button type="button"
                                                                    class="report-editor-item-remove"
                                                                    title="Quitar de esta sección (vuelve a la suya)"
                                                                    @onclick="() => RemovePlacedFieldAsync(sectionConfiguration, field.Id)">
                                                                <i class="fa-solid fa-xmark"></i>
                                                            </button>
                                                        </Actions>
                                                    </ReportFieldRow>
                                                }
                                            }

                                        </div>
                                    }

                                </div>
                            }
                        }
                    }
                    else if (item.Type == ReportBodyItemType.Block)
                    {
                        if (item.LocalBlock?.Type == ReportBlockType.Text)
                        {
                            <ReportTextBlockEditor @key="item.Id"
                                                   Item="item"
                                                   CanMoveUp="canMoveUp"
                                                   CanMoveDown="canMoveDown"
                                                   MoveUp="() => MoveBodyItemAsync(item.Id, -1)"
                                                   MoveDown="() => MoveBodyItemAsync(item.Id, 1)"
                                                   Remove="() => RemoveBodyItemAsync(item.Id)"
                                                   Changed="ConfigurationUpdated" />
                        }
                        else
                        {
                            var reusableBlock = FindBodyBlock(item.BlockId);

                            if (reusableBlock is not null)
                            {
                                <div class="report-editor-content-item" @key="item.Id">
                                    <div class="report-editor-content-item-header">
                                        <div class="report-editor-content-item-heading">
                                            <span class="report-editor-content-item-icon">
                                                <i class="fa-solid @GetBlockIcon(reusableBlock.Type)"></i>
                                            </span>
                                            <div>
                                                <strong>@reusableBlock.Name</strong>
                                                <span>Bloque reutilizable · @GetBlockTypeLabel(reusableBlock.Type)</span>
                                            </div>
                                        </div>

                                        <div class="report-editor-section-actions">
                                            <button type="button"
                                                    class="report-editor-section-order-button"
                                                    title="Mover arriba"
                                                    disabled="@(!canMoveUp)"
                                                    @onclick="() => MoveBodyItemAsync(item.Id, -1)">
                                                <i class="fa-solid fa-arrow-up"></i>
                                            </button>
                                            <button type="button"
                                                    class="report-editor-section-order-button"
                                                    title="Mover abajo"
                                                    disabled="@(!canMoveDown)"
                                                    @onclick="() => MoveBodyItemAsync(item.Id, 1)">
                                                <i class="fa-solid fa-arrow-down"></i>
                                            </button>
                                            <button type="button"
                                                    class="report-editor-section-order-button report-editor-danger-button"
                                                    title="Quitar del report"
                                                    @onclick="() => RemoveBodyItemAsync(item.Id)">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
                }

            </div>
        }

        @if (_activeTab == HeaderFooterTab)
        {
            <div class="report-editor-block">

                <div class="report-editor-block-title">
                    Cabecera y pie
                </div>

                @if (Definition.Header is not null)
                {
                    <ReportHeaderEditor Definition="Definition.Header"
                                        Resolved="_resolved?.Header"
                                        PreviewData="_previewData"
                                        Configuration="Configuration"
                                        Blocks="HeaderBlocks"
                                        Texts="Texts"
                                        DataFields="_dataFields"
                                        Changed="ConfigurationUpdated" />
                }

                @if (Definition.Footer is not null)
                {
                    <ReportFooterEditor Definition="Definition.Footer"
                                        Resolved="_resolved?.Footer"
                                        Configuration="Configuration"
                                        Blocks="FooterBlocks"
                                        Texts="Texts"
                                        DataFields="_dataFields"
                                        Changed="ConfigurationUpdated" />
                }

            </div>
        }

        @if (_activeTab == LayoutTab)
        {
            <ReportLayoutEditor Items="GetLayoutItems()"
                                SameRowToggled="change => SetBodyItemSameRowAsync(change.Id, change.SameRow)"
                                SpanSelected="change => SetBodyItemSpanAsync(change.Id, change.Span)"
                                MoveRequested="change => MoveBodyItemAsync(change.Id, change.Direction)" />
        }

        @if (_activeTab == ThemeTab)
        {
            <ReportThemeTab Configuration="Configuration"
                            Theme="Theme"
                            Themes="Themes"
                            Changed="ThemeReplacedAsync" />
        }

    </aside>

    @* Arrastra para cambiar el ancho; doble clic vuelve al de por defecto.
       El ancho lo aplica JS sobre una variable CSS, sin pasar por el
       servidor: un pointermove por render dejaría el editor a rastras. *@
    <div class="report-editor-resizer"
         role="separator"
         aria-orientation="vertical"
         title="Arrastra para cambiar el ancho. Doble clic para el ancho por defecto.">
        <span></span>
    </div>

    <main class="report-editor-preview">

        <div class="report-editor-preview-toolbar">
            <div>
                <strong>Vista previa</strong>
                <span>@Definition.Name</span>
            </div>

            <div class="report-editor-preview-badge">
                Tiempo real
            </div>
        </div>

        <div class="report-editor-preview-canvas">
            @if (_resolved is not null)
            {
                <div class="report-editor-paper">
                    <DynamicReportRenderer Report="@_resolved"
                                           Data="@_previewData"
                                           Theme="@Theme"
                                           Document="Renderset.Core.Rendering.ReportDocumentContext.Preview" />
                </div>
            }
        </div>

    </main>

</div>

@if (_showComposer && _composerRequest is not null)
{
    <ReportSectionComposerModal Definition="Definition"
                                Request="_composerRequest"
                                Saved="SaveComposedSectionAsync"
                                Cancelled="CloseSectionComposer" />
}

<ReportDataPanel Visible="_showData"
                 Data="_previewData"
                 DataChanged="PreviewDataChangedAsync"
                 Closed="() => _showData = false" />

@code {
    private const string StructureTab = "structure";
    private const string HeaderFooterTab = "header-footer";
    private const string LayoutTab = "layout";
    private const string ThemeTab = "theme";
    private const long MaxPresetFileSize = 1024 * 1024;

    [Parameter]
    public EventCallback<JsonElement> DataChanged { get; set; }

    private bool _showData;
    private JsonElement _previewData;
    private string? _previewDataSignature;

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        WriteIndented = true,
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        PropertyNameCaseInsensitive = true,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
        Converters = { new JsonStringEnumConverter() }
    };

    [Parameter, EditorRequired]
    public ReportDefinition Definition { get; set; } = default!;

    [Parameter, EditorRequired]
    public ReportConfiguration Configuration { get; set; } = default!;

    [Parameter]
    public IReadOnlyCollection<ReportBlock> HeaderBlocks { get; set; } = [];

    [Parameter]
    public IReadOnlyCollection<ReportBlock> FooterBlocks { get; set; } = [];

    [Parameter]
    public IReadOnlyCollection<ReportBlock> BodyBlocks { get; set; } = [];

    [Parameter]
    public EventCallback<ReportConfiguration> ConfigurationChanged { get; set; }

    [Parameter, EditorRequired]
    public ReportTheme Theme { get; set; } = default!;

    [Parameter]
    public bool ShowSaveButton { get; set; } = true;

    /// <summary>
    /// Lo calcula la página: resalta el botón de guardar.
    /// </summary>
    [Parameter]
    public bool HasUnsavedChanges { get; set; }

    [Parameter]
    public EventCallback<ReportTheme> ThemeChanged { get; set; }

    /// <summary>
    /// Temas de empresa del tenant que se ofrecen en la pestaña Tema.
    /// </summary>
    [Parameter]
    public IReadOnlyCollection<TenantReportTheme> Themes { get; set; } = [];

    [Parameter, EditorRequired]
    public JsonElement Data { get; set; }

    [Parameter]
    public EventCallback SaveRequested { get; set; }

    /// <summary>
    /// Diccionario en edición para el ámbito del preset. El editor escribe
    /// aquí los textos y la página anfitriona los persiste al guardar.
    /// </summary>
    [Parameter]
    public ReportTextWorkspace Texts { get; set; } =
        ReportTextWorkspace.Detached();

    /// <summary>
    /// Culturas disponibles para previsualizar. Con menos de dos, el selector
    /// no se pinta.
    /// </summary>
    [Parameter]
    public IReadOnlyCollection<TenantCulture> Cultures { get; set; } = [];

    /// <summary>
    /// Cambio de cultura de edición. La página recarga el diccionario y
    /// reconstruye el workspace.
    /// </summary>
    [Parameter]
    public EventCallback<string> CultureChanged { get; set; }

    private readonly ReportConfigurationResolver _resolver = new();

    private bool _showComposer;
    private SectionCompositionRequest? _composerRequest;

    private ResolvedReportDefinition? _resolved;
    private string _activeTab = StructureTab;

    private static readonly (string Id, string Label, string Icon, string Hint)[] Tabs =
    [
        (StructureTab, "Estructura", "fa-solid fa-sitemap", "Secciones, campos y tablas del documento, y contenido añadido."),
        (HeaderFooterTab, "Cabecera", "fa-solid fa-heading", "Cabecera y pie: título, logo y datos de empresa arriba; texto y fecha abajo."),
        (LayoutTab, "Maquetación", "fa-solid fa-table-columns", "Qué secciones comparten fila en la página y cuánto ancho ocupa cada una."),
        (ThemeTab, "Tema", "fa-solid fa-palette", "Colores y tipografía: un tema de empresa o colores propios.")
    ];

    private string ActiveTabHint =>
        Tabs.FirstOrDefault(x => x.Id == _activeTab).Hint ?? string.Empty;

    /// <summary>
    /// Subsección que se está editando, como ruta de ids desde la sección del
    /// body. Vacía = vista general de la estructura.
    /// </summary>
    private List<string> _focusPath = [];

    private IReadOnlyList<string> FocusBelowRoot =>
        _focusPath.Count > 1
            ? _focusPath.Skip(1).ToList()
            : [];

    private void EditSection(IReadOnlyList<string> path)
    {
        _focusPath = path.ToList();
        _activeTab = StructureTab;
    }

    private void ExitFocus() =>
        _focusPath = [];

    private void FocusTo(int depth) =>
        _focusPath = _focusPath.Take(depth).ToList();

    /// <summary>
    /// Nombres (ya traducidos) de cada nivel de la ruta, para las migas.
    /// </summary>
    private List<string> FocusCrumbs()
    {
        var names = new List<string>();

        if (_resolved is null || _focusPath.Count == 0)
            return names;

        var section = _resolved.GetSection(_focusPath[0]);

        foreach (var id in _focusPath)
        {
            if (section is null)
                break;

            if (names.Count > 0)
            {
                section = section.Sections.FirstOrDefault(x =>
                    string.Equals(x.Id, id, StringComparison.OrdinalIgnoreCase));

                if (section is null)
                    break;
            }

            names.Add(section.Name);
        }

        return names;
    }

    private void SelectTab(string tab)
    {
        _activeTab = tab;
        _showAddContentMenu = false;
    }
    private bool _showAddContentMenu;
    private bool _showExistingBlocks;

    private IReadOnlyList<ReportBlock> ReusableBodyBlocks =>
        BodyBlocks
            .Where(x => x.Type is ReportBlockType.Text or ReportBlockType.Image or ReportBlockType.Fields)
            .OrderBy(x => x.Name)
            .ToList();

    private readonly HashSet<string> _collapsedItems = new(StringComparer.OrdinalIgnoreCase);

    private bool IsCollapsed(string itemId) =>
        _collapsedItems.Contains(itemId);

    private void ToggleCollapsed(string itemId)
    {
        if (!_collapsedItems.Remove(itemId))
            _collapsedItems.Add(itemId);
    }

    private ElementReference _root;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await JS.InvokeVoidAsync(
            "renderSet.initEditorResizer",
            _root);
    }

    /// <summary>
    /// Campos de valor único, para insertar datos en cabecera y pie.
    /// </summary>
    private IReadOnlyList<ReportDataFieldOption> _dataFields = [];

    protected override void OnParametersSet()
    {
        _dataFields = ReportDataFields.SingleValued(Definition);
        RebuildNestedSectionIndex();
        SyncPreviewDataFromParameter();
        Resolve();
    }

    /// <summary>
    /// Ids de las secciones que cuelgan de otra sección. El body sólo pinta
    /// raíces: de las anidadas se encarga el ReportSectionEditor del padre.
    /// </summary>
    private HashSet<string> _nestedSectionIds =
        new(StringComparer.OrdinalIgnoreCase);

    private bool IsNestedSection(string? sectionId) =>
        !string.IsNullOrWhiteSpace(sectionId) &&
        _nestedSectionIds.Contains(sectionId);

    private void RebuildNestedSectionIndex()
    {
        _nestedSectionIds =
            new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var section in Definition.Sections)
            CollectNestedSectionIds(section, _nestedSectionIds);
    }

    private static void CollectNestedSectionIds(
        ReportSectionDefinition section,
        HashSet<string> target)
    {
        foreach (var child in section.Sections)
        {
            target.Add(child.Id);
            CollectNestedSectionIds(child, target);
        }
    }

    private void SyncPreviewDataFromParameter()
    {
        var signature =
            Data.ValueKind == JsonValueKind.Undefined
                ? string.Empty
                : JsonSerializer.Serialize(Data);

        if (string.Equals(
                signature,
                _previewDataSignature,
                StringComparison.Ordinal))
        {
            return;
        }

        _previewDataSignature = signature;
        _previewData = Data.ValueKind == JsonValueKind.Undefined
            ? default
            : Data.Clone();
    }

    private async Task PreviewDataChangedAsync(
        JsonElement data)
    {
        _previewData = data.Clone();
        _previewDataSignature = JsonSerializer.Serialize(_previewData);

        await DataChanged.InvokeAsync(_previewData);
    }

    private void Resolve()
    {
        var headerBlock = FindSelectedBlock(
            HeaderBlocks,
            Configuration.Header?.BlockId);

        var footerBlock = FindSelectedBlock(
            FooterBlocks,
            Configuration.Footer?.BlockId);

        var effectiveConfiguration =
            ConfigurationComposer.Compose(
                Configuration,
                headerBlock,
                footerBlock);

        // El catálogo sale del workspace, no de base de datos: así el preview
        // refleja al instante lo que se está escribiendo.
        _resolved =
            _resolver.Resolve(
                Definition,
                effectiveConfiguration,
                BodyBlocks,
                Texts.ToCatalog());
    }

    private static ReportBlock? FindSelectedBlock(
        IReadOnlyCollection<ReportBlock> blocks,
        string? blockId)
    {
        if (string.IsNullOrWhiteSpace(blockId))
            return null;

        return blocks.FirstOrDefault(x =>
            string.Equals(
                x.Id,
                blockId,
                StringComparison.OrdinalIgnoreCase));
    }

    private ReportBlock? FindBodyBlock(string? blockId) =>
        string.IsNullOrWhiteSpace(blockId)
            ? null
            : BodyBlocks.FirstOrDefault(x =>
                string.Equals(x.Id, blockId, StringComparison.OrdinalIgnoreCase));

    private async Task ConfigurationUpdated()
    {
        Resolve();
        await ConfigurationChanged.InvokeAsync(Configuration);
    }

    /// <summary>
    /// Elegir tema cambia el objeto del tema y ThemeId en la configuración:
    /// se avisa de las dos cosas para que la página guarde ambas.
