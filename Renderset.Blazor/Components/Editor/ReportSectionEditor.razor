@using System.Globalization
@using Renderset.Core.Configurations
@using Renderset.Core.Definitions
@using Renderset.Core.Resolved

@if (FocusPath.Count > 0)
{
    @* Modo "entrar en una subsección": esta sección no se pinta, sólo hace de
       camino hasta la que se edita, para que la configuración se siga
       escribiendo dentro de la de su padre. *@
    var target = Definition.Sections.FirstOrDefault(x =>
        string.Equals(x.Id, FocusPath[0], StringComparison.OrdinalIgnoreCase));

    var resolvedTarget =
        target is null ? null : FindResolvedChild(target.Id);

    if (target is not null && resolvedTarget is not null)
    {
        <ReportSectionEditor @key="target.Id"
                             Definition="target"
                             Resolved="resolvedTarget"
                             Configuration="Configuration"
                             Depth="@(Depth + 1)"
                             ScopeReader="ChildScopeReader"
                             ScopeWriter="ChildScopeWriter"
                             Texts="Texts"
                             Changed="Changed"
                             EditSection="EditSection"
                             Path="ChildPath(target.Id)"
                             FocusPath="FocusPath.Skip(1).ToList()"
                             StartExpanded="true" />
    }
}
else
{
    <div class="report-editor-section @DepthClass @KindClass">

        <div class="report-editor-section-header">

            <label class="report-editor-toggle-row">
                <input type="checkbox"
                       class="report-editor-toggle-input"
                       checked="@Resolved.Visible"
                       @onchange="e => SetSectionVisibleAsync(GetBool(e))" />

                <span class="report-editor-toggle"></span>

                <span class="report-editor-section-name">
                    @Resolved.Name
                </span>
            </label>

            <div class="report-editor-section-chips">

                @if (IsNested)
                {
                    <span class="report-editor-section-chip is-nested"
                          title="Subsección: se pinta dentro de su sección padre">
                        Subsección
                    </span>
                }

                <span class="report-editor-section-chip @KindChipClass"
                      title="@KindDescription">
                    @KindLabel
                </span>

                @if (!string.IsNullOrWhiteSpace(EffectiveDataPath))
                {
                    <span class="report-editor-section-chip is-path"
                          title="Colección de origen">
                        @(EffectiveDataPath)[]
                    </span>
                }

            </div>

            <div class="report-editor-section-actions">

                @if (ShowMoveButtons)
                {
                    <button type="button"
                            class="report-editor-section-order-button"
                            title="Mover sección arriba"
                            disabled="@(!CanMoveUp)"
                            @onclick="MoveUp">
                        <i class="fa-solid fa-arrow-up"></i>
                    </button>

                    <button type="button"
                            class="report-editor-section-order-button"
                            title="Mover sección abajo"
                            disabled="@(!CanMoveDown)"
                            @onclick="MoveDown">
                        <i class="fa-solid fa-arrow-down"></i>
                    </button>
                }

                <button type="button"
                        class="report-editor-collapse-button"
                        @onclick="ToggleCollapsed">

                    <span class="report-editor-chevron @(_collapsed ? null : "expanded")"></span>

                </button>

            </div>

        </div>

        @if (Resolved.Visible && !_collapsed)
        {
            <div class="report-editor-section-content">

                <label class="report-editor-section-option">

                    <input type="checkbox"
                           checked="@ShowsName"
                           @onchange="ToggleShowNameAsync" />

                    <span>Mostrar el título de la sección</span>

                </label>

                @if (Definition.Table is null &&
                    Definition.Fields.Count > 0)
                {
                    <ReportSectionLayoutPicker Layout="Resolved.Layout"
                                               Columns="Resolved.Columns"
                                               Changed="LayoutChangedAsync" />
                }

                @foreach (var fieldDefinition in OrderedFields)
                {
                    var resolvedField = Resolved.GetField(fieldDefinition.Id);

                    if (resolvedField is null)
                        continue;

                    <ReportFieldRow @key="fieldDefinition.Id"
                                    Title="@resolvedField.Label"
                                    Label="@GetFieldLabel(fieldDefinition)"
                                    DefaultLabel="@fieldDefinition.Label"
                                    Visible="resolvedField.Visible"
                                    Type="resolvedField.Type"
                                    InferredType="fieldDefinition.Type"
                                    CssClass="@GetDragClass(DragItemType.Field, fieldDefinition.Id)"
                                    VisibleChanged="visible => SetFieldVisibleAsync(fieldDefinition, visible)"
                                    LabelChanged="label => SetFieldLabelAsync(fieldDefinition, label)"
                                    TypeChanged="type => SetFieldTypeAsync(fieldDefinition, type)"
                                    DragStart="() => StartDrag(DragItemType.Field, fieldDefinition.Id)"
                                    Drop="() => DropFieldAsync(fieldDefinition.Id)"
                                    DragEnd="ClearDrag" />
                }

                @if (Definition.Table is not null && Resolved.Table is not null)
                {
                    var widthPlan = ColumnWidthPlan;

                    <div class="report-editor-columns-heading">

                        <span class="report-editor-subtitle">Columnas</span>

                        <span class="report-editor-columns-count">
                            @widthPlan.Segments.Count de @Resolved.Table.Columns.Count visibles
                        </span>

                    </div>

                    @if (widthPlan.Segments.Count > 0)
                    {
                        @* Reparto real de la tabla en el documento: las columnas sin
                           ancho se quedan con lo que dejan libre las demás. *@
                        <div class="report-editor-columns-bar @(widthPlan.IsOverflowing ? "is-overflowing" : null)"
                             aria-hidden="true">
                            @foreach (var segment in widthPlan.Segments)
                            {
                                <span class="@(segment.IsAuto ? "is-auto" : null)"
                                      style="@($"flex-basis:{segment.Share.ToString("0.##", CultureInfo.InvariantCulture)}%;")"
                                      title="@segment.Title">
                                    @segment.Label
                                </span>
                            }
                        </div>

                        <div class="report-editor-columns-summary @(widthPlan.IsOverflowing ? "is-overflowing" : null)">
                            @widthPlan.Summary
                        </div>
                    }

                    <div class="report-editor-columns">

                        @foreach (var columnDefinition in OrderedColumns)
                        {
                            var resolvedColumn = Resolved.Table.GetColumn(columnDefinition.Id);

                            if (resolvedColumn is null)
                                continue;

                            <div class="report-editor-column @(resolvedColumn.Visible ? null : "is-hidden") @GetDragClass(DragItemType.Column, columnDefinition.Id)"
                                 draggable="true"
                                 @key="columnDefinition.Id"
                                 @ondragstart="() => StartDrag(DragItemType.Column, columnDefinition.Id)"
                                 @ondragover:preventDefault
                                 @ondrop="() => DropColumnAsync(columnDefinition.Id)"
                                 @ondragend="ClearDrag">

                                <span class="report-editor-drag-handle"
                                      title="Arrastrar para reordenar">
                                    ⋮⋮
                                </span>

                                <label class="report-editor-toggle-row"
                                       title="@(resolvedColumn.Visible ? "Ocultar columna" : "Mostrar columna")">

                                    <input type="checkbox"
                                           class="report-editor-toggle-input"
                                           checked="@resolvedColumn.Visible"
                                           @onchange="e => SetColumnVisibleAsync(columnDefinition, GetBool(e))" />

                                    <span class="report-editor-toggle"></span>

                                </label>

                                <div class="report-editor-column-name">

                                    <input type="text"
                                           value="@GetColumnLabel(columnDefinition)"
                                           placeholder="@columnDefinition.Label"
                                           disabled="@(!resolvedColumn.Visible)"
                                           aria-label="Título de la columna"
                                           @onchange="e => SetColumnLabelAsync(columnDefinition, e.Value?.ToString())" />

                                    <div class="report-editor-column-meta">

                                        <ReportFieldTypeSelect Compact="true"
                                                               Value="resolvedColumn.Type"
                                                               Inferred="columnDefinition.Type"
                                                               Disabled="@(!resolvedColumn.Visible)"
                                                               Changed="type => SetColumnTypeAsync(columnDefinition, type)" />

                                        <select class="report-editor-chip-select @(resolvedColumn.Total == ReportColumnTotal.None ? null : "is-overridden")"
                                                title="Total al pie de la tabla"
                                                value="@resolvedColumn.Total"
                                                disabled="@(!resolvedColumn.Visible)"
                                                @onchange="e => SetColumnTotalAsync(columnDefinition, e.Value?.ToString())">
                                            <option value="@ReportColumnTotal.None">Sin total</option>
                                            <option value="@ReportColumnTotal.Sum">Σ Suma</option>
                                            <option value="@ReportColumnTotal.Count">Nº Contar</option>
                                            <option value="@ReportColumnTotal.Average">Media</option>
                                            <option value="@ReportColumnTotal.Min">Mínimo</option>
                                            <option value="@ReportColumnTotal.Max">Máximo</option>
                                        </select>

                                        <small title="@columnDefinition.DataPath">@columnDefinition.DataPath</small>

                                    </div>

                                </div>

                                @if (IsColumnLabelCustomized(columnDefinition))
                                {
                                    <button type="button"
                                            class="report-editor-column-reset"
                                            title="@($"Volver al título original: {columnDefinition.Label}")"
                                            @onclick="() => SetColumnLabelAsync(columnDefinition, null)">
                                        <i class="fa-solid fa-rotate-left"></i>
                                    </button>
                                }

                                @if (resolvedColumn.Visible)
                                {
                                    <label class="report-editor-column-width"
                                           title="Ancho en % de la tabla. Vacío = automático">

                                        <input type="number"
                                               min="5"
                                               max="80"
                                               step="1"
                                               placeholder="auto"
                                               value="@GetWidthValue(resolvedColumn)"
                                               aria-label="Ancho de la columna en %"
                                               @onchange="e => SetColumnWidthAsync(columnDefinition, e.Value?.ToString())" />

                                        <span>%</span>

                                    </label>
                                }
                                else
                                {
                                    <span class="report-editor-column-hidden-tag">Oculta</span>
                                }

                            </div>
                        }

                    </div>
                }

                @if (OrderedChildren.Count > 0)
                {
                    <div class="report-editor-subtitle">
                        Subsecciones
                    </div>

                    <div class="report-editor-subsections">

                        @foreach (var childDefinition in OrderedChildren)
                        {
                            var resolvedChild = FindResolvedChild(childDefinition.Id);

                            if (resolvedChild is null)
                            {
                                continue;
                            }

                            if (EditSection.HasDelegate)
                            {
                                @* Las subsecciones se editan entrando en ellas, no
                                   desplegando niveles: con factura → albaranes →
                                   líneas el árbol entero no cabe en la barra. *@
                                <div class="report-editor-child-row @(resolvedChild.Visible ? null : "is-hidden")"
                                     @key="childDefinition.Id">

                                    <span class="report-editor-child-icon">
                                        <i class="@ChildIcon(childDefinition)"></i>
                                    </span>

                                    <div class="report-editor-child-text">
                                        <strong>@resolvedChild.Name</strong>
                                        <small>@ChildSummary(childDefinition)</small>
                                    </div>

                                    @if (!resolvedChild.Visible)
                                    {
                                        <span class="report-editor-section-chip">Oculta</span>
                                    }

                                    <button type="button"
                                            class="report-editor-child-edit"
                                            title="Editar sólo esta sección"
                                            @onclick="() => EditSection.InvokeAsync(ChildPath(childDefinition.Id))">
                                        Editar
                                        <i class="fa-solid fa-chevron-right"></i>
                                    </button>

                                </div>
                            }
                            else
                            {
                                <ReportSectionEditor @key="childDefinition.Id"
                                                     Definition="childDefinition"
                                                     Resolved="resolvedChild"
                                                     Configuration="Configuration"
                                                     Depth="@(Depth + 1)"
                                                     ScopeReader="ChildScopeReader"
                                                     ScopeWriter="ChildScopeWriter"
                                                     Texts="Texts"
                                                     Changed="Changed" />
                            }
                        }

                    </div>
                }

            </div>
        }

    </div>
}

@code {

    [Parameter, EditorRequired]
    public ReportSectionDefinition Definition { get; set; } = default!;

    [Parameter, EditorRequired]
    public ResolvedReportSection Resolved { get; set; } = default!;

    [Parameter, EditorRequired]
    public ReportConfiguration Configuration { get; set; } = default!;

    [Parameter]
    public bool CanMoveUp { get; set; }

    [Parameter]
    public bool CanMoveDown { get; set; }

    [Parameter]
    public EventCallback MoveUp { get; set; }

    [Parameter]
    public EventCallback MoveDown { get; set; }

    /// <summary>
    /// Diccionario en edición. Las etiquetas se guardan aquí, no en el preset.
    /// </summary>
    [Parameter]
    public ReportTextWorkspace Texts { get; set; } =
        ReportTextWorkspace.Detached();

    [Parameter]
    public EventCallback Changed { get; set; }

    /// <summary>
    /// Nivel de anidamiento. 0 es una sección del body; 1 en adelante son
    /// subsecciones que ya dibuja su padre, no el ReportEditor.
    /// </summary>
    [Parameter]
    public int Depth { get; set; }

    /// <summary>
    /// Lista donde vive la configuración de esta sección, sólo para leer.
    /// Puede devolver null porque la configuración es sparse y el padre
    /// quizá no tenga todavía ninguna entrada.
    ///
    /// Nulo significa raíz: Configuration.Sections.
    /// </summary>
    [Parameter]
    public Func<List<ReportSectionConfiguration>?>? ScopeReader { get; set; }

    /// <summary>
    /// Lo mismo, pero creando por el camino la configuración del padre. Sólo
    /// se invoca al escribir un override, para no ensuciar el preset con
    /// entradas vacías al pintar.
    /// </summary>
    [Parameter]
    public Func<List<ReportSectionConfiguration>>? ScopeWriter { get; set; }

    /// <summary>
    /// Ruta de ids desde la sección del body hasta ésta. Vacía en la raíz:
    /// se toma como [Definition.Id].
    /// </summary>
    [Parameter]
    public IReadOnlyList<string> Path { get; set; } = [];

    /// <summary>
    /// Subsecciones por debajo de ésta hasta la que se está editando. Si
    /// trae algo, esta sección no se pinta y sólo lleva hasta allí.
    /// </summary>
    [Parameter]
    public IReadOnlyList<string> FocusPath { get; set; } = [];

    /// <summary>
    /// Entrar a editar una subsección (ruta completa de ids). Sin manejador,
    /// las subsecciones se pintan anidadas como antes.
    /// </summary>
    [Parameter]
    public EventCallback<IReadOnlyList<string>> EditSection { get; set; }

    [Parameter]
    public bool StartExpanded { get; set; }

    private bool _collapsed = true;
    private DragItem? _dragItem;

    protected override void OnInitialized()
    {
        // Abierta si es la que se acaba de abrir para editar, o si tiene
        // subsecciones (que ahora son una lista corta de "Editar").
        _collapsed = !StartExpanded && Definition.Sections.Count == 0;
    }

    private IReadOnlyList<string> OwnPath =>
        Path.Count > 0 ? Path : [Definition.Id];

    private IReadOnlyList<string> ChildPath(string childId) =>
        OwnPath.Append(childId).ToList();

    private static string ChildIcon(ReportSectionDefinition child) =>
        !string.IsNullOrWhiteSpace(child.DataPath)
            ? "fa-solid fa-layer-group"
            : child.Table is not null
                ? "fa-solid fa-table"
                : "fa-regular fa-square";

    private static string ChildSummary(ReportSectionDefinition child)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(child.DataPath))
            parts.Add("Repetida");

        if (child.Table is not null)
            parts.Add($"Tabla · {child.Table.Columns.Count} columnas");

        if (child.Fields.Count > 0)
            parts.Add(child.Fields.Count == 1 ? "1 campo" : $"{child.Fields.Count} campos");

        if (child.Sections.Count > 0)
            parts.Add(child.Sections.Count == 1 ? "1 subsección" : $"{child.Sections.Count} subsecciones");

        return string.Join(" · ", parts);
    }

    private bool IsRepeated =>
        !string.IsNullOrWhiteSpace(Definition.DataPath);

    private bool IsTable =>
        Definition.Table is not null;

    private bool IsNested =>
        Depth > 0;

    private bool ShowMoveButtons =>
        Depth == 0;

    private string? EffectiveDataPath =>
        Definition.DataPath
        ?? Definition.Table?.DataPath;

    private string DepthClass =>
        $"is-depth-{Math.Min(Depth, 3)}";

    private string? KindClass =>
        IsRepeated
            ? "is-repeated"
            : IsTable
                ? "is-table"
                : null;

    private string KindLabel =>
        IsRepeated
            ? "Repetida"
            : IsTable
                ? "Tabla"
                : "Sección";

    private string KindChipClass =>
        IsRepeated
            ? "is-repeated"
            : IsTable
                ? "is-table"
                : "is-plain";

    private string KindDescription =>
        IsRepeated
            ? "Se pinta una vez por cada elemento de la colección"
            : IsTable
                ? "Una fila por elemento de la colección"
                : "Se pinta una sola vez con los datos del documento";

    private IReadOnlyList<ReportSectionDefinition> OrderedChildren =>
        Definition.Sections
            .OrderBy(x => FindResolvedChild(x.Id)?.Order ?? x.Order)
            .ThenBy(x => x.Id, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private ResolvedReportSection? FindResolvedChild(string sectionId) =>
        Resolved.Sections.FirstOrDefault(x =>
            string.Equals(
                x.Id,
                sectionId,
                StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// Ámbito de configuración de las subsecciones: la lista Sections de la
    /// configuración de esta sección, que puede no existir todavía.
    /// </summary>
    private List<ReportSectionConfiguration>? ChildScopeReader() =>
        FindSectionConfiguration()?.Sections;

    private List<ReportSectionConfiguration> ChildScopeWriter() =>
        GetOrCreateSectionConfiguration().Sections;

    private List<ReportSectionConfiguration>? ReadScope =>
        ScopeReader is null
            ? Configuration.Sections
            : ScopeReader();

    private List<ReportSectionConfiguration> WriteScope =>
        ScopeWriter is null
            ? Configuration.Sections
            : ScopeWriter();

    private IEnumerable<ReportFieldDefinition> OrderedFields =>
        Definition.Fields.OrderBy(x =>
            Resolved.GetField(x.Id)?.Order ?? x.Order);

    private IEnumerable<ReportColumnDefinition> OrderedColumns =>
        Definition.Table is null || Resolved.Table is null
            ? []
            : Definition.Table.Columns.OrderBy(x =>
                Resolved.Table.GetColumn(x.Id)?.Order ?? x.Order);

    private void ToggleCollapsed() =>
        _collapsed = !_collapsed;


    private readonly HashSet<string> _expandedFields =
        new(StringComparer.OrdinalIgnoreCase);

    private async Task LayoutChangedAsync(ReportSectionGridLayout layout)
    {
        var section =
            GetOrCreateSectionConfiguration();

        section.Layout = layout.Layout;
        section.Columns = layout.StoredColumns;

        await Changed.InvokeAsync();
    }

    private async Task SetSectionVisibleAsync(bool visible)
    {
        GetOrCreateSectionConfiguration().Visible = visible;
        await Changed.InvokeAsync();
    }

    // De lectura: pintar la sección no puede crear configuración, o el preset
    // dejaría de ser sparse sólo por abrir el editor.
    private bool ShowsName => FindSectionConfiguration()?.ShowName ?? true;

    private async Task ToggleShowNameAsync(ChangeEventArgs e)
    {
        GetOrCreateSectionConfiguration().ShowName =
            e.Value is bool value && value;

        await Changed.InvokeAsync();
    }

    private async Task SetFieldVisibleAsync(
        ReportFieldDefinition field,
        bool visible)
    {
        GetOrCreateFieldConfiguration(field.Id).Visible = visible;
        await Changed.InvokeAsync();
    }

    private async Task SetFieldTypeAsync(
        ReportFieldDefinition field,
        ReportFieldType? type)
    {
        GetOrCreateFieldConfiguration(field.Id).Type = type;
        await Changed.InvokeAsync();
    }

    private async Task SetColumnTypeAsync(
        ReportColumnDefinition column,
        ReportFieldType? type)
    {
        GetOrCreateColumnConfiguration(column.Id).Type = type;
        await Changed.InvokeAsync();
    }

    /// <summary>
    /// Sin total se guarda nulo: la configuración sólo lleva lo que cambia.
    /// </summary>
    private async Task SetColumnTotalAsync(
        ReportColumnDefinition column,
        string? value)
    {
        if (!Enum.TryParse<ReportColumnTotal>(value, out var total))
            return;

        GetOrCreateColumnConfiguration(column.Id).Total =
            total == ReportColumnTotal.None ? null : total;

        await Changed.InvokeAsync();
    }

    private async Task SetFieldLabelAsync(
        ReportFieldDefinition field,
        string? label)
    {
        // El texto no se guarda en el preset: va al diccionario, en el ámbito
        // del preset y bajo la clave convencional del campo. Vaciarlo devuelve
        // la etiqueta heredada del report.
        Texts.SetText(
            ReportTextKeys.Field(field.Id),
            label);

        await Changed.InvokeAsync();
    }

    private async Task SetColumnVisibleAsync(
        ReportColumnDefinition column,
        bool visible)
    {
        GetOrCreateColumnConfiguration(column.Id).Visible = visible;
        await Changed.InvokeAsync();
    }

    private async Task SetColumnLabelAsync(
        ReportColumnDefinition column,
        string? label)
    {
        Texts.SetText(
            ReportTextKeys.Column(
                Definition.Table?.Id ?? Definition.Id,
                column.Id),
            label);

        await Changed.InvokeAsync();
    }

    private async Task SetColumnWidthAsync(
        ReportColumnDefinition column,
        string? value)
    {
        var configuration =
            GetOrCreateColumnConfiguration(column.Id);

        if (string.IsNullOrWhiteSpace(value))
        {
            configuration.Width = null;
            await Changed.InvokeAsync();
            return;
        }

        if (!decimal.TryParse(
                value,
                NumberStyles.Number,
                CultureInfo.InvariantCulture,
                out var width))
        {
            return;
        }

        configuration.Width = Math.Clamp(width, 5m, 80m);
        await Changed.InvokeAsync();
    }

    private ReportSectionConfiguration? FindSectionConfiguration() =>
        ReadScope?.FirstOrDefault(x =>
            string.Equals(
                x.SectionId,
                Definition.Id,
                StringComparison.OrdinalIgnoreCase));

    private ReportSectionConfiguration GetOrCreateSectionConfiguration()
    {
        // El ámbito es el del padre cuando esto es una subsección: el
        // resolver espera las subsecciones dentro de Sections de su padre,
        // no en la lista plana del report.
        var scope = WriteScope;

        var section =
            scope.FirstOrDefault(x =>
                string.Equals(
                    x.SectionId,
                    Definition.Id,
                    StringComparison.OrdinalIgnoreCase));

        if (section is not null)
            return section;

        section =
            new ReportSectionConfiguration
            {
                SectionId = Definition.Id
            };

        scope.Add(section);

        return section;
    }

    private ReportFieldConfiguration GetOrCreateFieldConfiguration(
        string fieldId)
    {
        var section = GetOrCreateSectionConfiguration();

        var configuration =
            section.Fields.FirstOrDefault(x =>
                string.Equals(
                    x.FieldId,
                    fieldId,
                    StringComparison.OrdinalIgnoreCase));

        if (configuration is not null)
            return configuration;

        configuration = new ReportFieldConfiguration
        {
            FieldId = fieldId
        };

        section.Fields.Add(configuration);
        return configuration;
    }

    private ReportColumnConfiguration GetOrCreateColumnConfiguration(
        string columnId)
    {
        var section = GetOrCreateSectionConfiguration();

        var tableDefinition =
            Definition.Table
            ?? throw new InvalidOperationException(
                $"La sección '{Definition.Id}' no contiene una tabla.");

        section.Table ??= new ReportTableConfiguration
        {
            TableId = tableDefinition.Id
        };

        var configuration =
            section.Table.Columns.FirstOrDefault(x =>
                string.Equals(
                    x.ColumnId,
                    columnId,
                    StringComparison.OrdinalIgnoreCase));

        if (configuration is not null)
            return configuration;

        configuration = new ReportColumnConfiguration
        {
            ColumnId = columnId
        };

        section.Table.Columns.Add(configuration);
        return configuration;
    }

    private ReportFieldConfiguration? FindFieldConfiguration(
        string fieldId) =>
        FindSectionConfiguration()
            ?.Fields
            .FirstOrDefault(x =>
                string.Equals(
                    x.FieldId,
                    fieldId,
                    StringComparison.OrdinalIgnoreCase));

    private ReportColumnConfiguration? FindColumnConfiguration(
        string columnId) =>
        FindSectionConfiguration()
            ?.Table
            ?.Columns
            .FirstOrDefault(x =>
                string.Equals(
                    x.ColumnId,
                    columnId,
                    StringComparison.OrdinalIgnoreCase));

    private string GetFieldLabel(ReportFieldDefinition field) =>
        Texts.GetText(
            ReportTextKeys.Field(field.Id),
            field.Label);

    private string GetColumnLabel(ReportColumnDefinition column) =>
        Texts.GetText(
            ReportTextKeys.Column(
                Definition.Table?.Id ?? Definition.Id,
                column.Id),
            column.Label);

    private bool IsFieldLabelCustomized(ReportFieldDefinition field) =>
        Texts.HasOwnValue(
            ReportTextKeys.Field(field.Id));

    private bool IsColumnLabelCustomized(ReportColumnDefinition column) =>
        Texts.HasOwnValue(
            ReportTextKeys.Column(
                Definition.Table?.Id ?? Definition.Id,
                column.Id));

    private static string GetWidthValue(ResolvedReportColumn column) =>
        column.Width?.ToString(CultureInfo.InvariantCulture)
        ?? string.Empty;

    /// <summary>
    /// Cómo queda repartido el ancho de la tabla con la configuración actual.
    /// Es lo mismo que hará el navegador: las columnas con ancho fijo se
    /// quedan su %, y las automáticas se reparten lo que sobre.
    /// </summary>
    private ColumnWidthPlanModel ColumnWidthPlan
    {
        get
        {
            var visible =
                Resolved.Table?.Columns
                    .Where(x => x.Visible)
                    .OrderBy(x => x.Order)
                    .ToList()
                ?? [];

            if (visible.Count == 0)
                return new ColumnWidthPlanModel([], false, string.Empty);

            var fixedTotal =
                visible.Sum(x => x.Width ?? 0m);

            var autoCount =
                visible.Count(x => x.Width is null);

            var free =
                Math.Max(0m, 100m - fixedTotal);

            // Sin hueco, el navegador comprime igualmente las automáticas
            // hasta su contenido: se pintan con un mínimo para que se vean.
            var autoWidth =
                autoCount == 0
                    ? 0m
                    : Math.Max(free / autoCount, 4m);

            var total =
                fixedTotal + autoWidth * autoCount;

            var segments =
                visible
                    .Select((column, index) =>
                    {
                        var width = column.Width ?? autoWidth;

                        return new ColumnWidthSegment(
                            (index + 1).ToString(CultureInfo.InvariantCulture),
                            column.Width is null
                                ? $"{column.Label}: automático"
                                : $"{column.Label}: {column.Width.Value.ToString("0.##", CultureInfo.InvariantCulture)} %",
                            column.Width is null,
                            total == 0 ? 0 : width * 100m / total);
                    })
                    .ToList();

            var overflowing = fixedTotal > 100m;

            var fixedText =
                fixedTotal.ToString("0.##", CultureInfo.InvariantCulture);

            var summary =
                overflowing
                    ? $"Los anchos fijos suman {fixedText} %: el navegador los reducirá en proporción."
                    : autoCount == 0
                        ? $"Anchos fijos: {fixedText} % de la tabla."
                        : fixedTotal == 0
                            ? "Todas automáticas: se reparten según su contenido."
                            : $"Fijo {fixedText} % · {autoCount} automática{(autoCount == 1 ? "" : "s")} con el {(100m - fixedTotal).ToString("0.##", CultureInfo.InvariantCulture)} % restante.";

            return new ColumnWidthPlanModel(segments, overflowing, summary);
        }
    }

    private sealed record ColumnWidthSegment(
        string Label,
        string Title,
        bool IsAuto,
        decimal Share);

    private sealed record ColumnWidthPlanModel(
        List<ColumnWidthSegment> Segments,
        bool IsOverflowing,
        string Summary);

    private enum DragItemType
    {
        Field,
        Column
    }

    private sealed record DragItem(
        DragItemType Type,
        string ItemId);

    private void StartDrag(
        DragItemType type,
        string itemId)
    {
        _dragItem = new DragItem(type, itemId);
    }

    private void ClearDrag()
    {
        _dragItem = null;
    }

    private string? GetDragClass(
        DragItemType type,
        string itemId)
    {
        if (_dragItem is null)
            return null;

        return _dragItem.Type == type &&
               string.Equals(
                   _dragItem.ItemId,
                   itemId,
                   StringComparison.OrdinalIgnoreCase)
            ? "report-editor-item-dragging"
            : null;
    }

    private async Task DropFieldAsync(string targetFieldId)
    {
        if (!CanDrop(DragItemType.Field, targetFieldId))
            return;

        var fields =
            Resolved.Fields
                .OrderBy(x => x.Order)
                .ToList();

        var dragged = fields.FirstOrDefault(x =>
            string.Equals(
                x.Id,
                _dragItem!.ItemId,
                StringComparison.OrdinalIgnoreCase));

        var target = fields.FirstOrDefault(x =>
            string.Equals(
                x.Id,
                targetFieldId,
                StringComparison.OrdinalIgnoreCase));

        if (dragged is null || target is null)
            return;

        fields.Remove(dragged);
        fields.Insert(fields.IndexOf(target), dragged);

        for (var i = 0; i < fields.Count; i++)
        {
            GetOrCreateFieldConfiguration(fields[i].Id).Order =
                (i + 1) * 10;
        }

        ClearDrag();
        await Changed.InvokeAsync();
    }

    private async Task DropColumnAsync(string targetColumnId)
    {
        if (!CanDrop(DragItemType.Column, targetColumnId) ||
            Resolved.Table is null)
        {
            return;
        }

        var columns =
            Resolved.Table.Columns
                .OrderBy(x => x.Order)
                .ToList();

        var dragged = columns.FirstOrDefault(x =>
            string.Equals(
                x.Id,
                _dragItem!.ItemId,
                StringComparison.OrdinalIgnoreCase));

        var target = columns.FirstOrDefault(x =>
            string.Equals(
                x.Id,
                targetColumnId,
                StringComparison.OrdinalIgnoreCase));

        if (dragged is null || target is null)
            return;

        columns.Remove(dragged);
        columns.Insert(columns.IndexOf(target), dragged);

        for (var i = 0; i < columns.Count; i++)
        {
            GetOrCreateColumnConfiguration(columns[i].Id).Order =
                (i + 1) * 10;
        }

        ClearDrag();
        await Changed.InvokeAsync();
    }

    private bool CanDrop(
        DragItemType type,
        string targetItemId)
    {
        if (_dragItem is null ||
            _dragItem.Type != type)
        {
            return false;
        }

        if (!string.Equals(
                _dragItem.ItemId,
                targetItemId,
                StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        ClearDrag();
        return false;
    }

    private bool IsFieldExpanded(string fieldId) =>
        _expandedFields.Contains(fieldId);

    private void ToggleFieldExpanded(string fieldId)
    {
        if (!_expandedFields.Add(fieldId))
            _expandedFields.Remove(fieldId);
    }

    private static bool GetBool(ChangeEventArgs e) =>
        e.Value is bool value && value;

    private static string? Normalize(string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? null
            : value.Trim();
}
