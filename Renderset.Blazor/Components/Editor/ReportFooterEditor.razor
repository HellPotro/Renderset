@using Renderset.Core.Blocks
@using Renderset.Core.Configurations
@using Renderset.Core.Definitions
@using Renderset.Core.Resolved
@using Renderset.Core.Rendering
@using Renderset.Core.Reports

<div class="report-editor-section">

    <div class="report-editor-section-header">

        <label class="report-editor-toggle-row">

            <input type="checkbox"
                   class="report-editor-toggle-input"
                   checked="@IsVisible"
                   @onchange="ToggleVisibleAsync" />

            <span class="report-editor-toggle">
                <span></span>
            </span>

            <strong>Pie de página</strong>

        </label>

    </div>

    @if (IsVisible)
    {
        <div class="report-editor-section-content">

            @if (Blocks.Count > 0)
            {
                <div class="report-editor-property">
                    <label>Bloque reutilizable</label>

                    <select value="@Footer.BlockId"
                            @onchange="BlockChangedAsync">

                        <option value="">Sin bloque</option>

                        @foreach (var block in Blocks)
                        {
                            <option value="@block.Id">
                                @block.Name
                            </option>
                        }

                    </select>
                </div>
            }

            <div class="report-editor-property">
                <div class="report-editor-property-heading">
                    <label>Texto</label>

                    <DataFieldPicker Fields="DataFields"
                                     Selected="InsertDataAsync" />
                </div>

                <textarea rows="3"
                          value="@FooterText"
                          @onchange="TextChangedAsync"
                          placeholder="Texto legal, datos de contacto..."></textarea>
            </div>

            <label class="report-editor-toggle-row">

                <input type="checkbox"
                       class="report-editor-toggle-input"
                       checked="@ShowGenerationDate"
                       @onchange="GenerationDateChangedAsync" />

                <span class="report-editor-toggle">
                    <span></span>
                </span>

                <span>Mostrar fecha de generación</span>

            </label>

            <label class="report-editor-toggle-row">

                <input type="checkbox"
                       class="report-editor-toggle-input"
                       checked="@ShowPageNumber"
                       @onchange="PageNumberChangedAsync" />

                <span class="report-editor-toggle">
                    <span></span>
                </span>

                <span>Numerar las páginas</span>

            </label>

            @if (ShowPageNumber)
            {
                <div class="report-editor-property">
                    <label>Formato</label>

                    <input type="text"
                           value="@PageNumberFormat"
                           @onchange="PageNumberFormatChangedAsync"
                           placeholder="@ResolvedReportFooter.DefaultPageNumberFormat" />

                    <small>
                        {page} es la página y {pages} el total. Se traduce en el
                        diccionario (footer.pageNumber).
                    </small>
                </div>
            }

            <p class="report-editor-hint">
                <i class="fa-solid fa-file-lines"></i>
                El pie va al final de la hoja y, al imprimir o en el PDF, se
                repite en todas las páginas. El texto admite datos del
                documento: &#123;&#123;data.numero&#125;&#125;.
            </p>

        </div>
    }

</div>

@code {

    [Parameter, EditorRequired]
    public ReportFooterDefinition Definition { get; set; } = default!;

    [Parameter]
    public ResolvedReportFooter? Resolved { get; set; }

    [Parameter, EditorRequired]
    public ReportConfiguration Configuration { get; set; } = default!;

    [Parameter]
    public IReadOnlyCollection<ReportBlock> Blocks { get; set; } = [];

    /// <summary>
    /// Diccionario en edición. Las etiquetas se guardan aquí, no en el preset.
    /// </summary>
    [Parameter]
    public ReportTextWorkspace Texts { get; set; } =
        ReportTextWorkspace.Detached();

    [Parameter]
    public EventCallback Changed { get; set; }

    [Parameter]
    public IReadOnlyList<ReportDataFieldOption> DataFields { get; set; } = [];

    private async Task InsertDataAsync(string path)
    {
        var token = ReportDataTemplate.TokenFor(path);
        var current = FooterText;

        Texts.SetText(
            ReportTextKeys.FooterText,
            string.IsNullOrWhiteSpace(current)
                ? token
                : current.TrimEnd() + " " + token);

        await Changed.InvokeAsync();
    }

    private ReportFooterConfiguration Footer
    {
        get
        {
            Configuration.Footer ??= new ReportFooterConfiguration();
            return Configuration.Footer;
        }
    }

    private bool IsVisible =>
        Resolved?.Visible
        ?? Footer.Visible
        ?? Definition.VisibleByDefault;

    private bool ShowGenerationDate =>
        Resolved?.ShowGenerationDate
        ?? Footer.ShowGenerationDate
        ?? Definition.ShowGenerationDate;

    private bool ShowPageNumber =>
        Resolved?.ShowPageNumber
        ?? Footer.ShowPageNumber
        ?? false;

    private string PageNumberFormat =>
        Texts.GetText(
            ReportTextKeys.FooterPageNumber,
            ResolvedReportFooter.DefaultPageNumberFormat);

    private async Task PageNumberChangedAsync(ChangeEventArgs e)
    {
        Footer.ShowPageNumber = GetBool(e);
        await Changed.InvokeAsync();
    }

    private async Task PageNumberFormatChangedAsync(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        // Sin {page} la numeración no dice nada: se vuelve al formato
        // heredado en vez de guardar un texto fijo.
        Texts.SetText(
            ReportTextKeys.FooterPageNumber,
            value?.Contains("{page}", StringComparison.OrdinalIgnoreCase) == true
                ? value
                : null);

        await Changed.InvokeAsync();
    }

    private string FooterText =>
        Texts.GetText(
            ReportTextKeys.FooterText,
            Definition.Text ?? string.Empty);

    private async Task ToggleVisibleAsync(ChangeEventArgs e)
    {
        Footer.Visible = GetBool(e);
        await Changed.InvokeAsync();
    }

    private async Task BlockChangedAsync(ChangeEventArgs e)
    {
        Footer.BlockId = Normalize(e.Value?.ToString());
        await Changed.InvokeAsync();
    }

    private async Task TextChangedAsync(ChangeEventArgs e)
    {
        Texts.SetText(
            ReportTextKeys.FooterText,
            e.Value?.ToString());

        await Changed.InvokeAsync();
    }

    private async Task GenerationDateChangedAsync(ChangeEventArgs e)
    {
        Footer.ShowGenerationDate = GetBool(e);
        await Changed.InvokeAsync();
    }

    private static bool GetBool(ChangeEventArgs e) =>
        e.Value is bool value && value;

    private static string? Normalize(string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? null
            : value.Trim();
}
