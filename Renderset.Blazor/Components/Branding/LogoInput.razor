@using Microsoft.AspNetCore.Components.Forms
@using Renderset.Core.Sharing
@using Renderset.Core.Tenancy

@*
    Logo del tenant: enlazar una imagen que ya está en otra web o subirla.
    Subida, la imagen se guarda en RenderSet (base de datos o Azure Blob) y
    lo que se queda en el campo es su URL pública, igual que si se hubiera
    pegado: el resto (página pública, cabecera del DeCA, PDF) no distingue.

    Las comprobaciones de aquí (tamaño, URL) son locales y van en línea; el
    fallo de la subida lo avisa el anfitrión con un toast.
*@

<div class="logo-input">

    <div class="logo-input-preview @(HasLogo ? null : "is-empty")">
        @if (HasLogo)
        {
            <img src="@Value" alt="Logo" />
        }
        else
        {
            <span>@EmptyText</span>
        }
    </div>

    <div class="logo-input-controls">

        <div class="logo-input-actions">

            @if (Upload is not null)
            {
                <label class="secondary-button logo-input-upload @(_uploading || Disabled ? "is-disabled" : null)">

                    <i class="fa-solid @(_uploading ? "fa-spinner fa-spin" : "fa-arrow-up-from-bracket")"></i>
                    @(_uploading ? "Subiendo..." : "Subir imagen")

                    <InputFile accept="@TenantAssetRules.Accept"
                               disabled="@(_uploading || Disabled)"
                               OnChange="FileChangedAsync" />
                </label>
            }

            <button type="button"
                    class="secondary-button"
                    disabled="@Disabled"
                    @onclick="() => _showUrl = !_showUrl">
                <i class="fa-solid fa-link"></i>
                Enlazar URL
            </button>

            @if (!string.IsNullOrWhiteSpace(Value))
            {
                <button type="button"
                        class="icon-button logo-input-remove"
                        title="Quitar el logo"
                        disabled="@(_uploading || Disabled)"
                        @onclick="() => SetAsync(null)">
                    <i class="fa-solid fa-trash"></i>
                </button>
            }

        </div>

        @if (_showUrl || (!string.IsNullOrWhiteSpace(Value) && !IsValid))
        {
            <input type="url"
                   class="logo-input-url"
                   value="@Value"
                   maxlength="@DocumentSharingSettings.MaxLogoUrlLength"
                   placeholder="https://tuempresa.com/logo.png"
                   disabled="@Disabled"
                   @onchange="e => SetAsync(e.Value?.ToString())" />
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <small class="logo-input-error">@_error</small>
        }
        else if (!IsValid)
        {
            <small class="logo-input-error">
                Tiene que ser una URL completa que empiece por https:// o http://.
            </small>
        }
        else
        {
            <small>PNG, JPG o WebP de hasta @(TenantAssetRules.MaxLogoBytes / 1024) KB. Con 400 px de ancho sobra.</small>
        }

    </div>

</div>

@code {

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>
    /// Sube la imagen y devuelve su URL, o nulo si no se ha podido (el
    /// anfitrión ya ha avisado). Sin él, sólo se puede enlazar.
    /// </summary>
    [Parameter]
    public Func<byte[], string, Task<string?>>? Upload { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string EmptyText { get; set; } = "Sin logo";

    private bool _uploading;
    private bool _showUrl;
    private string? _error;

    private bool IsValid =>
        string.IsNullOrWhiteSpace(Value) ||
        TenantBranding.CleanLogoUrl(Value) is not null;

    private bool HasLogo =>
        !string.IsNullOrWhiteSpace(Value) && IsValid;

    private async Task SetAsync(
        string? value)
    {
        _error = null;

        var normalized =
            string.IsNullOrWhiteSpace(value)
                ? null
                : value.Trim();

        Value = normalized;

        await ValueChanged.InvokeAsync(normalized);
    }

    private async Task FileChangedAsync(
        InputFileChangeEventArgs e)
    {
        _error = null;

        if (Upload is null)
            return;

        var file = e.File;

        if (file.Size > TenantAssetRules.MaxLogoBytes)
        {
            _error = $"La imagen pasa de {TenantAssetRules.MaxLogoBytes / 1024} KB. Guárdala más pequeña.";
            return;
        }

        _uploading = true;

        try
        {
            byte[] content;

            await using (var stream = file.OpenReadStream(TenantAssetRules.MaxLogoBytes))
            {
                using var memory = new MemoryStream((int)file.Size);
                await stream.CopyToAsync(memory);
                content = memory.ToArray();
            }

            // La API vuelve a mirarlo; esto ahorra subir un PDF o un SVG
            // para que diga que no.
            if (TenantAssetRules.DetectContentType(content) is null)
            {
                _error = "Tiene que ser una imagen PNG, JPG, WebP o GIF. SVG no se admite.";
                return;
            }

            var url = await Upload(content, file.Name);

            if (url is not null)
            {
                _showUrl = false;
                await SetAsync(url);
            }
        }
        catch (IOException)
        {
            _error = "No se ha podido leer la imagen.";
        }
        finally
        {
            _uploading = false;
        }
    }
}
