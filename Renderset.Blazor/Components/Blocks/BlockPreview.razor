@using Renderset.Core.Blocks
@using Renderset.Core.Configurations
@using Renderset.Core.Definitions
@using Renderset.Core.Localization
@using Renderset.Core.Rendering
@using Renderset.Core.Resolved
@using Renderset.Core.Themes
@using Renderset.Core.Variables
@using Renderset.Blazor.Components.Rendering

<div class="blkprev">

    <div class="blkprev-head">

        <span>
            <i class="fa-solid fa-eye"></i>
            Vista previa
        </span>

        @if (UnresolvedVariables.Count > 0)
        {
            <span class="blkprev-warn"
                  title="@string.Join(", ", UnresolvedVariables)">
                <i class="fa-solid fa-triangle-exclamation"></i>
                @UnresolvedVariables.Count variable@(UnresolvedVariables.Count == 1 ? "" : "s") sin definir
            </span>
        }

    </div>

    <div class="blkprev-sheet">

        <div class="dynamic-report" style="@ThemeStyle">

            @switch (Type)
            {
                case ReportBlockType.Header:
                    <DynamicReportHeader Header="_resolvedHeader"
                                         MissingData="MarkData" />
                    break;

                case ReportBlockType.Footer:
                    <DynamicReportFooter Footer="_resolvedFooter"
                                         MissingData="MarkData" />
                    break;

                case ReportBlockType.Text:
                    <DynamicReportBlock Block="_resolvedTextBlock"
                                        MissingData="MarkData" />
                    break;

                case ReportBlockType.Fields:
                    <DynamicReportBlock Block="_resolvedFieldsBlock"
                                        MissingData="MarkData" />
                    break;
            }

        </div>

    </div>

    @if (IsEmpty)
    {
        <p class="blkprev-empty">
            Todavía no hay nada que mostrar. Rellena los campos del bloque.
        </p>
    }

    @if (_dataTokens.Count > 0)
    {
        <p class="blkprev-note">
            <i class="fa-solid fa-database"></i>
            Los datos del documento (@string.Join(", ", _dataTokens.Select(x => "data." + x)))
            se rellenan al emitir cada documento.
        </p>
    }

</div>


@code {

    /// <summary>
    /// El preview usa los mismos componentes que el informe real
    /// (DynamicReportHeader, DynamicReportFooter, DynamicReportBlock) en vez
    /// de imitar el HTML. Es lo único que garantiza que lo que ves aquí sea
    /// lo que sale luego en el documento: si cambia el render, cambia el
    /// preview solo.
    /// </summary>
    [Parameter, EditorRequired]
    public ReportBlockType Type { get; set; }

    [Parameter]
    public ReportHeaderConfiguration? Header { get; set; }

    [Parameter]
    public ReportFooterConfiguration? Footer { get; set; }

    [Parameter]
    public ReportTextBlockConfiguration? Text { get; set; }

    [Parameter]
    public ReportFieldsBlockConfiguration? Fields { get; set; }

    /// <summary>
    /// Diccionario en edición: los bloques guardan claves, no literales.
    /// </summary>
    [Parameter]
    public ReportTextWorkspace Texts { get; set; } =
        ReportTextWorkspace.Detached();

    /// <summary>
    /// Variables del tenant, para sustituir los {{marcadores}} y ver el texto
    /// final en lugar de la plantilla.
    /// </summary>
    [Parameter]
    public IReadOnlyCollection<ReportVariable> Variables { get; set; } = [];

    [Parameter]
    public ReportTheme Theme { get; set; } = new();

    private readonly List<string> _unresolved = [];

    private List<string> UnresolvedVariables => _unresolved;

    /*
     * Lo resuelto se calcula una vez por cambio de parámetros, no en cada
     * acceso desde el marcado. Si no, el aviso de variables sin definir se
     * pinta antes de que nadie haya mirado los textos y va siempre un
     * render por detrás.
     */
    private IReadOnlyDictionary<string, string> _variableValues =
        new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    private ResolvedReportHeader? _resolvedHeader;
    private ResolvedReportFooter? _resolvedFooter;
    private ResolvedReportBlock _resolvedTextBlock = new()
    {
        Id = "preview",
        Type = ReportBlockType.Text,
        Text = new ReportTextBlockConfiguration()
    };
    private ResolvedReportBlock _resolvedFieldsBlock = new()
    {
        Id = "preview",
        Type = ReportBlockType.Fields,
        Fields = new ResolvedFieldsBlock()
    };

    /// <summary>
    /// {{data.ruta}} que aparecen en el bloque. No son variables sin definir:
    /// se rellenan con cada documento.
    /// </summary>
    private IReadOnlyList<string> _dataTokens = [];

    private static string MarkData(
        string path) =>
        $"\u27e8data.{path}\u27e9";

    /// <summary>
    /// Se calculan aquí y no al pintar: los componentes hijos se pintan
    /// después que este y el aviso iría siempre un render por detrás.
    /// </summary>
    private IReadOnlyList<string> CollectDataTokens()
    {
        var texts = new List<string?>();

        if (_resolvedHeader is not null)
        {
            texts.Add(_resolvedHeader.Title);
            texts.Add(_resolvedHeader.Subtitle);
            texts.AddRange(_resolvedHeader.Lines.Select(x => x.Text));
            texts.AddRange(_resolvedHeader.Columns.SelectMany(x => x.Lines).Select(x => x.Text));
        }

        texts.Add(_resolvedFooter?.Text);
        texts.Add(_resolvedTextBlock.Text?.Title);
        texts.Add(_resolvedTextBlock.Text?.Text);

        if (_resolvedFieldsBlock.Fields is { } fields)
        {
            texts.Add(fields.Title);
            texts.AddRange(fields.Fields.Select(x => x.Label));
            texts.AddRange(fields.Fields.Select(x => x.Value));
        }

        return texts
            .SelectMany(ReportDataTemplate.Paths)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }


    private string ThemeStyle =>
        ReportThemeCss.Variables(Theme);


    private bool IsEmpty =>
        Type switch
        {
            ReportBlockType.Header =>
                string.IsNullOrWhiteSpace(_resolvedHeader?.Title) &&
                string.IsNullOrWhiteSpace(_resolvedHeader?.Subtitle) &&
                (_resolvedHeader?.Lines.Count ?? 0) == 0 &&
                _resolvedHeader?.ShowLogo != true,

            ReportBlockType.Footer =>
                string.IsNullOrWhiteSpace(_resolvedFooter?.Text) &&
                _resolvedFooter?.ShowGenerationDate != true,

            ReportBlockType.Text =>
                string.IsNullOrWhiteSpace(_resolvedTextBlock.Text?.Title) &&
                string.IsNullOrWhiteSpace(_resolvedTextBlock.Text?.Text),

            ReportBlockType.Fields =>
                (_resolvedFieldsBlock.Fields?.Fields.Count ?? 0) == 0 &&
                string.IsNullOrWhiteSpace(_resolvedFieldsBlock.Fields?.Title),

            _ => true
        };


    protected override void OnParametersSet()
    {
        _unresolved.Clear();

        // El workspace ya los trae resueltos para su cultura. Se usa como
        // reserva la lista cruda para los sitios que montan el preview sin
        // área de trabajo, donde no hay idioma que aplicar.
        _variableValues =
            Texts.VariableValues.Count > 0
                ? Texts.VariableValues
                : ReportVariableTemplate.ToDictionary(Variables);

        _resolvedHeader = BuildHeader();
        _resolvedFooter = BuildFooter();
        _resolvedTextBlock = BuildTextBlock();
        _resolvedFieldsBlock = BuildFieldsBlock();

        _dataTokens = CollectDataTokens();
    }


    private ResolvedReportBlock BuildFieldsBlock()
    {
        var grid =
            ReportSectionGrid.Normalize(
                Fields?.Layout,
                Fields?.Columns);

        return new ResolvedReportBlock
        {
            Id = "preview",
            Type = ReportBlockType.Fields,

            Fields = Fields is null
                ? new ResolvedFieldsBlock()
                : new ResolvedFieldsBlock
                {
                    Title = Resolve(Fields.TitleKey),
                    ShowTitle = Fields.ShowTitle ?? true,
                    Layout = grid.Layout,
                    Columns = grid.Columns,
                    Fields = Fields.Fields
                        .OrderBy(x => x.Order)
                        .Select(field => new ResolvedFixedField
                        {
                            Id = field.Id,
                            Label = Resolve(field.LabelKey ?? ReportTextKeys.BlockFieldLabel(field.Id)) ?? string.Empty,
                            Value = Resolve(field.ValueKey ?? ReportTextKeys.BlockFieldValue(field.Id)) ?? string.Empty
                        })
                        .Where(x =>
                            !string.IsNullOrWhiteSpace(x.Label) ||
                            !string.IsNullOrWhiteSpace(x.Value))
                        .ToList()
                }
        };
    }


    private ResolvedReportHeader? BuildHeader()
    {
        if (Header is null)
            return null;

        return new ResolvedReportHeader
        {
            // Siempre visible en el preview: aquí estás editando el
            // bloque, no decidiendo si se pinta en un report concreto.
            Visible = true,

            Title = Resolve(Header.TitleKey),
            Subtitle = Resolve(Header.SubtitleKey),
            ShowTitle = Header.ShowTitle ?? true,
            ShowSubtitle = Header.ShowSubtitle ?? true,
            ShowLogo = Header.ShowLogo ?? false,

            // La URL es un literal de la configuración, no una clave del
            // diccionario, así que hay que sustituirle las variables aquí:
            // de lo contrario el src acaba siendo {{company.logoUrl}} y el
            // preview enseña una imagen rota.
            LogoUrl = ResolveUrl(Header.LogoUrl),

            LogoMaxHeight = Header.LogoMaxHeight,
            Layout = Header.Layout ?? ReportHeaderLayout.LogoLeft,
            TitlePlacement = Header.TitlePlacement ?? ReportHeaderTitlePlacement.Inline,
            BackgroundColor = Header.BackgroundColor,
            TextColor = Header.TextColor,
            ShowDivider = Header.ShowDivider ?? true,

            Lines = Header.Lines
                .OrderBy(x => x.Order)
                .Select(line => new ResolvedReportHeaderLine
                {
                    Text = Resolve(line.TextKey) ?? string.Empty,
                    Style = line.Style
                })
                .Where(x => !string.IsNullOrWhiteSpace(x.Text))
                .ToList(),

            Columns = Header.Columns
                .Select(column => new ResolvedReportHeaderColumn
                {
                    Id = column.Id,
                    Align = column.Align,
                    Width = Math.Clamp(column.Width, 1, 100),
                    Lines = column.Lines
                        .OrderBy(x => x.Order)
                        .Select(line => new ResolvedReportHeaderLine
                        {
                            Text = Resolve(line.TextKey) ?? string.Empty,
                            Style = line.Style
                        })
                        .Where(x => !string.IsNullOrWhiteSpace(x.Text))
                        .ToList()
                })
                .Where(x => x.Lines.Count > 0)
                .ToList()
        };
    }


    private ResolvedReportFooter? BuildFooter()
    {
        if (Footer is null)
            return null;

        return new ResolvedReportFooter
        {
            Visible = true,
            Text = Resolve(Footer.TextKey),
            ShowGenerationDate = Footer.ShowGenerationDate ?? false,
            ShowPageNumber = Footer.ShowPageNumber ?? false
        };
    }


    private ResolvedReportBlock BuildTextBlock()
    {
        return new ResolvedReportBlock
        {
            Id = "preview",
            Type = ReportBlockType.Text,

            Text = Text is null
                ? new ReportTextBlockConfiguration()
                : new ReportTextBlockConfiguration
                {
                    Title = Resolve(Text.TitleKey),
                    Text = Resolve(Text.TextKey) ?? string.Empty,
                    Style = Text.Style,
                    Alignment = Text.Alignment
                }
        };
    }


    /// <summary>
    /// Igual que Resolve, pero sobre un literal y pensado para un src: si
    /// queda algún marcador sin valor no sirve como URL, así que se devuelve
    /// nulo y el aviso de variables sin definir explica por qué no hay logo.
    /// </summary>
    private string? ResolveUrl(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        var resolved = ApplyVariables(value);

        return resolved.Contains('\u27e8')
            ? null
            : resolved;
    }


    /// <summary>
    /// Clave de diccionario → texto del idioma en edición → sustitución de
    /// variables. Ese es el orden correcto: primero se traduce la plantilla y
    /// después se rellenan los {{marcadores}}, nunca al revés.
    /// </summary>
    private string? Resolve(
        string? key)
    {
        if (string.IsNullOrWhiteSpace(key))
            return null;

        var value = Texts.GetText(key, string.Empty);

        return string.IsNullOrWhiteSpace(value)
            ? null
            : ApplyVariables(value);
    }


    /// <summary>
    /// Sustituye los {{marcadores}} con la misma implementación que usa la
    /// API, pero dejando visible el que no tiene valor: un hueco en blanco no
    /// dice que falte nada.
    /// </summary>
    private string ApplyVariables(
        string text)
    {
        return ReportVariableTemplate.Apply(
            text,
            _variableValues,
            onMissing: key =>
            {
                // Los datos del documento no son variables: se dejan tal
                // cual y los marca el componente al pintar.
                if (key.StartsWith(ReportDataTemplate.Prefix, StringComparison.OrdinalIgnoreCase))
                    return "{{" + key + "}}";

                if (!_unresolved.Contains(key))
                    _unresolved.Add(key);

                return $"\u27e8{key}\u27e9";
            });
    }
}
