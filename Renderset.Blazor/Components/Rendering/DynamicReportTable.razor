@using System.Text.Json
@using Renderset.Core.Data
@using Renderset.Core.Definitions
@using Renderset.Core.Resolved

@if (VisibleColumns.Any())
{
    <div class="dynamic-report-table-wrapper">

        <table class="dynamic-report-table">

            <thead>
                <tr>
                    @foreach (var column in VisibleColumns)
                    {
                        <th style="@GetWidthStyle(column)"
                            class="@GetAlignmentClass(column)">
                            @column.Label
                        </th>
                    }
                </tr>
            </thead>

            <tbody>
                @foreach (var row in Rows)
                {
                    <tr>
                        @foreach (var column in VisibleColumns)
                        {
                            <td class="@GetAlignmentClass(column)">
                                @FormatValue(
                                    row,
                                    column)
                            </td>
                        }
                    </tr>
                }
            </tbody>

        </table>

        @if (IncludeTableData)
        {
            @* Los datos de origen viajan junto a la tabla para que exportar
               no dependa de raspar el texto de las celdas. Un importe leído
               del DOM llega como "1.014,00 €" y ya no se puede sumar; aquí
               sale el número tal cual venía.

               Va en un script para que el navegador no lo pinte y para que
               no aparezca ni al imprimir ni en el PDF. *@
            <script type="application/json"
                    class="dynamic-report-data"
                    data-table="@Table.Id">@((MarkupString)PayloadJson)</script>
        }

    </div>
}

@code {
    [Parameter, EditorRequired]
    public ResolvedReportTable Table { get; set; } = default!;

    [Parameter, EditorRequired]
    public JsonElement Data { get; set; }

    [CascadingParameter(Name = "IncludeTableData")]
    public bool IncludeTableData { get; set; }

    private readonly IReportDataAccessor _dataAccessor =
        new JsonReportDataAccessor();

    private IEnumerable<ResolvedReportColumn> VisibleColumns =>
        Table.Columns
            .Where(x => x.Visible)
            .OrderBy(x => x.Order);

    private IReadOnlyList<JsonElement> Rows =>
        _dataAccessor.GetCollection(
            Data,
            Table.DataPath);

    private string FormatValue(
        JsonElement row,
        ResolvedReportColumn column)
    {
        if (!_dataAccessor.TryGetValue(
                row,
                column.DataPath,
                out var value)
            || value is null)
        {
            return string.Empty;
        }

        return column.Type switch
        {
            ReportFieldType.Date when value is DateTime date
                => date.ToString("dd/MM/yyyy"),

            ReportFieldType.Currency when value is decimal number
                => number.ToString("N2"),

            ReportFieldType.Number when value is decimal number
                => number.ToString("N2"),

            ReportFieldType.Percentage when value is decimal number
                => $"{number:N2} %",

            ReportFieldType.Boolean when value is bool boolean
                => boolean ? "Sí" : "No",

            _ =>
                value.ToString() ?? string.Empty
        };
    }

    private static readonly JsonSerializerOptions PayloadOptions =
        new()
        {
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder
                .UnsafeRelaxedJsonEscaping
        };

    /// <summary>
    /// Datos de la tabla tal y como se van a exportar: una fila por línea y
    /// una propiedad por columna visible, con el valor sin formatear.
    /// 
    /// Se usa la etiqueta de la columna como nombre de propiedad porque el
    /// destino es una hoja de cálculo o un pegado manual, no un consumo
    /// programático: quien abre el CSV espera ver "Referencia", no
    /// "col-ref-01".
    /// </summary>
    private string PayloadJson
    {
        get
        {
            var columns =
                VisibleColumns.ToList();

            var rows =
                Rows
                    .Select(row =>
                    {
                        var item =
                            new Dictionary<string, object?>();

                        foreach (var column in columns)
                        {
                            _dataAccessor.TryGetValue(
                                row,
                                column.DataPath,
                                out var value);

                            item[column.Label] = value;
                        }

                        return item;
                    })
                    .ToList();

            var payload =
                new
                {
                    id = Table.Id,
                    title = Table.Name,
                    columns = columns.Select(x => x.Label).ToList(),
                    rows
                };

            // Se escapa el cierre de etiqueta porque el JSON va dentro de un
            // <script>: un dato que contenga "</script>" cerraría el bloque
            // y rompería el documento entero.
            return JsonSerializer
                .Serialize(payload, PayloadOptions)
                .Replace("</", "<\\/", StringComparison.Ordinal);
        }
    }

    private static string GetWidthStyle(
        ResolvedReportColumn column)
    {
        return column.Width.HasValue
            ? $"width:{column.Width.Value}%;"
            : string.Empty;
    }

    private static string GetAlignmentClass(
        ResolvedReportColumn column)
    {
        return column.Type switch
        {
            ReportFieldType.Number
                or ReportFieldType.Currency
                or ReportFieldType.Percentage
                => "number",

            _ => string.Empty
        };
    }
}