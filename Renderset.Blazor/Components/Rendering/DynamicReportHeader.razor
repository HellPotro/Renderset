@using System.Text
@using Renderset.Core.Definitions
@using Renderset.Core.Resolved

@if (Header is not null && Header.Visible)
{
    <div class="report-header @LayoutClass @StateClasses"
         style="@HeaderStyle">

        @if (Header.ShowLogo &&
             !string.IsNullOrWhiteSpace(Header.LogoUrl))
        {
            <div class="report-header-logo">
                <img src="@Header.LogoUrl"
                     alt="Logo"
                     style="@LogoStyle" />
            </div>
        }

        <div class="report-header-content">

            @if (!string.IsNullOrWhiteSpace(Header.Title))
            {
                <h1>@Header.Title</h1>
            }

            @if (!string.IsNullOrWhiteSpace(Header.Subtitle))
            {
                <div class="report-header-subtitle">
                    @Header.Subtitle
                </div>
            }

            @if (Header.Columns.Count > 0)
            {
                <div class="report-header-columns">
                    @foreach (var column in Header.Columns)
                    {
                        <div class="report-header-column @AlignmentClass(column.Align)"
                             style="@ColumnStyle(column)">
                            @foreach (var line in column.Lines)
                            {
                                <div class="report-header-line @LineClass(line.Style)">
                                    @line.Text
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (Header.Lines.Count > 0)
            {
                @* El camino legacy permanece separado a propósito: una cabecera
                   guardada antes de existir Columns debe generar el mismo DOM y
                   por tanto conservar exactamente el mismo aspecto. *@
                <div class="report-header-lines">

                    @foreach (var line in Header.Lines)
                    {
                        <div class="report-header-line @LineClass(line.Style)">
                            @line.Text
                        </div>
                    }

                </div>
            }

        </div>

    </div>
}

@code {
    [Parameter]
    public ResolvedReportHeader? Header { get; set; }

    private string LayoutClass =>
        Header?.Layout switch
        {
            ReportHeaderLayout.LogoRight => "is-logo-right",
            ReportHeaderLayout.Stacked => "is-stacked",
            _ => "is-logo-left"
        };

    /// <summary>
    /// Con fondo propio la cabecera deja de ser una banda transparente y
    /// necesita su propio relleno, o el color se pega al texto.
    /// </summary>
    private string StateClasses
    {
        get
        {
            var classes = new List<string>();

            if (!string.IsNullOrWhiteSpace(Header?.BackgroundColor))
                classes.Add("is-filled");

            if (Header?.ShowDivider == false)
                classes.Add("is-borderless");

            return string.Join(' ', classes);
        }
    }

    private string? HeaderStyle
    {
        get
        {
            if (Header is null)
                return null;

            var style = new StringBuilder();

            if (!string.IsNullOrWhiteSpace(Header.BackgroundColor))
                style.Append("background:").Append(Header.BackgroundColor).Append(';');

            if (!string.IsNullOrWhiteSpace(Header.TextColor))
                style.Append("color:").Append(Header.TextColor).Append(';');

            return style.Length == 0
                ? null
                : style.ToString();
        }
    }

    private string? LogoStyle =>
        Header?.LogoMaxHeight is > 0
            ? $"max-height:{Header.LogoMaxHeight}px;"
            : null;

    private static string ColumnStyle(
        ResolvedReportHeaderColumn column) =>
        $"flex-basis:{Math.Clamp(column.Width, 1, 100)}%;";

    private static string AlignmentClass(
        ReportHorizontalAlignment alignment) =>
        alignment switch
        {
            ReportHorizontalAlignment.Center => "is-align-center",
            ReportHorizontalAlignment.Right => "is-align-right",
            _ => "is-align-left"
        };

    private static string LineClass(
        ReportHeaderLineStyle style) =>
        style switch
        {
            ReportHeaderLineStyle.Strong => "is-strong",
            ReportHeaderLineStyle.Muted => "is-muted",
            ReportHeaderLineStyle.Small => "is-small",
            _ => "is-normal"
        };
}
