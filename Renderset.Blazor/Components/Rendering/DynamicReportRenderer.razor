@using System.Text.Json
@using Renderset.Core.Definitions
@using Renderset.Core.Rendering
@using Renderset.Core.Resolved
@using Renderset.Core.Themes

<CascadingValue Value="IncludeTableData"
                Name="IncludeTableData"
                IsFixed="true">

@* has-page-footer: la hoja empuja el pie al final (pantalla) y al imprimir
   lo sustituye el pie repetido en cada página (ver ReportPageFooter). *@
<div class="@ReportClass"
     style="@ThemeStyle">

    <DynamicReportHeader Header="Report.Header"
                         Data="Data"
                         Document="Document" />

    @foreach (var row in Rows)
    {
        @* Una fila de un solo elemento se pinta tal cual, sin envoltorio.
           Así los reports que no usan columnas generan exactamente el mismo
           HTML que antes y no cambian de aspecto. *@
        @if (row.Count == 1)
        {
            @RenderItem(row[0])
        }
        else
        {
            <div class="dynamic-report-row">

                @foreach (var item in row)
                {
                    <div class="dynamic-report-column"
                         style="flex-grow:@item.Span">

                        @RenderItem(item)

                    </div>
                }

            </div>
        }
    }

    @if (HasPageFooter)
    {
        <div class="dynamic-report-page-spacer" aria-hidden="true"></div>
    }

    <DynamicReportFooter Footer="Report.Footer"
                         Data="Data" />

</div>

</CascadingValue>

@code {
    [Parameter, EditorRequired]
    public ResolvedReportDefinition Report { get; set; } = default!;

    [Parameter, EditorRequired]
    public JsonElement Data { get; set; }

    [Parameter]
    public ReportTheme Theme { get; set; } = new();

    /// <summary>
    /// Emite junto a cada tabla sus datos de origen en JSON, para que la
    /// barra del documento pueda exportarlos con los valores reales en vez
    /// de raspar el texto ya formateado de las celdas.
    ///
    /// Apagado en el preview del editor: allí nadie exporta y duplicaría los
    /// datos en cada repintado.
    /// </summary>
    [Parameter]
    public bool IncludeTableData { get; set; }

    /// <summary>
    /// Id y enlace del documento que se emite, para el QR de la cabecera.
    /// El preview del diseñador pasa <see cref="ReportDocumentContext.Preview"/>.
    /// </summary>
    [Parameter]
    public ReportDocumentContext? Document { get; set; }

    private IEnumerable<ResolvedReportBodyItem> VisibleBodyItems =>
        Report.Body
            .Where(x =>
                x.Type != ReportBodyItemType.Section ||
                x.Section?.Visible == true)
            .OrderBy(x => x.Order);

    /// <summary>
    /// Las filas salen de agrupar por el número que ya trae el elemento
    /// resuelto: aquí no se decide layout, sólo se agrupa.
    ///
    /// Se agrupa después de filtrar por visibilidad a propósito. Si una
    /// sección oculta deja a su compañera sola en la fila, la compañera pasa
    /// a ocupar el ancho completo en vez de quedarse a media página con un
    /// hueco al lado.
    /// </summary>
    private IReadOnlyList<IReadOnlyList<ResolvedReportBodyItem>> Rows =>
        VisibleBodyItems
            .GroupBy(x => x.Row)
            .Select(group =>
                (IReadOnlyList<ResolvedReportBodyItem>)group.ToList())
            .ToList();

    private RenderFragment RenderItem(
        ResolvedReportBodyItem item) =>
        @<text>
            @if (item.Type == ReportBodyItemType.Section &&
                 item.Section is not null)
            {
                <DynamicReportSection Section="@item.Section"
                                      Data="@Data" />
            }
            else if (item.Type == ReportBodyItemType.Block &&
                     item.Block is not null)
            {
                <DynamicReportBlock Block="item.Block"
                                    Data="@Data" />
            }
        </text>;

    private string ThemeStyle =>
        ReportThemeCss.Variables(Theme);

    private bool HasPageFooter =>
        Report.Footer?.HasContent == true;

    private string ReportClass =>
        HasPageFooter
            ? "dynamic-report has-page-footer"
            : "dynamic-report";
}
