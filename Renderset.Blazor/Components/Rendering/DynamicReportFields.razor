@using System.Text.Json
@using Renderset.Core.Configurations
@using Renderset.Core.Data
@using Renderset.Core.Definitions
@using Renderset.Core.Rendering
@using Renderset.Core.Resolved

@if (Section.Visible)
{
    var visibleFields = Section.Fields
        .Where(x => x.Visible)
        .OrderBy(x => x.Order)
        .ToList();

    @if (visibleFields.Count > 0)
    {
        @if (Section.Layout == ReportSectionLayout.List)
        {
            <div class="dynamic-report-fields">

                @foreach (var field in visibleFields)
                {
                    <div class="dynamic-report-field">

                        <div class="dynamic-report-field-label">
                            @field.Label
                        </div>

                        <div class="dynamic-report-field-value">
                            @FormatValue(field)
                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="@GridClass"
                 style="@GridStyle">

                @foreach (var field in visibleFields)
                {
                    <div class="dynamic-report-metric">

                        <div class="dynamic-report-metric-label">
                            @field.Label
                        </div>

                        <div class="dynamic-report-metric-value">
                            @FormatValue(field)
                        </div>

                    </div>
                }

            </div>
        }
    }
}

@code {

    [Parameter, EditorRequired]
    public ResolvedReportSection Section { get; set; } = default!;

    [Parameter, EditorRequired]
    public JsonElement Data { get; set; }

    private readonly IReportDataAccessor _dataAccessor =
        new JsonReportDataAccessor();

    private int Columns =>
        Math.Clamp(
            Section.Columns,
            ReportSectionGrid.MinColumns,
            ReportSectionGrid.MaxColumns);

    /// <summary>
    /// El número de columnas va en una variable CSS y no en una clase por
    /// valor: así sirve cualquier N sin repetir reglas en la hoja.
    /// </summary>
    private string GridStyle =>
        $"--report-grid-columns:{Columns};";

    private string GridClass =>
        Columns >= ReportSectionGrid.DenseFromColumns
            ? "dynamic-report-grid is-dense"
            : "dynamic-report-grid";

    private string FormatValue(
        ResolvedReportField field)
    {
        if (!_dataAccessor.TryGetValue(
                Data,
                field.DataPath,
                out var value)
            || value is null)
        {
            return string.Empty;
        }

        return ReportValueFormatter.Format(value, field.Type);
    }
}