@using System.Text.Json
@using Renderset.Core.DataSources
@using Renderset.Core.Mapping
@using Renderset.Core.Reports
@using Renderset.Core.Reports.Inference

@* Asistente de origen de datos.

   Va por pasos en vez de enseñarlo todo a la vez: pegar, definir un nivel,
   definir el siguiente, revisar. Un SELECT con JOINs de un ERP trae
   fácilmente cuarenta columnas, y decidirlo todo en una pantalla obliga a
   sostener en la cabeza la estructura entera antes de haber visto nada.

   El modelo no cambia: sigue siendo una cadena de niveles y una asignación
   de columna a nivel. Lo único que cambia es el ritmo al que se construye. *@

<div class="dsrc">

    <ol class="dsrc-steps">

        <li class="@StepClass(WizardStep.Source, 0)">
            <button type="button"
                    @onclick="() => GoToStepAsync(WizardStep.Source, 0)">
                <span class="dsrc-step-dot">1</span>
                Datos
            </button>
        </li>

        @for (var index = 0; index < _levels.Count; index++)
        {
            var depth = index;

            <li class="@StepClass(WizardStep.Level, depth)">
                <button type="button"
                        @onclick="() => GoToStepAsync(WizardStep.Level, depth)">
                    <span class="dsrc-step-dot">@(depth + 2)</span>
                    @GetLevelDisplayName(_levels[depth])
                </button>
            </li>
        }

        <li class="@StepClass(WizardStep.Review, 0)">
            <button type="button"
                    disabled="@(!CanReview)"
                    @onclick="() => GoToStepAsync(WizardStep.Review, 0)">
                <span class="dsrc-step-dot">
                    <i class="fa-solid fa-check"></i>
                </span>
                Revisar
            </button>
        </li>

    </ol>


    @* ------------------------------------------------------ paso: datos *@

    @if (_step == WizardStep.Source)
    {
        <div class="dsrc-panel">

            <div class="dsrc-head">

                <div class="dsrc-segmented">

                    <button type="button"
                            class="@(_kind == DatasetSourceKind.Json ? "is-on" : "")"
                            @onclick="() => SwitchTo(DatasetSourceKind.Json)">
                        <i class="fa-solid fa-code"></i>
                        JSON
                    </button>

                    <button type="button"
                            class="@(_kind == DatasetSourceKind.Tabular ? "is-on" : "")"
                            @onclick="() => SwitchTo(DatasetSourceKind.Tabular)">
                        <i class="fa-solid fa-table"></i>
                        SQL / CSV
                    </button>

                </div>

                <p class="dsrc-hint">
                    @(_kind == DatasetSourceKind.Json
                        ? "Pega un documento de ejemplo con la estructura que ya usa tu sistema."
                        : "Pega el resultado de tu consulta tal cual. Desde SSMS, copia la rejilla con cabeceras.")
                </p>

                <button type="button"
                        class="dsrc-example"
                        @onclick="LoadExample">
                    <i class="fa-solid fa-flask"></i>
                    Ejemplo
                </button>

            </div>

            @if (_kind == DatasetSourceKind.Json)
            {
                <textarea class="dsrc-input"
                          rows="@Rows"
                          spellcheck="false"
                          value="@_json"
                          @onchange="JsonChanged"></textarea>
            }
            else
            {
                <textarea class="dsrc-input"
                          rows="@Rows"
                          spellcheck="false"
                          value="@_raw"
                          @onchange="RawChanged"
                          placeholder="Factura&#9;Cliente&#9;Albaran_codigo&#9;Articulo&#9;Cantidad"></textarea>

                @if (_payload is not null && _payload.Rows.Count > 0)
                {
                    <div class="dsrc-summary">

                        <span class="dsrc-metric">
                            <strong>@_payload.Rows.Count</strong> filas
                        </span>

                        <span class="dsrc-metric">
                            <strong>@_payload.Columns.Count</strong> columnas
                        </span>

                        @if (!string.IsNullOrWhiteSpace(_reason))
                        {
                            <span class="dsrc-reason">@_reason</span>
                        }

                    </div>
                }
            }

        </div>
    }
    else if (_step == WizardStep.Level && ActiveLevel is { } level)
    {
        // Paso de nivel: se edita uno cada vez, empezando por el documento.

        var available = AvailableOrdinals(level);

        <div class="dsrc-panel">

            <header class="dsrc-level-head">

                <span class="dsrc-level-icon">
                    <i class="@GetLevelIcon(level)"></i>
                </span>

                @if (level.Depth == 0)
                {
                    <div class="dsrc-level-title">
                        <strong>Documento</strong>
                        <span>
                            Los datos que se repiten en todas las filas: son la
                            cabecera del documento.
                        </span>
                    </div>
                }
                else
                {
                    <div class="dsrc-level-title">
                        <input value="@level.Name"
                               placeholder="nombre de la colección"
                               @onchange="e => LevelNameChanged(level, e)" />
                        <span>
                            Se repetirá dentro de
                            @(GetLevelDisplayName(_levels[level.Depth - 1]) + ".")
                        </span>
                    </div>

                    <button type="button"
                            class="dsrc-mini-button is-danger"
                            title="Quitar este nivel y devolver sus columnas"
                            @onclick="RemoveActiveLevelAsync">
                        <i class="fa-solid fa-xmark"></i>
                        Quitar nivel
                    </button>
                }

            </header>


            <div class="dsrc-field">

                <label>
                    @(level.Depth == 0
                        ? "¿Qué columna identifica cada documento?"
                        : $"¿Qué columna identifica cada {GetLevelDisplayName(level)}?")
                </label>

                <select value="@(level.KeyColumn?.ToString() ?? "")"
                        @onchange="e => LevelKeyChangedAsync(level, e)">

                    <option value="">
                        @(level.Depth == 0
                            ? "— Todas las filas son un solo documento"
                            : "— Cada fila es un elemento")
                    </option>

                    @foreach (var ordinal in available)
                    {
                        <option value="@ordinal">
                            @_payload!.Columns[ordinal].Name
                        </option>
                    }

                </select>

                @if (KeyHint is not null)
                {
                    <p class="dsrc-key-hint">
                        <i class="fa-solid fa-lightbulb"></i>
                        @KeyHint
                    </p>
                }

            </div>


            <div class="dsrc-field">

                <div class="dsrc-field-head">

                    <label>
                        Campos de este nivel
                        <em>@ColumnsOf(level).Count de @available.Count</em>
                    </label>

                    <div class="dsrc-field-actions">

                        @if (SuggestedOrdinals.Count > 0)
                        {
                            <button type="button"
                                    class="dsrc-mini-button"
                                    @onclick="() => ApplySuggestionAsync(level)">
                                <i class="fa-solid fa-wand-magic-sparkles"></i>
                                Marcar las @SuggestedOrdinals.Count sugeridas
                            </button>
                        }

                        <button type="button"
                                class="dsrc-mini-button"
                                @onclick="() => SelectAllAsync(level, available)">
                            Todas
                        </button>

                        <button type="button"
                                class="dsrc-mini-button"
                                @onclick="() => ClearAllAsync(level)">
                            Ninguna
                        </button>

                    </div>

                </div>

                <p class="dsrc-legend">
                    Ordenadas de menos a más valores distintos: arriba las que
                    no cambian nunca, abajo las que cambian en cada fila.
                </p>

                @if (available.Count == 0)
                {
                    <div class="dsrc-empty">
                        No quedan columnas sin colocar. Vuelve a un nivel
                        anterior si quieres liberar alguna.
                    </div>
                }
                else
                {
                    <div class="dsrc-columns">

                        @foreach (var ordinal in available)
                        {
                            var column = _payload!.Columns[ordinal];
                            var assigned = IsAssignedTo(ordinal, level);

                            <label class="@ColumnClass(ordinal, level)"
                                   @key="ordinal">

                                <input type="checkbox"
                                       checked="@assigned"
                                       @onchange="e => ToggleColumnAsync(level, ordinal, GetBool(e.Value))" />

                                <span class="dsrc-column-body">

                                    <span class="dsrc-column-top">
                                        <code>@column.Name</code>

                                        @if (level.KeyColumn == ordinal)
                                        {
                                            <span class="dsrc-badge is-key">clave</span>
                                        }

                                        <span class="@CardinalityClass(ordinal)">
                                            @CardinalityLabel(ordinal)
                                        </span>
                                    </span>

                                    <span class="dsrc-column-sample">
                                        @SampleOf(ordinal)
                                    </span>

                                </span>

                                <em>@column.Type</em>

                            </label>
                        }

                    </div>
                }

            </div>


            @if (UnassignedCount > 0)
            {
                <p class="dsrc-note">
                    Quedan <strong>@UnassignedCount</strong> columnas sin
                    colocar. Si finalizas ahora se quedarán fuera del modelo;
                    el último paso te las enseña y te deja recuperarlas.
                </p>
            }

        </div>
    }
    else if (_step == WizardStep.Review)
    {
        <div class="dsrc-panel">

            <div class="dsrc-summary">

                @if (_payload is not null)
                {
                    <span class="dsrc-metric">
                        <strong>@_payload.Rows.Count</strong> filas
                    </span>
                }

                <i class="fa-solid fa-arrow-right-long"></i>

                <span class="dsrc-metric is-result">
                    <strong>@_documents.Count</strong>
                    documento@(_documents.Count == 1 ? "" : "s")
                </span>

                @if (_levels.Count > 1)
                {
                    <span class="dsrc-metric">
                        <strong>@(_levels.Count - 1)</strong>
                        nivel@(_levels.Count - 1 == 1 ? "" : "es") anidado@(_levels.Count - 1 == 1 ? "" : "s")
                    </span>
                }

            </div>

            @if (!string.IsNullOrWhiteSpace(_structureWarning))
            {
                <div class="dsrc-warn">
                    @_structureWarning
                </div>
            }

            @if (_kind == DatasetSourceKind.Tabular && _levels.Count > 0 && UnassignedCount > 0)
            {
                var leftovers = UnassignedOrdinals();
                var deepest = _levels[^1];

                <div class="dsrc-warn dsrc-leftovers">

                    <div class="dsrc-leftovers-head">

                        <strong>
                            @leftovers.Count columna@(leftovers.Count == 1 ? "" : "s")
                            fuera del modelo
                        </strong>

                        <button type="button"
                                class="dsrc-mini-button"
                                @onclick="() => AddRemainingToLevelAsync(deepest)">
                            <i class="fa-solid fa-plus"></i>
                            Añadirlas a @GetLevelDisplayName(deepest)
                        </button>

                    </div>

                    <div class="dsrc-leftovers-list">
                        @foreach (var ordinal in leftovers)
                        {
                            <code @key="ordinal">@_payload!.Columns[ordinal].Name</code>
                        }
                    </div>

                </div>
            }

            @if (_kind == DatasetSourceKind.Tabular)
            {
                <div class="dsrc-tree">

                    @foreach (var node in _levels)
                    {
                        <section class="dsrc-tree-level"
                                 style="@Indent(node)"
                                 @key="node.Depth">

                            <header>

                                <span class="dsrc-level-icon">
                                    <i class="@GetLevelIcon(node)"></i>
                                </span>

                                <strong>@GetLevelDisplayName(node)</strong>

                                @if (node.Depth > 0)
                                {
                                    <span class="dsrc-badge">array</span>
                                }

                                @if (node.KeyColumn is not null)
                                {
                                    <span class="dsrc-tree-key">
                                        agrupado por
                                        <code>@_payload!.Columns[node.KeyColumn.Value].Name</code>
                                    </span>
                                }

                                <button type="button"
                                        class="dsrc-mini-button"
                                        @onclick="() => GoToStepAsync(WizardStep.Level, node.Depth)">
                                    <i class="fa-solid fa-pen"></i>
                                    Editar
                                </button>

                            </header>

                            @if (ColumnsOf(node).Count == 0)
                            {
                                <div class="dsrc-empty is-compact">
                                    Sin columnas.
                                </div>
                            }
                            else
                            {
                                <div class="dsrc-tree-fields">

                                    @foreach (var ordinal in ColumnsOf(node))
                                    {
                                        <div class="dsrc-tree-field" @key="ordinal">

                                            <code>@_payload!.Columns[ordinal].Name</code>

                                            <i class="fa-solid fa-arrow-right-long"></i>

                                            <input value="@_assignments[ordinal].Name"
                                                   @onchange="e => FieldNameChanged(ordinal, e)" />

                                        </div>
                                    }

                                </div>
                            }

                        </section>
                    }

                </div>
            }

            @if (ShowPreview && _documents.Count > 0)
            {
                <div class="dsrc-field">

                    <div class="dsrc-field-head">

                        <label>Modelo generado</label>

                        @if (_documents.Count > 1)
                        {
                            <div class="dsrc-doc-tabs">
                                @for (var i = 0; i < Math.Min(_documents.Count, 12); i++)
                                {
                                    var index = i;

                                    <button type="button"
                                            class="@(index == _selected ? "is-on" : "")"
                                            @onclick="() => _selected = index">
                                        @(index + 1)
                                    </button>
                                }
                            </div>
                        }

                    </div>

                    <pre class="dsrc-json">@Pretty(_documents[SafeSelectedIndex])</pre>

                </div>
            }

        </div>
    }


    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="dsrc-error">
            @_error
        </div>
    }


    @* ------------------------------------------------------- navegación *@

    <div class="dsrc-actions">

        @if (_step != WizardStep.Source)
        {
            <button type="button"
                    class="secondary-button"
                    @onclick="BackAsync">
                <i class="fa-solid fa-arrow-left"></i>
                Atrás
            </button>
        }

        <span class="dsrc-actions-spacer"></span>

        @if (_step == WizardStep.Source)
        {
            <button type="button"
                    class="primary-button"
                    disabled="@(!CanLeaveSource)"
                    @onclick="LeaveSourceAsync">
                Continuar
                <i class="fa-solid fa-arrow-right"></i>
            </button>
        }
        else if (_step == WizardStep.Level)
        {
            <button type="button"
                    class="secondary-button"
                    @onclick="AddLevelAsync">
                <i class="fa-solid fa-plus"></i>
                Añadir nivel dentro
            </button>

            <button type="button"
                    class="primary-button"
                    @onclick="FinishAsync">
                Finalizar
                <i class="fa-solid fa-arrow-right"></i>
            </button>
        }
        else
        {
            @ChildContent

            <button type="button"
                    class="primary-button"
                    disabled="@(!CanContinue)"
                    @onclick="EmitAsync">
                <i class="fa-solid fa-arrow-right"></i>
                @ContinueText
            </button>
        }

    </div>

</div>


@code {

    private const string IgnorePath = "\u0000ignore";

    private static readonly JsonSerializerOptions PrettyOptions =
        new() { WriteIndented = true };

    [Parameter, EditorRequired]
    public EventCallback<DatasetResult> OnDatasetReady { get; set; }

    [Parameter]
    public string ContinueText { get; set; } = "Continuar";

    [Parameter]
    public int Rows { get; set; } = 8;

    [Parameter]
    public bool ShowPreview { get; set; } = true;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private DatasetSourceKind _kind = DatasetSourceKind.Json;

    private string _json = string.Empty;
    private string _raw = string.Empty;
    private string? _error;
    private string? _structureWarning;
    private string _reason = string.Empty;

    private TabularPayload? _payload;
    private DataSetSchema? _dataSchema;

    /// <summary>
    /// Copia de las filas como array, que es lo que pide el sugeridor. Se
    /// guarda una vez y no en cada paso: con miles de filas, rehacerla en
    /// cada render se nota.
    /// </summary>
    private List<object?[]> _rows = [];

    /// <summary>
    /// Valores distintos por columna en toda la muestra. Es lo que permite
    /// ordenar el listado de menos a más variación y decir de un vistazo
    /// cuáles son datos de cabecera y cuáles de detalle.
    ///
    /// Se calcula una vez al parsear: hacerlo en cada render con unos miles
    /// de filas se nota.
    /// </summary>
    private readonly Dictionary<int, int> _distinct = [];

    /// <summary>
    /// Cadena lineal de niveles: documento → albaran → lines. Cada uno es
    /// hijo del anterior.
    /// </summary>
    private readonly List<LevelState> _levels = [];

    /// <summary>
    /// Indexado por POSICIÓN de columna, no por nombre. Una consulta con
    /// JOINs trae nombres repetidos (Referencia del pedido y Referencia del
    /// artículo) y un diccionario por nombre los machaca.
    /// </summary>
    private readonly Dictionary<int, Assignment> _assignments = [];

    private List<JsonElement> _documents = [];
    private ReportDataSchema? _schema;
    private DataMapping? _mapping;

    private int _selected;

    private WizardStep _step = WizardStep.Source;
    private int _activeLevel;

    /// <summary>
    /// Candidatas a clave del nivel que se está editando, ya puntuadas.
    /// </summary>
    private IReadOnlyList<DataMappingKeyCandidate> _candidates = [];

    /// <summary>
    /// Columnas que el análisis propone para el nivel activo. En el
    /// documento se marcan solas; a partir del primer nivel anidado se
    /// ofrecen pero no se marcan, porque ahí la heurística acierta menos que
    /// quien conoce los datos.
    /// </summary>
    private readonly HashSet<int> _suggested = [];


    private LevelState? ActiveLevel =>
        _activeLevel >= 0 && _activeLevel < _levels.Count
            ? _levels[_activeLevel]
            : null;

    private IReadOnlySet<int> SuggestedOrdinals => _suggested;

    private int SafeSelectedIndex =>
        _documents.Count == 0
            ? 0
            : Math.Clamp(_selected, 0, _documents.Count - 1);

    private bool CanLeaveSource =>
        _kind == DatasetSourceKind.Json
            ? _documents.Count > 0
            : _payload is not null && _payload.Rows.Count > 0;

    private bool CanReview =>
        _kind == DatasetSourceKind.Json
            ? _documents.Count > 0
            : _levels.Count > 0;

    private bool CanContinue =>
        _documents.Count > 0 &&
        _schema is not null;

    private int UnassignedCount =>
        _assignments.Count(x => x.Value.LevelPath == IgnorePath);

    private string? KeyHint
    {
        get
        {
            var level = ActiveLevel;

            if (level is null || _payload is null)
                return null;

            if (level.KeyColumn is not null)
            {
                var chosen =
                    _candidates.FirstOrDefault(x => x.Ordinal == level.KeyColumn.Value);

                return chosen is null
                    ? null
                    : $"Agrupa las filas en {chosen.GroupCount} " +
                      $"grupo{(chosen.GroupCount == 1 ? "" : "s")}, " +
                      $"dejando {chosen.ConstantOrdinals.Count} columna" +
                      $"{(chosen.ConstantOrdinals.Count == 1 ? "" : "s")} constante" +
                      $"{(chosen.ConstantOrdinals.Count == 1 ? "" : "s")}.";
            }

            var best = _candidates.FirstOrDefault();

            return best is null
                ? null
                : $"Sugerencia: '{best.Column}' agruparía las filas en " +
                  $"{best.GroupCount} grupo{(best.GroupCount == 1 ? "" : "s")}.";
        }
    }


    // -------------------------------------------------------------- entrada

    private void SwitchTo(
        DatasetSourceKind kind)
    {
        _kind = kind;
        _error = null;

        Reset();

        if (kind == DatasetSourceKind.Json)
            AnalyzeJson();
        else
            AnalyzeTabular();
    }


    private void JsonChanged(
        ChangeEventArgs e)
    {
        _json = e.Value?.ToString() ?? string.Empty;

        AnalyzeJson();
    }


    private void RawChanged(
        ChangeEventArgs e)
    {
        _raw = e.Value?.ToString() ?? string.Empty;

        AnalyzeTabular();
    }


    private void LoadExample()
    {
        if (_kind == DatasetSourceKind.Json)
        {
            _json =
                """
                {
                  "number": "10001",
                  "customer": { "code": "000123", "name": "Ford España" },
                  "lines": [
                    { "reference": "A001", "quantity": 5, "price": 20.00 }
                  ]
                }
                """;

            AnalyzeJson();

            return;
        }

        // Dos albaranes dentro de una factura: el caso de dos niveles.
        _raw =
            "Factura\tCliente\tNombre\tAlbaran_codigo\tAlbaran_fecha\tArticulo\tDescripcion\tCantidad\tPrecio\n" +
            "060098\t002532\tGestamp Esmar\t001148\t2026-06-03\tGBA02101\tSill Inner LH.\t56\t33,3562\n" +
            "060098\t002532\tGestamp Esmar\t001148\t2026-06-03\tGBA02102\tSill Inner RH.\t56\t33,3562\n" +
            "060098\t002532\tGestamp Esmar\t001310\t2026-06-17\tGBA01101\tAssy Cantrail LH.\t240\t13,739\n" +
            "060098\t002532\tGestamp Esmar\t001310\t2026-06-17\tGBA01102\tAssy Cantrail RH.\t240\t13,739";

        AnalyzeTabular();
    }


    // ------------------------------------------------------------- análisis

    private void AnalyzeJson()
    {
        Reset();

        if (string.IsNullOrWhiteSpace(_json))
            return;

        try
        {
            using var document = JsonDocument.Parse(_json);

            var data = document.RootElement.Clone();

            _schema = JsonSchemaInferer.Infer(data);
            _documents = [data];
            _mapping = null;
        }
        catch (JsonException exception)
        {
            _error = $"El JSON no es válido: {exception.Message}";
        }
    }


    /// <summary>
    /// Sólo parsea y describe. La estructura no se toca todavía: eso es el
    /// paso siguiente, y decidirlo aquí sería volver a hacerlo todo de una
    /// vez.
    /// </summary>
    private void AnalyzeTabular()
    {
        Reset();

        if (string.IsNullOrWhiteSpace(_raw))
            return;

        try
        {
            _payload = DelimitedTextParser.Parse(_raw);
        }
        catch (Exception exception)
        {
            _error = exception.Message;

            return;
        }

        if (_payload.Rows.Count == 0)
        {
            _error = "No se ha encontrado ninguna fila de datos.";
            _payload = null;

            return;
        }

        _dataSchema = _payload.ToSchema();

        _rows =
            _payload.Rows
                .Select(row => row.ToArray())
                .ToList();

        _distinct.Clear();

        for (var ordinal = 0; ordinal < _payload.Columns.Count; ordinal++)
        {
            _assignments[ordinal] =
                new Assignment
                {
                    LevelPath = IgnorePath,
                    Name = DataMappingSuggester.ToCamelCase(
                        _payload.Columns[ordinal].Name)
                };

            var position = ordinal;

            _distinct[ordinal] =
                _rows
                    .Select(row => row[position]?.ToString() ?? "\u0000")
                    .Distinct(StringComparer.Ordinal)
                    .Count();
        }

        var best =
            DataMappingSuggester
                .RankKeyCandidates(
                    _dataSchema,
                    _rows,
                    AllOrdinals(),
                    [])
                .FirstOrDefault();

        _reason =
            best is null
                ? "Ninguna columna agrupa las filas: cada fila sería un documento."
                : $"'{best.Column}' agruparía {_rows.Count} filas en " +
                  $"{best.GroupCount} documento(s).";
    }


    // --------------------------------------------------------- navegación

    private async Task LeaveSourceAsync()
    {
        if (!CanLeaveSource)
            return;

        if (_kind == DatasetSourceKind.Json)
        {
            _step = WizardStep.Review;
            return;
        }

        if (_levels.Count == 0)
            StartDocumentLevel();

        _activeLevel = 0;
        _step = WizardStep.Level;

        RefreshSuggestion();

        await Task.CompletedTask;
    }


    private async Task BackAsync()
    {
        if (_step == WizardStep.Review)
        {
            if (_kind == DatasetSourceKind.Json || _levels.Count == 0)
            {
                _step = WizardStep.Source;
                return;
            }

            await GoToStepAsync(WizardStep.Level, _levels.Count - 1);
            return;
        }

        if (_step == WizardStep.Level && _activeLevel > 0)
        {
            await GoToStepAsync(WizardStep.Level, _activeLevel - 1);
            return;
        }

        _step = WizardStep.Source;
    }


    private async Task GoToStepAsync(
        WizardStep step,
        int level)
    {
        switch (step)
        {
            case WizardStep.Source:
                _step = WizardStep.Source;
                break;

            case WizardStep.Level when level >= 0 && level < _levels.Count:
                _activeLevel = level;
                _step = WizardStep.Level;
                RefreshSuggestion();
                break;

            case WizardStep.Review when CanReview:
                await FinishAsync();
                break;
        }
    }


    /// <summary>
    /// El nivel raíz sí llega propuesto: lo que se repite en todas las filas
    /// es la cabecera del documento sin ambigüedad posible, y hacer marcarlo
    /// a mano sería trabajo por nada.
    /// </summary>
    private void StartDocumentLevel()
    {
        _levels.Add(
            new LevelState
            {
                Depth = 0,
                Name = string.Empty
            });

        var best =
            DataMappingSuggester
                .RankKeyCandidates(_dataSchema!, _rows, AllOrdinals(), [])
                .FirstOrDefault();

        var proposed =
            best is null
                ? DataMappingSuggester.ConstantColumns(_rows, AllOrdinals())
                : best.ConstantOrdinals;

        _levels[0].KeyColumn = best?.Ordinal;

        foreach (var ordinal in proposed)
            _assignments[ordinal].LevelPath = _levels[0].Path;
    }


    private async Task AddLevelAsync()
    {
        var parent = ActiveLevel;

        if (parent is null)
            return;

        // Sólo se puede profundizar desde el último nivel: la cadena no
        // admite hermanos y meter uno por el medio dejaría huérfano lo de
        // abajo.
        if (parent.Depth != _levels.Count - 1)
        {
            await GoToStepAsync(WizardStep.Level, _levels.Count - 1);
            return;
        }

        var name = SuggestLevelName();

        _levels.Add(
            new LevelState
            {
                Depth = parent.Depth + 1,
                Name = name
            });

        _activeLevel = _levels.Count - 1;
        _step = WizardStep.Level;

        RefreshSuggestion();
    }


    private async Task RemoveActiveLevelAsync()
    {
        var level = ActiveLevel;

        if (level is null || level.Depth == 0)
            return;

        // Se quitan también los de debajo: sin su padre no tienen dónde
        // colgar.
        for (var depth = _levels.Count - 1; depth >= level.Depth; depth--)
        {
            var removed = _levels[depth];

            foreach (var assignment in _assignments.Values)
            {
                if (assignment.LevelPath == removed.Path)
                    assignment.LevelPath = IgnorePath;
            }

            _levels.RemoveAt(depth);
        }

        await GoToStepAsync(WizardStep.Level, _levels.Count - 1);
    }


    private async Task FinishAsync()
    {
        if (_kind == DatasetSourceKind.Json)
        {
            _step = WizardStep.Review;
            return;
        }

        // Lo que no se ha marcado se queda FUERA del modelo. Colocarlo solo
        // en el último nivel convertía cualquier descuido en campos que
        // nadie había pedido, y encima en el sitio más difícil de ver.
        // El paso de revisión lo enseña y ofrece añadirlo de una vez.
        Build();

        _step = WizardStep.Review;

        await Task.CompletedTask;
    }


    // -------------------------------------------------------------- niveles

    private void LevelNameChanged(
        LevelState level,
        ChangeEventArgs e)
    {
        var previousPath = level.Path;

        var value = e.Value?.ToString();

        level.Name =
            string.IsNullOrWhiteSpace(value)
                ? level.Name
                : DataMappingSuggester.ToCamelCase(value.Trim());

        RepathAssignments(previousPath, level);
    }


    private async Task LevelKeyChangedAsync(
        LevelState level,
        ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        level.KeyColumn =
            string.IsNullOrWhiteSpace(value)
                ? null
                : int.Parse(value);

        // La clave pertenece al nivel que agrupa: si no, el modelo sale sin
        // el número de factura dentro de la factura.
        if (level.KeyColumn is not null)
            _assignments[level.KeyColumn.Value].LevelPath = level.Path;

        RefreshSuggestion();

        await Task.CompletedTask;
    }


    /// <summary>
    /// Recalcula candidatas y propuesta para el nivel activo, contando sólo
    /// con lo que todavía está libre.
    /// </summary>
    private void RefreshSuggestion()
    {
        _suggested.Clear();
        _candidates = [];

        var level = ActiveLevel;

        if (level is null || _dataSchema is null || _rows.Count == 0)
            return;

        var available = AvailableOrdinals(level);

        var usedKeys =
            _levels
                .Where(x => x.Depth < level.Depth)
                .Select(x => x.KeyColumn)
                .Where(x => x is not null)
                .Select(x => x!.Value)
                .ToList();

        _candidates =
            DataMappingSuggester.RankKeyCandidates(
                _dataSchema,
                _rows,
                available,
                usedKeys);

        var chosen =
            level.KeyColumn is null
                ? _candidates.FirstOrDefault()
                : _candidates.FirstOrDefault(x => x.Ordinal == level.KeyColumn.Value);

        var proposed =
            chosen?.ConstantOrdinals
            ?? DataMappingSuggester.ConstantColumns(_rows, available);

        foreach (var ordinal in proposed)
            _suggested.Add(ordinal);
    }


    private string SuggestLevelName()
    {
        var used =
            _levels
                .Select(x => x.Name)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var candidate = PrefixName();

        if (!string.IsNullOrWhiteSpace(candidate) && used.Add(candidate))
            return candidate;

        var index = _levels.Count;

        while (!used.Add($"nivel{index}"))
            index++;

        return $"nivel{index}";
    }


    /// <summary>
    /// Albaran_codigo y Albaran_fecha sugieren "albaran". Sólo vale si lo
    /// comparten dos columnas: con una sola es casualidad.
    /// </summary>
    private string PrefixName()
    {
        if (_payload is null)
            return string.Empty;

        var free =
            _assignments
                .Where(x => x.Value.LevelPath == IgnorePath)
                .Select(x => x.Key);

        var dominant =
            free
                .Select(ordinal => _payload.Columns[ordinal].Name)
                .Select(PrefixOf)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .GroupBy(x => x, StringComparer.OrdinalIgnoreCase)
                .Where(x => x.Count() >= 2)
                .OrderByDescending(x => x.Count())
                .FirstOrDefault();

        return dominant is null
            ? string.Empty
            : DataMappingSuggester.ToCamelCase(dominant.Key);
    }


    private static string PrefixOf(
        string columnName)
    {
        var separator = columnName.IndexOfAny(['_', '.', '-']);

        return separator > 0
            ? columnName[..separator]
            : string.Empty;
    }


    // ------------------------------------------------------------- columnas

    private async Task ToggleColumnAsync(
        LevelState level,
        int ordinal,
        bool selected)
    {
        _assignments[ordinal].LevelPath =
            selected
                ? level.Path
                : IgnorePath;

        // Quitar del nivel la columna que lo agrupa deja una estructura que
        // no se sostiene, así que la clave se suelta con ella.
        if (!selected && level.KeyColumn == ordinal)
        {
            level.KeyColumn = null;

            RefreshSuggestion();
        }

        await Task.CompletedTask;
    }


    private async Task ApplySuggestionAsync(
        LevelState level)
    {
        foreach (var ordinal in _suggested)
            _assignments[ordinal].LevelPath = level.Path;

        await Task.CompletedTask;
    }


    private async Task SelectAllAsync(
        LevelState level,
        IReadOnlyList<int> available)
    {
        foreach (var ordinal in available)
            _assignments[ordinal].LevelPath = level.Path;

        await Task.CompletedTask;
    }


    private async Task ClearAllAsync(
        LevelState level)
    {
        foreach (var ordinal in ColumnsOf(level))
            _assignments[ordinal].LevelPath = IgnorePath;

        level.KeyColumn = null;

        RefreshSuggestion();

        await Task.CompletedTask;
    }


    private async Task AddRemainingToLevelAsync(
        LevelState level)
    {
        foreach (var assignment in _assignments.Values)
        {
            if (assignment.LevelPath == IgnorePath)
                assignment.LevelPath = level.Path;
        }

        Build();

        await Task.CompletedTask;
    }


    private void FieldNameChanged(
        int ordinal,
        ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        _assignments[ordinal].Name =
            string.IsNullOrWhiteSpace(value)
                ? DataMappingSuggester.ToCamelCase(_payload!.Columns[ordinal].Name)
                : value.Trim();

        Build();
    }


    /// <summary>
    /// Lo que este nivel puede usar: lo libre más lo que ya tiene. Lo que se
    /// colocó arriba no reaparece, que es lo que hace que la lista se vaya
    /// acortando paso a paso.
    ///
    /// Se ordena de menos a más valores distintos. Arriba quedan las que no
    /// cambian nunca, que son las candidatas naturales de este nivel, y
    /// abajo las que cambian en cada fila, que son detalle. El orden del
    /// modelo generado NO sale de aquí: ese sigue siendo el de la consulta.
    /// </summary>
    private List<int> AvailableOrdinals(
        LevelState level) =>
        _assignments
            .Where(x =>
                x.Value.LevelPath == IgnorePath ||
                x.Value.LevelPath == level.Path)
            .Select(x => x.Key)
            .OrderBy(DistinctOf)
            .ThenBy(x => x)
            .ToList();


    private int DistinctOf(
        int ordinal) =>
        _distinct.TryGetValue(ordinal, out var count)
            ? count
            : 0;


    /// <summary>
    /// Columnas que no se han colocado en ningún nivel.
    /// </summary>
    private List<int> UnassignedOrdinals() =>
        _assignments
            .Where(x => x.Value.LevelPath == IgnorePath)
            .Select(x => x.Key)
            .OrderBy(x => x)
            .ToList();


    private List<int> AllOrdinals() =>
        _payload is null
            ? []
            : Enumerable.Range(0, _payload.Columns.Count).ToList();


    private bool IsAssignedTo(
        int ordinal,
        LevelState level) =>
        _assignments.TryGetValue(ordinal, out var assignment) &&
        assignment.LevelPath == level.Path;


    private List<int> ColumnsOf(
        LevelState level) =>
        _assignments
            .Where(x => x.Value.LevelPath == level.Path)
            .Select(x => x.Key)
            .OrderBy(x => x)
            .ToList();


    private string SampleOf(
        int ordinal)
    {
        if (_payload is null || _payload.Rows.Count == 0)
            return string.Empty;

        var value = _payload.Rows[0][ordinal]?.ToString();

        return string.IsNullOrWhiteSpace(value)
            ? "—"
            : value.Length > 32
                ? value[..32] + "…"
                : value;
    }


    private string ColumnClass(
        int ordinal,
        LevelState level)
    {
        var css = "dsrc-column";

        if (IsAssignedTo(ordinal, level))
            css += " is-on";

        if (level.KeyColumn == ordinal)
            css += " is-key";
        else if (_suggested.Contains(ordinal))
            css += " is-suggested";

        return css;
    }


    /// <summary>
    /// Cuántos valores distintos tiene la columna, dicho en palabras. Es el
    /// dato que más ayuda a colocarla: una que no cambia nunca es cabecera,
    /// y una que cambia en cada fila es detalle.
    /// </summary>
    private string CardinalityLabel(
        int ordinal)
    {
        var count = DistinctOf(ordinal);

        if (count <= 1)
            return "siempre igual";

        return count >= _rows.Count
            ? "distinta en cada fila"
            : $"{count} valores";
    }


    private string CardinalityClass(
        int ordinal)
    {
        var count = DistinctOf(ordinal);

        var css = "dsrc-badge";

        if (count <= 1)
            css += " is-constant";
        else if (count >= _rows.Count)
            css += " is-unique";
        else
            css += " is-partial";

        return css;
    }


    private string StepClass(
        WizardStep step,
        int level)
    {
        var css = "dsrc-step";

        if (_step == step && (step != WizardStep.Level || _activeLevel == level))
            css += " is-on";

        return css;
    }


    private void RepathAssignments(
        string previousPath,
        LevelState level)
    {
        // Renombrar un nivel cambia su ruta, así que hay que reapuntar lo
        // que colgaba de ella.
        var newPath = level.Path;

        foreach (var assignment in _assignments.Values)
        {
            if (assignment.LevelPath == previousPath)
                assignment.LevelPath = newPath;
        }
    }


    private static string GetLevelDisplayName(
        LevelState level) =>
        level.Depth == 0
            ? "Documento"
            : string.IsNullOrWhiteSpace(level.Name)
                ? $"nivel{level.Depth}"
                : level.Name;


    private static string GetLevelIcon(
        LevelState level) =>
        level.Depth switch
        {
            0 => "fa-solid fa-file-lines",
            1 => "fa-solid fa-box-archive",
            _ => "fa-solid fa-list-ul"
        };


    private static string Indent(
        LevelState level) =>
        $"margin-left:{level.Depth * 20}px";


    private static bool GetBool(
        object? value) =>
        value is bool boolean && boolean;


    // ---------------------------------------------------------- construcción

    private void Build()
    {
        _error = null;
        _structureWarning = null;
        _documents = [];
        _schema = null;
        _selected = 0;

        if (_payload is null || _payload.Rows.Count == 0)
            return;

        ValidateStructure();

        _mapping = BuildMapping();

        try
        {
            var builder = new HierarchyBuilder();
            var reader = new TabularPayloadDataSet(_payload);
            var documents = new List<JsonElement>();

            var task = Task.Run(async () =>
            {
                await foreach (var document in builder.BuildAsync(reader, _mapping))
                    documents.Add(document);
            });

            task.GetAwaiter().GetResult();

            _documents = documents;
            _schema = DataMappingSchemaFactory.Create(_mapping);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
    }


    /// <summary>
    /// Avisos de estructura que no impiden construir pero casi siempre
    /// significan que algo está mal puesto.
    /// </summary>
    private void ValidateStructure()
    {
        var problems = new List<string>();

        foreach (var level in _levels)
        {
            if (level.KeyColumn is null)
                continue;

            if (!ColumnsOf(level).Contains(level.KeyColumn.Value))
            {
                var name =
                    _payload!.Columns[level.KeyColumn.Value].Name;

                problems.Add(
                    $"La columna '{name}' agrupa " +
                    $"{GetLevelDisplayName(level)} " +
                    "pero está asignada a otro nivel.");
            }
        }

        // Sólo se avisa de las colecciones vacías. Un documento sin campos
        // propios es raro pero legítimo: hay informes que son sólo detalle.
        var empty =
            _levels
                .Where(x => x.Depth > 0 && ColumnsOf(x).Count == 0)
                .Select(GetLevelDisplayName)
                .ToList();

        if (empty.Count > 0)
        {
            problems.Add(
                $"Sin columnas asignadas: {string.Join(", ", empty)}.");
        }

        _structureWarning =
            problems.Count == 0
                ? null
                : string.Join(" ", problems);
    }


    private DataMapping BuildMapping()
    {
        DataMappingNode? root = null;
        DataMappingNode? parent = null;

        foreach (var level in _levels)
        {
            var node =
                new DataMappingNode
                {
                    Name = level.Depth == 0 ? string.Empty : level.Name,

                    Kind = level.Depth == 0
                        ? DataMappingNodeKind.Object
                        : DataMappingNodeKind.Collection,

                    KeyColumns =
                        level.KeyColumn is null
                            ? []
                            : [_payload!.Columns[level.KeyColumn.Value].Name],

                    Fields =
                        ColumnsOf(level)
                            .Select(ordinal =>
                            {
                                var column = _payload!.Columns[ordinal];

                                return new DataMappingField
                                {
                                    Name = _assignments[ordinal].Name,
                                    SourceColumn = column.Name,
                                    Type = column.Type,
                                    Nullable = column.Nullable
                                };
                            })
                            .ToList()
                };

            if (root is null)
                root = node;
            else
                parent!.Children.Add(node);

            parent = node;
        }

        return new DataMapping
        {
            Id = "draft",
            Name = "Mapping",
            Root = root!
        };
    }


    private async Task EmitAsync()
    {
        if (!CanContinue)
            return;

        await OnDatasetReady.InvokeAsync(
            new DatasetResult
            {
                Kind = _kind,
                Schema = _schema!,
                SampleData = _documents[0],
                Documents = _documents,
                Mapping = _mapping,

                RawInput = _kind == DatasetSourceKind.Json
                    ? _json
                    : _raw
            });
    }


    private void Reset()
    {
        _error = null;
        _structureWarning = null;
        _reason = string.Empty;
        _documents = [];
        _schema = null;
        _mapping = null;
        _payload = null;
        _dataSchema = null;
        _rows = [];
        _levels.Clear();
        _assignments.Clear();
        _candidates = [];
        _suggested.Clear();
        _selected = 0;
        _activeLevel = 0;
        _step = WizardStep.Source;
    }


    private static string Pretty(
        JsonElement element) =>
        JsonSerializer.Serialize(element, PrettyOptions);


    private enum WizardStep
    {
        Source,
        Level,
        Review
    }


    private sealed class LevelState
    {
        public required int Depth { get; init; }

        public string Name { get; set; } = string.Empty;

        /// <summary>
        /// Posición de la columna que agrupa este nivel. Nula significa que
        /// cada fila es un elemento.
        /// </summary>
        public int? KeyColumn { get; set; }

        /// <summary>
        /// Ruta en el modelo. La raíz es cadena vacía.
        /// </summary>
        public string Path =>
            Depth == 0
                ? string.Empty
                : Name;
    }


    private sealed class Assignment
    {
        public string LevelPath { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;
    }
}
