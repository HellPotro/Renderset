@using System.Text.Json
@using Microsoft.JSInterop
@using Renderset.Core.DataSources
@using Renderset.Core.Mapping
@using Renderset.Core.Reports
@using Renderset.Core.Reports.Inference
@inject IJSRuntime JS


<div class="dsrc">

    <div class="dsrc-head">

        <div class="dsrc-segmented">

            <button type="button"
                    class="@(_kind == DatasetSourceKind.Json ? "is-on" : "")"
                    @onclick="() => SwitchTo(DatasetSourceKind.Json)">
                <i class="fa-solid fa-code"></i>
                JSON
            </button>

            <button type="button"
                    class="@(_kind == DatasetSourceKind.Tabular ? "is-on" : "")"
                    @onclick="() => SwitchTo(DatasetSourceKind.Tabular)">
                <i class="fa-solid fa-table"></i>
                SQL / CSV
            </button>

        </div>

        <p class="dsrc-hint">
            @(_kind == DatasetSourceKind.Json
                ? "Pega un documento de ejemplo con la estructura que ya usa tu sistema."
                : "Pega el resultado de tu consulta tal cual. Desde SSMS, copia la rejilla con cabeceras.")
        </p>

        <button type="button"
                class="dsrc-example"
                @onclick="LoadExample">
            <i class="fa-solid fa-flask"></i>
            Ejemplo
        </button>

    </div>


    @if (_kind == DatasetSourceKind.Json)
    {
        <textarea class="dsrc-input"
                  rows="@Rows"
                  spellcheck="false"
                  value="@_json"
                  @onchange="JsonChanged"></textarea>
    }
    else
    {
        <textarea class="dsrc-input"
                  rows="@Rows"
                  spellcheck="false"
                  value="@_raw"
                  @onchange="RawChanged"
                  placeholder="Factura&#9;Cliente&#9;Albaran_codigo&#9;Articulo&#9;Cantidad"></textarea>

        @if (_payload is not null && _payload.Rows.Count > 0)
        {
            <div class="dsrc-panel">

                <div class="dsrc-panel-head">

                    <span class="dsrc-metric">
                        <strong>@_payload.Rows.Count</strong> filas
                    </span>

                    <span class="dsrc-metric">
                        <strong>@_payload.Columns.Count</strong> columnas
                    </span>

                    <i class="fa-solid fa-arrow-right-long"></i>

                    <span class="dsrc-metric is-result">
                        <strong>@_documents.Count</strong>
                        documento@(_documents.Count == 1 ? "" : "s")
                    </span>

                    @if (_levels.Count > 1)
                    {
                        <span class="dsrc-metric">
                            <strong>@(_levels.Count - 1)</strong>
                            nivel@(_levels.Count - 1 == 1 ? "" : "es") anidado@(_levels.Count - 1 == 1 ? "" : "s")
                        </span>
                    }

                </div>


                @* ---------------------------------------- estructura ----- *@

                <div class="dsrc-field">

                    <label>Estructura</label>

                    <div class="dsrc-levels">

                        @foreach (var level in _levels)
                        {
                            <div class="dsrc-level"
                                 style="@Indent(level)">

                                <span class="dsrc-level-icon">
                                    @if (level.Depth == 0)
                                    {
                                        <i class="fa-solid fa-file-lines"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-layer-group"></i>
                                    }
                                </span>

                                @if (level.Depth == 0)
                                {
                                    <span class="dsrc-level-name is-root">
                                        Documento
                                    </span>
                                }
                                else
                                {
                                    <input class="dsrc-level-name"
                                           value="@level.Name"
                                           @onchange="e => LevelNameChanged(level, e)" />

                                    <span class="dsrc-level-tag">array</span>
                                }

                                <span class="dsrc-level-key">
                                    <label>Agrupar por</label>

                                    <select value="@(level.KeyColumn?.ToString() ?? "")"
                                            @onchange="e => LevelKeyChanged(level, e)">

                                        <option value="">
                                            @(level.Depth == 0
                                                ? "— (un solo documento)"
                                                : "— (una fila = un elemento)")
                                        </option>

                                        @foreach (var ordinal in ColumnsOf(level))
                                        {
                                            <option value="@ordinal">
                                                @_payload.Columns[ordinal].Name
                                            </option>
                                        }

                                    </select>
                                </span>

                                <span class="dsrc-level-count">
                                    @ColumnsOf(level).Count col.
                                </span>

                                @if (level.Depth > 0 && level == _levels[^1])
                                {
                                    <button type="button"
                                            class="dsrc-level-remove"
                                            title="Quitar este nivel y subir sus columnas"
                                            @onclick="RemoveDeepestLevel">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                }

                            </div>
                        }

                        <button type="button"
                                class="dsrc-level-add"
                                @onclick="AddLevel">
                            <i class="fa-solid fa-plus"></i>
                            Añadir nivel dentro de @(_levels[^1].Depth == 0 ? "el documento" : _levels[^1].Name)
                        </button>

                    </div>

                </div>


                @if (!string.IsNullOrWhiteSpace(_structureWarning))
                {
                    <div class="dsrc-warn">
                        @_structureWarning
                    </div>
                }


                <div class="dsrc-panel-foot">

                    <span class="dsrc-reason">
                        @_reason
                    </span>

                    <div class="dsrc-links">

                        <button type="button"
                                class="dsrc-link"
                                @onclick="() => _showColumns = !_showColumns">
                            <i class="@(_showColumns ? "fa-solid fa-chevron-up" : "fa-solid fa-sliders")"></i>
                            Asignar columnas
                        </button>

                        @if (ShowPreview && _documents.Count > 0)
                        {
                            <button type="button"
                                    class="dsrc-link"
                                    @onclick="OpenPreviewModal">
                                <i class="fa-solid fa-code"></i>
                                Ver modelo
                            </button>
                        }

                    </div>

                </div>


                @* ---------------------------------------- columnas ------- *@

                @if (_showColumns)
                {
                    <div class="dsrc-column-designer is-simplified">

                        <div class="dsrc-column-toolbar is-simplified">

                            <div class="dsrc-column-search">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                <input type="search"
                                       value="@_columnSearch"
                                       @oninput="ColumnSearchChanged"
                                       placeholder="Buscar columnas..." />
                            </div>

                            <div class="dsrc-column-sort">
                                <label>Orden</label>
                                <select value="@_columnSort"
                                        @onchange="ColumnSortChanged">
                                    <option value="@ColumnSortMode.Original">Original</option>
                                    <option value="@ColumnSortMode.Alphabetical">A-Z</option>
                                    <option value="@ColumnSortMode.Type">Tipo</option>
                                </select>
                            </div>

                            <label class="dsrc-compact-toggle">
                                <input type="checkbox"
                                       checked="@_compactColumns"
                                       @onchange="e => _compactColumns = GetBool(e.Value)" />
                                Compacto
                            </label>

                        </div>

                        <div class="dsrc-bulkbar is-simplified">

                            <div class="dsrc-selection-summary">
                                <strong>@_selectedColumns.Count</strong>
                                seleccionada@(_selectedColumns.Count == 1 ? "" : "s")

                                @if (TotalVisibleColumns != _payload.Columns.Count)
                                {
                                    <span>
                                        · @TotalVisibleColumns visible@((TotalVisibleColumns == 1) ? "" : "s")
                                    </span>
                                }
                            </div>

                            <div class="dsrc-bulk-actions">

                                <button type="button"
                                        class="dsrc-mini-button"
                                        disabled="@(TotalVisibleColumns == 0)"
                                        @onclick="SelectVisibleColumns">
                                    Seleccionar visibles
                                </button>

                                <button type="button"
                                        class="dsrc-mini-button"
                                        disabled="@(_selectedColumns.Count == 0)"
                                        @onclick="ClearSelectedColumns">
                                    Limpiar
                                </button>

                                <button type="button"
                                        class="dsrc-assign-button"
                                        disabled="@(_selectedColumns.Count == 0)"
                                        @onclick="OpenMoveColumnsModal">
                                    <i class="fa-solid fa-arrow-right-arrow-left"></i>
                                    Mover a nivel
                                </button>

                            </div>

                        </div>

                        <div class="dsrc-column-groups">
                            @foreach (var group in GetColumnGroups())
                            {
                                <section class="@GetColumnGroupClass(group)"
                                         @key="group.Path">

                                    <header class="dsrc-column-group-head">

                                        <div class="dsrc-column-group-title">
                                            <span class="dsrc-column-group-icon">
                                                <i class="@group.Icon"></i>
                                            </span>

                                            <div>
                                                <strong>@group.Label</strong>
                                                <span>@GetGroupDescription(group)</span>
                                            </div>
                                        </div>

                                        <div class="dsrc-column-group-actions">
                                            <span>@group.Ordinals.Count columna@(group.Ordinals.Count == 1 ? "" : "s")</span>

                                            <button type="button"
                                                    disabled="@(group.Ordinals.Count == 0)"
                                                    @onclick="() => SelectGroupColumns(group)">
                                                Seleccionar
                                            </button>
                                        </div>

                                    </header>

                                    @if (group.Ordinals.Count == 0)
                                    {
                                        <div class="dsrc-column-empty">
                                            No hay columnas en este nivel con el filtro actual.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="@GetColumnGridClass()">
                                            @foreach (var ordinal in group.Ordinals)
                                            {
                                                var column = _payload.Columns[ordinal];
                                                var assignment = _assignments[ordinal];

                                                <article class="@GetColumnCardClass(ordinal)"
                                                         @key="ordinal">

                                                    <label class="dsrc-column-check"
                                                           title="Seleccionar columna">
                                                        <input type="checkbox"
                                                               checked="@_selectedColumns.Contains(ordinal)"
                                                               @onchange="e => ToggleColumnSelection(ordinal, GetBool(e.Value))" />
                                                        <span></span>
                                                    </label>

                                                    <div class="dsrc-column-card-main">

                                                        <div class="dsrc-column-card-top">
                                                            <code title="@column.Name">@column.Name</code>

                                                            @if (IsKeyColumn(ordinal))
                                                            {
                                                                <span class="dsrc-key">clave</span>
                                                            }

                                                            <em>@column.Type</em>
                                                        </div>

                                                        <div class="dsrc-column-card-meta">
                                                            <span>Modelo</span>
                                                            <strong title="@assignment.Name">@assignment.Name</strong>
                                                        </div>

                                                    </div>

                                                    <div class="dsrc-column-card-actions">
                                                        <button type="button"
                                                                class="dsrc-icon-button"
                                                                title="Editar nombre o nivel"
                                                                @onclick="() => OpenColumnEditor(ordinal)">
                                                            <i class="fa-solid fa-pen"></i>
                                                        </button>
                                                    </div>

                                                </article>
                                            }
                                        </div>
                                    }

                                </section>
                            }
                        </div>

                    </div>
                }


            </div>
        }
    }


    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="dsrc-error">
            @_error
        </div>
    }


    @if (ShowPreview && _kind == DatasetSourceKind.Json && _documents.Count > 0)
    {
        <button type="button"
                class="dsrc-link dsrc-preview-open"
                @onclick="OpenPreviewModal">
            <i class="fa-solid fa-code"></i>
            Ver modelo resultante
        </button>
    }


    @if (_showPreview && ShowPreview && _documents.Count > 0)
    {
        <div class="dsrc-modal-backdrop"
             @onclick="ClosePreviewModal">

            <section class="dsrc-modal dsrc-preview-modal"
                     @onclick:stopPropagation="true">

                <header class="dsrc-modal-head">
                    <div>
                        <strong>Modelo generado</strong>
                        <span>Previsualización del JSON que recibirá el diseñador.</span>
                    </div>

                    <button type="button"
                            class="dsrc-modal-close"
                            @onclick="ClosePreviewModal">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </header>

                @if (_documents.Count > 1)
                {
                    <div class="dsrc-doc-tabs">
                        @for (var i = 0; i < Math.Min(_documents.Count, 12); i++)
                        {
                            var index = i;

                            <button type="button"
                                    class="@(index == _selected ? "is-on" : "")"
                                    @onclick="() => _selected = index">
                                @(index + 1)
                            </button>
                        }
                    </div>
                }

                <pre class="dsrc-json dsrc-json-modal">@Pretty(_documents[SafeSelectedIndex])</pre>

                <footer class="dsrc-modal-actions">
                    <button type="button"
                            class="dsrc-mini-button"
                            @onclick="CopyCurrentPreviewAsync">
                        <i class="fa-solid fa-copy"></i>
                        Copiar JSON
                    </button>

                    <button type="button"
                            class="dsrc-assign-button"
                            @onclick="ClosePreviewModal">
                        Cerrar
                    </button>
                </footer>

            </section>

        </div>
    }


    @if (_showMoveModal)
    {
        <div class="dsrc-modal-backdrop"
             @onclick="CloseMoveColumnsModal">

            <section class="dsrc-modal dsrc-move-modal"
                     @onclick:stopPropagation="true">

                <header class="dsrc-modal-head">
                    <div>
                        <strong>Mover columnas</strong>
                        <span>@_selectedColumns.Count columna@(_selectedColumns.Count == 1 ? "" : "s") seleccionada@(_selectedColumns.Count == 1 ? "" : "s")</span>
                    </div>

                    <button type="button"
                            class="dsrc-modal-close"
                            @onclick="CloseMoveColumnsModal">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </header>

                <div class="dsrc-target-grid">
                    @foreach (var target in AssignmentTargets())
                    {
                        <button type="button"
                                class="@GetTargetCardClass(target)"
                                @onclick="() => AssignSelectedFromModal(target.Path)">
                            <i class="@target.Icon"></i>
                            <strong>@target.Label</strong>
                            <span>@GetTargetDescription(target)</span>
                        </button>
                    }
                </div>

            </section>

        </div>
    }


    @if (_editingColumnOrdinal is not null &&
         _payload is not null &&
         _editingColumnOrdinal.Value >= 0 &&
         _editingColumnOrdinal.Value < _payload.Columns.Count)
    {
        var editingOrdinal = _editingColumnOrdinal.Value;
        var editingColumn = _payload.Columns[editingOrdinal];

        <div class="dsrc-modal-backdrop"
             @onclick="CloseColumnEditor">

            <section class="dsrc-modal dsrc-column-edit-modal"
                     @onclick:stopPropagation="true">

                <header class="dsrc-modal-head">
                    <div>
                        <strong>Configurar columna</strong>
                        <span>@editingColumn.Name · @editingColumn.Type</span>
                    </div>

                    <button type="button"
                            class="dsrc-modal-close"
                            @onclick="CloseColumnEditor">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </header>

                <div class="dsrc-edit-form">

                    <label>
                        Nombre en el modelo
                        <input value="@_editingColumnName"
                               @oninput="e => _editingColumnName = e.Value?.ToString() ?? string.Empty" />
                    </label>

                    <label>
                        Nivel
                        <select value="@_editingColumnLevelPath"
                                @onchange="e => _editingColumnLevelPath = e.Value?.ToString() ?? string.Empty">
                            @foreach (var target in AssignmentTargets())
                            {
                                <option value="@target.Path">
                                    @target.Label
                                </option>
                            }
                        </select>
                    </label>

                    @if (IsKeyColumn(editingOrdinal))
                    {
                        <div class="dsrc-warn is-compact">
                            Esta columna se está usando como clave de agrupación. Si la mueves a otro nivel, revisa la estructura.
                        </div>
                    }

                </div>

                <footer class="dsrc-modal-actions">
                    <button type="button"
                            class="dsrc-mini-button"
                            @onclick="CloseColumnEditor">
                        Cancelar
                    </button>

                    <button type="button"
                            class="dsrc-assign-button"
                            @onclick="SaveColumnEditor">
                        Guardar cambios
                    </button>
                </footer>

            </section>

        </div>
    }


    <div class="dsrc-actions">

        @ChildContent

        <button type="button"
                class="primary-button"
                disabled="@(!CanContinue)"
                @onclick="EmitAsync">
            <i class="fa-solid fa-arrow-right"></i>
            @ContinueText
        </button>

    </div>

</div>


@code {

    private const string IgnorePath = "\u0000ignore";

    private static readonly JsonSerializerOptions PrettyOptions =
        new() { WriteIndented = true };

    [Parameter, EditorRequired]
    public EventCallback<DatasetResult> OnDatasetReady { get; set; }

    [Parameter]
    public string ContinueText { get; set; } = "Continuar";

    [Parameter]
    public int Rows { get; set; } = 8;

    [Parameter]
    public bool ShowPreview { get; set; } = true;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private DatasetSourceKind _kind = DatasetSourceKind.Json;

    private string _json = string.Empty;
    private string _raw = string.Empty;
    private string? _error;
    private string? _structureWarning;
    private string _reason = string.Empty;

    private TabularPayload? _payload;

    /// <summary>
    /// Cadena lineal de niveles: documento → albaran → lines. Cada uno es
    /// hijo del anterior.
    ///
    /// El modelo (DataMappingNode) admite hermanos, pero la pantalla no los
    /// ofrece todavía: el caso de "líneas sueltas además de albaranes" hay
    /// que montarlo a mano por ahora.
    /// </summary>
    private readonly List<LevelState> _levels = [];

    /// <summary>
    /// Indexado por POSICIÓN de columna, no por nombre. Una consulta con
    /// JOINs trae nombres repetidos (Referencia del pedido y Referencia del
    /// artículo) y un diccionario por nombre los machaca.
    /// </summary>
    private readonly Dictionary<int, Assignment> _assignments = [];

    private List<JsonElement> _documents = [];
    private ReportDataSchema? _schema;
    private DataMapping? _mapping;

    private int _selected;
    private bool _showColumns;
    private bool _showPreview;

    private readonly HashSet<int> _selectedColumns = [];
    private string _columnSearch = string.Empty;
    private ColumnSortMode _columnSort = ColumnSortMode.Original;
    private bool _compactColumns;
    private string _targetLevelPath = string.Empty;
    private bool _showMoveModal;
    private int? _editingColumnOrdinal;
    private string _editingColumnName = string.Empty;
    private string _editingColumnLevelPath = string.Empty;


    private int TotalVisibleColumns =>
        _payload is null
            ? 0
            : GetVisibleColumnOrdinals().Count;



    private int SafeSelectedIndex =>
        _documents.Count == 0
            ? 0
            : Math.Clamp(_selected, 0, _documents.Count - 1);

    private bool CanContinue =>
        _documents.Count > 0 &&
        _schema is not null;


    // -------------------------------------------------------------- entrada

    private void SwitchTo(
        DatasetSourceKind kind)
    {
        _kind = kind;
        _error = null;

        Reset();

        if (kind == DatasetSourceKind.Json)
            AnalyzeJson();
        else
            AnalyzeTabular();
    }


    private void JsonChanged(
        ChangeEventArgs e)
    {
        _json = e.Value?.ToString() ?? string.Empty;

        AnalyzeJson();
    }


    private void RawChanged(
        ChangeEventArgs e)
    {
        _raw = e.Value?.ToString() ?? string.Empty;

        AnalyzeTabular();
    }


    private void LoadExample()
    {
        if (_kind == DatasetSourceKind.Json)
        {
            _json =
                """
                {
                  "number": "10001",
                  "customer": { "code": "000123", "name": "Ford España" },
                  "lines": [
                    { "reference": "A001", "quantity": 5, "price": 20.00 }
                  ]
                }
                """;

            AnalyzeJson();

            return;
        }

        // Dos albaranes dentro de una factura: el caso de dos niveles.
        _raw =
            "Factura\tCliente\tNombre\tAlbaran_codigo\tAlbaran_fecha\tArticulo\tDescripcion\tCantidad\tPrecio\n" +
            "060098\t002532\tGestamp Esmar\t001148\t2026-06-03\tGBA02101\tSill Inner LH.\t56\t33,3562\n" +
            "060098\t002532\tGestamp Esmar\t001148\t2026-06-03\tGBA02102\tSill Inner RH.\t56\t33,3562\n" +
            "060098\t002532\tGestamp Esmar\t001310\t2026-06-17\tGBA01101\tAssy Cantrail LH.\t240\t13,739\n" +
            "060098\t002532\tGestamp Esmar\t001310\t2026-06-17\tGBA01102\tAssy Cantrail RH.\t240\t13,739";

        AnalyzeTabular();
    }


    // ------------------------------------------------------------- análisis

    private void AnalyzeJson()
    {
        Reset();

        if (string.IsNullOrWhiteSpace(_json))
            return;

        try
        {
            using var document = JsonDocument.Parse(_json);

            var data = document.RootElement.Clone();

            _schema = JsonSchemaInferer.Infer(data);
            _documents = [data];
            _mapping = null;
        }
        catch (JsonException exception)
        {
            _error = $"El JSON no es válido: {exception.Message}";
        }
    }


    private void AnalyzeTabular()
    {
        Reset();

        if (string.IsNullOrWhiteSpace(_raw))
            return;

        try
        {
            _payload = DelimitedTextParser.Parse(_raw);
        }
        catch (Exception exception)
        {
            _error = exception.Message;

            return;
        }

        if (_payload.Rows.Count == 0)
        {
            _error = "No se ha encontrado ninguna fila de datos.";

            return;
        }

        var schema = _payload.ToSchema();

        var rows =
            _payload.Rows
                .Select(row => row.ToArray())
                .ToList();

        var suggestion =
            DataMappingSuggester.Suggest(schema, rows);

        _reason = suggestion.Reason;

        ApplySuggestion(schema, suggestion);

        Build();
    }


    /// <summary>
    /// Traduce los niveles sugeridos al estado editable de la pantalla.
    /// </summary>
    private void ApplySuggestion(
        DataSetSchema schema,
        DataMappingSuggestion suggestion)
    {
        _levels.Clear();
        _assignments.Clear();

        var depth = 0;

        foreach (var level in suggestion.Levels)
        {
            _levels.Add(
                new LevelState
                {
                    Depth = depth,
                    Name = level.Name,

                    KeyColumn = level.KeyColumn is null
                        ? null
                        : schema.IndexOf(level.KeyColumn)
                });

            depth++;
        }

        if (_levels.Count == 0)
        {
            _levels.Add(
                new LevelState
                {
                    Depth = 0,
                    Name = string.Empty
                });
        }

        // Asignación por defecto: cada columna al nivel donde el sugeridor la
        // dejó constante.
        for (var ordinal = 0; ordinal < schema.Columns.Count; ordinal++)
        {
            var name = schema.Columns[ordinal].Name;

            var levelIndex =
                suggestion.Levels
                    .Select((level, index) => (level, index))
                    .Where(x => x.level.Columns.Contains(name))
                    .Select(x => x.index)
                    .DefaultIfEmpty(_levels.Count - 1)
                    .First();

            _assignments[ordinal] =
                new Assignment
                {
                    LevelPath = _levels[Math.Min(levelIndex, _levels.Count - 1)].Path,
                    Name = DataMappingSuggester.ToCamelCase(name)
                };
        }

        _targetLevelPath = _levels.LastOrDefault()?.Path ?? string.Empty;
        _selectedColumns.Clear();
    }


    // -------------------------------------------------------------- niveles

    private void LevelNameChanged(
        LevelState level,
        ChangeEventArgs e)
    {
        var previousPath = level.Path;

        var value = e.Value?.ToString();

        level.Name =
            string.IsNullOrWhiteSpace(value)
                ? level.Name
                : DataMappingSuggester.ToCamelCase(value.Trim());

        RepathAssignments(previousPath, level);

        if (_targetLevelPath == previousPath)
            _targetLevelPath = level.Path;

        Build();
    }


    private void LevelKeyChanged(
        LevelState level,
        ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        level.KeyColumn =
            string.IsNullOrWhiteSpace(value)
                ? null
                : int.Parse(value);

        Build();
    }


    private void AddLevel()
    {
        var parent = _levels[^1];

        _levels.Add(
            new LevelState
            {
                Depth = parent.Depth + 1,
                Name = $"nivel{parent.Depth + 1}"
            });

        _targetLevelPath = _levels[^1].Path;

        Build();
    }


    /// <summary>
    /// Al quitar el nivel más profundo, sus columnas suben al padre en vez de
    /// perderse.
    /// </summary>
    private void RemoveDeepestLevel()
    {
        if (_levels.Count <= 1)
            return;

        var removed = _levels[^1];
        var parent = _levels[^2];

        _levels.RemoveAt(_levels.Count - 1);

        foreach (var assignment in _assignments.Values)
        {
            if (assignment.LevelPath == removed.Path)
                assignment.LevelPath = parent.Path;
        }

        if (_targetLevelPath == removed.Path)
            _targetLevelPath = parent.Path;

        _selectedColumns.Clear();

        Build();
    }


    private void LevelAssigned(
        int ordinal,
        ChangeEventArgs e)
    {
        _assignments[ordinal].LevelPath =
            e.Value?.ToString() ?? _levels[0].Path;

        Build();
    }


    private void NameChanged(
        int ordinal,
        ChangeEventArgs e)
    {
        _assignments[ordinal].Name =
            e.Value?.ToString() ?? string.Empty;

        Build();
    }


    // ------------------------------------------------------------- columnas

    private void ColumnSearchChanged(
        ChangeEventArgs e)
    {
        _columnSearch = e.Value?.ToString() ?? string.Empty;

        PruneSelectedColumns();
    }


    private void ColumnSortChanged(
        ChangeEventArgs e)
    {
        if (Enum.TryParse<ColumnSortMode>(
                e.Value?.ToString(),
                out var mode))
        {
            _columnSort = mode;
        }
    }


    private void TargetLevelChanged(
        ChangeEventArgs e)
    {
        _targetLevelPath = e.Value?.ToString() ?? string.Empty;

        EnsureValidTargetLevel();
    }


    private void ToggleColumnSelection(
        int ordinal,
        bool selected)
    {
        if (selected)
            _selectedColumns.Add(ordinal);
        else
            _selectedColumns.Remove(ordinal);
    }


    private void SelectVisibleColumns()
    {
        foreach (var ordinal in GetVisibleColumnOrdinals())
            _selectedColumns.Add(ordinal);
    }


    private void SelectGroupColumns(
        ColumnGroup group)
    {
        foreach (var ordinal in group.Ordinals)
            _selectedColumns.Add(ordinal);
    }


    private void ClearSelectedColumns()
    {
        _selectedColumns.Clear();
    }


    private void AssignSelectedToTarget()
    {
        AssignSelectedTo(_targetLevelPath);
    }


    private void AssignSelectedTo(
        string levelPath)
    {
        if (_selectedColumns.Count == 0)
            return;

        if (!AssignmentTargets().Any(x => x.Path == levelPath))
            levelPath = string.Empty;

        foreach (var ordinal in _selectedColumns.ToList())
        {
            if (!_assignments.TryGetValue(ordinal, out var assignment))
                continue;

            assignment.LevelPath = levelPath;
        }

        _targetLevelPath = levelPath;
        _selectedColumns.Clear();

        Build();
    }




    private void OpenPreviewModal()
    {
        if (_documents.Count == 0)
            return;

        _showPreview = true;
    }


    private void ClosePreviewModal()
    {
        _showPreview = false;
    }


    private async Task CopyCurrentPreviewAsync()
    {
        if (_documents.Count == 0)
            return;

        await JS.InvokeVoidAsync(
            "navigator.clipboard.writeText",
            Pretty(_documents[SafeSelectedIndex]));
    }


    private void OpenMoveColumnsModal()
    {
        if (_selectedColumns.Count == 0)
            return;

        EnsureValidTargetLevel();

        _showMoveModal = true;
    }


    private void CloseMoveColumnsModal()
    {
        _showMoveModal = false;
    }


    private void AssignSelectedFromModal(
        string levelPath)
    {
        AssignSelectedTo(levelPath);

        _showMoveModal = false;
    }


    private void OpenColumnEditor(
        int ordinal)
    {
        if (_payload is null ||
            !_assignments.TryGetValue(ordinal, out var assignment))
        {
            return;
        }

        _editingColumnOrdinal = ordinal;
        _editingColumnName = assignment.Name;
        _editingColumnLevelPath = assignment.LevelPath;
    }


    private void CloseColumnEditor()
    {
        _editingColumnOrdinal = null;
        _editingColumnName = string.Empty;
        _editingColumnLevelPath = string.Empty;
    }


    private void SaveColumnEditor()
    {
        if (_payload is null || _editingColumnOrdinal is null)
            return;

        var ordinal = _editingColumnOrdinal.Value;

        if (!_assignments.TryGetValue(ordinal, out var assignment))
            return;

        assignment.Name = string.IsNullOrWhiteSpace(_editingColumnName)
            ? DataMappingSuggester.ToCamelCase(_payload.Columns[ordinal].Name)
            : _editingColumnName.Trim();

        assignment.LevelPath = AssignmentTargets().Any(x => x.Path == _editingColumnLevelPath)
            ? _editingColumnLevelPath
            : string.Empty;

        CloseColumnEditor();

        Build();
    }
    private void EnsureValidTargetLevel()
    {
        if (AssignmentTargets().Any(x => x.Path == _targetLevelPath))
            return;

        _targetLevelPath = _levels.LastOrDefault()?.Path ?? string.Empty;
    }


    private void PruneSelectedColumns()
    {
        if (_payload is null)
        {
            _selectedColumns.Clear();
            return;
        }

        var visible =
            GetVisibleColumnOrdinals()
                .ToHashSet();

        _selectedColumns.RemoveWhere(x => !visible.Contains(x));
    }


    private List<int> GetVisibleColumnOrdinals()
    {
        if (_payload is null)
            return [];

        return SortColumnOrdinals(
                Enumerable.Range(0, _payload.Columns.Count)
                    .Where(ColumnMatchesSearch))
            .ToList();
    }


    private List<int> GetVisibleColumnOrdinalsForPath(
        string path)
    {
        return SortColumnOrdinals(
                _assignments
                    .Where(x => x.Value.LevelPath == path)
                    .Select(x => x.Key)
                    .Where(ColumnMatchesSearch))
            .ToList();
    }


    private IEnumerable<int> SortColumnOrdinals(
        IEnumerable<int> ordinals)
    {
        if (_payload is null)
            return [];

        return _columnSort switch
        {
            ColumnSortMode.Alphabetical =>
                ordinals
                    .OrderBy(x => _payload.Columns[x].Name, StringComparer.OrdinalIgnoreCase)
                    .ThenBy(x => x),

            ColumnSortMode.Type =>
                ordinals
                    .OrderBy(x => _payload.Columns[x].Type.ToString(), StringComparer.OrdinalIgnoreCase)
                    .ThenBy(x => _payload.Columns[x].Name, StringComparer.OrdinalIgnoreCase)
                    .ThenBy(x => x),

            _ =>
                ordinals.OrderBy(x => x)
        };
    }


    private bool ColumnMatchesSearch(
        int ordinal)
    {
        if (_payload is null)
            return false;

        if (string.IsNullOrWhiteSpace(_columnSearch))
            return true;

        var search = _columnSearch.Trim();

        var column = _payload.Columns[ordinal];
        var assignment = _assignments[ordinal];
        var level = FindLevelByPath(assignment.LevelPath);

        return Contains(column.Name, search) ||
               Contains(assignment.Name, search) ||
               Contains(column.Type.ToString(), search) ||
               Contains(level is null ? "Ignorar" : GetLevelDisplayName(level), search);
    }


    private List<ColumnGroup> GetColumnGroups()
    {
        var groups = new List<ColumnGroup>();

        foreach (var level in _levels)
        {
            groups.Add(
                new ColumnGroup
                {
                    Path = level.Path,
                    Label = GetLevelDisplayName(level),
                    Icon = GetLevelIcon(level),
                    Depth = level.Depth,
                    IsIgnored = false,
                    Ordinals = GetVisibleColumnOrdinalsForPath(level.Path)
                });
        }

        var ignored =
            GetVisibleColumnOrdinalsForPath(IgnorePath);

        if (ignored.Count > 0 || _assignments.Values.Any(x => x.LevelPath == IgnorePath))
        {
            groups.Add(
                new ColumnGroup
                {
                    Path = IgnorePath,
                    Label = "Ignorar",
                    Icon = "fa-solid fa-eye-slash",
                    Depth = _levels.Count,
                    IsIgnored = true,
                    Ordinals = ignored
                });
        }

        return groups;
    }


    private IReadOnlyList<AssignmentTarget> AssignmentTargets()
    {
        var targets =
            _levels
                .Select(level =>
                    new AssignmentTarget
                    {
                        Path = level.Path,
                        Label = GetLevelDisplayName(level),
                        Icon = GetLevelIcon(level),
                        IsIgnored = false
                    })
                .ToList();

        targets.Add(
            new AssignmentTarget
            {
                Path = IgnorePath,
                Label = "Ignorar",
                Icon = "fa-solid fa-eye-slash",
                IsIgnored = true
            });

        return targets;
    }


    private LevelState? FindLevelByPath(
        string path) =>
        _levels.FirstOrDefault(x => x.Path == path);


    private string GetLevelDisplayName(
        LevelState level) =>
        level.Depth == 0
            ? "Documento"
            : level.Name;


    private static string GetLevelIcon(
        LevelState level) =>
        level.Depth switch
        {
            0 => "fa-solid fa-file-lines",
            1 => "fa-solid fa-box-archive",
            _ => "fa-solid fa-list-ul"
        };


    private static string GetGroupDescription(
        ColumnGroup group)
    {
        if (group.IsIgnored)
            return "No se incluirán en el modelo generado";

        return group.Depth switch
        {
            0 => "Campos únicos del documento",
            1 => "Primera colección agrupada",
            _ => "Colección anidada de detalle"
        };
    }


    private static string GetColumnGroupClass(
        ColumnGroup group)
    {
        var css = "dsrc-column-group";

        if (group.IsIgnored)
            css += " is-ignored";
        else if (group.Depth == 0)
            css += " is-root";
        else if (group.Depth == 1)
            css += " is-level-one";
        else
            css += " is-level-deep";

        return css;
    }


    private string GetColumnGridClass() =>
        _compactColumns
            ? "dsrc-column-grid is-compact"
            : "dsrc-column-grid";


    private string GetColumnCardClass(
        int ordinal)
    {
        var css = "dsrc-column-card";

        if (_selectedColumns.Contains(ordinal))
            css += " is-selected";

        if (_assignments.TryGetValue(ordinal, out var assignment) &&
            assignment.LevelPath == IgnorePath)
        {
            css += " is-ignored";
        }

        if (IsKeyColumn(ordinal))
            css += " is-key";

        return css;
    }


    private static string GetQuickTargetClass(
        AssignmentTarget target)
    {
        var css = "dsrc-quick-target";

        if (target.IsIgnored)
            css += " is-ignore";

        return css;
    }




    private static string GetTargetCardClass(
        AssignmentTarget target)
    {
        var css = "dsrc-target-card";

        if (target.IsIgnored)
            css += " is-ignore";

        return css;
    }


    private static string GetTargetDescription(
        AssignmentTarget target)
    {
        if (target.IsIgnored)
            return "Excluir del modelo";

        return target.Label == "Documento"
            ? "Campo único de cabecera"
            : "Colección del modelo";
    }
    private static bool Contains(
        string? source,
        string value) =>
        !string.IsNullOrWhiteSpace(source) &&
        source.Contains(value, StringComparison.OrdinalIgnoreCase);


    private static bool GetBool(
        object? value) =>
        value is bool boolean && boolean;


    private void RepathAssignments(
        string previousPath,
        LevelState level)
    {
        // Renombrar un nivel cambia su ruta y la de sus descendientes, así
        // que hay que reapuntar lo que colgaba de ellos.
        var newPath = level.Path;

        foreach (var assignment in _assignments.Values)
        {
            if (assignment.LevelPath == previousPath)
                assignment.LevelPath = newPath;
        }
    }


    private List<int> ColumnsOf(
        LevelState level) =>
        _assignments
            .Where(x => x.Value.LevelPath == level.Path)
            .Select(x => x.Key)
            .OrderBy(x => x)
            .ToList();


    private bool IsKeyColumn(
        int ordinal) =>
        _levels.Any(x => x.KeyColumn == ordinal);


    private static string Indent(
        LevelState level) =>
        $"margin-left:{level.Depth * 22}px";


    // ---------------------------------------------------------- construcción

    private void Build()
    {
        _error = null;
        _structureWarning = null;
        _documents = [];
        _schema = null;
        _selected = 0;

        if (_payload is null || _payload.Rows.Count == 0)
            return;

        ValidateStructure();

        _mapping = BuildMapping();

        try
        {
            var builder = new HierarchyBuilder();
            var reader = new TabularPayloadDataSet(_payload);
            var documents = new List<JsonElement>();

            var task = Task.Run(async () =>
            {
                await foreach (var document in builder.BuildAsync(reader, _mapping))
                    documents.Add(document);
            });

            task.GetAwaiter().GetResult();

            _documents = documents;
            _schema = DataMappingSchemaFactory.Create(_mapping);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
    }


    /// <summary>
    /// Avisos de estructura que no impiden construir pero casi siempre
    /// significan que algo está mal puesto.
    /// </summary>
    private void ValidateStructure()
    {
        var problems = new List<string>();

        foreach (var level in _levels)
        {
            if (level.KeyColumn is null)
                continue;

            var assigned = ColumnsOf(level);

            if (!assigned.Contains(level.KeyColumn.Value))
            {
                var name =
                    _payload!.Columns[level.KeyColumn.Value].Name;

                problems.Add(
                    $"La columna '{name}' agrupa " +
                    $"{(level.Depth == 0 ? "el documento" : level.Name)} " +
                    "pero está asignada a otro nivel.");
            }
        }

        var empty =
            _levels
                .Where(x => x.Depth > 0 && ColumnsOf(x).Count == 0)
                .Select(x => x.Name)
                .ToList();

        if (empty.Count > 0)
        {
            problems.Add(
                $"Sin columnas asignadas: {string.Join(", ", empty)}.");
        }

        _structureWarning =
            problems.Count == 0
                ? null
                : string.Join(" ", problems);
    }


    private DataMapping BuildMapping()
    {
        DataMappingNode? root = null;
        DataMappingNode? parent = null;

        foreach (var level in _levels)
        {
            var node =
                new DataMappingNode
                {
                    Name = level.Depth == 0 ? string.Empty : level.Name,

                    Kind = level.Depth == 0
                        ? DataMappingNodeKind.Object
                        : DataMappingNodeKind.Collection,

                    KeyColumns =
                        level.KeyColumn is null
                            ? []
                            : [_payload!.Columns[level.KeyColumn.Value].Name],

                    Fields =
                        ColumnsOf(level)
                            .Select(ordinal =>
                            {
                                var column = _payload!.Columns[ordinal];

                                return new DataMappingField
                                {
                                    Name = _assignments[ordinal].Name,
                                    SourceColumn = column.Name,
                                    Type = column.Type,
                                    Nullable = column.Nullable
                                };
                            })
                            .ToList()
                };

            if (root is null)
                root = node;
            else
                parent!.Children.Add(node);

            parent = node;
        }

        return new DataMapping
        {
            Id = "draft",
            Name = "Mapping",
            Root = root!
        };
    }


    private async Task EmitAsync()
    {
        if (!CanContinue)
            return;

        await OnDatasetReady.InvokeAsync(
            new DatasetResult
            {
                Kind = _kind,
                Schema = _schema!,
                SampleData = _documents[0],
                Documents = _documents,
                Mapping = _mapping,

                RawInput = _kind == DatasetSourceKind.Json
                    ? _json
                    : _raw
            });
    }


    private void Reset()
    {
        _error = null;
        _structureWarning = null;
        _reason = string.Empty;
        _documents = [];
        _schema = null;
        _mapping = null;
        _payload = null;
        _levels.Clear();
        _assignments.Clear();
        _selectedColumns.Clear();
        _targetLevelPath = string.Empty;
        _showMoveModal = false;
        _editingColumnOrdinal = null;
        _editingColumnName = string.Empty;
        _editingColumnLevelPath = string.Empty;
        _selected = 0;
    }


    private static string Pretty(
        JsonElement element) =>
        JsonSerializer.Serialize(element, PrettyOptions);


    private sealed class LevelState
    {
        public required int Depth { get; init; }

        public string Name { get; set; } = string.Empty;

        /// <summary>
        /// Posición de la columna que agrupa este nivel. Nula significa que
        /// cada fila es un elemento.
        /// </summary>
        public int? KeyColumn { get; set; }

        /// <summary>
        /// Ruta en el modelo. La raíz es cadena vacía.
        /// </summary>
        public string Path =>
            Depth == 0
                ? string.Empty
                : Name;
    }


    private sealed class Assignment
    {
        public string LevelPath { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;
    }


    private enum ColumnSortMode
    {
        Original,
        Alphabetical,
        Type
    }


    private sealed class AssignmentTarget
    {
        public required string Path { get; init; }

        public required string Label { get; init; }

        public required string Icon { get; init; }

        public bool IsIgnored { get; init; }
    }


    private sealed class ColumnGroup
    {
        public required string Path { get; init; }

        public required string Label { get; init; }

        public required string Icon { get; init; }

        public required int Depth { get; init; }

        public required bool IsIgnored { get; init; }

        public required List<int> Ordinals { get; init; }
    }
}
