@inherits LayoutComponentBase
@inject RendersetIdentityOptions Product

@* Páginas de cuenta: estáticas, sin menú. Una tarjeta centrada. *@

<div class="account-page">

    <div class="account-card">

        <div class="account-brand">
            <span class="account-brand-mark">@Product.ProductMark</span>
            <strong>@Product.ProductName</strong>
        </div>

        @Body

    </div>

</div>
