@inject IConfiguration Configuration

<nav class="renderset-nav">

    <div class="renderset-nav-section">

        <div class="renderset-nav-title">
            Workspace
        </div>

        <NavLink href="/"
                 Match="NavLinkMatch.All"
                 class="renderset-nav-item">

            <span class="renderset-nav-icon">
                <i class="fa-solid fa-flask"></i>
            </span>

            <span>Playground</span>

        </NavLink>

        <NavLink href="/reports"
                 class="renderset-nav-item">

            <span class="renderset-nav-icon">
                <i class="fa-solid fa-file-lines"></i>
            </span>

            <span>Reports</span>

        </NavLink>

        <NavLink href="/blocks"
                 class="renderset-nav-item">

            <span class="renderset-nav-icon">
                <i class="fa-solid fa-cubes"></i>
            </span>

            <span>Blocks</span>

        </NavLink>

        <NavLink href="/presets"
                 class="renderset-nav-item">

            <span class="renderset-nav-icon">
                <i class="fa-solid fa-sliders"></i>
            </span>

            <span>Presets</span>

        </NavLink>

        <NavLink href="/bundles"
                 class="renderset-nav-item">

            <span class="renderset-nav-icon">
                <i class="fa-solid fa-share-nodes"></i>
            </span>

            <span>Compartir</span>

        </NavLink>

        <NavLink href="/variables"
                 class="renderset-nav-item">

            <span class="renderset-nav-icon">
                <i class="fa-solid fa-database"></i>
            </span>

            <span>Variables</span>

        </NavLink>

        <NavLink href="/resources"
                 class="renderset-nav-item">

            <span class="renderset-nav-icon">
                <i class="fa-solid fa-language"></i>
            </span>

            <span>Diccionario</span>

        </NavLink>


        <NavLink href="/styles"
                 class="renderset-nav-item">

            <span class="renderset-nav-icon">
                <i class="fa-solid fa-palette"></i>
            </span>

            <span>Temas</span>

        </NavLink>

        @* El portal DeCA es otra aplicación (Renderset.Deca.Web): sólo se
           enlaza si está configurada su URL (Deca:PortalUrl). *@
        @if (!string.IsNullOrWhiteSpace(DecaPortalUrl))
        {
            <a href="@DecaPortalUrl"
               class="renderset-nav-item"
               target="_blank"
               rel="noopener">

                <span class="renderset-nav-icon">
                    <i class="fa-solid fa-truck"></i>
                </span>

                <span>DeCA</span>

            </a>
        }

        @* Las opciones de administración sólo se enseñan a Admin y Owner; la
           protección de verdad es la política de cada página y la API. *@
        <AuthorizeView Policy="@TenantPolicies.Admin">
            <NavLink href="/idiomas"
                     class="renderset-nav-item">

                <span class="renderset-nav-icon">
                    <i class="fa-solid fa-language"></i>
                </span>

                <span>Idiomas</span>

            </NavLink>
        </AuthorizeView>

    </div>


    <div class="renderset-nav-section">

        <div class="renderset-nav-title">
            Developer
        </div>

        <NavLink href="/api"
                 class="renderset-nav-item">

            <span class="renderset-nav-icon">
                <i class="fa-solid fa-code"></i>
            </span>

            <span>API</span>

        </NavLink>

        <AuthorizeView Policy="@TenantPolicies.Admin">
            <NavLink href="/settings/api-keys"
                     class="renderset-nav-item">

                <span class="renderset-nav-icon">
                    <i class="fa-solid fa-key"></i>
                </span>

                <span>API keys</span>

            </NavLink>
        </AuthorizeView>

    </div>


    <AuthorizeView Policy="@TenantPolicies.Admin">
        <div class="renderset-nav-section">

            <div class="renderset-nav-title">
                Administración
            </div>

            <NavLink href="/settings/members"
                     class="renderset-nav-item">

                <span class="renderset-nav-icon">
                    <i class="fa-solid fa-users"></i>
                </span>

                <span>Miembros</span>

            </NavLink>

        </div>
    </AuthorizeView>

</nav>

@code {

    /// <summary>
    /// Portal DeCA (Renderset.Deca.Web). En local lo pone AppHost.
    /// </summary>
    private string? DecaPortalUrl =>
        Configuration["Deca:PortalUrl"];
}
