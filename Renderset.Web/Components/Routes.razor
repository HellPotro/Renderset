@* Las páginas de cuenta (entrar, invitación, contraseña) están en
   Renderset.Identity, compartidas con el portal DeCA. *@
<Router AppAssembly="typeof(Program).Assembly"
        AdditionalAssemblies="new[] { typeof(Renderset.Web.Components.Account.AccountLinks).Assembly }">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <div class="page">
                        <div class="account-denied">
                            <i class="fa-solid fa-lock"></i>
                            <h1>Sin permiso</h1>
                            <p>Esta página es sólo para administradores del tenant.</p>
                            <a class="secondary-button" href="">Volver al inicio</a>
                        </div>
                    </div>
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
