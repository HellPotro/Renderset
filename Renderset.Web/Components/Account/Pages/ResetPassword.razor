@page "/account/reset-password"
@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@inject UserManager<RendersetUser> UserManager

<PageTitle>Contraseña nueva - RenderSet</PageTitle>

<HeadContent>
    @* El enlace lleva el código: que no salga en el Referer. *@
    <meta name="referrer" content="no-referrer" />
</HeadContent>

<h1>Contraseña nueva</h1>

@if (done)
{
    <AccountAlert Kind="ok"
                  Message="Contraseña cambiada. Las sesiones abiertas con la anterior se cierran." />

    <div class="account-links">
        <a href="account/login">Entrar</a>
    </div>
}
else if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Code))
{
    <AccountAlert Message="El enlace no está completo. Pide uno nuevo." />

    <div class="account-links">
        <a href="account/forgot-password">Pedir otro enlace</a>
    </div>
}
else
{
    <p class="account-lead">
        Al menos 10 caracteres, con mayúsculas, minúsculas y algún número.
    </p>

    <AccountAlert Message="@error" />

    <EditForm Model="Input"
              method="post"
              FormName="reset-password"
              OnValidSubmit="ResetAsync"
              class="account-form">

        <DataAnnotationsValidator />

        <div class="account-field">
            <label for="reset-email">Correo</label>
            <input id="reset-email"
                   type="email"
                   autocomplete="username"
                   value="@Email"
                   readonly />
        </div>

        <div class="account-field">
            <label for="reset-password">Contraseña nueva</label>
            <InputText id="reset-password"
                       type="password"
                       autocomplete="new-password"
                       autofocus
                       @bind-Value="Input.Password" />
            <ValidationMessage For="() => Input.Password" />
        </div>

        <div class="account-field">
            <label for="reset-confirm">Repite la contraseña</label>
            <InputText id="reset-confirm"
                       type="password"
                       autocomplete="new-password"
                       @bind-Value="Input.ConfirmPassword" />
            <ValidationMessage For="() => Input.ConfirmPassword" />
        </div>

        <button type="submit" class="primary-button">
            Guardar la contraseña
        </button>

    </EditForm>

    <div class="account-links">
        <a href="account/forgot-password">Pedir otro enlace</a>
    </div>
}

@code {

    private const string InvalidLink =
        "El enlace no es válido o ha caducado (dura 2 horas y sólo sirve una vez). Pide uno nuevo.";

    private bool done;
    private string? error;

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    [SupplyParameterFromForm]
    private ResetInput? Input { get; set; }

    protected override void OnInitialized() =>
        Input ??= new ResetInput();

    private async Task ResetAsync()
    {
        var user = await UserManager.FindByEmailAsync(Email!.Trim());

        if (user is null)
        {
            error = InvalidLink;
            return;
        }

        string code;

        try
        {
            code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code!));
        }
        catch (FormatException)
        {
            error = InvalidLink;
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, code, Input!.Password);

        if (!result.Succeeded)
        {
            error = result.Errors.Any(x => x.Code == nameof(IdentityErrorDescriber.InvalidToken))
                ? InvalidLink
                : string.Join(" ", result.Errors.Select(x => x.Description));

            return;
        }

        // Quien recupera la contraseña no tiene que esperar al bloqueo.
        await UserManager.ResetAccessFailedCountAsync(user);
        await UserManager.SetLockoutEndDateAsync(user, null);

        done = true;
    }

    private sealed class ResetInput
    {
        [Required(ErrorMessage = "Escribe la contraseña nueva.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Repite la contraseña.")]
        [Compare(nameof(Password), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
