@page "/account/forgot-password"
@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@using Renderset.Web.Email
@inject UserManager<RendersetUser> UserManager
@inject IAppEmailSender EmailSender
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject ILogger<ForgotPassword> Logger

<PageTitle>Restablecer la contraseña - RenderSet</PageTitle>

<h1>Restablecer la contraseña</h1>

@if (sent)
{
    <AccountAlert Kind="ok"
                  Message="Si el correo tiene cuenta en RenderSet, te hemos enviado un enlace para elegir una contraseña nueva. Caduca en 2 horas." />
}
else
{
    <p class="account-lead">
        Te enviaremos un enlace para elegir una contraseña nueva.
    </p>

    <EditForm Model="Input"
              method="post"
              FormName="forgot-password"
              OnValidSubmit="SendAsync"
              class="account-form">

        <DataAnnotationsValidator />

        <div class="account-field">
            <label for="forgot-email">Correo</label>
            <InputText id="forgot-email"
                       type="email"
                       autocomplete="username"
                       autofocus
                       @bind-Value="Input.Email" />
            <ValidationMessage For="() => Input.Email" />
        </div>

        <button type="submit" class="primary-button">
            Enviar el enlace
        </button>

    </EditForm>
}

<div class="account-links">
    <a href="account/login">Volver a entrar</a>
</div>

@code {

    private bool sent;

    [SupplyParameterFromForm]
    private ForgotInput? Input { get; set; }

    protected override void OnInitialized() =>
        Input ??= new ForgotInput();

    /// <summary>
    /// La respuesta es la misma exista o no la cuenta: no se dice qué
    /// correos están dados de alta.
    /// </summary>
    private async Task SendAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input!.Email.Trim());

        if (user is not null &&
            await UserManager.IsEmailConfirmedAsync(user))
        {
            var code = await UserManager.GeneratePasswordResetTokenAsync(user);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));

            var link =
                $"{AccountLinks.PublicBaseUrl(Configuration, Navigation)}/account/reset-password" +
                $"?email={Uri.EscapeDataString(user.Email!)}&code={Uri.EscapeDataString(code)}";

            // Sin esperar al envío: el tiempo de respuesta no tiene que
            // delatar qué correos tienen cuenta. El remitente es singleton y
            // no depende de esta petición.
            var to = user.Email!;
            var userId = user.Id;
            var sender = EmailSender;
            var logger = Logger;

            _ = Task.Run(async () =>
            {
                try
                {
                    await sender.SendAsync(
                        to,
                        "Restablecer la contraseña de RenderSet",
                        EmailTemplates.PasswordReset(link));
                }
                catch (Exception exception)
                {
                    logger.LogError(exception, "No se ha podido enviar el correo de restablecer la contraseña a {UserId}.", userId);
                }
            });
        }

        sent = true;
    }

    private sealed class ForgotInput
    {
        [Required(ErrorMessage = "Escribe tu correo.")]
        [EmailAddress(ErrorMessage = "El correo no es válido.")]
        public string Email { get; set; } = string.Empty;
    }
}
