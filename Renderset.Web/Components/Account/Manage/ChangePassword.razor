@page "/account/password"
@using Microsoft.AspNetCore.Authentication
@inject UserManager<RendersetUser> UserManager
@inject TenantSignIn TenantSignIn

<PageTitle>Cambiar la contraseña - RenderSet</PageTitle>

<h1>Cambiar la contraseña</h1>

@if (done)
{
    <AccountAlert Kind="ok"
                  Message="Contraseña cambiada. Las demás sesiones abiertas se cierran en unos minutos." />
}
else
{
    <p class="account-lead">
        Al menos 10 caracteres, con mayúsculas, minúsculas y algún número.
    </p>

    <AccountAlert Message="@error" />

    <EditForm Model="Input"
              method="post"
              FormName="change-password"
              OnValidSubmit="ChangeAsync"
              class="account-form">

        <DataAnnotationsValidator />

        <input type="email"
               autocomplete="username"
               value="@HttpContext.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value"
               hidden
               readonly />

        <div class="account-field">
            <label for="password-current">Contraseña actual</label>
            <InputText id="password-current"
                       type="password"
                       autocomplete="current-password"
                       autofocus
                       @bind-Value="Input.CurrentPassword" />
            <ValidationMessage For="() => Input.CurrentPassword" />
        </div>

        <div class="account-field">
            <label for="password-new">Contraseña nueva</label>
            <InputText id="password-new"
                       type="password"
                       autocomplete="new-password"
                       @bind-Value="Input.NewPassword" />
            <ValidationMessage For="() => Input.NewPassword" />
        </div>

        <div class="account-field">
            <label for="password-confirm">Repite la contraseña nueva</label>
            <InputText id="password-confirm"
                       type="password"
                       autocomplete="new-password"
                       @bind-Value="Input.ConfirmPassword" />
            <ValidationMessage For="() => Input.ConfirmPassword" />
        </div>

        <button type="submit" class="primary-button">
            Cambiar la contraseña
        </button>

    </EditForm>
}

<div class="account-links">
    <a href="">Volver a RenderSet</a>
</div>

@code {

    private bool done;
    private string? error;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private ChangePasswordInput? Input { get; set; }

    protected override void OnInitialized() =>
        Input ??= new ChangePasswordInput();

    private async Task ChangeAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);

        if (user is null)
        {
            error = "La sesión ha caducado. Vuelve a entrar.";
            return;
        }

        var result =
            await UserManager.ChangePasswordAsync(
                user,
                Input!.CurrentPassword,
                Input.NewPassword);

        if (!result.Succeeded)
        {
            error = string.Join(" ", result.Errors.Select(x => x.Description));
            return;
        }

        // El cambio renueva el sello de seguridad, que cierra las demás
        // sesiones; ésta se vuelve a firmar con el mismo tenant.
        var current =
            await HttpContext.AuthenticateAsync(IdentityConstants.ApplicationScheme);

        await TenantSignIn.SignInAsync(
            user,
            current.Properties?.IsPersistent == true,
            HttpContext.User.FindFirst(RendersetClaimTypes.TenantId)?.Value);

        done = true;
    }

    private sealed class ChangePasswordInput
    {
        [Required(ErrorMessage = "Escribe la contraseña actual.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Escribe la contraseña nueva.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Repite la contraseña nueva.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
