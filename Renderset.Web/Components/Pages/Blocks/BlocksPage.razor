@page "/blocks"

@using System.Text.Json
@using System.Text.Json.Serialization
@using Renderset.Core.Blocks
@using Renderset.Core.Configurations

@inject IRenderSetApi RenderSetApi
@inject ICurrentTenant CurrentTenant
@inject NavigationManager Navigation
@inject IToastService Toasts

<PageTitle>Bloques - RenderSet</PageTitle>

<div class="page">

    <header class="page-header">

        <div>
            <h1>Bloques</h1>

            <p>
                Piezas reutilizables entre reports: la cabecera y el pie de la
                empresa, avisos y condiciones, datos fijos.
            </p>
        </div>

        <button type="button"
                class="primary-button"
                @onclick="() => CreateBlock(null)">
            <i class="fa-solid fa-plus"></i>
            Nuevo bloque
        </button>

    </header>


    @if (_loading)
    {
        <div class="page-state">
            Cargando bloques...
        </div>
    }
    else if (_blocks.Count == 0)
    {
        <div class="empty-state">

            <div class="empty-state-icon">
                <i class="fa-solid fa-cubes"></i>
            </div>

            <h2>No hay bloques</h2>

            <p>
                Empieza por la cabecera o el pie de tu empresa: se eligen en el
                diseñador de cualquier report.
            </p>

            <div class="blk-empty-actions">
                @foreach (var type in Types)
                {
                    <button type="button"
                            class="secondary-button"
                            @onclick="() => CreateBlock(type.Type)">
                        <i class="fa-solid @type.Icon"></i>
                        @type.Label
                    </button>
                }
            </div>

        </div>
    }
    else
    {
        <div class="blocks-toolbar">

            <button type="button"
                    class="@GetFilterClass(null)"
                    @onclick="() => SetFilter(null)">
                Todos
                <span class="filter-count">@_blocks.Count</span>
            </button>

            @foreach (var type in Types)
            {
                var count = _blocks.Count(x => x.Type == type.Type);

                <button type="button"
                        class="@GetFilterClass(type.Type)"
                        @onclick="() => SetFilter(type.Type)">
                    <i class="fa-solid @type.Icon"></i>
                    @type.Plural
                    @if (count > 0)
                    {
                        <span class="filter-count">@count</span>
                    }
                </button>
            }

        </div>


        <div class="blocks-grid">

            @if (_filter is { } filter && !FilteredBlocks.Any())
            {
                <button type="button"
                        class="block-card blk-new-card"
                        @onclick="() => CreateBlock(filter)">
                    <i class="fa-solid fa-plus"></i>
                    <span>Crear @TypeOf(filter).Label.ToLowerInvariant()</span>
                </button>
            }

            @foreach (var block in FilteredBlocks)
            {
                var type = TypeOf(block.Type);

                <article class="block-card">

                    <div class="block-card-header">

                        <div class="block-icon @type.Css">
                            <i class="fa-solid @type.Icon"></i>
                        </div>

                        <div class="block-heading">

                            <h2>@block.Name</h2>

                            <code>@block.Id</code>

                        </div>

                        <span class="block-type">
                            @type.Label
                        </span>

                    </div>


                    <div class="block-content">

                        <ul class="blk-summary">
                            @foreach (var line in Summary(block))
                            {
                                <li>@line</li>
                            }
                        </ul>

                        <p class="blk-summary-where">
                            <i class="fa-solid fa-location-dot"></i>
                            @type.WhereUsed
                        </p>

                    </div>


                    <footer class="block-card-footer">

                        <button type="button"
                                class="secondary-button"
                                @onclick="() => EditBlock(block)">
                            <i class="fa-solid fa-pen"></i>
                            Editar
                        </button>

                    </footer>

                </article>
            }

        </div>
    }

</div>


@code {

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        PropertyNameCaseInsensitive = true,
        Converters =
        {
            new JsonStringEnumConverter()
        }
    };

    private sealed record TypeInfo(
        ReportBlockType Type,
        string Label,
        string Plural,
        string Icon,
        string Css,
        string WhereUsed);

    private static readonly TypeInfo[] Types =
    [
        new(ReportBlockType.Header, "Cabecera", "Cabeceras", "fa-heading", "header", "Pestaña Cabecera del diseñador."),
        new(ReportBlockType.Footer, "Pie de página", "Pies", "fa-shoe-prints", "footer", "Pestaña Cabecera → Pie de página."),
        new(ReportBlockType.Text, "Texto", "Textos", "fa-align-left", "text", "Estructura → Añadir contenido."),
        new(ReportBlockType.Fields, "Campos fijos", "Campos fijos", "fa-table-list", "fields", "Estructura → Añadir contenido.")
    ];

    private static TypeInfo TypeOf(
        ReportBlockType type) =>
        Types.FirstOrDefault(x => x.Type == type)
        ?? new TypeInfo(type, type.ToString(), type.ToString(), "fa-cube", string.Empty, string.Empty);

    private IReadOnlyCollection<ReportBlock> _blocks = [];

    private ReportBlockType? _filter;

    private bool _loading = true;


    private IEnumerable<ReportBlock> FilteredBlocks =>
        (_filter is null
            ? _blocks
            : _blocks.Where(x => x.Type == _filter))
        .OrderBy(x => x.Type)
        .ThenBy(x => x.Name);


    protected override async Task OnInitializedAsync()
    {
        try
        {
            var blocks = await Toasts.RunAsync(
                () => RenderSetApi.GetBlocksAsync(
                    CurrentTenant.Id),
                errorTitle: "No se han podido cargar los bloques");

            if (blocks is not null)
                _blocks = blocks;
        }
        finally
        {
            _loading = false;
        }
    }


    private void SetFilter(
        ReportBlockType? type) =>
        _filter = type;


    private string GetFilterClass(
        ReportBlockType? type) =>
        _filter == type
            ? "filter-button active"
            : "filter-button";


    private void CreateBlock(
        ReportBlockType? type) =>
        Navigation.NavigateTo(
            type is null
                ? "/blocks/new"
                : $"/blocks/new?type={type}");


    private void EditBlock(
        ReportBlock block) =>
        Navigation.NavigateTo(
            $"/blocks/{Uri.EscapeDataString(block.Id)}");


    /// <summary>
    /// Qué lleva el bloque, en dos o tres líneas legibles. Antes se
    /// enseñaba el JSON tal cual.
    /// </summary>
    private static IEnumerable<string> Summary(
        ReportBlock block)
    {
        switch (block.Type)
        {
            case ReportBlockType.Header:
            {
                var header = Read<ReportHeaderConfiguration>(block);
                var lines = header.Lines.Count + header.Columns.Sum(x => x.Lines.Count);
                var parts = new List<string>();

                if (header.ShowLogo == true)
                    parts.Add("Logo");

                if (header.TitleKey is not null)
                    parts.Add("título");

                if (header.ShowQr == true)
                    parts.Add("QR");

                yield return parts.Count == 0
                    ? "Sin logo ni título"
                    : string.Join(", ", parts);

                yield return header.Columns.Count > 0
                    ? $"{lines} línea(s) de datos en {header.Columns.Count} columnas"
                    : $"{lines} línea(s) de datos";

                yield break;
            }

            case ReportBlockType.Footer:
            {
                var footer = Read<ReportFooterConfiguration>(block);

                yield return footer.TextKey is null ? "Sin texto" : "Con texto";

                if (footer.ShowGenerationDate == true)
                    yield return "Fecha de generación";

                if (footer.ShowPageNumber == true)
                    yield return "Número de página";

                yield break;
            }

            case ReportBlockType.Text:
            {
                var text = Read<ReportTextBlockConfiguration>(block);

                yield return string.IsNullOrWhiteSpace(text.Title)
                    ? "Sin título"
                    : text.Title;

                if (!string.IsNullOrWhiteSpace(text.Text))
                {
                    yield return text.Text.Length > 90
                        ? text.Text[..90] + "…"
                        : text.Text;
                }

                yield break;
            }

            case ReportBlockType.Fields:
            {
                var fields = Read<ReportFieldsBlockConfiguration>(block);

                yield return $"{fields.Fields.Count} campo(s)";

                yield return fields.Layout is null or Renderset.Core.Definitions.ReportSectionLayout.List
                    ? "En lista"
                    : $"En cuadrícula de {fields.Columns ?? 2}";

                yield break;
            }
        }
    }


    private static T Read<T>(
        ReportBlock block)
        where T : new()
    {
        if (string.IsNullOrWhiteSpace(block.ConfigurationJson))
            return new T();

        try
        {
            return JsonSerializer.Deserialize<T>(block.ConfigurationJson, JsonOptions) ?? new T();
        }
        catch (JsonException)
        {
            return new T();
        }
    }
}
