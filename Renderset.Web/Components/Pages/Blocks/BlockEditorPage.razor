                        </div>
                    }

                </section>

            </aside>

        </div>
    }

</div>


@code {

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        PropertyNameCaseInsensitive = true,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
        Converters =
        {
            new JsonStringEnumConverter()
        }
    };

    [Parameter]
    public string? BlockId { get; set; }

    /// <summary>
    /// /blocks/new?type=Fields abre directamente el editor de ese tipo.
    /// </summary>
    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeFromQuery { get; set; }

    private string _id = string.Empty;
    private string _name = string.Empty;
    private bool _idEdited;

    private ReportBlockType _type = ReportBlockType.Header;
    private bool _typeChosen;

    private ReportHeaderConfiguration _header = new();
    private ReportFooterConfiguration _footer = new();
    private ReportTextBlockConfiguration _text = new();
    private ReportFieldsBlockConfiguration _fields = new();

    private IReadOnlyCollection<ReportVariable> _variables = [];
    private IReadOnlyCollection<TenantCulture> _cultures = [];
    private IReadOnlyCollection<ReportBlock> _existingBlocks = [];

    private readonly ReportTheme _theme = new();

    private string? _selectedCulture;

    private ReportTextWorkspace _texts =
        ReportTextWorkspace.Detached();

    private bool _loading;
    private bool _saving;


    // ------------------------------------------------------------- tipos

    private sealed record TypeOption(
        ReportBlockType Type,
        string Label,
        string Icon,
        string Css,
        string Description,
        string WhereUsed,
        string NamePlaceholder);

    private static readonly TypeOption[] TypeOptions =
    [
        new(ReportBlockType.Header,
            "Cabecera",
            "fa-heading",
            "header",
            "Logo, título y datos de empresa en la parte de arriba del documento.",
            "Diseñador → pestaña Cabecera → Bloque reutilizable.",
            "Cabecera ORAN"),

        new(ReportBlockType.Footer,
            "Pie de página",
            "fa-shoe-prints",
            "footer",
            "Texto legal, fecha y número de página al final de cada hoja.",
            "Diseñador → pestaña Cabecera → Pie de página → Bloque reutilizable.",
            "Pie legal ORAN"),

        new(ReportBlockType.Text,
            "Texto",
            "fa-align-left",
            "text",
            "Un aviso, unas condiciones o una nota que se repite en varios documentos.",
            "Diseñador → Estructura → Añadir contenido → Bloque existente.",
            "Condiciones de entrega"),

        new(ReportBlockType.Fields,
            "Campos fijos",
            "fa-table-list",
            "fields",
            "Etiqueta y valor en lista o cuadrícula, como una sección, pero con valores fijos: datos de empresa, bancarios, horario...",
            "Diseñador → Estructura → Añadir contenido → Bloque existente.",
            "Datos de empresa")
    ];

    private TypeOption CurrentType =>
        TypeOptions.First(x => x.Type == _type);

    private static readonly (ReportHeaderLayout Layout, string Label, string Icon)[] HeaderLayouts =
    [
        (ReportHeaderLayout.LogoLeft, "Logo a la izquierda", "fa-align-left"),
        (ReportHeaderLayout.LogoRight, "Logo a la derecha", "fa-align-right"),
        (ReportHeaderLayout.Stacked, "Centrado", "fa-align-center")
    ];

    private static readonly (ReportHeaderTitlePlacement Placement, string Label, string Icon)[] TitlePlacements =
    [
        (ReportHeaderTitlePlacement.Inline, "Junto al logo", "fa-grip-lines"),
        (ReportHeaderTitlePlacement.Below, "Debajo, a todo el ancho", "fa-arrow-down-wide-short"),
        (ReportHeaderTitlePlacement.Above, "Encima, a todo el ancho", "fa-arrow-up-wide-short")
    ];

    private static readonly (ReportTextBlockStyle Style, string Label)[] TextStyles =
    [
        (ReportTextBlockStyle.Default, "Normal"),
        (ReportTextBlockStyle.Information, "Información"),
        (ReportTextBlockStyle.Warning, "Aviso"),
        (ReportTextBlockStyle.Success, "Correcto")
    ];

    private static readonly (ReportHorizontalAlignment Alignment, string Label, string Icon)[] Alignments =
    [
        (ReportHorizontalAlignment.Left, "Izquierda", "fa-align-left"),
        (ReportHorizontalAlignment.Center, "Centro", "fa-align-center"),
        (ReportHorizontalAlignment.Right, "Derecha", "fa-align-right")
    ];


    private bool IsEditMode =>
        !string.IsNullOrWhiteSpace(BlockId);

    private string PageTitleText =>
        IsEditMode
            ? string.IsNullOrWhiteSpace(_name) ? "Editar bloque" : _name
            : _typeChosen
                ? $"Nuevo bloque · {CurrentType.Label}"
                : "Nuevo bloque";

    private bool CanSave =>
        !string.IsNullOrWhiteSpace(_name) &&
        IsValidId(_id);


    private string ConfigurationJson =>
        _type switch
        {
            ReportBlockType.Header => JsonSerializer.Serialize(_header, JsonOptions),
            ReportBlockType.Footer => JsonSerializer.Serialize(_footer, JsonOptions),
            ReportBlockType.Text => JsonSerializer.Serialize(_text, JsonOptions),
            ReportBlockType.Fields => JsonSerializer.Serialize(_fields, JsonOptions),
            _ => "{}"
        };


    // ------------------------------------------------------------- carga

    protected override async Task OnParametersSetAsync()
    {
        if (!IsEditMode)
        {
            ResetNewBlock();

            if (Enum.TryParse<ReportBlockType>(TypeFromQuery, ignoreCase: true, out var type))
                ChooseType(type);

            _loading = true;

            try
            {
                await Toasts.RunAsync(
                    LoadEditorContextAsync,
                    errorTitle: "No se han podido cargar los datos del editor");
            }
            finally
            {
                _loading = false;
            }

            return;
        }

        await LoadAsync();
    }


    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            var block =
                await RenderSetApi.GetBlockAsync(
                    CurrentTenant.Id,
                    BlockId!);

            _id = block.Id;
            _name = block.Name;
            _type = block.Type;
            _typeChosen = true;

            switch (_type)
            {
                case ReportBlockType.Header:
                    _header = Deserialize<ReportHeaderConfiguration>(block.ConfigurationJson);
                    break;

                case ReportBlockType.Footer:
                    _footer = Deserialize<ReportFooterConfiguration>(block.ConfigurationJson);
                    break;

                case ReportBlockType.Text:
                    _text = Deserialize<ReportTextBlockConfiguration>(block.ConfigurationJson);
                    break;

                case ReportBlockType.Fields:
                    _fields = Deserialize<ReportFieldsBlockConfiguration>(block.ConfigurationJson);
                    break;
            }

            await LoadEditorContextAsync();
        }
        catch (Exception exception)
        {
            Toasts.Error(
                ToastServiceExtensions.Describe(exception),
                "No se ha podido cargar el bloque");

            Navigation.NavigateTo("/blocks");
        }
        finally
        {
            _loading = false;
        }
    }


    private async Task LoadEditorContextAsync()
    {
        _variables =
            await RenderSetApi.GetVariablesAsync(
                CurrentTenant.Id);

        _cultures =
            await RenderSetApi.GetCulturesAsync(
                CurrentTenant.Id);

        if (!IsEditMode)
        {
            _existingBlocks =
                await RenderSetApi.GetBlocksAsync(
                    CurrentTenant.Id);
        }

        _selectedCulture ??=
            _cultures.FirstOrDefault(x => x.IsDefault)?.Culture
            ?? _cultures.FirstOrDefault()?.Culture;

        _texts =
            await LoadTextsAsync(
                _selectedCulture);
    }


    private async Task<ReportTextWorkspace> LoadTextsAsync(
        string? culture)
    {
        if (string.IsNullOrWhiteSpace(culture))
            return ReportTextWorkspace.Detached();

        var resources =
            await RenderSetApi.GetResourcesAsync(
                CurrentTenant.Id,
                ReportResourceScope.Global);

        return new ReportTextWorkspace(
            ReportResourceScope.Global,
            culture,
            resources,
            variables: _variables);
    }


    private async Task ChangeCultureAsync(
        ChangeEventArgs e)
    {
        if (_texts.HasPendingChanges &&
            !await SaveTextsAsync())
        {
            return;
        }

        _selectedCulture =
            e.Value?.ToString();

        var texts = await Toasts.RunAsync(
            () => LoadTextsAsync(_selectedCulture),
            errorTitle: "No se han podido cargar los textos del bloque");

        if (texts is not null)
            _texts = texts;
    }


    private void ResetNewBlock()
    {
        _id = string.Empty;
        _name = string.Empty;
        _idEdited = false;
        _typeChosen = false;
        _type = ReportBlockType.Header;

        _header = new ReportHeaderConfiguration();
        _footer = new ReportFooterConfiguration();
        _text = new ReportTextBlockConfiguration();
        _fields = new ReportFieldsBlockConfiguration();
    }


    private void ChooseType(
        ReportBlockType type)
    {
        _type = type;
        _typeChosen = true;

        if (!_idEdited)
            _id = ProposeId();
    }


    /// <summary>
    /// Sólo para bloques nuevos: lo escrito en el tipo anterior se queda en
    /// su objeto por si se vuelve a él.
    /// </summary>
    private void ChangeType() =>
        _typeChosen = false;


    // ------------------------------------------------------- nombre e id

    private void NameChanged(
        ChangeEventArgs e)
    {
        _name = e.Value?.ToString() ?? string.Empty;

        if (!IsEditMode && !_idEdited)
            _id = ProposeId();
    }


    private void IdChanged(
        ChangeEventArgs e)
    {
        _id = Slug(e.Value?.ToString());
        _idEdited = true;
    }


    /// <summary>
    /// Del nombre, o del tipo si aún no hay nombre ("fields-1a2b3c"). Si
    /// choca con un bloque que ya existe se le añade un número: guardar con
    /// un id existente machacaría ese bloque.
    /// </summary>
    private string ProposeId()
    {
        var baseId =
            string.IsNullOrWhiteSpace(_name)
                ? $"{_type.ToString().ToLowerInvariant()}-{Guid.NewGuid():N}"[..(_type.ToString().Length + 7)]
                : Slug(_name);

        if (string.IsNullOrWhiteSpace(baseId))
            baseId = _type.ToString().ToLowerInvariant();

        var candidate = baseId;
        var suffix = 2;

        while (_existingBlocks.Any(x => string.Equals(x.Id, candidate, StringComparison.OrdinalIgnoreCase)))
            candidate = $"{baseId}-{suffix++}";

        return candidate;
    }


    private static bool IsValidId(
        string? id) =>
        !string.IsNullOrWhiteSpace(id) &&
        id.Length <= 100 &&
        id.All(c => char.IsAsciiLetterLower(c) || char.IsAsciiDigit(c) || c == '-');


    // ------------------------------------------------------------ textos

    /// <summary>
    /// Texto de una clave del diccionario en el idioma de edición.
    /// </summary>
    private string KeyText(
        string? key,
        string fallback = "") =>
        string.IsNullOrWhiteSpace(key)
            ? fallback
            : _texts.GetText(key, fallback);


    /// <summary>
    /// Clave para un texto del bloque. Se decide la primera vez que se
    /// escribe y se guarda en la configuración: cambiar después el id no la
    /// mueve ni pierde traducciones.
    /// </summary>
    private string NewKey(
        Func<string, string> convention) =>
        convention(string.IsNullOrWhiteSpace(_id) ? ProposeId() : _id);


    private void HeaderTitleChanged(ChangeEventArgs e)
    {
        _header.TitleKey ??= NewKey(ReportTextKeys.BlockTitle);
        _texts.SetText(_header.TitleKey, e.Value?.ToString());
    }


    private void HeaderSubtitleChanged(ChangeEventArgs e)
    {
        _header.SubtitleKey ??= NewKey(ReportTextKeys.BlockSubtitle);
        _texts.SetText(_header.SubtitleKey, e.Value?.ToString());
    }


    private Task InsertTitleVariableAsync(ReportVariable variable)
    {
        _header.TitleKey ??= NewKey(ReportTextKeys.BlockTitle);
        _texts.SetText(_header.TitleKey, AppendToken(KeyText(_header.TitleKey), variable.Key));
        return Task.CompletedTask;
    }


    private Task InsertSubtitleVariableAsync(ReportVariable variable)
    {
        _header.SubtitleKey ??= NewKey(ReportTextKeys.BlockSubtitle);
        _texts.SetText(_header.SubtitleKey, AppendToken(KeyText(_header.SubtitleKey), variable.Key));
        return Task.CompletedTask;
    }


    private void HeaderShowLogoChanged(ChangeEventArgs e) =>
        _header.ShowLogo = e.Value is bool value && value;


    private void HeaderLogoUrlChanged(ChangeEventArgs e) =>
        _header.LogoUrl = Normalize(e.Value?.ToString());


    private void HeaderLogoHeightChanged(ChangeEventArgs e)
    {
        _header.LogoMaxHeight =
            int.TryParse(e.Value?.ToString(), out var height)
                ? Math.Clamp(height, 20, 300)
                : null;
    }


    private Task InsertLogoVariableAsync(ReportVariable variable)
    {
        _header.LogoUrl = $"{{{{{variable.Key}}}}}";
        return Task.CompletedTask;
    }


    private ReportHeaderLayout HeaderLayoutValue =>
        _header.Layout ?? ReportHeaderLayout.LogoLeft;

    private ReportHeaderTitlePlacement TitlePlacementValue =>
        _header.TitlePlacement ?? ReportHeaderTitlePlacement.Inline;

    /// <summary>
    /// Junto al logo es lo de siempre: se guarda nulo para que el bloque
    /// sólo lleve la propiedad cuando de verdad cambia algo.
    /// </summary>
    private void TitlePlacementChanged(
        ReportHeaderTitlePlacement placement) =>
        _header.TitlePlacement =
            placement == ReportHeaderTitlePlacement.Inline
                ? null
                : placement;


    // -------------------------------------------------- líneas de cabecera

    /*
     * Atajos para los datos que aparecen en casi todas las cabeceras y en
     * los bloques de campos. No inventan nada: crean la línea con el texto
     * ya apuntando a la variable del tenant que mejor encaja, si hay alguna.
     */
    private sealed record LinePreset(
        string Label,
        string Prefix,
        string[] Hints,
        ReportHeaderLineStyle Style);

    private static readonly LinePreset[] LinePresets =
    [
        new("Razón social", "", ["company.name", "empresa", "razon", "company"], ReportHeaderLineStyle.Strong),
        new("CIF", "CIF: ", ["cif", "nif", "vat"], ReportHeaderLineStyle.Normal),
        new("Dirección", "", ["address", "direccion", "domicilio"], ReportHeaderLineStyle.Normal),
        new("Teléfono", "Tel. ", ["phone", "telefono", "tel"], ReportHeaderLineStyle.Muted),
        new("Email", "", ["email", "mail", "correo"], ReportHeaderLineStyle.Muted),
        new("Web", "", ["web", "url", "site"], ReportHeaderLineStyle.Muted)
    ];

    private IEnumerable<ReportHeaderLineConfiguration> OrderedHeaderLines =>
        _header.Lines.OrderBy(x => x.Order);


    private string? SuggestVariableToken(
        IEnumerable<string> hints)
    {
        foreach (var hint in hints)
        {
            var variable =
                _variables.FirstOrDefault(x =>
                    x.Key.Contains(hint, StringComparison.OrdinalIgnoreCase));

            if (variable is not null)
                return $"{{{{{variable.Key}}}}}";
        }

        return null;
    }


    private RenderFragment HeaderLineRow(
        ReportHeaderLineConfiguration line,
        ReportHeaderColumnConfiguration? column) =>
        @<div class="header-line-row" @key="line.Id">

            <input type="text"
                   value="@KeyText(line.TextKey)"
                   @onchange="e => HeaderLineTextChanged(line, e)"
                   placeholder="Texto de la línea" />

            <VariablePicker Variables="_variables"
                            Selected="variable => InsertHeaderLineVariableAsync(line, variable)" />

            <select value="@line.Style"
                    @onchange="e => HeaderLineStyleChanged(line, e)">
                <option value="@ReportHeaderLineStyle.Normal">Normal</option>
                <option value="@ReportHeaderLineStyle.Strong">Destacado</option>
                <option value="@ReportHeaderLineStyle.Muted">Secundario</option>
                <option value="@ReportHeaderLineStyle.Small">Pequeño</option>
            </select>

            <div class="header-line-actions">
                <button type="button"
                        title="Subir"
                        disabled="@(!CanMoveLine(Lines(column), line, -1))"
                        @onclick="() => MoveLine(column, line, -1)">
                    <i class="fa-solid fa-arrow-up"></i>
                </button>
                <button type="button"
                        title="Bajar"
                        disabled="@(!CanMoveLine(Lines(column), line, 1))"
                        @onclick="() => MoveLine(column, line, 1)">
                    <i class="fa-solid fa-arrow-down"></i>
                </button>
                <button type="button"
                        class="is-danger"
                        title="Quitar línea"
                        @onclick="() => RemoveLine(column, line)">
                    <i class="fa-solid fa-trash"></i>
                </button>
            </div>

        </div>;


    private List<ReportHeaderLineConfiguration> Lines(
        ReportHeaderColumnConfiguration? column) =>
        column?.Lines ?? _header.Lines;


    private void AddPresetLine(
        LinePreset preset) =>
        AddHeaderLine(
            preset.Prefix + (SuggestVariableToken(preset.Hints) ?? string.Empty),
            preset.Style);


    private void AddPresetLine(
        ReportHeaderColumnConfiguration column,
        LinePreset preset) =>
        AddHeaderLine(
            column,
            preset.Prefix + (SuggestVariableToken(preset.Hints) ?? string.Empty),
            preset.Style);


    private void AddHeaderLine(
        string? text = null,
        ReportHeaderLineStyle style = ReportHeaderLineStyle.Normal) =>
        AddLineTo(_header.Lines, text, style);


    private void AddHeaderLine(
        ReportHeaderColumnConfiguration column,
        string? text = null,
        ReportHeaderLineStyle style = ReportHeaderLineStyle.Normal) =>
        AddLineTo(column.Lines, text, style);


    private void AddLineTo(
        List<ReportHeaderLineConfiguration> lines,
        string? text,
        ReportHeaderLineStyle style)
    {
        var line =
            new ReportHeaderLineConfiguration
            {
                Id = ShortId(),
                Style = style,
                Order = lines.Count == 0 ? 10 : lines.Max(x => x.Order) + 10
            };

        line.TextKey = ReportTextKeys.HeaderLine(line.Id);

        lines.Add(line);

        if (!string.IsNullOrWhiteSpace(text))
            _texts.SetText(line.TextKey, text);
    }


    private static bool CanMoveLine(
        List<ReportHeaderLineConfiguration> lines,
        ReportHeaderLineConfiguration line,
        int direction)
    {
        var ordered = lines.OrderBy(x => x.Order).ToList();
        var index = ordered.IndexOf(line);
        var target = index + direction;

        return index >= 0 && target >= 0 && target < ordered.Count;
    }


    private void MoveLine(
        ReportHeaderColumnConfiguration? column,
        ReportHeaderLineConfiguration line,
        int direction)
    {
        var ordered = Lines(column).OrderBy(x => x.Order).ToList();
        var index = ordered.IndexOf(line);
        var target = index + direction;

        if (index < 0 || target < 0 || target >= ordered.Count)
            return;

        (ordered[index], ordered[target]) = (ordered[target], ordered[index]);

        SetLines(column, ordered);
    }


    /// <summary>
    /// El texto se queda en el diccionario a propósito: borrarlo desde aquí
    /// dejaría huérfanas las traducciones de otros idiomas.
    /// </summary>
    private void RemoveLine(
        ReportHeaderColumnConfiguration? column,
        ReportHeaderLineConfiguration line) =>
        SetLines(
            column,
            Lines(column)
                .Where(x => !ReferenceEquals(x, line))
                .OrderBy(x => x.Order)
                .ToList());


    private void SetLines(
        ReportHeaderColumnConfiguration? column,
        List<ReportHeaderLineConfiguration> lines)
    {
        for (var i = 0; i < lines.Count; i++)
            lines[i].Order = (i + 1) * 10;

        if (column is null)
            _header.Lines = lines;
        else
            column.Lines = lines;
    }


    private void HeaderLineTextChanged(
        ReportHeaderLineConfiguration line,
        ChangeEventArgs e)
    {
        line.TextKey ??= ReportTextKeys.HeaderLine(line.Id);
        _texts.SetText(line.TextKey, e.Value?.ToString());
    }


    private void HeaderLineStyleChanged(
        ReportHeaderLineConfiguration line,
        ChangeEventArgs e)
    {
        if (Enum.TryParse<ReportHeaderLineStyle>(e.Value?.ToString(), out var style))
            line.Style = style;
    }


    private Task InsertHeaderLineVariableAsync(
        ReportHeaderLineConfiguration line,
        ReportVariable variable)
    {
        line.TextKey ??= ReportTextKeys.HeaderLine(line.Id);
        _texts.SetText(line.TextKey, AppendToken(KeyText(line.TextKey), variable.Key));
        return Task.CompletedTask;
    }


    /// <summary>
    /// Activar columnas: las líneas actuales pasan a la primera columna y se
    /// crea una segunda vacía. Mientras no se pulse, el JSON no cambia y el
    /// documento sigue usando el camino de una sola lista.
    /// </summary>
    private void EnableHeaderColumns()
    {
        if (_header.Columns.Count > 0)
            return;

        var first = CreateHeaderColumn(50);
        first.Lines = _header.Lines;

        _header.Columns = [first, CreateHeaderColumn(50)];
        _header.Lines = [];
    }


    private void DisableHeaderColumns()
    {
        if (_header.Columns.Count == 0)
            return;

        SetLines(
            null,
            _header.Columns
                .SelectMany(x => x.Lines.OrderBy(line => line.Order))
                .ToList());

        _header.Columns = [];
    }


    private void AddHeaderColumn()
    {
        if (_header.Columns.Count >= 4)
            return;

        _header.Columns.Add(CreateHeaderColumn(50));
        DistributeHeaderColumnWidths();
    }


    private static ReportHeaderColumnConfiguration CreateHeaderColumn(
        int width) =>
        new()
        {
            Id = ShortId(),
            Width = width,
            Align = ReportHorizontalAlignment.Left
        };


    private void RemoveHeaderColumn(
        ReportHeaderColumnConfiguration column)
    {
        if (_header.Columns.Count <= 1)
            return;

        _header.Columns.Remove(column);
        DistributeHeaderColumnWidths();
    }


    private void DistributeHeaderColumnWidths()
    {
        if (_header.Columns.Count == 0)
            return;

        var width = 100 / _header.Columns.Count;
        var remainder = 100 - (width * _header.Columns.Count);

        for (var i = 0; i < _header.Columns.Count; i++)
            _header.Columns[i].Width = width + (i == _header.Columns.Count - 1 ? remainder : 0);
    }


    private static void HeaderColumnAlignmentChanged(
        ReportHeaderColumnConfiguration column,
        ChangeEventArgs e)
    {
        if (Enum.TryParse<ReportHorizontalAlignment>(e.Value?.ToString(), out var alignment))
            column.Align = alignment;
    }


    private static void HeaderColumnWidthChanged(
        ReportHeaderColumnConfiguration column,
        ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var width))
            column.Width = Math.Clamp(width, 10, 100);
    }


    // --------------------------------------------------------------- pie

    private void FooterTextChanged(ChangeEventArgs e)
    {
        _footer.TextKey ??= NewKey(ReportTextKeys.BlockText);
        _texts.SetText(_footer.TextKey, e.Value?.ToString());
    }


    private Task InsertFooterVariableAsync(ReportVariable variable)
    {
