@page "/blocks/new"
@page "/blocks/{BlockId}"

@using System.Globalization
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using Renderset.Blazor.Components.Blocks
@using Renderset.Blazor.Components.Editor
@using Renderset.Core.Blocks
@using Renderset.Core.Configurations
@using Renderset.Core.Definitions
@using Renderset.Core.Localization
@using Renderset.Core.Variables
@using Renderset.Core.Themes

@inject IRenderSetApi RenderSetApi
@inject ICurrentTenant CurrentTenant
@inject NavigationManager Navigation
@inject IToastService Toasts

<PageTitle>@PageTitleText - RenderSet</PageTitle>

@*
    Editor de bloques reutilizables.

    Primero se elige qué se crea (cabecera, pie, texto o campos fijos), con
    una tarjeta por tipo que explica dónde se usa. Después, formulario a la
    izquierda y vista previa a la derecha, con los mismos componentes que el
    documento.

    El identificador ya no hay que escribirlo: se propone a partir del
    nombre y queda en "Avanzado". Antes, sin identificador, los textos que
    se escribían (título, subtítulo, texto del pie) se perdían en silencio,
    porque su clave del diccionario colgaba de él. Ahora la clave se asigna
    la primera vez que se escribe y se guarda en la configuración del
    bloque, así que no depende de en qué orden se rellene el formulario.
*@

<div class="page blk-page">

    <header class="page-header">

        <div>
            <button type="button"
                    class="back-button"
                    @onclick="GoBack">
                <i class="fa-solid fa-arrow-left"></i>
                Bloques
            </button>

            <h1>@PageTitleText</h1>

            <p>
                @if (_typeChosen)
                {
                    @CurrentType.Description
                }
                else
                {
                    <span>Elige qué quieres crear. Cada tipo se usa en un sitio distinto del documento.</span>
                }
            </p>
        </div>

        @if (_typeChosen)
        {
            <div class="page-actions">

                <button type="button"
                        class="secondary-button"
                        @onclick="GoBack">
                    Cancelar
                </button>

                <button type="button"
                        class="primary-button"
                        @onclick="SaveAsync"
                        disabled="@(_saving || !CanSave)">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Guardar
                </button>

            </div>
        }

    </header>


    @if (_loading)
    {
        <div class="page-state">
            Cargando bloque...
        </div>
    }
    else if (!_typeChosen)
    {
        <div class="blk-type-grid">

            @foreach (var option in TypeOptions)
            {
                <button type="button"
                        class="blk-type-card is-@option.Css"
                        @onclick="() => ChooseType(option.Type)">

                    <span class="blk-type-icon">
                        <i class="fa-solid @option.Icon"></i>
                    </span>

                    <span class="blk-type-body">
                        <strong>@option.Label</strong>
                        <span>@option.Description</span>
                        <small>
                            <i class="fa-solid fa-location-dot"></i>
                            @option.WhereUsed
                        </small>
                    </span>

                    <span class="blk-type-sketch" aria-hidden="true">
                        @switch (option.Type)
                        {
                            case ReportBlockType.Header:
                                <span class="sk-row"><span class="sk-logo"></span><span class="sk-lines"><span></span><span class="is-short"></span></span></span>
                                <span class="sk-page"></span>
                                break;

                            case ReportBlockType.Footer:
                                <span class="sk-page"></span>
                                <span class="sk-foot"><span></span><span class="is-short"></span></span>
                                break;

                            case ReportBlockType.Text:
                                <span class="sk-page is-half"></span>
                                <span class="sk-note"><span></span><span></span><span class="is-short"></span></span>
                                break;

                            default:
                                <span class="sk-page is-half"></span>
                                <span class="sk-grid"><span></span><span></span><span></span><span></span></span>
                                break;
                        }
                    </span>

                </button>
            }

        </div>
    }
    else
    {
        <div class="blk-layout">

            <div class="blk-form">

                @* ---------------------------------------------- general *@

                <section class="editor-card">

                    <div class="editor-card-body blk-general">

                        <div class="blk-type-chip is-@CurrentType.Css">
                            <i class="fa-solid @CurrentType.Icon"></i>
                            @CurrentType.Label

                            @if (!IsEditMode)
                            {
                                <button type="button"
                                        title="Elegir otro tipo"
                                        @onclick="ChangeType">
                                    Cambiar
                                </button>
                            }
                        </div>

                        <div class="form-group">
                            <label>Nombre</label>

                            <input type="text"
                                   value="@_name"
                                   @oninput="NameChanged"
                                   placeholder="@CurrentType.NamePlaceholder" />

                            <small>Es lo que se ve al elegir el bloque en el diseñador.</small>
                        </div>

                        <details class="blk-advanced">
                            <summary>Avanzado</summary>

                            <div class="form-group">
                                <label>Identificador</label>

                                <input type="text"
                                       value="@_id"
                                       @oninput="IdChanged"
                                       disabled="@IsEditMode" />

                                <small>
                                    @(IsEditMode
                                        ? "No se puede cambiar: los presets que usan el bloque lo referencian."
                                        : "Se propone a partir del nombre. Sólo minúsculas, números y guiones.")
                                </small>
                            </div>

                            <div class="form-group">
                                <label>Configuración (JSON)</label>
                                <pre class="json-preview">@ConfigurationJson</pre>
                            </div>
                        </details>

                    </div>

                </section>


                @* --------------------------------------------- cabecera *@

                @if (_type == ReportBlockType.Header)
                {
                    <section class="editor-card">

                        <div class="editor-card-header blk-card-header">
                            <span class="blk-step">1</span>
                            <div>
                                <h2>Título y subtítulo</h2>
                                <small>Lo que se lee en grande. Puede ir vacío si el report ya pone el suyo.</small>
                            </div>
                        </div>

                        <div class="editor-card-body">

                            <div class="form-group">
                                <label>Título</label>

                                <div class="variable-input-row">
                                    <input type="text"
                                           value="@KeyText(_header.TitleKey)"
                                           @onchange="HeaderTitleChanged"
                                           placeholder="Albarán {{data.numero}}" />

                                    <VariablePicker Variables="_variables"
                                                    Selected="InsertTitleVariableAsync" />
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Subtítulo</label>

                                <div class="variable-input-row">
                                    <input type="text"
                                           value="@KeyText(_header.SubtitleKey)"
                                           @onchange="HeaderSubtitleChanged"
                                           placeholder="Talleres ORAN S.L.U." />

                                    <VariablePicker Variables="_variables"
                                                    Selected="InsertSubtitleVariableAsync" />
                                </div>
                            </div>

                            <DataTokenHint />

                        </div>

                    </section>

                    <section class="editor-card">

                        <div class="editor-card-header blk-card-header">
                            <span class="blk-step">2</span>
                            <div>
                                <h2>Logo y disposición</h2>
                                <small>Dónde van el logo y el título respecto a los datos de empresa y el QR.</small>
                            </div>
                        </div>

                        <div class="editor-card-body">

                            <div class="blk-layout-options" role="radiogroup" aria-label="Disposición">
                                @foreach (var (layout, label, icon) in HeaderLayouts)
                                {
                                    <button type="button"
                                            role="radio"
                                            aria-checked="@(HeaderLayoutValue == layout ? "true" : "false")"
                                            class="@(HeaderLayoutValue == layout ? "is-active" : null)"
                                            @onclick="() => _header.Layout = layout">
                                        <i class="fa-solid @icon"></i>
                                        @label
                                    </button>
                                }
                            </div>

                            <div class="form-group">
                                <label>Título</label>

                                <div class="blk-layout-options" role="radiogroup" aria-label="Posición del título">
                                    @foreach (var (placement, label, icon) in TitlePlacements)
                                    {
                                        <button type="button"
                                                role="radio"
                                                aria-checked="@(TitlePlacementValue == placement ? "true" : "false")"
                                                class="@(TitlePlacementValue == placement ? "is-active" : null)"
                                                @onclick="() => TitlePlacementChanged(placement)">
                                            <i class="fa-solid @icon"></i>
                                            @label
                                        </button>
                                    }
                                </div>

                                <small class="blk-muted">
                                    Con logo, datos de empresa y QR, el título en banda
                                    propia evita que la cabecera se apelotone.
                                </small>
                            </div>

                            <label class="toggle-row">
                                <input type="checkbox"
                                       checked="@(_header.ShowLogo ?? false)"
                                       @onchange="HeaderShowLogoChanged" />
                                <span>Mostrar logo</span>
                            </label>

                            @if (_header.ShowLogo == true)
                            {
                                <div class="blk-two">
                                    <div class="form-group">
                                        <label>URL del logo</label>

                                        <div class="variable-input-row">
                                            <input type="url"
                                                   value="@_header.LogoUrl"
                                                   @oninput="HeaderLogoUrlChanged"
                                                   placeholder="https://..." />

                                            <VariablePicker Variables="_variables"
                                                            Selected="InsertLogoVariableAsync" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label>Alto máximo (px)</label>

                                        <input type="number"
                                               min="20"
                                               max="300"
                                               step="1"
                                               value="@_header.LogoMaxHeight"
                                               @onchange="HeaderLogoHeightChanged"
                                               placeholder="70" />
                                    </div>
                                </div>
                            }

                        </div>

                    </section>

                    <section class="editor-card">

                        <div class="editor-card-header blk-card-header">
                            <span class="blk-step">3</span>
                            <div>
                                <h2>Datos de empresa</h2>
                                <small>Una línea por dato. Usa columnas para repartirlos a izquierda y derecha.</small>
                            </div>

                            @if (_header.Columns.Count == 0)
                            {
                                <button type="button"
                                        class="secondary-button blk-card-action"
                                        @onclick="EnableHeaderColumns">
                                    <i class="fa-solid fa-table-columns"></i>
                                    En columnas
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="secondary-button blk-card-action"
                                        @onclick="DisableHeaderColumns">
                                    <i class="fa-solid fa-bars"></i>
                                    Una columna
                                </button>
                            }
                        </div>

                        <div class="editor-card-body">

                            @if (_header.Columns.Count == 0)
                            {
                                <div class="header-line-presets">

                                    @foreach (var preset in LinePresets)
                                    {
                                        <button type="button"
                                                class="header-line-preset"
                                                title="Añadir una línea de @preset.Label"
                                                @onclick="() => AddPresetLine(preset)">
                                            <i class="fa-solid fa-plus"></i>
                                            @preset.Label
                                        </button>
                                    }

                                    <button type="button"
                                            class="header-line-preset"
                                            @onclick="() => AddHeaderLine()">
                                        <i class="fa-solid fa-plus"></i>
                                        Línea vacía
                                    </button>

                                </div>

                                @if (_header.Lines.Count == 0)
                                {
                                    <p class="blk-empty-hint">
                                        Sin líneas. Pulsa un dato de arriba: la línea se crea
                                        apuntando a la variable del tenant que encaje
                                        (CIF: &#123;&#123;company.cif&#125;&#125;).
                                    </p>
                                }

                                @foreach (var line in OrderedHeaderLines)
                                {
                                    @HeaderLineRow(line, null)
                                }
                            }
                            else
                            {
                                <div class="header-columns-editor">
                                    @foreach (var column in _header.Columns)
                                    {
                                        var columnIndex = _header.Columns.IndexOf(column);

                                        <section class="header-column-card" @key="column.Id">
                                            <header>
                                                <div>
                                                    <strong>Columna @(columnIndex + 1)</strong>
                                                    <span>@column.Lines.Count línea(s)</span>
                                                </div>

                                                <button type="button"
                                                        class="icon-button is-danger"
                                                        title="Quitar columna"
                                                        disabled="@(_header.Columns.Count <= 1)"
                                                        @onclick="() => RemoveHeaderColumn(column)">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </header>

                                            <div class="header-column-options">
                                                <label>
                                                    <span>Alineación</span>
                                                    <select value="@column.Align"
                                                            @onchange="e => HeaderColumnAlignmentChanged(column, e)">
                                                        <option value="@ReportHorizontalAlignment.Left">Izquierda</option>
                                                        <option value="@ReportHorizontalAlignment.Center">Centro</option>
                                                        <option value="@ReportHorizontalAlignment.Right">Derecha</option>
                                                    </select>
                                                </label>

                                                <label>
                                                    <span>Ancho (%)</span>
                                                    <input type="number"
                                                           min="10"
                                                           max="100"
                                                           step="5"
                                                           value="@column.Width"
                                                           @onchange="e => HeaderColumnWidthChanged(column, e)" />
                                                </label>
                                            </div>

                                            <div class="header-line-presets">
                                                @foreach (var preset in LinePresets)
                                                {
                                                    <button type="button"
                                                            class="header-line-preset"
                                                            @onclick="() => AddPresetLine(column, preset)">
                                                        <i class="fa-solid fa-plus"></i>
                                                        @preset.Label
                                                    </button>
                                                }

                                                <button type="button"
                                                        class="header-line-preset"
                                                        @onclick="() => AddHeaderLine(column)">
                                                    <i class="fa-solid fa-plus"></i>
                                                    Línea vacía
                                                </button>
                                            </div>

                                            @foreach (var line in column.Lines.OrderBy(x => x.Order))
                                            {
                                                @HeaderLineRow(line, column)
                                            }
                                        </section>
                                    }
                                </div>

                                <button type="button"
                                        class="secondary-button header-column-add"
                                        disabled="@(_header.Columns.Count >= 4)"
                                        @onclick="AddHeaderColumn">
                                    <i class="fa-solid fa-plus"></i>
                                    Añadir columna
                                </button>
                            }

                        </div>

                    </section>

                    <section class="editor-card">

                        <div class="editor-card-header blk-card-header">
                            <span class="blk-step">4</span>
                            <div>
                                <h2>Colores</h2>
                                <small>Opcional: sin colores la cabecera usa los del tema.</small>
                            </div>
                        </div>

                        <div class="editor-card-body">

                            <div class="blk-two">
                                <div class="form-group">
                                    <label>Fondo</label>

                                    <div class="color-input-row">
                                        <input type="color"
                                               value="@(_header.BackgroundColor ?? "#ffffff")"
                                               @onchange="e => _header.BackgroundColor = Normalize(e.Value?.ToString())" />

                                        <span>@(_header.BackgroundColor ?? "Sin fondo")</span>

                                        @if (_header.BackgroundColor is not null)
                                        {
                                            <button type="button"
                                                    class="link-button"
                                                    @onclick="() => _header.BackgroundColor = null">
                                                Quitar
                                            </button>
                                        }
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label>Texto</label>

                                    <div class="color-input-row">
                                        <input type="color"
                                               value="@(_header.TextColor ?? "#1f2933")"
                                               @onchange="e => _header.TextColor = Normalize(e.Value?.ToString())" />

                                        <span>@(_header.TextColor ?? "Del tema")</span>

                                        @if (_header.TextColor is not null)
                                        {
                                            <button type="button"
                                                    class="link-button"
                                                    @onclick="() => _header.TextColor = null">
                                                Quitar
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>

                            <label class="toggle-row">
                                <input type="checkbox"
                                       checked="@(_header.ShowDivider ?? true)"
                                       @onchange="e => _header.ShowDivider = e.Value is bool v && v" />
                                <span>Línea de separación bajo la cabecera</span>
                            </label>

                        </div>

                    </section>
                }


                @* ------------------------------------------------- pie *@

                @if (_type == ReportBlockType.Footer)
                {
                    <section class="editor-card">

                        <div class="editor-card-header blk-card-header">
                            <span class="blk-step">1</span>
                            <div>
                                <h2>Texto del pie</h2>
                                <small>Texto legal, registro mercantil, dirección... Admite varias líneas.</small>
                            </div>
                        </div>

                        <div class="editor-card-body">

                            <div class="form-group">
                                <div class="form-label-row">
                                    <label>Texto</label>

                                    <VariablePicker Variables="_variables"
                                                    Selected="InsertFooterVariableAsync" />
                                </div>

                                <textarea rows="4"
                                          value="@KeyText(_footer.TextKey)"
                                          @onchange="FooterTextChanged"
                                          placeholder="Inscrita en el Registro Mercantil de Cantabria..."></textarea>

                                <VariableOnlyHint Text="@KeyText(_footer.TextKey)" />
                            </div>

                            <DataTokenHint />

                        </div>

                    </section>

                    <section class="editor-card">

                        <div class="editor-card-header blk-card-header">
                            <span class="blk-step">2</span>
                            <div>
                                <h2>Fecha y numeración</h2>
                                <small>Se repiten en cada hoja al imprimir y en el PDF.</small>
                            </div>
                        </div>

                        <div class="editor-card-body">

                            <label class="toggle-row">
                                <input type="checkbox"
                                       checked="@(_footer.ShowGenerationDate ?? false)"
                                       @onchange="e => _footer.ShowGenerationDate = e.Value is bool v && v" />
                                <span>Fecha de generación</span>
                            </label>

                            <label class="toggle-row">
                                <input type="checkbox"
                                       checked="@(_footer.ShowPageNumber ?? false)"
                                       @onchange="e => _footer.ShowPageNumber = e.Value is bool v && v" />
                                <span>Número de página (Página 1 de 3)</span>
                            </label>

                            <small class="blk-muted">
                                El formato de la numeración se traduce en el diccionario
                                común, clave footer.pageNumber.
                            </small>

                        </div>

                    </section>
                }


                @* ----------------------------------------------- texto *@

                @if (_type == ReportBlockType.Text)
                {
                    <section class="editor-card">

                        <div class="editor-card-header blk-card-header">
                            <span class="blk-step">1</span>
                            <div>
                                <h2>Contenido</h2>
                                <small>Un aviso, condiciones o nota. Se añade al cuerpo desde el diseñador: Añadir contenido → Bloque existente.</small>
                            </div>
                        </div>

                        <div class="editor-card-body">

                            <div class="form-group">
                                <label>Título (opcional)</label>

                                <div class="variable-input-row">
                                    <input type="text"
                                           value="@KeyText(_text.TitleKey, _text.Title ?? string.Empty)"
                                           @onchange="TextTitleChanged"
                                           placeholder="Condiciones de entrega" />

                                    <VariablePicker Variables="_variables"
                                                    Selected="InsertTextTitleVariableAsync" />
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="form-label-row">
                                    <label>Texto</label>

                                    <VariablePicker Variables="_variables"
                                                    Selected="InsertTextVariableAsync" />
                                </div>

                                <textarea rows="7"
                                          value="@KeyText(_text.TextKey, _text.Text)"
                                          @onchange="TextContentChanged"
                                          placeholder="Escribe el aviso, las condiciones o cualquier texto reutilizable..."></textarea>

                                <VariableOnlyHint Text="@KeyText(_text.TextKey, _text.Text)" />
                            </div>

                            <DataTokenHint />

                        </div>

                    </section>

                    <section class="editor-card">

                        <div class="editor-card-header blk-card-header">
                            <span class="blk-step">2</span>
                            <div>
                                <h2>Aspecto</h2>
                            </div>
                        </div>

                        <div class="editor-card-body">

                            <div class="blk-style-options" role="radiogroup" aria-label="Estilo">
                                @foreach (var (style, label) in TextStyles)
                                {
                                    <button type="button"
                                            role="radio"
                                            aria-checked="@(_text.Style == style ? "true" : "false")"
                                            class="blk-style-option is-@style.ToString().ToLowerInvariant() @(_text.Style == style ? "is-active" : null)"
                                            @onclick="() => _text.Style = style">
                                        <span></span>
                                        @label
                                    </button>
                                }
                            </div>

                            <div class="blk-layout-options" role="radiogroup" aria-label="Alineación">
                                @foreach (var (alignment, label, icon) in Alignments)
                                {
                                    <button type="button"
                                            role="radio"
                                            aria-checked="@(TextAlignment == alignment ? "true" : "false")"
                                            class="@(TextAlignment == alignment ? "is-active" : null)"
                                            @onclick="() => _text.Alignment = alignment">
                                        <i class="fa-solid @icon"></i>
                                        @label
                                    </button>
                                }
                            </div>

                        </div>

                    </section>
                }


                @* -------------------------------------- campos fijos *@

                @if (_type == ReportBlockType.Fields)
                {
                    <section class="editor-card">

                        <div class="editor-card-header blk-card-header">
                            <span class="blk-step">1</span>
                            <div>
                                <h2>Título</h2>
                                <small>La banda de arriba, como el nombre de una sección. Opcional.</small>
                            </div>
                        </div>

                        <div class="editor-card-body">

                            <div class="variable-input-row">
                                <input type="text"
                                       class="blk-input"
                                       value="@KeyText(_fields.TitleKey)"
                                       @onchange="FieldsTitleChanged"
                                       placeholder="Datos de la empresa" />

                                <VariablePicker Variables="_variables"
                                                Selected="InsertFieldsTitleVariableAsync" />
                            </div>

                        </div>

                    </section>

                    <section class="editor-card">

                        <div class="editor-card-header blk-card-header">
                            <span class="blk-step">2</span>
                            <div>
                                <h2>Campos</h2>
                                <small>Etiqueta y valor. El valor admite variables del tenant y datos del documento.</small>
                            </div>
                        </div>

                        <div class="editor-card-body">

                            <div class="header-line-presets">

                                @foreach (var preset in LinePresets)
                                {
                                    <button type="button"
                                            class="header-line-preset"
                                            title="Añadir @preset.Label"
                                            @onclick="() => AddFixedField(preset)">
                                        <i class="fa-solid fa-plus"></i>
                                        @preset.Label
                                    </button>
                                }

                                <button type="button"
                                        class="header-line-preset"
                                        @onclick="() => AddFixedField(null)">
                                    <i class="fa-solid fa-plus"></i>
                                    Campo vacío
                                </button>

                            </div>

                            @if (_fields.Fields.Count == 0)
                            {
                                <p class="blk-empty-hint">
                                    Sin campos. Pulsa un dato de arriba para añadirlo ya
                                    apuntando a la variable del tenant que encaje.
                                </p>
                            }
                            else
                            {
                                <div class="blk-field-head">
                                    <span>Etiqueta</span>
                                    <span>Valor</span>
                                </div>
                            }

                            @foreach (var field in OrderedFixedFields)
                            {
                                <div class="blk-field-row" @key="field.Id">

                                    <input type="text"
                                           value="@KeyText(field.LabelKey)"
                                           @onchange="e => FixedFieldLabelChanged(field, e)"
                                           placeholder="CIF" />

                                    <div class="variable-input-row">
                                        <input type="text"
                                               value="@KeyText(field.ValueKey)"
                                               @onchange="e => FixedFieldValueChanged(field, e)"
                                               placeholder="{{company.cif}}" />

                                        <VariablePicker Variables="_variables"
                                                        Selected="variable => InsertFixedFieldVariableAsync(field, variable)" />
                                    </div>

                                    <div class="header-line-actions">
                                        <button type="button"
                                                title="Subir"
