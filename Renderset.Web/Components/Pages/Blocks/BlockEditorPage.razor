    private bool CanMoveFixedField(
        ReportFixedFieldConfiguration field,
        int direction)
    {
        var ordered = OrderedFixedFields.ToList();
        var index = ordered.IndexOf(field);
        var target = index + direction;

        return index >= 0 && target >= 0 && target < ordered.Count;
    }


    private void MoveFixedField(
        ReportFixedFieldConfiguration field,
        int direction)
    {
        var ordered = OrderedFixedFields.ToList();
        var index = ordered.IndexOf(field);
        var target = index + direction;

        if (index < 0 || target < 0 || target >= ordered.Count)
            return;

        (ordered[index], ordered[target]) = (ordered[target], ordered[index]);

        SetFixedFields(ordered);
    }


    private void RemoveFixedField(
        ReportFixedFieldConfiguration field) =>
        SetFixedFields(
            OrderedFixedFields
                .Where(x => !ReferenceEquals(x, field))
                .ToList());


    private void SetFixedFields(
        List<ReportFixedFieldConfiguration> fields)
    {
        for (var i = 0; i < fields.Count; i++)
            fields[i].Order = (i + 1) * 10;

        _fields.Fields = fields;
    }


    private void FieldsLayoutChanged(
        ReportSectionGridLayout layout)
    {
        // Lista es lo de por defecto: se guarda nulo.
        _fields.Layout = layout.IsList ? null : layout.Layout;
        _fields.Columns = layout.StoredColumns;
    }


    // ----------------------------------------------------------- guardar

    private async Task SaveAsync()
    {
        if (!CanSave)
        {
            Toasts.Warning("Ponle un nombre al bloque antes de guardarlo.");
            return;
        }

        var blockId = _id.Trim();

        if (!IsEditMode &&
            _existingBlocks.Any(x => string.Equals(x.Id, blockId, StringComparison.OrdinalIgnoreCase)))
        {
            Toasts.Warning($"Ya existe un bloque con el identificador '{blockId}'. Cámbialo en Avanzado.");
            return;
        }

        _saving = true;

        try
        {
            var block =
                new ReportBlock
                {
                    Id = blockId,
                    Name = _name.Trim(),
                    Type = _type,
                    ConfigurationJson = ConfigurationJson
                };

            var saved = await Toasts.RunApiAsync(
                () => RenderSetApi.SaveBlockAsync(
                    CurrentTenant.Id,
                    block.Id,
                    block),
                errorTitle: "No se ha podido guardar el bloque");

            if (!saved)
                return;

            if (!await SaveTextsAsync())
                return;

            Toasts.Success("Bloque guardado.");

            Navigation.NavigateTo("/blocks");
        }
        catch (Exception exception)
        {
            Toasts.Error(
                ToastServiceExtensions.Describe(exception),
                "No se ha podido guardar el bloque");
        }
        finally
        {
            _saving = false;
        }
    }


    private async Task<bool> SaveTextsAsync()
    {
        if (!_texts.HasPendingChanges)
            return true;

        var saved = await Toasts.RunApiAsync(
            () => RenderSetApi.SaveResourcesAsync(
                CurrentTenant.Id,
                _texts.GetPendingChanges()),
            errorTitle: "No se han podido guardar los textos del bloque");

        if (saved)
            _texts.AcceptPendingChanges();

        return saved;
    }


    private void GoBack() =>
        Navigation.NavigateTo("/blocks");


    // ------------------------------------------------------------- utils

    private static T Deserialize<T>(
        string? json)
        where T : new()
    {
        if (string.IsNullOrWhiteSpace(json))
            return new T();

        try
        {
            return JsonSerializer.Deserialize<T>(json, JsonOptions) ?? new T();
        }
        catch (JsonException)
        {
            return new T();
        }
    }


    private static string AppendToken(
        string? current,
        string key)
    {
        var token = $"{{{{{key}}}}}";

        if (string.IsNullOrEmpty(current))
            return token;

        return current.EndsWith(' ')
            ? current + token
            : current + " " + token;
    }


    private static string ShortId() =>
        Guid.NewGuid().ToString("N")[..8];


    private static string? Normalize(
        string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? null
            : value.Trim();


    /// <summary>
    /// Id legible y estable: sin acentos, sin espacios y en minúsculas.
    /// </summary>
    private static string Slug(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        var normalized =
            value
                .Trim()
                .ToLowerInvariant()
                .Normalize(NormalizationForm.FormD);

        var builder = new StringBuilder();
        var lastWasSeparator = false;

        foreach (var character in normalized)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(character) == UnicodeCategory.NonSpacingMark)
                continue;

            if (char.IsAsciiLetterOrDigit(character))
            {
                builder.Append(character);
                lastWasSeparator = false;
                continue;
            }

            if (lastWasSeparator || builder.Length == 0)
                continue;

            builder.Append('-');
            lastWasSeparator = true;
        }

        var slug = builder.ToString().Trim('-');

        return slug.Length > 60
            ? slug[..60].Trim('-')
            : slug;
    }
