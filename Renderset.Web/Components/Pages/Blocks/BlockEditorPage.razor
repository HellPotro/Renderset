    private void AddFixedField(
        LinePreset? preset)
    {
        var field =
            new ReportFixedFieldConfiguration
            {
                Id = ShortId(),
                Order = _fields.Fields.Count == 0 ? 10 : _fields.Fields.Max(x => x.Order) + 10
            };

        field.LabelKey = ReportTextKeys.BlockFieldLabel(field.Id);
        field.ValueKey = ReportTextKeys.BlockFieldValue(field.Id);

        _fields.Fields.Add(field);

        if (preset is null)
            return;

        _texts.SetText(field.LabelKey, preset.Label);

        var token = SuggestVariableToken(preset.Hints);

        if (token is not null)
            _texts.SetText(field.ValueKey, token);
    }


