@page "/blocks/new"
@page "/blocks/{BlockId}"

@using System.Text.Json
@using System.Text.Json.Serialization
@using Renderset.Blazor.Components.Blocks
@using Renderset.Core.Blocks
@using Renderset.Core.Configurations 
@using Renderset.Core.Definitions
@using Renderset.Core.Localization
@using Renderset.Core.Variables 
@using Renderset.Core.Themes

@inject IRenderSetApi RenderSetApi
@inject ICurrentTenant CurrentTenant
@inject NavigationManager Navigation
@inject IToastService Toasts

<PageTitle>@PageTitleText - RenderSet</PageTitle>

<div class="page">

    <header class="page-header">

        <div>
            <button type="button"
                    class="back-button"
                    @onclick="GoBack">
                <i class="fa-solid fa-arrow-left"></i>
                Blocks
            </button>

            <h1>@PageTitleText</h1>

            <p>
                Configura un bloque reutilizable para usarlo en varios reports.
            </p>
        </div>

        <div class="page-actions">

            <button type="button"
                    class="secondary-button"
                    @onclick="GoBack">
                Cancelar
            </button>

            <button type="button"
                    class="primary-button"
                    @onclick="SaveAsync"
                    disabled="@_saving">
                <i class="fa-solid fa-floppy-disk"></i>
                Guardar
            </button>

        </div>

    </header>


    @if (!_loading && _cultures.Count > 0)
    {
        <section class="editor-card language-card">

            <div class="editor-card-body language-card-body">

                <div>
                    <strong>Idioma de edición</strong>
                    <span>Los textos del bloque se guardan como resources traducibles.</span>
                </div>

                <select value="@_selectedCulture"
                        @onchange="ChangeCultureAsync">

                    @foreach (var culture in _cultures)
                    {
                        <option value="@culture.Culture">
                            @culture.DisplayName (@culture.Culture)
                        </option>
                    }

                </select>

            </div>

        </section>
    }


    @if (_loading)
    {
        <div class="page-state">
            Cargando bloque...
        </div>
    }
    else
    {
        <div class="editor-layout">

            <section class="editor-card">

                <div class="editor-card-header">
                    <h2>General</h2>
                </div>

                <div class="editor-card-body">

                    <div class="form-group">
                        <label>Identificador</label>

                        <input type="text"
                               value="@_id"
                               @oninput="e => _id = e.Value?.ToString() ?? string.Empty"
                               disabled="@IsEditMode"
                               placeholder="oran-default-header" />

                        <small>
                            Se usa internamente para referenciar el bloque.
                        </small>
                    </div>

                    <div class="form-group">
                        <label>Nombre</label>

                        <input type="text"
                               value="@_name"
                               @oninput="e => _name = e.Value?.ToString() ?? string.Empty"
                               placeholder="Cabecera ORAN" />
                    </div>

                    <div class="form-group">
                        <label>Tipo</label>

                        <select value="@_type"
                                @onchange="BlockTypeChanged"
                                disabled="@IsEditMode">

                            <option value="@ReportBlockType.Header">
                                Cabecera
                            </option>

                            <option value="@ReportBlockType.Footer">
                                Pie de página
                            </option>

                            <option value="@ReportBlockType.Text">
                                Texto
                            </option>

                        </select>
                    </div>

                </div>

            </section>


            @if (_type == ReportBlockType.Header)
            {
                <section class="editor-card">

                    <div class="editor-card-header">
                        <h2>Cabecera</h2>
                    </div>

                    <div class="editor-card-body">

                        <div class="form-group">
                            <label>Título</label>

                            <input type="text"
                                   value="@BlockText(ReportTextKeys.BlockTitle(_id))"
                                   @onchange="HeaderTitleChanged"
                                   placeholder="Opcional" />
                        </div>

                        <div class="form-group">

                            <label>Subtítulo</label>

                            <div class="variable-input-row">

                                <input type="text"
                                       value="@BlockText(ReportTextKeys.BlockSubtitle(_id))"
                                       @onchange="HeaderSubtitleChanged"
                                       placeholder="Talleres ORAN S.L.U." />

                                <VariablePicker Variables="_variables"
                                                Selected="InsertSubtitleVariableAsync" />

                            </div>

                        </div>

                        <label class="toggle-row">

                            <input type="checkbox"
                                   checked="@(_header.ShowLogo ?? false)"
                                   @onchange="HeaderShowLogoChanged" />

                            <span>Mostrar logo</span>

                        </label>

                        @if (_header.ShowLogo == true)
                        {
                            <div class="form-group">

                                <label>URL del logo</label>

                                <div class="variable-input-row">

                                    <input type="url"
                                           value="@_header.LogoUrl"
                                           @oninput="HeaderLogoUrlChanged"
                                           placeholder="https://..." />

                                    <VariablePicker Variables="_variables"
                                                    Selected="InsertLogoVariableAsync" />

                                </div>

                            </div>

                            <div class="form-group">

                                <label>Alto máximo del logo (px)</label>

                                <input type="number"
                                       min="20"
                                       max="300"
                                       step="1"
                                       value="@_header.LogoMaxHeight"
                                       @onchange="HeaderLogoHeightChanged"
                                       placeholder="70" />

                            </div>
                        }

                        <div class="form-group">

                            <label>Disposición</label>

                            <select value="@HeaderLayoutValue"
                                    @onchange="HeaderLayoutChanged">

                                <option value="@ReportHeaderLayout.LogoLeft">
                                    Logo a la izquierda
                                </option>

                                <option value="@ReportHeaderLayout.LogoRight">
                                    Logo a la derecha
                                </option>

                                <option value="@ReportHeaderLayout.Stacked">
                                    Logo arriba, todo centrado
                                </option>

                            </select>

                        </div>

                        <div class="form-group">

                            <label>Datos de la empresa</label>

                            <div class="header-line-presets">

                                @foreach (var preset in HeaderLinePresets)
                                {
                                    <button type="button"
                                            class="header-line-preset"
                                            title="Añadir una línea de @preset.Label"
                                            @onclick="() => AddPresetLine(preset)">

                                        <i class="fa-solid fa-plus"></i>
                                        @preset.Label

                                    </button>
                                }

                                <button type="button"
                                        class="header-line-preset"
                                        @onclick="() => AddHeaderLine()">

                                    <i class="fa-solid fa-plus"></i>
                                    Línea vacía

                                </button>

                            </div>

                            @if (_header.Lines.Count == 0)
                            {
                                <small>
                                    Cada línea es un texto libre que puede llevar
                                    variables del tenant, por ejemplo
                                    CIF: &#123;&#123;company.cif&#125;&#125;.
                                </small>
                            }

                            @foreach (var line in OrderedHeaderLines)
                            {
                                <div class="header-line-row" @key="line.Id">

                                    <input type="text"
                                           value="@HeaderLineText(line)"
                                           @onchange="e => HeaderLineTextChanged(line, e)"
                                           placeholder="Texto de la línea" />

                                    <VariablePicker Variables="_variables"
                                                    Selected="variable => InsertHeaderLineVariableAsync(line, variable)" />

                                    <select value="@line.Style"
                                            @onchange="e => HeaderLineStyleChanged(line, e)">

                                        <option value="@ReportHeaderLineStyle.Normal">
                                            Normal
                                        </option>

                                        <option value="@ReportHeaderLineStyle.Strong">
                                            Destacado
                                        </option>

                                        <option value="@ReportHeaderLineStyle.Muted">
                                            Secundario
                                        </option>

                                        <option value="@ReportHeaderLineStyle.Small">
                                            Pequeño
                                        </option>

                                    </select>

                                    <div class="header-line-actions">

                                        <button type="button"
                                                title="Subir"
                                                disabled="@(!CanMoveHeaderLine(line, -1))"
                                                @onclick="() => MoveHeaderLine(line, -1)">
                                            <i class="fa-solid fa-arrow-up"></i>
                                        </button>

                                        <button type="button"
                                                title="Bajar"
                                                disabled="@(!CanMoveHeaderLine(line, 1))"
                                                @onclick="() => MoveHeaderLine(line, 1)">
                                            <i class="fa-solid fa-arrow-down"></i>
                                        </button>

                                        <button type="button"
                                                class="is-danger"
                                                title="Quitar línea"
                                                @onclick="() => RemoveHeaderLine(line)">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>

                                    </div>

                                </div>
                            }

                        </div>

                        <div class="form-group">

                            <label>Color de fondo</label>

                            <div class="color-input-row">

                                <input type="color"
                                       value="@(_header.BackgroundColor ?? "#ffffff")"
                                       @onchange="HeaderBackgroundChanged" />

                                <span>@(_header.BackgroundColor ?? "Sin fondo")</span>

                                <button type="button"
                                        class="secondary-button"
                                        @onclick="() => _header.BackgroundColor = null">
                                    Quitar
                                </button>

                            </div>

                        </div>

                        <div class="form-group">

                            <label>Color del texto</label>

                            <div class="color-input-row">

                                <input type="color"
                                       value="@(_header.TextColor ?? "#1f2933")"
                                       @onchange="HeaderTextColorChanged" />

                                <span>@(_header.TextColor ?? "Del tema")</span>

                                <button type="button"
                                        class="secondary-button"
                                        @onclick="() => _header.TextColor = null">
                                    Quitar
                                </button>

                            </div>

                        </div>

                        <label class="toggle-row">

                            <input type="checkbox"
                                   checked="@(_header.ShowDivider ?? true)"
                                   @onchange="HeaderDividerChanged" />

                            <span>Línea de separación bajo la cabecera</span>

                        </label>

                        <BlockPreview Type="ReportBlockType.Header"
                                      Header="_header"
                                      Texts="_texts"
                                      Variables="_variables"
                                      Theme="_theme" />

                    </div>

                </section>
            }


            @if (_type == ReportBlockType.Footer)
            {
                <section class="editor-card">

                    <div class="editor-card-header">
                        <h2>Pie de página</h2>
                    </div>

                    <div class="editor-card-body">

                        <div class="form-group">
                            <label>Texto</label>

                            <textarea rows="4"
                                      value="@BlockText(ReportTextKeys.BlockText(_id))"
                                      @onchange="FooterTextChanged"
                                      placeholder="Texto legal, dirección, contacto..."></textarea>

                                      
                            <VariablePicker Variables="_variables"
                                            Selected="InsertFooterTextVariableAsync" />
                        </div>

                        <label class="toggle-row">

                            <input type="checkbox"
                                   checked="@(_footer.ShowGenerationDate ?? false)"
                                   @onchange="FooterGenerationDateChanged" />

                            <span>Mostrar fecha de generación</span>

                        </label>

                        <label class="toggle-row">

                            <input type="checkbox"
                                   checked="@(_footer.ShowPageNumber ?? false)"
                                   @onchange="FooterPageNumberChanged" />

                            <span>Mostrar número de página</span>

                        </label>

                        <BlockPreview Type="ReportBlockType.Footer"
                                      Footer="_footer"
                                      Texts="_texts"
                                      Variables="_variables"
                                      Theme="_theme" />

                    </div>

                </section>
            }


            @if (_type == ReportBlockType.Text)
            {
                <section class="editor-card">

                    <div class="editor-card-header">
                        <h2>Texto</h2>
                    </div>

                    <div class="editor-card-body">

                        <div class="form-group">
                            <label>Título opcional</label>

                            <div class="variable-input-row">
                                <input type="text"
                                       value="@TextBlockTitleValue"
                                       @oninput="TextTitleChanged"
                                       placeholder="Directrices de seguridad" />

                                <VariablePicker Variables="_variables"
                                                Selected="InsertTextTitleVariableAsync" />
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="form-label-row">
                                <label>Contenido</label>

                                <VariablePicker Variables="_variables"
                                                Selected="InsertTextVariableAsync" />
                            </div>

                            <textarea rows="8"
                                      value="@TextBlockTextValue"
                                      @oninput="TextContentChanged"
                                      placeholder="Escribe las directrices, avisos, condiciones o cualquier texto reutilizable..."></textarea>

                            <small>
                                Puedes insertar variables del tenant dentro del texto.
                            </small>
                        </div>

                        <div class="form-group">
                            <label>Estilo</label>

                            <select value="@_text.Style"
                                    @onchange="TextStyleChanged">
                                <option value="@ReportTextBlockStyle.Default">Normal</option>
                                <option value="@ReportTextBlockStyle.Information">Información</option>
                                <option value="@ReportTextBlockStyle.Warning">Aviso</option>
                                <option value="@ReportTextBlockStyle.Success">Correcto</option>
                            </select>
                        </div>

                        <BlockPreview Type="ReportBlockType.Text"
                                      Text="_text"
                                      Texts="_texts"
                                      Variables="_variables"
                                      Theme="_theme" />

                    </div>

                </section>
            }


            <section class="editor-card">

                <div class="editor-card-header">
                    <h2>JSON resultante</h2>
                </div>

                <div class="editor-card-body">

                    <pre class="json-preview">@ConfigurationJson</pre>

                </div>

            </section>

        </div>
    }

</div>


@code {

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        PropertyNameCaseInsensitive = true,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
        Converters =
        {
            new JsonStringEnumConverter()
        }
    };

    [Parameter]
    public string? BlockId { get; set; }

    private string _id = string.Empty;
    private string _name = string.Empty;

    private ReportBlockType _type =
        ReportBlockType.Header;

    private ReportHeaderConfiguration _header = new();

    private ReportFooterConfiguration _footer = new();

    private ReportTextBlockConfiguration _text = new();

    private IReadOnlyCollection<ReportVariable> _variables = [];

    private IReadOnlyCollection<TenantCulture> _cultures = [];

    private readonly ReportTheme _theme = new();

    private string? _selectedCulture;

    private ReportTextWorkspace _texts =
        ReportTextWorkspace.Detached();

    private string? _activeVariableTarget;

    private bool _loading;
    private bool _saving;


    private bool IsEditMode =>
        !string.IsNullOrWhiteSpace(BlockId);

    private string PageTitleText =>
        IsEditMode
            ? "Editar bloque"
            : "Nuevo bloque";


    private string ConfigurationJson
    {
        get
        {
            return _type switch
            {
                ReportBlockType.Header =>
                    JsonSerializer.Serialize(
                        _header,
                        JsonOptions),

                ReportBlockType.Footer =>
                    JsonSerializer.Serialize(
                        _footer,
                        JsonOptions),

                ReportBlockType.Text =>
                    JsonSerializer.Serialize(
                        _text,
                        JsonOptions),

                _ => "{}"
            };
        }
    }


    protected override async Task OnParametersSetAsync()
    {
        if (!IsEditMode)
        {
            ResetNewBlock();
            await Toasts.RunAsync(
                LoadEditorContextAsync,
                errorTitle: "No se han podido cargar los datos del editor");
            return;
        }

        await LoadAsync();
    }


    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            var block =
                await RenderSetApi.GetBlockAsync(
                    CurrentTenant.Id,
                    BlockId!);

            _id = block.Id;
            _name = block.Name;
            _type = block.Type;

            if (_type == ReportBlockType.Header)
            {
                _header =
                    JsonSerializer.Deserialize<ReportHeaderConfiguration>(
                        block.ConfigurationJson,
                        JsonOptions)
                    ?? new ReportHeaderConfiguration();
            }
            else if (_type == ReportBlockType.Footer)
            {
                _footer =
                    JsonSerializer.Deserialize<ReportFooterConfiguration>(
                        block.ConfigurationJson,
                        JsonOptions)
                    ?? new ReportFooterConfiguration();
            }
            else if (_type == ReportBlockType.Text)
            {
                _text =
                    JsonSerializer.Deserialize<ReportTextBlockConfiguration>(
                        block.ConfigurationJson,
                        JsonOptions)
                    ?? new ReportTextBlockConfiguration();
            }

            await LoadEditorContextAsync();
        }
        catch (Exception exception)
        {
            Toasts.Error(
                ToastServiceExtensions.Describe(exception),
                "No se ha podido cargar el bloque");

            Navigation.NavigateTo("/blocks");
        }
        finally
        {
            _loading = false;
        }
    }


    private async Task LoadEditorContextAsync()
    {
        _variables =
            await RenderSetApi.GetVariablesAsync(
                CurrentTenant.Id);

        _cultures =
            await RenderSetApi.GetCulturesAsync(
                CurrentTenant.Id);

        _selectedCulture ??=
            _cultures.FirstOrDefault(x => x.IsDefault)?.Culture
            ?? _cultures.FirstOrDefault()?.Culture;

        _texts =
            await LoadTextsAsync(
                _selectedCulture);
    }


    private async Task<ReportTextWorkspace> LoadTextsAsync(
        string? culture)
    {
        if (string.IsNullOrWhiteSpace(culture))
            return ReportTextWorkspace.Detached();

        var resources =
            await RenderSetApi.GetResourcesAsync(
                CurrentTenant.Id,
                ReportResourceScope.Global);

        return new ReportTextWorkspace(
            ReportResourceScope.Global,
            culture,
            resources);
    }


    private async Task ChangeCultureAsync(
        ChangeEventArgs e)
    {
        if (_texts.HasPendingChanges &&
            !await SaveTextsAsync())
        {
            return;
        }

        _selectedCulture =
            e.Value?.ToString();

        var texts = await Toasts.RunAsync(
            () => LoadTextsAsync(_selectedCulture),
            errorTitle: "No se han podido cargar los textos del bloque");

        if (texts is not null)
            _texts = texts;
    }


    private void ResetNewBlock()
    {
        _id = string.Empty;
        _name = string.Empty;

        _type =
            ReportBlockType.Header;

        _header =
            new ReportHeaderConfiguration();

        _footer =
            new ReportFooterConfiguration();

        _text =
            new ReportTextBlockConfiguration();
    }


    private void BlockTypeChanged(
        ChangeEventArgs e)
    {
        if (Enum.TryParse<ReportBlockType>(
                e.Value?.ToString(),
                out var type))
        {
            _type = type;
        }
    }


    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_id))
            return;

        if (string.IsNullOrWhiteSpace(_name))
            return;

        _saving = true;

        try
        {
            var blockId =
                _id.Trim();

            PrepareConfigurationForSave(blockId);

            var block =
                new ReportBlock
                {
                    Id = blockId,
                    Name = _name.Trim(),
                    Type = _type,
                    ConfigurationJson =
                        ConfigurationJson
                };

            var saved = await Toasts.RunApiAsync(
                () => RenderSetApi.SaveBlockAsync(
                    CurrentTenant.Id,
                    block.Id,
                    block),
                errorTitle: "No se ha podido guardar el bloque");

            if (!saved)
                return;

            if (!await SaveTextsAsync())
                return;

            Toasts.Success("Bloque guardado.");

            Navigation.NavigateTo(
                "/blocks");
        }
        catch (Exception exception)
        {
            Toasts.Error(
                ToastServiceExtensions.Describe(exception),
                "No se ha podido guardar el bloque");
        }
        finally
        {
            _saving = false;
        }
    }


    private void GoBack()
    {
        Navigation.NavigateTo(
            "/blocks");
    }


    /// <summary>
    /// Los bloques son de tenant, así que sus textos van al ámbito global del
    /// diccionario. La configuración del bloque sólo guarda la clave.
    /// </summary>
    private string BlockText(
        string? key,
        string fallback = "") =>
        string.IsNullOrWhiteSpace(key)
            ? fallback
            : _texts.GetText(
                key,
                fallback);


    private void HeaderTitleChanged(
        ChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(_id))
            return;

        _header.TitleKey =
            ReportTextKeys.BlockTitle(_id.Trim());

        _texts.SetText(
            _header.TitleKey,
            e.Value?.ToString());
    }


    private void HeaderSubtitleChanged(
        ChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(_id))
            return;

        _header.SubtitleKey =
            ReportTextKeys.BlockSubtitle(_id.Trim());

        _texts.SetText(
            _header.SubtitleKey,
            e.Value?.ToString());
    }


    private void HeaderShowLogoChanged(
        ChangeEventArgs e)
    {
        _header.ShowLogo =
            e.Value is bool value &&
            value;
    }


    private void HeaderLogoUrlChanged(
        ChangeEventArgs e)
    {
        _header.LogoUrl =
            Normalize(
                e.Value?.ToString());
    }


    private void HeaderLogoHeightChanged(
        ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var height))
        {
            _header.LogoMaxHeight = null;
            return;
        }

        _header.LogoMaxHeight = Math.Clamp(height, 20, 300);
    }


    private string HeaderLayoutValue =>
        (_header.Layout ?? ReportHeaderLayout.LogoLeft).ToString();


    private void HeaderLayoutChanged(
        ChangeEventArgs e)
    {
        if (Enum.TryParse<ReportHeaderLayout>(
                e.Value?.ToString(),
                out var layout))
        {
            _header.Layout = layout;
        }
    }


    private void HeaderBackgroundChanged(
        ChangeEventArgs e)
    {
        _header.BackgroundColor =
            Normalize(e.Value?.ToString());
    }


    private void HeaderTextColorChanged(
        ChangeEventArgs e)
    {
        _header.TextColor =
            Normalize(e.Value?.ToString());
    }


    private void HeaderDividerChanged(
        ChangeEventArgs e)
    {
        _header.ShowDivider =
            e.Value is bool value &&
            value;
    }


    /*
     * Atajos para los datos que aparecen en casi todas las cabeceras. No
     * inventan nada: crean la línea con el texto ya apuntando a la variable
     * del tenant que mejor encaja, si existe alguna.
     */
    private sealed record HeaderLinePreset(
        string Label,
        string Prefix,
        string[] Hints,
        ReportHeaderLineStyle Style);

    private static readonly HeaderLinePreset[] HeaderLinePresets =
    [
        new("Razón social", "", ["company.name", "empresa", "razon", "company"], ReportHeaderLineStyle.Strong),
        new("CIF", "CIF: ", ["cif", "nif", "vat"], ReportHeaderLineStyle.Normal),
        new("Dirección", "", ["address", "direccion", "domicilio"], ReportHeaderLineStyle.Normal),
        new("Teléfono", "Tel. ", ["phone", "telefono", "tel"], ReportHeaderLineStyle.Muted),
        new("Email", "", ["email", "mail", "correo"], ReportHeaderLineStyle.Muted),
        new("Web", "", ["web", "url", "site"], ReportHeaderLineStyle.Muted)
    ];

    private IEnumerable<ReportHeaderLineConfiguration> OrderedHeaderLines =>
        _header.Lines.OrderBy(x => x.Order);


    private string? SuggestVariableToken(
        IEnumerable<string> hints)
    {
        foreach (var hint in hints)
        {
            var variable =
                _variables.FirstOrDefault(x =>
                    x.Key.Contains(
                        hint,
                        StringComparison.OrdinalIgnoreCase));

            if (variable is not null)
                return $"{{{{{variable.Key}}}}}";
        }

        return null;
    }


    private void AddPresetLine(
        HeaderLinePreset preset)
    {
        var token =
            SuggestVariableToken(preset.Hints);

        AddHeaderLine(
            preset.Prefix + (token ?? string.Empty),
            preset.Style);
    }


    private void AddHeaderLine(
        string? text = null,
        ReportHeaderLineStyle style = ReportHeaderLineStyle.Normal)
    {
        var line =
            new ReportHeaderLineConfiguration
            {
                Id = Guid.NewGuid().ToString("N")[..8],
                Style = style,
                Order = NextHeaderLineOrder()
            };

        line.TextKey =
            ReportTextKeys.HeaderLine(line.Id);

        _header.Lines.Add(line);

        if (!string.IsNullOrWhiteSpace(text))
        {
            _texts.SetText(
                line.TextKey,
                text);
        }
    }


    private int NextHeaderLineOrder() =>
        _header.Lines.Count == 0
            ? 10
            : _header.Lines.Max(x => x.Order) + 10;


    private void RemoveHeaderLine(
        ReportHeaderLineConfiguration line)
    {
        // El texto se queda en el diccionario a propósito: borrar recursos
        // desde aquí dejaría huérfanas las traducciones de otros idiomas.
        _header.Lines =
            OrderedHeaderLines
                .Where(x => !ReferenceEquals(x, line))
                .ToList();

        NormalizeHeaderLineOrders();
    }


    private bool CanMoveHeaderLine(
        ReportHeaderLineConfiguration line,
        int direction)
    {
        var ordered =
            OrderedHeaderLines.ToList();

        var index =
            ordered.IndexOf(line);

        var target =
            index + direction;

        return index >= 0 &&
               target >= 0 &&
               target < ordered.Count;
    }


    private void MoveHeaderLine(
        ReportHeaderLineConfiguration line,
        int direction)
    {
        var ordered =
            OrderedHeaderLines.ToList();

        var index =
            ordered.IndexOf(line);

        var target =
            index + direction;

        if (index < 0 ||
            target < 0 ||
            target >= ordered.Count)
        {
            return;
        }

        (ordered[index], ordered[target]) =
            (ordered[target], ordered[index]);

        _header.Lines = ordered;

        NormalizeHeaderLineOrders();
    }


    /// <summary>
    /// Renumera siguiendo el orden actual de la lista, que es el que acaban
    /// de dejar mover o quitar.
    /// </summary>
    private void NormalizeHeaderLineOrders()
    {
        for (var i = 0; i < _header.Lines.Count; i++)
            _header.Lines[i].Order = (i + 1) * 10;
    }


    private string HeaderLineText(
        ReportHeaderLineConfiguration line) =>
        BlockText(line.TextKey);


    private void HeaderLineTextChanged(
        ReportHeaderLineConfiguration line,
        ChangeEventArgs e)
    {
        line.TextKey ??=
            ReportTextKeys.HeaderLine(line.Id);

        _texts.SetText(
            line.TextKey,
            e.Value?.ToString());
    }


    private void HeaderLineStyleChanged(
        ReportHeaderLineConfiguration line,
        ChangeEventArgs e)
    {
        if (Enum.TryParse<ReportHeaderLineStyle>(
                e.Value?.ToString(),
                out var style))
        {
            line.Style = style;
        }
    }


    private Task InsertHeaderLineVariableAsync(
        ReportHeaderLineConfiguration line,
        ReportVariable variable)
    {
        line.TextKey ??=
            ReportTextKeys.HeaderLine(line.Id);

        _texts.SetText(
            line.TextKey,
            AppendVariable(
                HeaderLineText(line),
                variable.Key));

        return Task.CompletedTask;
    }


