@page "/blocks/new"
@page "/blocks/{BlockId}"

@using System.Text.Json
@using System.Text.Json.Serialization
@using Renderset.Core.Blocks
@using Renderset.Core.Configurations 
@using Renderset.Core.Localization
@using Renderset.Core.Variables

@inject IRenderSetApi RenderSetApi
@inject ICurrentTenant CurrentTenant
@inject NavigationManager Navigation

<PageTitle>@PageTitleText - RenderSet</PageTitle>

<div class="page">

    <header class="page-header">

        <div>
            <button type="button"
                    class="back-button"
                    @onclick="GoBack">
                <i class="fa-solid fa-arrow-left"></i>
                Blocks
            </button>

            <h1>@PageTitleText</h1>

            <p>
                Configura un bloque reutilizable para usarlo en varios reports.
            </p>
        </div>

        <div class="page-actions">

            <button type="button"
                    class="secondary-button"
                    @onclick="GoBack">
                Cancelar
            </button>

            <button type="button"
                    class="primary-button"
                    @onclick="SaveAsync"
                    disabled="@_saving">
                <i class="fa-solid fa-floppy-disk"></i>
                Guardar
            </button>

        </div>

    </header>


    @if (!_loading && _cultures.Count > 0)
    {
        <section class="editor-card language-card">

            <div class="editor-card-body language-card-body">

                <div>
                    <strong>Idioma de edición</strong>
                    <span>Los textos del bloque se guardan como resources traducibles.</span>
                </div>

                <select value="@_selectedCulture"
                        @onchange="ChangeCultureAsync">

                    @foreach (var culture in _cultures)
                    {
                        <option value="@culture.Culture">
                            @culture.DisplayName (@culture.Culture)
                        </option>
                    }

                </select>

            </div>

        </section>
    }


    @if (_loading)
    {
        <div class="page-state">
            Cargando bloque...
        </div>
    }
    else
    {
        <div class="editor-layout">

            <section class="editor-card">

                <div class="editor-card-header">
                    <h2>General</h2>
                </div>

                <div class="editor-card-body">

                    <div class="form-group">
                        <label>Identificador</label>

                        <input type="text"
                               value="@_id"
                               @oninput="e => _id = e.Value?.ToString() ?? string.Empty"
                               disabled="@IsEditMode"
                               placeholder="oran-default-header" />

                        <small>
                            Se usa internamente para referenciar el bloque.
                        </small>
                    </div>

                    <div class="form-group">
                        <label>Nombre</label>

                        <input type="text"
                               value="@_name"
                               @oninput="e => _name = e.Value?.ToString() ?? string.Empty"
                               placeholder="Cabecera ORAN" />
                    </div>

                    <div class="form-group">
                        <label>Tipo</label>

                        <select value="@_type"
                                @onchange="BlockTypeChanged"
                                disabled="@IsEditMode">

                            <option value="@ReportBlockType.Header">
                                Cabecera
                            </option>

                            <option value="@ReportBlockType.Footer">
                                Pie de página
                            </option>

                            <option value="@ReportBlockType.Text">
                                Texto
                            </option>

                        </select>
                    </div>

                </div>

            </section>


            @if (_type == ReportBlockType.Header)
            {
                <section class="editor-card">

                    <div class="editor-card-header">
                        <h2>Cabecera</h2>
                    </div>

                    <div class="editor-card-body">

                        <div class="form-group">
                            <label>Título</label>

                            <input type="text"
                                   value="@BlockText(ReportTextKeys.BlockTitle(_id))"
                                   @onchange="HeaderTitleChanged"
                                   placeholder="Opcional" />
                        </div>

                        <div class="form-group">

                            <label>Subtítulo</label>

                            <div class="variable-input-row">

                                <input type="text"
                                       value="@BlockText(ReportTextKeys.BlockSubtitle(_id))"
                                       @onchange="HeaderSubtitleChanged"
                                       placeholder="Talleres ORAN S.L.U." />

                                <VariablePicker Variables="_variables"
                                                Selected="InsertSubtitleVariableAsync" />

                            </div>

                        </div>

                        <label class="toggle-row">

                            <input type="checkbox"
                                   checked="@(_header.ShowLogo ?? false)"
                                   @onchange="HeaderShowLogoChanged" />

                            <span>Mostrar logo</span>

                        </label>

                        @if (_header.ShowLogo == true)
                        {
                            <div class="form-group">

                                <label>URL del logo</label>

                                <div class="variable-input-row">

                                    <input type="url"
                                           value="@_header.LogoUrl"
                                           @oninput="HeaderLogoUrlChanged"
                                           placeholder="https://..." />

                                    <VariablePicker Variables="_variables"
                                                    Selected="InsertLogoVariableAsync" />

                                </div>

                            </div>
                        }

                    </div>

                </section>
            }


            @if (_type == ReportBlockType.Footer)
            {
                <section class="editor-card">

                    <div class="editor-card-header">
                        <h2>Pie de página</h2>
                    </div>

                    <div class="editor-card-body">

                        <div class="form-group">
                            <label>Texto</label>

                            <textarea rows="4"
                                      value="@BlockText(ReportTextKeys.BlockText(_id))"
                                      @onchange="FooterTextChanged"
                                      placeholder="Texto legal, dirección, contacto..."></textarea>

                                      
                            <VariablePicker Variables="_variables"
                                            Selected="InsertFooterTextVariableAsync" />
                        </div>

                        <label class="toggle-row">

                            <input type="checkbox"
                                   checked="@(_footer.ShowGenerationDate ?? false)"
                                   @onchange="FooterGenerationDateChanged" />

                            <span>Mostrar fecha de generación</span>

                        </label>

                        <label class="toggle-row">

                            <input type="checkbox"
                                   checked="@(_footer.ShowPageNumber ?? false)"
                                   @onchange="FooterPageNumberChanged" />

                            <span>Mostrar número de página</span>

                        </label>

                    </div>

                </section>
            }


            @if (_type == ReportBlockType.Text)
            {
                <section class="editor-card">

                    <div class="editor-card-header">
                        <h2>Texto</h2>
                    </div>

                    <div class="editor-card-body">

                        <div class="form-group">
                            <label>Título opcional</label>

                            <div class="variable-input-row">
                                <input type="text"
                                       value="@TextBlockTitleValue"
                                       @oninput="TextTitleChanged"
                                       placeholder="Directrices de seguridad" />

                                <VariablePicker Variables="_variables"
                                                Selected="InsertTextTitleVariableAsync" />
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="form-label-row">
                                <label>Contenido</label>

                                <VariablePicker Variables="_variables"
                                                Selected="InsertTextVariableAsync" />
                            </div>

                            <textarea rows="8"
                                      value="@TextBlockTextValue"
                                      @oninput="TextContentChanged"
                                      placeholder="Escribe las directrices, avisos, condiciones o cualquier texto reutilizable..."></textarea>

                            <small>
                                Puedes insertar variables del tenant dentro del texto.
                            </small>
                        </div>

                        <div class="form-group">
                            <label>Estilo</label>

                            <select value="@_text.Style"
                                    @onchange="TextStyleChanged">
                                <option value="@ReportTextBlockStyle.Default">Normal</option>
                                <option value="@ReportTextBlockStyle.Information">Información</option>
                                <option value="@ReportTextBlockStyle.Warning">Aviso</option>
                                <option value="@ReportTextBlockStyle.Success">Correcto</option>
                            </select>
                        </div>

                        <div class="text-block-preview @GetTextPreviewClass()">
                            @if (!string.IsNullOrWhiteSpace(TextBlockTitleValue))
                            {
                                <strong>@TextBlockTitleValue</strong>
                            }

                            <div>@(TextBlockTextValue.Length == 0 ? "Vista previa del bloque de texto" : TextBlockTextValue)</div>
                        </div>

                    </div>

                </section>
            }


            <section class="editor-card">

                <div class="editor-card-header">
                    <h2>JSON resultante</h2>
                </div>

                <div class="editor-card-body">

                    <pre class="json-preview">@ConfigurationJson</pre>

                </div>

            </section>

        </div>
    }

</div>


@code {

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        PropertyNameCaseInsensitive = true,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
        Converters =
        {
            new JsonStringEnumConverter()
        }
    };

    [Parameter]
    public string? BlockId { get; set; }

    private string _id = string.Empty;
    private string _name = string.Empty;

    private ReportBlockType _type =
        ReportBlockType.Header;

    private ReportHeaderConfiguration _header = new();

    private ReportFooterConfiguration _footer = new();

    private ReportTextBlockConfiguration _text = new();

    private IReadOnlyCollection<ReportVariable> _variables = [];

    private IReadOnlyCollection<TenantCulture> _cultures = [];

    private string? _selectedCulture;

    private ReportTextWorkspace _texts =
        ReportTextWorkspace.Detached();

    private string? _activeVariableTarget;

    private bool _loading;
    private bool _saving;


    private bool IsEditMode =>
        !string.IsNullOrWhiteSpace(BlockId);

    private string PageTitleText =>
        IsEditMode
            ? "Editar bloque"
            : "Nuevo bloque";


    private string ConfigurationJson
    {
        get
        {
            return _type switch
            {
                ReportBlockType.Header =>
                    JsonSerializer.Serialize(
                        _header,
                        JsonOptions),

                ReportBlockType.Footer =>
                    JsonSerializer.Serialize(
                        _footer,
                        JsonOptions),

                ReportBlockType.Text =>
                    JsonSerializer.Serialize(
                        _text,
                        JsonOptions),

                _ => "{}"
            };
        }
    }


    protected override async Task OnParametersSetAsync()
    {
        if (!IsEditMode)
        {
            ResetNewBlock();
            await LoadEditorContextAsync();
            return;
        }

        await LoadAsync();
    }


    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            var block =
                await RenderSetApi.GetBlockAsync(
                    CurrentTenant.Id,
                    BlockId!);

            _id = block.Id;
            _name = block.Name;
            _type = block.Type;

            if (_type == ReportBlockType.Header)
            {
                _header =
                    JsonSerializer.Deserialize<ReportHeaderConfiguration>(
                        block.ConfigurationJson,
                        JsonOptions)
                    ?? new ReportHeaderConfiguration();
            }
            else if (_type == ReportBlockType.Footer)
            {
                _footer =
                    JsonSerializer.Deserialize<ReportFooterConfiguration>(
                        block.ConfigurationJson,
                        JsonOptions)
                    ?? new ReportFooterConfiguration();
            }
            else if (_type == ReportBlockType.Text)
            {
                _text =
                    JsonSerializer.Deserialize<ReportTextBlockConfiguration>(
                        block.ConfigurationJson,
                        JsonOptions)
                    ?? new ReportTextBlockConfiguration();
            }

            await LoadEditorContextAsync();
        }
        finally
        {
            _loading = false;
        }
    }


    private async Task LoadEditorContextAsync()
    {
        _variables =
            await RenderSetApi.GetVariablesAsync(
                CurrentTenant.Id);

        _cultures =
            await RenderSetApi.GetCulturesAsync(
                CurrentTenant.Id);

        _selectedCulture ??=
            _cultures.FirstOrDefault(x => x.IsDefault)?.Culture
            ?? _cultures.FirstOrDefault()?.Culture;

        _texts =
            await LoadTextsAsync(
                _selectedCulture);
    }


    private async Task<ReportTextWorkspace> LoadTextsAsync(
        string? culture)
    {
        if (string.IsNullOrWhiteSpace(culture))
            return ReportTextWorkspace.Detached();

        var resources =
            await RenderSetApi.GetResourcesAsync(
                CurrentTenant.Id,
                ReportResourceScope.Global);

        return new ReportTextWorkspace(
            ReportResourceScope.Global,
            culture,
            resources);
    }


    private async Task ChangeCultureAsync(
        ChangeEventArgs e)
    {
        if (_texts.HasPendingChanges)
            await SaveTextsAsync();

        _selectedCulture =
            e.Value?.ToString();

        _texts =
            await LoadTextsAsync(
                _selectedCulture);
    }


    private void ResetNewBlock()
    {
        _id = string.Empty;
        _name = string.Empty;

        _type =
            ReportBlockType.Header;

        _header =
            new ReportHeaderConfiguration();

        _footer =
            new ReportFooterConfiguration();

        _text =
            new ReportTextBlockConfiguration();
    }


    private void BlockTypeChanged(
        ChangeEventArgs e)
    {
        if (Enum.TryParse<ReportBlockType>(
                e.Value?.ToString(),
                out var type))
        {
            _type = type;
        }
    }


    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_id))
            return;

        if (string.IsNullOrWhiteSpace(_name))
            return;

        _saving = true;

        try
        {
            var blockId =
                _id.Trim();

            PrepareConfigurationForSave(blockId);

            var block =
                new ReportBlock
                {
                    Id = blockId,
                    Name = _name.Trim(),
                    Type = _type,
                    ConfigurationJson =
                        ConfigurationJson
                };

            await RenderSetApi.SaveBlockAsync(
                CurrentTenant.Id,
                block.Id,
                block);

            await SaveTextsAsync();

            Navigation.NavigateTo(
                "/blocks");
        }
        finally
        {
            _saving = false;
        }
    }


    private void GoBack()
    {
        Navigation.NavigateTo(
            "/blocks");
    }


    /// <summary>
    /// Los bloques son de tenant, así que sus textos van al ámbito global del
    /// diccionario. La configuración del bloque sólo guarda la clave.
    /// </summary>
    private string BlockText(
        string? key,
        string fallback = "") =>
        string.IsNullOrWhiteSpace(key)
            ? fallback
            : _texts.GetText(
                key,
                fallback);


    private void HeaderTitleChanged(
        ChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(_id))
            return;

        _header.TitleKey =
            ReportTextKeys.BlockTitle(_id.Trim());

        _texts.SetText(
            _header.TitleKey,
            e.Value?.ToString());
    }


    private void HeaderSubtitleChanged(
        ChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(_id))
            return;

        _header.SubtitleKey =
            ReportTextKeys.BlockSubtitle(_id.Trim());

        _texts.SetText(
            _header.SubtitleKey,
            e.Value?.ToString());
    }


    private void HeaderShowLogoChanged(
        ChangeEventArgs e)
    {
        _header.ShowLogo =
            e.Value is bool value &&
            value;
    }


    private void HeaderLogoUrlChanged(
        ChangeEventArgs e)
    {
        _header.LogoUrl =
            Normalize(
                e.Value?.ToString());
    }


    private void FooterTextChanged(
        ChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(_id))
            return;

        _footer.TextKey =
            ReportTextKeys.BlockText(_id.Trim());

        _texts.SetText(
            _footer.TextKey,
            e.Value?.ToString());
    }


    private void FooterGenerationDateChanged(
        ChangeEventArgs e)
    {
        _footer.ShowGenerationDate =
            e.Value is bool value &&
            value;
    }


    private void FooterPageNumberChanged(
        ChangeEventArgs e)
    {
        _footer.ShowPageNumber =
            e.Value is bool value &&
            value;
    }

    private Task InsertSubtitleVariableAsync(
        ReportVariable variable)
    {
        if (string.IsNullOrWhiteSpace(_id))
            return Task.CompletedTask;

        _header.SubtitleKey =
            ReportTextKeys.BlockSubtitle(_id.Trim());

        _texts.SetText(
            _header.SubtitleKey,
            $"{{{{{variable.Key}}}}}");

        return Task.CompletedTask;
    }

    private Task InsertLogoVariableAsync(
        ReportVariable variable)
    {
        _header.LogoUrl =
            $"{{{{{variable.Key}}}}}";

        return Task.CompletedTask;
    }

    private Task InsertFooterTextVariableAsync(
        ReportVariable variable)
    {
        if (string.IsNullOrWhiteSpace(_id))
            return Task.CompletedTask;

        _footer.TextKey =
            ReportTextKeys.BlockText(_id.Trim());

        _texts.SetText(
            _footer.TextKey,
            $"{{{{{variable.Key}}}}}");

        return Task.CompletedTask;
    }

    private string? TextBlockTitleKey =>
        string.IsNullOrWhiteSpace(_id)
            ? null
            : ReportTextKeys.BlockTitle(_id.Trim());

    private string? TextBlockTextKey =>
        string.IsNullOrWhiteSpace(_id)
            ? null
            : ReportTextKeys.BlockText(_id.Trim());

    private string TextBlockTitleValue =>
        BlockText(
            TextBlockTitleKey,
            _text.Title ?? string.Empty);

    private string TextBlockTextValue =>
        BlockText(
            TextBlockTextKey,
            _text.Text);


    private void TextTitleChanged(ChangeEventArgs e)
    {
        var value = Normalize(e.Value?.ToString());

        _text.Title = value;

        if (TextBlockTitleKey is null)
            return;

        _text.TitleKey = TextBlockTitleKey;

        _texts.SetText(
            _text.TitleKey,
            value);
    }

    private void TextContentChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;

        _text.Text = value;

        if (TextBlockTextKey is null)
            return;

        _text.TextKey = TextBlockTextKey;

        _texts.SetText(
            _text.TextKey,
            value);
    }

    private void TextStyleChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ReportTextBlockStyle>(
                e.Value?.ToString(),
                out var style))
        {
            _text.Style = style;
        }
    }

    private Task InsertTextTitleVariableAsync(ReportVariable variable)
    {
        var value = AppendVariable(TextBlockTitleValue, variable.Key);

        _text.Title = value;

        if (TextBlockTitleKey is not null)
        {
            _text.TitleKey = TextBlockTitleKey;
            _texts.SetText(_text.TitleKey, value);
        }

        return Task.CompletedTask;
    }

    private Task InsertTextVariableAsync(ReportVariable variable)
    {
        var value = AppendVariable(TextBlockTextValue, variable.Key);

        _text.Text = value;

        if (TextBlockTextKey is not null)
        {
            _text.TextKey = TextBlockTextKey;
            _texts.SetText(_text.TextKey, value);
        }

        return Task.CompletedTask;
    }

    private string GetTextPreviewClass() =>
        _text.Style switch
        {
            ReportTextBlockStyle.Information => "information",
            ReportTextBlockStyle.Warning => "warning",
            ReportTextBlockStyle.Success => "success",
            _ => "default"
        };

    private static string AppendVariable(string? current, string key)
    {
        var token = $"{{{{{key}}}}}";

        if (string.IsNullOrEmpty(current))
            return token;

        return current.EndsWith(' ')
            ? current + token
            : current + " " + token;
    }


    private void PrepareConfigurationForSave(
        string blockId)
    {
        if (_type == ReportBlockType.Header)
        {
            _header.TitleKey ??= ReportTextKeys.BlockTitle(blockId);
            _header.SubtitleKey ??= ReportTextKeys.BlockSubtitle(blockId);
            return;
        }

        if (_type == ReportBlockType.Footer)
        {
            _footer.TextKey ??= ReportTextKeys.BlockText(blockId);
            return;
        }

        if (_type != ReportBlockType.Text)
            return;

        var title = TextBlockTitleValue;
        var text = TextBlockTextValue;

        _text.TitleKey = ReportTextKeys.BlockTitle(blockId);
        _text.TextKey = ReportTextKeys.BlockText(blockId);

        _text.Title = title;
        _text.Text = text;

        _texts.SetText(
            _text.TitleKey,
            title);

        _texts.SetText(
            _text.TextKey,
            text);
    }


    private async Task SaveTextsAsync()
    {
        if (!_texts.HasPendingChanges)
            return;

        await RenderSetApi.SaveResourcesAsync(
            CurrentTenant.Id,
            _texts.GetPendingChanges());

        _texts.AcceptPendingChanges();
    }


    private static string? Normalize(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? null
            : value.Trim();
    }

}