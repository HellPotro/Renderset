@page "/Error"
@using System.Diagnostics

<PageTitle>Error - RenderSet</PageTitle>

<div class="page error-page">

    <section class="designer-state designer-state-error">
        <i class="fa-solid fa-triangle-exclamation"></i>

        <div>
            <strong>No se ha podido procesar la solicitud.</strong>

            <p>
                RenderSet ha encontrado un error inesperado. Revisa los logs
                del servidor para ver el detalle técnico.
            </p>

            @if (ShowRequestId)
            {
                <p>
                    <span>Request ID:</span>
                    <code>@requestId</code>
                </p>
            }
        </div>
    </section>

</div>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private string? requestId;

    private bool ShowRequestId =>
        !string.IsNullOrEmpty(requestId);

    protected override void OnInitialized()
    {
        requestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
