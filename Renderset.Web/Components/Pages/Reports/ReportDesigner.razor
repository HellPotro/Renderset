@page "/reports/{ReportId}/designer"
@page "/reports/{ReportId}/designer/{PresetId}"

@using System.Text.Json
@using Renderset.Blazor.Components.Editor
@using Renderset.Core.Blocks
@using Renderset.Core.Configurations
@using Renderset.Core.Localization
@using Renderset.Core.Persistence
@using Renderset.Core.Reports
@using Renderset.Core.Themes
@using Renderset.Core.Variables

@layout EmptyLayout
@inject IRenderSetApi RenderSetApi
@inject ICurrentTenant CurrentTenant
@inject IToastService Toasts
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Designer - RenderSet</PageTitle>

@if (_loading)
{
    <div class="designer-state">
        <i class="fa-solid fa-circle-notch fa-spin"></i>
        Cargando diseñador...
    </div>
}
else if (_report is null)
{
    <div class="designer-state designer-state-error">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <strong>No se ha podido abrir el report.</strong>
        <button type="button"
                class="secondary-button"
                @onclick="GoBack">
            Volver
        </button>
    </div>
}
else if (_configuration is not null &&
         _theme is not null)
{
    <div class="designer-shell">

        <header class="designer-topbar">

            <button type="button"
                    class="designer-back-button"
                    @onclick="GoBack">
                <i class="fa-solid fa-arrow-left"></i>
                Volver
            </button>

            <div class="designer-title">
                <strong>@_report.Name</strong>
                <span>
                    @_configuration.Name
                    @if (!string.IsNullOrWhiteSpace(_presetId))
                    {
                        <code>@_presetId</code>
                    }
                </span>
            </div>

            @if (_saving)
            {
                <span class="designer-saving">
                    <i class="fa-solid fa-circle-notch fa-spin"></i>
                    Guardando
                </span>
            }
            else if (HasUnsavedChanges)
            {
                <span class="designer-saving is-dirty">
                    <i class="fa-solid fa-circle"></i>
                    Cambios sin guardar
                </span>
            }

        </header>

        <div class="report-designer-page">

            <ReportEditor Definition="_report.Definition"
                          @bind-Configuration="_configuration"
                          @bind-Theme="_theme"
                          Data="_data"
                          DataChanged="DataChangedAsync"
                          HeaderBlocks="_headerBlocks"
                          FooterBlocks="_footerBlocks"
                          BodyBlocks="_bodyBlocks"
                          Texts="_texts"
                          Cultures="_cultures"
                          Themes="_themes"
                          CultureChanged="ChangeCultureAsync"
                          HasUnsavedChanges="HasUnsavedChanges"
                          SaveRequested="SaveAsync" />

        </div>

    </div>
}

@code {

    [Parameter]
    public string ReportId { get; set; } = default!;

    [Parameter]
    public string? PresetId { get; set; }

    private bool _loading = true;
    private bool _saving;

    private Report? _report;
    private ReportConfiguration? _configuration;

    private IReadOnlyCollection<ReportBlock> _headerBlocks = [];
    private IReadOnlyCollection<ReportBlock> _footerBlocks = [];
    private IReadOnlyCollection<ReportBlock> _bodyBlocks = [];

    private ReportTheme? _theme;
    private JsonElement _data;
    private string? _presetId;

    private IReadOnlyCollection<TenantCulture> _cultures = [];

    private IReadOnlyCollection<TenantReportTheme> _themes = [];

    /// <summary>
    /// Variables del tenant. El diccionario guarda plantillas
    /// ("CIF: {{company.cif}}") y es aquí donde se convierten en texto real
    /// para el preview.
    /// </summary>
    private IReadOnlyCollection<ReportVariable> _variables = [];

    private ReportTextWorkspace _texts =
        ReportTextWorkspace.Detached();

    /// <summary>
    /// Foto de lo guardado (configuración, tema y datos de ejemplo). Se
    /// compara con lo actual para saber si hay cambios sin guardar: el
    /// editor modifica los objetos en sitio y no hay un evento fiable por
    /// cada cambio.
    /// </summary>
    private string? _savedSnapshot;

    private bool _unsavedGuardActive;

    private bool HasUnsavedChanges =>
        !_loading &&
        _savedSnapshot is not null &&
        (_texts.HasPendingChanges ||
         !string.Equals(_savedSnapshot, Snapshot(), StringComparison.Ordinal));

    private string Snapshot() =>
        JsonSerializer.Serialize(
            new
            {
                Configuration = _configuration,
                Theme = _theme,
                Data = _data.ValueKind == JsonValueKind.Undefined
                    ? null
                    : _data.GetRawText()
            });

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;

        var loaded =
            await Toasts.RunAsync(
                LoadDesignerAsync,
                errorTitle: "No se ha podido abrir el diseñador");

        _loading = false;

        if (!loaded)
        {
            _report = null;
        }
    }

    private async Task LoadDesignerAsync()
    {
        _report =
            await RenderSetApi.GetReportAsync(
                CurrentTenant.Id,
                ReportId);

        _headerBlocks =
            await LoadResolvedBlocksAsync(
                ReportBlockType.Header);

        _footerBlocks =
            await LoadResolvedBlocksAsync(
                ReportBlockType.Footer);

        // Bloques que pueden ir en el cuerpo: textos y campos fijos (datos
        // de empresa...).
        _bodyBlocks =
            (await LoadResolvedBlocksAsync(ReportBlockType.Text))
                .Concat(await LoadResolvedBlocksAsync(ReportBlockType.Fields))
                .ToList();

        var preset =
            string.IsNullOrWhiteSpace(PresetId)
                ? await RenderSetApi.ResolvePresetAsync(
                    tenantId: CurrentTenant.Id,
                    reportId: ReportId,
                    contextType: null,
                    contextKey: null)
                : await RenderSetApi.GetPresetAsync(
                    CurrentTenant.Id,
                    PresetId);

        if (preset is null)
        {
            throw new InvalidOperationException(
                string.IsNullOrWhiteSpace(PresetId)
                    ? $"No existe preset default para '{ReportId}'."
                    : $"No existe el preset '{PresetId}'.");
        }

        if (!string.Equals(
                preset.Configuration.ReportId,
                ReportId,
                StringComparison.OrdinalIgnoreCase))
        {
            throw new InvalidOperationException(
                $"El preset '{preset.Id}' pertenece al report " +
                $"'{preset.Configuration.ReportId}' y no a '{ReportId}'.");
        }

        _presetId = preset.Id;
        _configuration = Clone(preset.Configuration);
        _theme = Clone(preset.Theme);

        _themes = await LoadThemesAsync();

        // Con tema de empresa, el preview tiene que enseñar el tema tal como
        // está hoy, que es con el que la API emite el documento; la copia del
        // preset puede ser de cuando se eligió.
        var linked =
            _themes.FirstOrDefault(x =>
                string.Equals(
                    x.Theme.Id,
                    _configuration.ThemeId,
                    StringComparison.OrdinalIgnoreCase));

        if (linked is not null)
            _theme = linked.Theme.Clone();

        _cultures =
            await RenderSetApi.GetCulturesAsync(
                CurrentTenant.Id);

        _variables =
            await RenderSetApi.GetVariablesAsync(
                CurrentTenant.Id);

        var initialCulture =
            _cultures.FirstOrDefault(x => x.IsDefault)
            ?? _cultures.FirstOrDefault();

        _texts =
            await LoadTextsAsync(
                initialCulture?.Culture);

        _data = _report.SampleData.HasValue
            ? _report.SampleData.Value.Clone()
            : default;

        _savedSnapshot = Snapshot();
    }

    /// <summary>
    /// Sin temas el diseñador funciona igual (todo personalizado), así que un
    /// fallo aquí avisa pero no impide abrirlo.
    /// </summary>
    private async Task<IReadOnlyCollection<TenantReportTheme>> LoadThemesAsync()
    {
        try
        {
            return await RenderSetApi.GetThemesAsync(CurrentTenant.Id);
        }
        catch (Exception exception)
        {
            Toasts.Error(
                ToastServiceExtensions.Describe(exception),
                "No se han podido cargar los temas de empresa");

            return [];
        }
    }

    private async Task<ReportTextWorkspace> LoadTextsAsync(
        string? culture)
    {
        if (string.IsNullOrWhiteSpace(culture) ||
            string.IsNullOrWhiteSpace(_presetId))
        {
            return ReportTextWorkspace.Detached();
        }

        var inherited =
            await RenderSetApi.GetCatalogAsync(
                CurrentTenant.Id,
                ReportId,
                presetId: null,
                culture: culture);

        var presetScope =
            ReportResourceScope.ForPreset(_presetId);

        var own =
            await RenderSetApi.GetResourcesAsync(
                CurrentTenant.Id,
                presetScope);

        return new ReportTextWorkspace(
            presetScope,
            culture,
            own,
            inherited,
            _variables);
    }

    private async Task ChangeCultureAsync(
        string culture)
    {
        await Toasts.RunAsync(
            async () =>
            {
                if (_texts.HasPendingChanges &&
                    !await SaveTextsAsync())
                {
                    return;
                }

                _texts =
                    await LoadTextsAsync(culture);
            },
            errorTitle: "No se ha podido cambiar el idioma");
    }

    private async Task<bool> SaveTextsAsync()
    {
        if (!_texts.HasPendingChanges)
            return true;

        var saved =
            await Toasts.RunApiAsync(
                () => RenderSetApi.SaveResourcesAsync(
                    CurrentTenant.Id,
                    _texts.GetPendingChanges()),
                errorTitle: "No se han podido guardar los textos");

        if (saved)
            _texts.AcceptPendingChanges();

        return saved;
    }

    private async Task SaveAsync()
    {
        if (_configuration is null ||
            _theme is null ||
            string.IsNullOrWhiteSpace(_presetId) ||
            _report is null ||
            _saving)
        {
            return;
        }

        _saving = true;

        try
        {
            _report.SampleData =
                _data.ValueKind == JsonValueKind.Undefined
                    ? null
                    : _data.Clone();

            var reportSaved =
                await Toasts.RunApiAsync(
                    () => RenderSetApi.SaveReportAsync(
                        CurrentTenant.Id,
                        _report.Id,
                        _report),
                    errorTitle: "No se han podido guardar los datos de ejemplo");

            if (!reportSaved)
                return;

            var preset =
                new ReportPreset
                {
                    Id = _presetId,
                    Version = 1,
                    Configuration = Clone(_configuration),
                    Theme = Clone(_theme)
                };

            var presetSaved =
                await Toasts.RunApiAsync(
                    () => RenderSetApi.SavePresetAsync(
                        CurrentTenant.Id,
                        _presetId,
                        preset),
                    errorTitle: "No se ha podido guardar el preset");

            if (!presetSaved)
                return;

            if (!await SaveTextsAsync())
                return;

            _savedSnapshot = Snapshot();

            Toasts.Success("Cambios guardados.");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task<IReadOnlyCollection<ReportBlock>> LoadResolvedBlocksAsync(
        ReportBlockType type)
    {
        var blocks =
            await RenderSetApi.GetBlocksByTypeAsync(
                CurrentTenant.Id,
                type);

        if (blocks.Count == 0)
            return [];

        var resolvedBlocks =
            await Task.WhenAll(
                blocks.Select(block =>
                    RenderSetApi.GetResolvedBlockAsync(
                        CurrentTenant.Id,
                        block.Id)));

        return resolvedBlocks;
    }

    private Task DataChangedAsync(
        JsonElement data)
    {
        _data = data.Clone();

        return Task.CompletedTask;
    }

    /// <summary>
    /// Siempre a Reports: desde ahí se llega al diseñador, y la ficha del
    /// preset es un paso que la mayoría no busca al salir.
    /// </summary>
    private async Task GoBack()
    {
        if (HasUnsavedChanges)
        {
            var leave =
                await JS.InvokeAsync<bool>(
                    "confirm",
                    "Tienes cambios sin guardar en el diseño. Si sales, se pierden. ¿Salir igualmente?");

            if (!leave)
                return;
        }

        await SetUnsavedGuardAsync(false);

        Navigation.NavigateTo("/reports");
    }

    /// <summary>
    /// Cerrar la pestaña o recargar con cambios pendientes pregunta también
    /// (aviso nativo del navegador, que no deja personalizar el texto).
    /// </summary>
    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        var dirty = HasUnsavedChanges;

        if (dirty != _unsavedGuardActive)
            await SetUnsavedGuardAsync(dirty);
    }

    private async Task SetUnsavedGuardAsync(
        bool active)
    {
        _unsavedGuardActive = active;

        try
        {
            await JS.InvokeVoidAsync(
                "renderSet.setUnsavedChangesGuard",
                active);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_unsavedGuardActive)
            await SetUnsavedGuardAsync(false);
    }

    private static T Clone<T>(
        T source)
    {
        var json =
            JsonSerializer.Serialize(source);

        return JsonSerializer.Deserialize<T>(json)
            ?? throw new InvalidOperationException(
                $"No se ha podido clonar '{typeof(T).Name}'.");
    }
}
