@page "/reports/new"

@using System.Globalization
@using System.Text
@using Renderset.Core.Configurations
@using Renderset.Core.DataSources
@using Renderset.Core.Localization
@using Renderset.Core.Persistence
@using Renderset.Core.Presets
@using Renderset.Core.Reports
@using Renderset.Core.Reports.Inference
@using Renderset.Core.Themes

@inject ICurrentTenant CurrentTenant
@inject IRenderSetApi RenderSetApi
@inject IToastService Toasts
@inject NavigationManager Navigation

<PageTitle>Nuevo report - RenderSet</PageTitle>

<div class="page new-report-page">

    <header class="page-header new-report-header">

        <div>
            <h1>Nuevo report</h1>

            <p>
                Pega un JSON de ejemplo o un resultado tabular de SQL/CSV.
                RenderSet inferirá el esquema y generará el report base.
            </p>
        </div>

        <div class="new-report-header-actions">
            <button type="button"
                    class="secondary-button"
                    @onclick="OpenCreationSummary">
                <i class="fa-solid fa-circle-info"></i>
                Qué se crea
            </button>

            <button type="button"
                    class="secondary-button"
                    @onclick="Cancel">
                Cancelar
            </button>
        </div>

    </header>


    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="new-error">
            @_error
        </div>
    }


    <div class="new-shell">

        <section class="new-setup-card">

            <div class="new-setup-main">

                <div class="new-row">

                    <div class="form-group">
                        <label>Nombre</label>

                        <input value="@_name"
                               @oninput="NameChanged"
                               placeholder="Factura cliente" />
                    </div>

                    <div class="form-group">
                        <label>
                            Identificador
                            <small>se usa desde la API</small>
                        </label>

                        <input value="@_reportId"
                               @oninput="e => _reportId = Slug(e.Value?.ToString())"
                               placeholder="invoice" />
                    </div>

                </div>

                <div class="new-flow-hint">
                    <span>
                        <i class="fa-solid fa-database"></i>
                        Dataset
                    </span>

                    <i class="fa-solid fa-arrow-right-long"></i>

                    <span>
                        <i class="fa-solid fa-sitemap"></i>
                        Esquema
                    </span>

                    <i class="fa-solid fa-arrow-right-long"></i>

                    <span>
                        <i class="fa-solid fa-file-lines"></i>
                        Report
                    </span>

                    <i class="fa-solid fa-arrow-right-long"></i>

                    <span>
                        <i class="fa-solid fa-palette"></i>
                        Preset default
                    </span>
                </div>

            </div>

            <aside class="new-setup-summary">
                <strong>Creación automática</strong>

                <span>
                    Se guardará el report, un preset inicial y una muestra de
                    datos para abrir directamente el designer.
                </span>

                <button type="button"
                        @onclick="OpenCreationSummary">
                    Ver detalle
                </button>
            </aside>

        </section>


        <section class="new-dataset-card">

            <header class="new-dataset-head">
                <div>
                    <h2>Origen de datos</h2>

                    <p>
                        Configura aquí la estructura del dataset. Esta zona
                        necesita todo el ancho disponible, por eso el resumen se
                        ha movido a un panel independiente.
                    </p>
                </div>
            </header>

            <DatasetSource OnDatasetReady="DatasetReady"
                           ContinueText="Crear y abrir designer"
                           Rows="10">
                @if (_saving)
                {
                    <span class="new-saving-inline">
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        Creando report...
                    </span>
                }
            </DatasetSource>

        </section>

    </div>


    @if (_showCreationSummary)
    {
        <div class="new-summary-backdrop"
             @onclick="CloseCreationSummary">

            <section class="new-summary-modal"
                     @onclick:stopPropagation="true">

                <header class="new-summary-modal-head">
                    <div>
                        <span>Resumen</span>
                        <h2>Qué se va a crear</h2>
                    </div>

                    <button type="button"
                            class="new-summary-close"
                            title="Cerrar"
                            @onclick="CloseCreationSummary">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </header>

                <div class="new-summary-list">

                    <article class="new-summary-item">
                        <span class="new-summary-icon">
                            <i class="fa-solid fa-file-lines"></i>
                        </span>

                        <div>
                            <strong>Report</strong>

                            <p>
                                Se creará un <em>ReportDefinition</em> inferido
                                desde el dataset configurado.
                            </p>

                            <code>@ReportIdentifierPreview</code>
                        </div>
                    </article>

                    <article class="new-summary-item">
                        <span class="new-summary-icon">
                            <i class="fa-solid fa-layer-group"></i>
                        </span>

                        <div>
                            <strong>Esquema y muestra</strong>

                            <p>
                                Se guardará el esquema de datos y el primer
                                documento generado como muestra para el editor.
                            </p>
                        </div>
                    </article>

                    <article class="new-summary-item">
                        <span class="new-summary-icon">
                            <i class="fa-solid fa-palette"></i>
                        </span>

                        <div>
                            <strong>Preset inicial</strong>

                            <p>
                                Se creará un preset llamado <em>Default</em> y se
                                asignará al report sin contexto específico.
                            </p>

                            <code>@DefaultPresetIdPreview</code>
                        </div>
                    </article>

                    <article class="new-summary-item">
                        <span class="new-summary-icon">
                            <i class="fa-solid fa-language"></i>
                        </span>

                        <div>
                            <strong>Diccionario</strong>

                            @if (_cultures.Count == 0)
                            {
                                <p class="is-warn">
                                    No hay idiomas configurados. No se sembrarán
                                    claves de diccionario automáticamente.
                                </p>

                                <a href="/idiomas">Configurar idiomas</a>
                            }
                            else
                            {
                                <p>
                                    El servidor sembrará las claves base para
                                    <strong>@BaseCultureName</strong> y dejará
                                    pendientes las traducciones del resto de
                                    idiomas configurados.
                                </p>
                            }
                        </div>
                    </article>

                </div>

                <footer class="new-summary-modal-foot">
                    <button type="button"
                            class="secondary-button"
                            @onclick="CloseCreationSummary">
                        Entendido
                    </button>
                </footer>

            </section>

        </div>
    }

</div>


@code {

    private string _name = string.Empty;
    private string _reportId = string.Empty;

    private string? _error;
    private bool _saving;
    private bool _showCreationSummary;

    private IReadOnlyCollection<TenantCulture> _cultures = [];


    private string BaseCultureName =>
        (_cultures.FirstOrDefault(x => x.IsDefault)
         ?? _cultures.FirstOrDefault())
        ?.DisplayName
        ?? string.Empty;


    private string ReportIdentifierPreview =>
        string.IsNullOrWhiteSpace(_reportId)
            ? "report-id"
            : _reportId;


    private string DefaultPresetIdPreview =>
        string.IsNullOrWhiteSpace(_reportId)
            ? "report-id-default"
            : $"{_reportId}-default";


    protected override async Task OnInitializedAsync()
    {
        _cultures =
            await RenderSetApi.GetCulturesAsync(
                CurrentTenant.Id);
    }


    private void NameChanged(
        ChangeEventArgs e)
    {
        _name = e.Value?.ToString() ?? string.Empty;
        _reportId = Slug(_name);
    }


    private async Task DatasetReady(
        DatasetResult dataset)
    {
        if (_saving)
            return;

        if (string.IsNullOrWhiteSpace(_name) ||
            string.IsNullOrWhiteSpace(_reportId))
        {
            Toasts.Warning("Pon antes un nombre al report.");
            return;
        }

        _error = null;
        _saving = true;

        try
        {
            var definition =
                ReportDefinitionFactory.Create(
                    _reportId,
                    _name,
                    dataset.Schema);

            var report =
                new Report
                {
                    Id = _reportId,
                    Name = _name,
                    Version = 1,
                    Definition = definition,
                    DataSchema = dataset.Schema,
                    SampleData = dataset.SampleData
                };

            var result = await Toasts.RunAsync(
                () => RenderSetApi.SaveReportAsync(CurrentTenant.Id, _reportId, report),
                success: "Report creado");

            if (!result.IsSuccessStatusCode)
                return;

            await CreateDefaultPresetAsync();

            // Cuando exista persistencia de mappings, aquí se guardará
            // dataset.Mapping y se enlazará con el report. Sin eso, un report
            // creado desde SQL no sabrá interpretar filas planas enviadas por API.
            Navigation.NavigateTo($"/reports/{Uri.EscapeDataString(_reportId)}/designer");
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _saving = false;
        }
    }


    private async Task CreateDefaultPresetAsync()
    {
        var presetId = $"{_reportId}-default";

        var preset =
            new ReportPreset
            {
                Id = presetId,
                Version = 1,

                Configuration =
                    new ReportConfiguration
                    {
                        Id = presetId,
                        ReportId = _reportId,
                        Name = "Default",
                        Version = 1,
                        Sections = []
                    },

                Theme =
                    new ReportTheme
                    {
                        Id = "default",
                        Name = "Default"
                    }
            };

        await RenderSetApi.SavePresetAsync(
            CurrentTenant.Id,
            presetId,
            preset);

        await RenderSetApi.SaveAssignmentAsync(
            CurrentTenant.Id,
            new ReportPresetAssignment
            {
                ReportId = _reportId,
                ContextType = null,
                ContextKey = null,
                PresetId = presetId
            });
    }


    private void OpenCreationSummary() =>
        _showCreationSummary = true;


    private void CloseCreationSummary() =>
        _showCreationSummary = false;


    private void Cancel() =>
        Navigation.NavigateTo("/reports");


    private static string Slug(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        var normalized =
            value
                .Trim()
                .ToLowerInvariant()
                .Normalize(NormalizationForm.FormD);

        var builder = new StringBuilder();
        var lastWasSeparator = false;

        foreach (var character in normalized)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(character) ==
                UnicodeCategory.NonSpacingMark)
            {
                continue;
            }

            if (char.IsLetterOrDigit(character))
            {
                builder.Append(character);
                lastWasSeparator = false;

                continue;
            }

            if (lastWasSeparator || builder.Length == 0)
                continue;

            builder.Append('-');
            lastWasSeparator = true;
        }

        return builder.ToString().Trim('-');
    }
}
