@page "/reports"

@using Renderset.Core.Localization
@using Renderset.Core.Persistence
@using Renderset.Core.Reports
@using Renderset.Core.Resources

@inject IRenderSetApi RenderSetApi
@inject ICurrentTenant CurrentTenant
@inject NavigationManager Navigation
@inject IToastService Toasts
@inject IJSRuntime JS

<PageTitle>Reports - RenderSet</PageTitle>

<div class="page">

    <header class="page-header">

        <div>
            <h1>Reports</h1>

            <p>
                La estructura de cada documento: secciones, campos y tablas
                inferidas del JSON de origen.
            </p>
        </div>

        <button type="button"
                class="primary-button"
                @onclick="CreateReport">
            <i class="fa-solid fa-plus"></i>
            Nuevo report
        </button>

    </header>



    @if (_loading)
    {
        <div class="page-state">
            Cargando reports...
        </div>
    }
    else if (_reports.Count == 0)
    {
        <div class="empty-state">

            <div class="empty-state-icon">
                <i class="fa-solid fa-file-lines"></i>
            </div>

            <h2>Todavía no hay reports</h2>

            <p>
                Pega un JSON de ejemplo y RenderSet genera la estructura
                inicial por ti.
            </p>

            <button type="button"
                    class="primary-button"
                    @onclick="CreateReport">
                <i class="fa-solid fa-plus"></i>
                Crear el primero
            </button>

        </div>
    }
    else
    {
        <div class="report-toolbar">

            <div class="report-search">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input value="@_search"
                       @oninput="e => _search = e.Value?.ToString() ?? string.Empty"
                       placeholder="Buscar por nombre, id, sección o campo" />

                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <button type="button"
                            class="report-search-clear"
                            title="Limpiar"
                            @onclick="() => _search = string.Empty">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                }

            </div>

            <div class="report-view-toggle">

                <button type="button"
                        class="@(_view == GridView ? "is-on" : null)"
                        title="Vista de cuadros"
                        @onclick="() => ChangeViewAsync(GridView)">
                    <i class="fa-solid fa-table-cells-large"></i>
                </button>

                <button type="button"
                        class="@(_view == ListView ? "is-on" : null)"
                        title="Vista de lista"
                        @onclick="() => ChangeViewAsync(ListView)">
                    <i class="fa-solid fa-list"></i>
                </button>

            </div>

        </div>

        @if (!FilteredReports.Any())
        {
            <div class="page-state">
                Ningún report coincide con «@_search».
            </div>
        }
        else if (_view == ListView)
        {
            <div class="report-list">

                @foreach (var report in FilteredReports)
                {
                    var stats = Stats(report);

                    <article class="report-row" @key="report.Id">

                        <div class="report-row-main">

                            <div class="report-row-title">
                                <h2>@report.Name</h2>
                                <code>@report.Id</code>
                            </div>

                            <div class="report-row-meta">

                                <span class="report-version">
                                    v@(report.Version)
                                </span>

                                <span>@stats.Sections secc.</span>
                                <span>@stats.Fields campos</span>
                                <span>@stats.Columns col.</span>
                                <span>@PresetCount(report.Id) presets</span>

                                @if (!stats.HasSampleData)
                                {
                                    <span class="report-row-warn"
                                          title="Sin datos de ejemplo: el preview del designer saldrá vacío.">
                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                        sin datos
                                    </span>
                                }

                            </div>

                            <div class="report-langs">
                                @LanguageBadges(report)
                            </div>

                        </div>

                        <div class="report-row-actions">
                            @ActionButtons(report)
                        </div>

                        @if (_reportToRename?.Id == report.Id)
                        {
                            @RenamePanel(report)
                        }

                        @if (_reportToDelete?.Id == report.Id)
                        {
                            @DeletePanel(report)
                        }

                    </article>
                }

            </div>
        }
        else
        {
            <div class="report-grid">

                @foreach (var report in FilteredReports)
                {
                    var stats = Stats(report);

                    <article class="report-card" @key="report.Id">

                        <header>

                            <div class="report-card-title">
                                <h2>@report.Name</h2>
                                <code>@report.Id</code>
                            </div>

                            <span class="report-version">
                                v@(report.Version)
                            </span>

                        </header>


                        <div class="report-stats">

                            <div>
                                <strong>@stats.Sections</strong>
                                <span>secciones</span>
                            </div>

                            <div>
                                <strong>@stats.Fields</strong>
                                <span>campos</span>
                            </div>

                            <div>
                                <strong>@stats.Columns</strong>
                                <span>columnas</span>
                            </div>

                            <div>
                                <strong>@PresetCount(report.Id)</strong>
                                <span>presets</span>
                            </div>

                        </div>


                        @if (!stats.HasSampleData)
                        {
                            <div class="report-warn">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                Sin datos de ejemplo: el preview del designer
                                saldrá vacío.
                            </div>
                        }


                        <div class="report-langs">
                            @LanguageBadges(report)
                        </div>


                        <footer class="report-actions">
                            @ActionButtons(report)
                        </footer>


                        @if (_reportToRename?.Id == report.Id)
                        {
                            @RenamePanel(report)
                        }

                        @if (_reportToDelete?.Id == report.Id)
                        {
                            @DeletePanel(report)
                        }

                    </article>
                }

            </div>
        }

    }

</div>


@code {

    private const string GridView = "grid";
    private const string ListView = "list";
    private const string ViewPreferenceKey = "renderset.reports.view";

    private bool _loading = true;
    private bool _deleting;
    private bool _renaming;
    private string _search = string.Empty;
    private string _view = GridView;

    private Report? _reportToDelete;
    private Report? _reportToRename;
    private string _renameValue = string.Empty;

    /// <summary>
    /// Validación local, así que va en línea y no por toast: no ha llegado a
    /// haber llamada a la API.
    /// </summary>
    private string? _renameError;

    private IReadOnlyCollection<Report> _reports = [];
    private IReadOnlyCollection<ReportPreset> _presets = [];
    private IReadOnlyCollection<TenantCulture> _cultures = [];
    private IReadOnlyCollection<ReportResourceCoverageDto> _coverage = [];


    private IEnumerable<Report> FilteredReports =>
        _reports
            .Where(Matches)
            .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Busca también dentro de la estructura: con la definición ya cargada en
    /// cliente, poder encontrar un report por uno de sus campos sale gratis.
    /// </summary>
    private bool Matches(Report report)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;

        if (Contains(report.Name) || Contains(report.Id))
            return true;

        if (report.Definition.Header?.Fields.Any(x => Contains(x.Label)) == true)
            return true;

        return report.Definition.Sections.Any(section =>
            Contains(section.Name) ||
            section.Fields.Any(x => Contains(x.Label)) ||
            section.Table?.Columns.Any(x => Contains(x.Label)) == true);
    }

    private bool Contains(string? value) => value?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true;


    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }


    /// <summary>
    /// La preferencia de vista se lee después del primer render porque
    /// durante el prerender no hay navegador al que preguntar.
    /// </summary>
    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;

        var stored =
            await JS.InvokeAsync<string?>(
                "renderSet.getPreference",
                ViewPreferenceKey,
                GridView);

        if (stored != ListView || _view == ListView)
            return;

        _view = ListView;

        StateHasChanged();
    }


    private async Task ChangeViewAsync(
        string view)
    {
        if (_view == view)
            return;

        _view = view;

        await JS.InvokeVoidAsync(
            "renderSet.setPreference",
            ViewPreferenceKey,
            view);
    }


    private async Task ReloadAsync()
    {
        _loading = true;

        try
        {
            var loaded = await Toasts.RunAsync(
                async () =>
                {
                    _reports =
                        await RenderSetApi.GetReportsAsync(
                            CurrentTenant.Id);

                    _presets =
                        await RenderSetApi.GetPresetsAsync(
                            CurrentTenant.Id);

                    _cultures =
                        await RenderSetApi.GetCulturesAsync(
                            CurrentTenant.Id);

                    _coverage =
                        await RenderSetApi.GetResourceCoverageAsync(
                            CurrentTenant.Id);
                },
                errorTitle: "No se han podido cargar los reports");

            if (!loaded)
            {
                _reports = [];
                _presets = [];
                _cultures = [];
                _coverage = [];
            }
        }
        finally
        {
            _loading = false;
        }
    }


    // ------------------------------------------------------- trozos comunes

    /// <summary>
    /// Las dos vistas enseñan lo mismo y sólo cambian de forma, así que los
    /// bloques repetidos se escriben una vez.
    /// </summary>
    private RenderFragment LanguageBadges(
        Report report) =>
        @<text>
            @if (_cultures.Count == 0)
            {
                <a class="report-langs-empty"
                   href="/idiomas">
                    Sin idiomas configurados
                </a>
            }
            else
            {
                @foreach (var culture in _cultures)
                {
                    var percentage = CoverageOf(report.Id, culture.Culture);

                    <span class="@LangClass(percentage)"
                          title="@culture.DisplayName">
                        <code>@culture.Culture</code>
                        <strong>@percentage%</strong>
                    </span>
                }
            }
        </text>;


    private RenderFragment ActionButtons(
        Report report) =>
        @<text>
            <button type="button"
                    class="primary-button"
                    @onclick="() => OpenDesigner(report.Id)">
                <i class="fa-solid fa-pen-ruler"></i>
                Diseñar
            </button>

            <button type="button"
                    class="secondary-button"
                    @onclick="() => OpenPresets(report.Id)">
                <i class="fa-solid fa-sliders"></i>
                Presets
            </button>

            <button type="button"
                    class="secondary-button"
                    @onclick="() => OpenDictionary(report.Id)">
                <i class="fa-solid fa-language"></i>
                Diccionario
            </button>

            <button type="button"
                    class="icon-button"
                    title="Renombrar report"
                    @onclick="() => AskRename(report)">
                <i class="fa-solid fa-pen"></i>
            </button>

            <button type="button"
                    class="icon-button danger"
                    title="Borrar report"
                    @onclick="() => AskDelete(report)">
                <i class="fa-solid fa-trash"></i>
            </button>
        </text>;


    private RenderFragment RenamePanel(
        Report report) =>
        @<div class="report-rename">

            <label>
                Nombre del report

                <input value="@_renameValue"
                       maxlength="120"
                       autofocus
                       @oninput="e => _renameValue = e.Value?.ToString() ?? string.Empty"
                       @onkeydown="RenameKeyDownAsync" />
            </label>

            <p class="report-rename-hint">
                El identificador <code>@report.Id</code> no cambia: presets,
                assignments y diccionario cuelgan de él.
            </p>

            @if (!string.IsNullOrWhiteSpace(_renameError))
            {
                <p class="report-rename-error">
                    @_renameError
                </p>
            }

            <div class="report-rename-actions">

                <button type="button"
                        class="secondary-button"
                        @onclick="CancelRename">
                    Cancelar
                </button>

                <button type="button"
                        class="primary-button"
                        disabled="@_renaming"
                        @onclick="ConfirmRenameAsync">
                    Guardar
                </button>

            </div>

        </div>;


    private RenderFragment DeletePanel(
        Report report) =>
        @<div class="report-delete">

            <div>
                <strong>¿Borrar @report.Name?</strong>
                <small>
                    Se desactiva el report y con él sus presets, assignments y
                    traducciones.
                </small>
            </div>

            <div class="report-delete-actions">

                <button type="button"
                        class="secondary-button"
                        @onclick="CancelDelete">
                    Cancelar
                </button>

                <button type="button"
                        class="danger-button"
                        disabled="@_deleting"
                        @onclick="ConfirmDeleteAsync">
                    Borrar
                </button>

            </div>

        </div>;


    /// <summary>
    /// El endpoint ya devuelve la definición completa, así que las cifras
    /// salen en cliente sin llamadas extra.
    /// </summary>
    private static ReportStats Stats(
        Report report)
    {
        var sections = report.Definition.Sections;

        return new ReportStats(
            Sections: sections.Count,

            Fields:
                sections.Sum(x => x.Fields.Count) +
                (report.Definition.Header?.Fields.Count ?? 0),

            Columns:
                sections.Sum(x => x.Table?.Columns.Count ?? 0),

            HasSampleData:
                report.SampleData.HasValue);
    }


    private int PresetCount(
        string reportId) =>
        _presets.Count(x =>
            string.Equals(
                x.Configuration.ReportId,
                reportId,
                StringComparison.OrdinalIgnoreCase));


    private int CoverageOf(
        string reportId,
        string culture)
    {
        var item =
            _coverage.FirstOrDefault(x =>
                string.Equals(x.Scope, reportId, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(x.Culture, culture, StringComparison.OrdinalIgnoreCase));

        return item is null
            ? 0
            : (int)Math.Round(item.Percentage);
    }


    private static string LangClass(
        int percentage) =>
        percentage switch
        {
            100 => "report-lang is-done",
            0   => "report-lang is-none",
            _   => "report-lang is-partial"
        };


    // ---------------------------------------------------------- navegación

    private void CreateReport() =>
        Navigation.NavigateTo("/reports/new");


    private void OpenDesigner(
        string reportId) =>
        Navigation.NavigateTo(
            $"/reports/{Uri.EscapeDataString(reportId)}/designer");


    private void OpenPresets(
        string reportId) =>
        Navigation.NavigateTo(
            $"/presets?report={Uri.EscapeDataString(reportId)}");


    private void OpenDictionary(
        string reportId) =>
        Navigation.NavigateTo(
            $"/resources?scope={Uri.EscapeDataString(reportId)}");


    // -------------------------------------------------------- renombrado

    private void AskRename(
        Report report)
    {
        _reportToDelete = null;
        _reportToRename = report;
        _renameValue = report.Name;
        _renameError = null;
    }


    private void CancelRename()
    {
        _reportToRename = null;
        _renameError = null;
    }


    private async Task RenameKeyDownAsync(
        KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ConfirmRenameAsync();
            return;
        }

        if (e.Key == "Escape")
            CancelRename();
    }


    /// <summary>
    /// El PUT lleva el report entero, así que se toca el nombre sobre el
    /// objeto ya cargado. Sólo se cambia el nombre: el Id no se toca porque
    /// de él cuelgan presets, assignments y diccionario, y la versión tampoco
    /// porque versiona la estructura, no la etiqueta.
    /// </summary>
    private async Task ConfirmRenameAsync()
    {
        if (_reportToRename is null || _renaming)
            return;

        var name = _renameValue.Trim();

        if (string.IsNullOrWhiteSpace(name))
        {
            _renameError = "El nombre no puede estar vacío.";
            return;
        }

        if (string.Equals(name, _reportToRename.Name, StringComparison.Ordinal))
        {
            CancelRename();
            return;
        }

        _renaming = true;

        try
        {
            var report = _reportToRename;
            var previousName = report.Name;
            var previousDefinitionName = report.Definition.Name;

            report.Name = name;
            report.Definition.Name = name;

            var saved = await Toasts.RunApiAsync(
                () => RenderSetApi.SaveReportAsync(
                    CurrentTenant.Id,
                    report.Id,
                    report),
                success: $"Report renombrado a '{name}'.",
                errorTitle: "No se ha podido renombrar el report");

            if (!saved)
            {
                // Si la API lo rechaza, no puede quedarse en pantalla un
                // nombre que no está guardado en ningún sitio.
                report.Name = previousName;
                report.Definition.Name = previousDefinitionName;

                return;
            }

            _reportToRename = null;

            await ReloadAsync();
        }
        finally
        {
            _renaming = false;
        }
    }


    // ---------------------------------------------------------------- borrado

    private void AskDelete(
        Report report)
    {
        _reportToRename = null;
        _reportToDelete = report;
    }


    private void CancelDelete()
    {
        _reportToDelete = null;
    }


    private async Task ConfirmDeleteAsync()
    {
        if (_reportToDelete is null)
            return;

        _deleting = true;

        try
        {
            var reportName = _reportToDelete.Name;

            var deleted = await Toasts.RunApiAsync(
                () => RenderSetApi.DeleteReportAsync(
                    CurrentTenant.Id,
                    _reportToDelete.Id),
                success: $"Report '{reportName}' eliminado.",
                errorTitle: "No se ha podido borrar el report");

            if (!deleted)
                return;

            _reportToDelete = null;

            await ReloadAsync();
        }
        finally
        {
            _deleting = false;
        }
    }


    private sealed record ReportStats(
        int Sections,
        int Fields,
        int Columns,
        bool HasSampleData);
}
