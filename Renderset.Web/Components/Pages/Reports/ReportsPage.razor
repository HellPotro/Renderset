@page "/reports"

@using Renderset.Core.Reports

@inject IRenderSetApi RenderSetApi
@inject ICurrentTenant CurrentTenant
@inject NavigationManager Navigation

<PageTitle>Reports - RenderSet</PageTitle>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 mb-1">Reports</h1>
            <div class="text-muted">
                Gestiona tus informes y configuraciones.
            </div>
        </div>

        <button class="btn btn-primary"
                @onclick="CreateReport">
            + Nuevo report
        </button>

    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">
            @_error
        </div>
    }

    @if (_reportToDelete is not null)
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-start gap-3">
            <div>
                <strong>¿Borrar report @_reportToDelete.Name?</strong>
                <div class="small mt-1">
                    Se desactivará el report y también sus presets,
                    assignments y traducciones asociadas al report/presets.
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        @onclick="CancelDelete">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-sm btn-danger"
                        disabled="@_deleting"
                        @onclick="ConfirmDeleteAsync">
                    Borrar
                </button>
            </div>
        </div>
    }

    @if (_loading)
    {
        <p>Cargando reports...</p>
    }
    else if (_reports.Count == 0)
    {
        <div class="alert alert-light border">
            Todavía no hay reports creados.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Id</th>
                        <th>Versión</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var report in _reports)
                    {
                        <tr>
                            <td>
                                <strong>@report.Name</strong>
                            </td>

                            <td>
                                <code>@report.Id</code>
                            </td>

                            <td>
                                @report.Version
                            </td>

                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary"
                                            @onclick="() => OpenDesigner(report.Id)">
                                        Diseñar
                                    </button>

                                    <button class="btn btn-outline-danger"
                                            @onclick="() => AskDelete(report)">
                                        Borrar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>

@code {

    private bool _loading = true;
    private bool _deleting;
    private string? _error;
    private Report? _reportToDelete;

    private IReadOnlyCollection<Report> _reports = [];

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _reports =
                await RenderSetApi.GetReportsAsync(
                    CurrentTenant.Id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void CreateReport()
    {
        Navigation.NavigateTo(
            "/reports/new");
    }

    private void OpenDesigner(
        string reportId)
    {
        Navigation.NavigateTo(
            $"/reports/{Uri.EscapeDataString(reportId)}/designer");
    }

    private void AskDelete(
        Report report)
    {
        _reportToDelete = report;
        _error = null;
    }

    private void CancelDelete()
    {
        _reportToDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_reportToDelete is null)
            return;

        _deleting = true;
        _error = null;

        try
        {
            await RenderSetApi.DeleteReportAsync(
                CurrentTenant.Id,
                _reportToDelete.Id);

            _reportToDelete = null;

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _deleting = false;
        }
    }
}
