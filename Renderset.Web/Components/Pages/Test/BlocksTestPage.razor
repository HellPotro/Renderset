@page "/blocks/test"

@using Renderset.Core.Blocks

@inject IRenderSetApi RenderSetApi
@inject IToastService Toasts

<div class="page">

    <header class="page-header">
        <div>
            <h1>Report blocks test</h1>
            <p>Utilidad interna para crear y cargar bloques de prueba.</p>
        </div>
    </header>

    <div class="page-actions">

        <button type="button"
                class="primary-button"
                @onclick="CreateBlocksAsync">
            Crear bloques de prueba
        </button>

        <button type="button"
                class="secondary-button"
                @onclick="LoadBlocksAsync">
            Cargar bloques
        </button>

    </div>

    @if (_blocks.Count > 0)
    {
        <section class="api-card mt-3">
            <table class="rs-table">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Nombre</th>
                            <th>Tipo</th>
                            <th>Configuración</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var block in _blocks)
                        {
                            <tr>
                                <td><code>@block.Id</code></td>
                                <td>@block.Name</td>
                                <td>@block.Type</td>
                                <td><pre>@block.ConfigurationJson</pre></td>
                            </tr>
                        }
                    </tbody>
            </table>
        </section>
    }

</div>

@code {

    private const string TenantId = "oranauto";

    private IReadOnlyCollection<ReportBlock> _blocks = [];

    private async Task CreateBlocksAsync()
    {
        var header =
            new ReportBlock
            {
                Id = "oran-default-header",
                Name = "Cabecera ORAN",
                Type = ReportBlockType.Header,
                ConfigurationJson =
                    """
                    {
                      "subtitle": "Talleres ORAN S.L.U.",
                      "showLogo": true,
                      "logoUrl": "https://oranauto.com/wp-content/uploads/logo.png"
                    }
                    """
            };

        var footer =
            new ReportBlock
            {
                Id = "oran-default-footer",
                Name = "Pie ORAN",
                Type = ReportBlockType.Footer,
                ConfigurationJson =
                    """
                    {
                      "text": "Talleres ORAN S.L.U.",
                      "showGenerationDate": true
                    }
                    """
            };

        var headerSaved = await Toasts.RunApiAsync(
            () => RenderSetApi.SaveBlockAsync(
                TenantId,
                header.Id,
                header),
            errorTitle: "No se ha podido guardar la cabecera de prueba");

        if (!headerSaved)
            return;

        var footerSaved = await Toasts.RunApiAsync(
            () => RenderSetApi.SaveBlockAsync(
                TenantId,
                footer.Id,
                footer),
            success: "Bloques de prueba guardados.",
            errorTitle: "No se ha podido guardar el pie de prueba");

        if (footerSaved)
            await LoadBlocksAsync();
    }

    private async Task LoadBlocksAsync()
    {
        var blocks = await Toasts.RunAsync(
            () => RenderSetApi.GetBlocksAsync(
                TenantId),
            errorTitle: "No se han podido cargar los bloques");

        if (blocks is null)
            return;

        _blocks = blocks;
        Toasts.Info($"Se han cargado {_blocks.Count} bloques.");
    }
}
