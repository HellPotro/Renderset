@page "/api"

@using Renderset.Core.Api

@inject ICurrentTenant CurrentTenant
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject IToastService Toasts

<PageTitle>API - RenderSet</PageTitle>

<div class="page page-wide api-page">

    <header class="page-header api-header">
        <div>
            <span class="page-eyebrow">Developer</span>
            <h1>API de RenderSet</h1>
            <p>
                Cómo generar documentos desde un ERP o cualquier aplicación:
                con la librería .NET o llamando a la API directamente.
            </p>
        </div>

        <div class="api-tenant-card">
            <span>Tenant actual</span>
            <code>@Tenant</code>
        </div>
    </header>

    @* ---------------------------------------------------- en tres pasos *@

    <section class="api-steps">

        <div class="api-step">
            <span class="api-step-number">1</span>
            <div>
                <strong>Crea una clave</strong>
                <p>
                    En <a href="settings/api-keys">Configuración → API keys</a>.
                    Empieza por <code>rs_live_</code>, se enseña una sola vez y
                    sólo da acceso a este tenant.
                </p>
            </div>
        </div>

        <div class="api-step">
            <span class="api-step-number">2</span>
            <div>
                <strong>Llama con la clave</strong>
                <p>
                    Cabecera <code>X-Api-Key</code> y el tenant en la ruta:
                    <code>/api/render/@Tenant</code>. Los errores vienen como
                    lista de <code>code</code>, <code>message</code> y <code>path</code>.
                </p>
            </div>
        </div>

        <div class="api-step">
            <span class="api-step-number">3</span>
            <div>
                <strong>Desde .NET, usa la librería</strong>
                <p>
                    <code>Renderset.Client</code> envía tu <code>SqlDataReader</code>
                    o <code>DataTable</code> tal cual y te devuelve el PDF.
                    Funciona en .NET Framework 4.6.1+ y WinForms.
                </p>
            </div>
        </div>

    </section>

    <nav class="api-tabs" role="tablist">
        @foreach (var (tab, label, icon) in Tabs)
        {
            <button type="button"
                    role="tab"
                    aria-selected="@(_tab == tab ? "true" : "false")"
                    class="@(_tab == tab ? "is-active" : null)"
                    @onclick="() => _tab = tab">
                <i class="@icon"></i>
                @label
            </button>
        }
    </nav>

    @if (_tab == ApiTab.Library)
    {
        @* ------------------------------------------------ librería .NET *@

        <div class="api-library">

            <aside class="api-library-index">
                <span>En esta guía</span>
                @foreach (var sample in LibrarySamples)
                {
                    <a href="@($"api#{sample.Anchor}")">@sample.Title</a>
                }
            </aside>

            <div class="api-library-body">

                @foreach (var sample in LibrarySamples)
                {
                    <section class="api-card api-sample" id="@sample.Anchor">

                        <header>
                            <div>
                                <h2>@sample.Title</h2>
                                <p>@sample.Intro</p>
                            </div>

                            <button type="button"
                                    class="secondary-button"
                                    @onclick="() => CopyAsync(sample.Code)">
                                <i class="fa-regular fa-copy"></i>
                                Copiar
                            </button>
                        </header>

                        <pre>@sample.Code</pre>

                        @if (!string.IsNullOrWhiteSpace(sample.Note))
                        {
                            <p class="api-sample-note">
                                <i class="fa-solid fa-circle-info"></i>
                                @sample.Note
                            </p>
                        }

                    </section>
                }

            </div>

        </div>
    }
    else if (_tab == ApiTab.Endpoints)
    {
        @* ------------------------------------------------ endpoints *@

        <section class="api-map-card">

            <header class="api-endpoints-head">

                <div>
                    <h2>Endpoints</h2>
                    <p>
                        Lo mismo que describe el documento OpenAPI de la API
                        (<code>/openapi/v1.json</code> en desarrollo).
                    </p>
                </div>

                <div class="api-endpoints-tools">

                    <div class="api-search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="search"
                               placeholder="Buscar: pdf, bundle, mapping…"
                               @bind="_search"
                               @bind:event="oninput" />
                    </div>

                    <label class="api-toggle">
                        <input type="checkbox"
                               checked="@_onlyIntegration"
                               @onchange="e => _onlyIntegration = e.Value is true" />
                        <span>Sólo lo que usa un ERP</span>
                    </label>

                </div>

            </header>

            @foreach (var group in VisibleGroups)
            {
                <section class="api-group" @key="group.Name">

                    <header>
                        <h3>@group.Name</h3>
                        <p>@group.Description</p>
                    </header>

                    <ul class="api-routes">
                        @foreach (var endpoint in group.Endpoints)
                        {
                            <li @key="@($"{endpoint.Method} {endpoint.Route}")">

                                <span class="api-method @endpoint.Method.ToLowerInvariant()">
                                    @(endpoint.Method == "DELETE" ? "DEL" : endpoint.Method)
                                </span>

                                <div class="api-route-text">

                                    <div class="api-route-head">
                                        <code>@endpoint.Route</code>
                                        <strong>@endpoint.Summary</strong>

                                        @if (endpoint.Integration)
                                        {
                                            <span class="api-badge is-integration">ERP</span>
                                        }

                                        @if (endpoint.ServiceOnly)
                                        {
                                            <span class="api-badge is-service">Sólo servicio</span>
                                        }

                                        @if (endpoint.Public)
                                        {
                                            <span class="api-badge is-public">Sin clave</span>
                                        }
                                    </div>

                                    <p>@endpoint.Description</p>

                                </div>

                            </li>
                        }
                    </ul>

                </section>
            }

            @if (!VisibleGroups.Any())
            {
                <p class="api-empty">Nada coincide con "@_search".</p>
            }

        </section>
    }
    else
    {
        @* ------------------------------------------------ HTTP *@

        <div class="api-grid">

            @foreach (var sample in HttpSamples)
            {
                <section class="api-card @(sample.Wide ? "api-card-wide" : null)">

                    <header>
                        <div>
                            <h2>@sample.Title</h2>
                            <p>@sample.Intro</p>
                        </div>

                        <button type="button"
                                class="secondary-button"
                                @onclick="() => CopyAsync(sample.Code)">
                            <i class="fa-regular fa-copy"></i>
                            Copiar
                        </button>
                    </header>

                    <pre>@sample.Code</pre>

                </section>
            }

        </div>
    }

</div>

@code {

    private enum ApiTab
    {
        Library,
        Endpoints,
        Http
    }

    private static readonly (ApiTab Tab, string Label, string Icon)[] Tabs =
    [
        (ApiTab.Library, "Librería .NET", "fa-brands fa-microsoft"),
        (ApiTab.Endpoints, "Endpoints", "fa-solid fa-list"),
        (ApiTab.Http, "Ejemplos HTTP", "fa-solid fa-code")
    ];

    private ApiTab _tab = ApiTab.Library;
    private string _search = string.Empty;
    private bool _onlyIntegration;

    private string Tenant => CurrentTenant.Id;

    /// <summary>
    /// URL de la API para los ejemplos: la que usa esta Web, o un ejemplo.
    /// </summary>
    private string ApiUrl
    {
        get
        {
            var configured = Configuration["ReportingApi"];

            return string.IsNullOrWhiteSpace(configured)
                ? "https://api.renderset.miempresa.com"
                : configured.TrimEnd('/');
        }
    }

    private IEnumerable<ApiEndpointGroup> VisibleGroups =>
        ApiEndpointCatalog.Groups
            .Select(group => group with
            {
                Endpoints = group.Endpoints
                    .Where(x => !_onlyIntegration || x.Integration)
                    .Where(Matches)
                    .ToList()
            })
            .Where(group => group.Endpoints.Count > 0);

    private bool Matches(
        ApiEndpointInfo endpoint)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;

        var term = _search.Trim();

        return endpoint.Route.Contains(term, StringComparison.OrdinalIgnoreCase) ||
               endpoint.Summary.Contains(term, StringComparison.OrdinalIgnoreCase) ||
               endpoint.Description.Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    private async Task CopyAsync(
        string text)
    {
        await JS.InvokeVoidAsync(
            "renderSet.copyText",
            text);

        Toasts.Success("Copiado al portapapeles.");
    }
}
