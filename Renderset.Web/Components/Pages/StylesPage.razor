@page "/styles"

@using Renderset.Blazor.Components.Themes
@using Renderset.Core.Themes

@inject IRenderSetApi RenderSetApi
@inject ICurrentTenant CurrentTenant
@inject IToastService Toasts

<PageTitle>Temas - RenderSet</PageTitle>

<div class="page themes-page">

    <header class="page-header">

        <div>
            <h1>Temas</h1>
            <p>
                Colores y tipografía de empresa. Un preset que usa un tema se
                actualiza solo al cambiarlo; los que tienen colores propios
                ("Personalizado") no cambian.
            </p>
        </div>

    </header>

    @* La lista, el editor y la vista previa son los mismos que en Marca del
       portal DeCA: los temas son del tenant. *@
    <TenantThemeManager Load="LoadAsync"
                        Save="SaveAsync"
                        Delete="DeleteAsync"
                        SelectedThemeId="@ThemeFromQuery" />

</div>

@code {

    /// <summary>
    /// /styles?theme=corporativo abre ese tema (enlace desde el diseñador).
    /// </summary>
    [SupplyParameterFromQuery(Name = "theme")]
    public string? ThemeFromQuery { get; set; }

    private Task<IReadOnlyCollection<TenantReportTheme>?> LoadAsync() =>
        Toasts.RunAsync<IReadOnlyCollection<TenantReportTheme>?>(
            async () => await RenderSetApi.GetThemesAsync(CurrentTenant.Id),
            errorTitle: "No se han podido cargar los temas");

    private Task<bool> SaveAsync(
        TenantReportTheme theme) =>
        Toasts.RunApiAsync(
            () => RenderSetApi.SaveThemeAsync(
                CurrentTenant.Id,
                theme.Theme.Id,
                theme),
            success: "Tema guardado.",
            errorTitle: "No se ha podido guardar el tema");

    private Task<bool> DeleteAsync(
        string themeId) =>
        Toasts.RunApiAsync(
            () => RenderSetApi.DeleteThemeAsync(
                CurrentTenant.Id,
                themeId),
            success: "Tema borrado.",
            errorTitle: "No se ha podido borrar el tema");
}
