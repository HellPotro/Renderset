@page "/presets"

@using System.Globalization
@using System.Text
@using System.Text.Json
@using Renderset.Core.Configurations
@using Renderset.Core.Localization
@using Renderset.Core.Persistence
@using Renderset.Core.Presets
@using Renderset.Core.Reports
@using Renderset.Core.Themes

@inject IRenderSetApi RenderSetApi
@inject ICurrentTenant CurrentTenant
@inject NavigationManager Navigation
@inject IToastService Toasts
@inject IJSRuntime JS

<PageTitle>Presets - RenderSet</PageTitle>

<div class="page">

    <header class="page-header">

        <div>
            <h1>Presets</h1>

            <p>
                Configuraciones reutilizables para adaptar un mismo report
                a distintos clientes o contextos.
            </p>
        </div>

        <button type="button"
                class="primary-button"
                @onclick="() => OpenCreator(null)">
            <i class="fa-solid fa-plus"></i>
            Nuevo preset
        </button>

    </header>



    @if (_creating)
    {
        <section class="preset-creator">

            <header>
                <h2>Nuevo preset</h2>
                <p>
                    Se crea con la configuración por defecto del report y se
                    abre el designer para ajustarlo.
                </p>
            </header>

            <div class="preset-creator-grid">

                <div class="form-group">
                    <label>Report</label>

                    <select value="@_newReportId"
                            @onchange="NewReportChanged">

                        <option value="">
                            Selecciona un report
                        </option>

                        @foreach (var report in _reports)
                        {
                            <option value="@report.Id">
                                @report.Name
                            </option>
                        }

                    </select>
                </div>

                <div class="form-group">
                    <label>Nombre</label>

                    <input value="@_newName"
                           @oninput="NewNameChanged"
                           placeholder="Factura Talleres Peláez" />
                </div>

                <div class="form-group">
                    <label>
                        Id
                        <small>no se puede cambiar después</small>
                    </label>

                    <input value="@_newId"
                           @oninput="e => _newId = Slug(e.Value?.ToString())"
                           placeholder="invoice-talleres-pelaez" />
                </div>

                <div class="form-group">
                    <label>Partir de</label>

                    <select value="@_copyFromPresetId"
                            @onchange="e => _copyFromPresetId = e.Value?.ToString()">

                        <option value="">
                            Configuración por defecto del report
                        </option>

                        @foreach (var preset in PresetsOfSelectedReport)
                        {
                            <option value="@preset.Id">
                                Duplicar @preset.Configuration.Name
                            </option>
                        }

                    </select>
                </div>

                <div class="form-group preset-creator-full">

                    <label class="preset-check">

                        <input type="checkbox"
                               checked="@_makeDefault"
                               disabled="@(!HasDefaultForNewReport ? true : false)"
                               @onchange="e => _makeDefault = e.Value is bool v && v" />

                        <span>
                            Marcar como preset por defecto del report
                        </span>

                    </label>

                    @if (!HasDefaultForNewReport &&
                         !string.IsNullOrWhiteSpace(_newReportId))
                    {
                        <small>
                            Este report todavía no tiene preset por defecto,
                            así que este lo será obligatoriamente. Sin él, el
                            designer no puede abrirlo.
                        </small>
                    }

                </div>

            </div>

            <div class="preset-creator-actions">

                <button type="button"
                        class="secondary-button"
                        @onclick="CancelCreate">
                    Cancelar
                </button>

                <button type="button"
                        class="primary-button"
                        disabled="@(!CanCreate || _saving)"
                        @onclick="CreatePresetAsync">
                    <i class="fa-solid fa-check"></i>
                    Crear y abrir designer
                </button>

            </div>

        </section>
    }


    @if (_loading)
    {
        <div class="page-state">
            Cargando presets...
        </div>
    }
    else
    {
        @if (!_reports.Any())
        {
            <div class="empty-state">

                <div class="empty-state-icon">
                    <i class="fa-solid fa-file-lines"></i>
                </div>

                <h2>No hay reports</h2>

                <p>
                    Crea un report antes de configurar presets.
                </p>

            </div>
        }
        else
        {
            <div class="presets-shell">

            @* El mismo menú que el Diccionario: con muchos reports un
               desplegable no se puede ni leer ni buscar. *@
            <SideNav Items="NavItems"
                     SelectedKey="@SelectedNavKey"
                     Selected="NavSelected"
                     AriaLabel="Report"
                     SearchPlaceholder="Filtrar reports" />

            <div class="preset-groups">

                @foreach (var group in FilteredGroups)
                {
                    <section class="preset-group">

                        <header class="preset-group-header">

                            <div>

                                <h2>
                                    @group.Report.Name
                                </h2>

                                <code>
                                    @group.Report.Id
                                </code>

                            </div>

                            <div class="preset-group-actions">

                                <button type="button"
                                        class="secondary-button"
                                        @onclick="() => OpenCreator(group.Report.Id)">
                                    <i class="fa-solid fa-plus"></i>
                                    Nuevo preset
                                </button>

                                @if (group.Presets.Count > 0)
                                {
                                    <button type="button"
                                            class="secondary-button"
                                            @onclick="() => OpenReport(group.Report)">
                                        <i class="fa-solid fa-pen-ruler"></i>
                                        Abrir designer
                                    </button>
                                }

                            </div>

                        </header>


                        @if (group.Presets.Count == 0)
                        {
                            <div class="preset-empty">
                                Este report no tiene ningún preset todavía.
                                El designer necesita al menos uno para poder
                                abrirse.
                            </div>
                        }
                        else
                        {
                            <div class="preset-list">

                                @foreach (var preset in group.Presets)
                                {
                                    <article class="preset-row">

                                        <div class="preset-icon">
                                            <i class="fa-solid fa-sliders"></i>
                                        </div>

                                        <div class="preset-info">

                                            <div class="preset-title">

                                                <strong>
                                                    @preset.Configuration.Name
                                                </strong>

                                                @if (IsDefaultPreset(
                                                    group.Report.Id,
                                                    preset.Id))
                                                {
                                                    <span class="default-badge">
                                                        Default
                                                    </span>
                                                }

                                            </div>

                                            <code>
                                                @preset.Id
                                            </code>

                                        </div>


                                        <div class="preset-version">
                                            v@(preset.Version)
                                        </div>


                                        <div class="preset-actions">

                                            <button type="button"
                                                    class="icon-button"
                                                    title="Abrir en el designer"
                                                    @onclick="() => OpenDesigner(group.Report.Id, preset.Id)">
                                                <i class="fa-solid fa-pen-ruler"></i>
                                            </button>

                                            <button type="button"
                                                    class="icon-button"
                                                    title="Duplicar preset"
                                                    @onclick="() => DuplicatePreset(group.Report.Id, preset)">
                                                <i class="fa-regular fa-copy"></i>
                                            </button>

                                            <button type="button"
                                                    class="icon-button"
                                                    title="Asignaciones y datos del preset"
                                                    @onclick="() => EditPreset(group.Report, preset)">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>

                                            <button type="button"
                                                    class="icon-button is-danger"
                                                    title="@(CanDelete(group, preset) ? "Eliminar preset" : "Es el preset por defecto: marca otro como predeterminado antes de eliminarlo")"
                                                    disabled="@(_saving || !CanDelete(group, preset))"
                                                    @onclick="() => DeletePresetAsync(group.Report, preset)">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>

                                        </div>

                                    </article>
                                }

                            </div>
                        }

                    </section>
                }

            </div>

            </div>
        }
    }

</div>


@code {

    private static readonly JsonSerializerOptions JsonOptions =
        new(JsonSerializerDefaults.Web);

    private IReadOnlyCollection<Report> _reports = [];

    private IReadOnlyCollection<ReportPreset> _presets = [];

    private readonly Dictionary<string, string?> _defaultPresets =
        new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Permite llegar filtrado desde la ficha del report:
    /// /presets?report=invoice
    /// </summary>
    [SupplyParameterFromQuery(Name = "report")]
    public string? ReportFromQuery { get; set; }

    private string? _selectedReportId;

    private bool _loading = true;
    private bool _saving;

    private bool _creating;
    private string? _newReportId;
    private string _newName = string.Empty;
    private string _newId = string.Empty;
    private string? _copyFromPresetId;
    private bool _makeDefault;


    /// <summary>
    /// Ahora se listan también los reports sin presets. Antes se saltaban, y
    /// como el designer exige un preset existente, un report recién creado no
    /// tenía ningún punto de entrada.
    /// </summary>
    private IEnumerable<PresetGroup> FilteredGroups
    {
        get
        {
            var reports =
                string.IsNullOrWhiteSpace(_selectedReportId)
                    ? _reports
                    : _reports.Where(x =>
                        string.Equals(
                            x.Id,
                            _selectedReportId,
                            StringComparison.OrdinalIgnoreCase));

            foreach (var report in reports)
            {
                var presets =
                    _presets
                        .Where(x =>
                            string.Equals(
                                x.Configuration.ReportId,
                                report.Id,
                                StringComparison.OrdinalIgnoreCase))
                        .OrderBy(x =>
                            x.Configuration.Name)
                        .ToList();

                yield return new PresetGroup(
                    report,
                    presets);
            }
        }
    }


    private IEnumerable<ReportPreset> PresetsOfSelectedReport =>
        string.IsNullOrWhiteSpace(_newReportId)
            ? []
            : _presets
                .Where(x =>
                    string.Equals(
                        x.Configuration.ReportId,
                        _newReportId,
                        StringComparison.OrdinalIgnoreCase))
                .OrderBy(x => x.Configuration.Name);


    private bool HasDefaultForNewReport =>
        !string.IsNullOrWhiteSpace(_newReportId) &&
        _defaultPresets.TryGetValue(_newReportId, out var presetId) &&
        !string.IsNullOrWhiteSpace(presetId);


    private bool CanCreate =>
        !string.IsNullOrWhiteSpace(_newReportId) &&
        !string.IsNullOrWhiteSpace(_newName) &&
        !string.IsNullOrWhiteSpace(_newId);


    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(ReportFromQuery))
            _selectedReportId = ReportFromQuery;

        await LoadAsync();
    }


    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            var loaded = await Toasts.RunAsync(
                async () =>
                {
                    _reports =
                        await RenderSetApi.GetReportsAsync(
                            CurrentTenant.Id);

                    _presets =
                        await RenderSetApi.GetPresetsAsync(
                            CurrentTenant.Id);

                    foreach (var report in _reports)
                    {
                        await LoadDefaultPresetAsync(
                            report.Id);
                    }
                },
                errorTitle: "No se han podido cargar los presets");

            if (!loaded)
            {
                _reports = [];
                _presets = [];
                _defaultPresets.Clear();
            }
        }
        finally
        {
            _loading = false;
        }
    }


    private async Task LoadDefaultPresetAsync(
        string reportId)
    {
        try
        {
            var assignment =
                await RenderSetApi.GetDefaultAssignmentAsync(
                    CurrentTenant.Id,
                    reportId);

            _defaultPresets[reportId] =
                assignment?.PresetId;
        }
        catch
        {
            // El endpoint devuelve 404 cuando no hay asignación por defecto,
            // que es un caso normal, no un error.
            _defaultPresets[reportId] =
                null;
        }
    }


    // ------------------------------------------------------------ creación

    private void OpenCreator(
        string? reportId)
    {
        _creating = true;

        _newReportId =
            reportId
            ?? _selectedReportId
            ?? _reports.FirstOrDefault()?.Id;

        _newName = string.Empty;
        _newId = string.Empty;
        _copyFromPresetId = null;

        // Si el report no tiene default, el nuevo preset tiene que serlo:
        // de lo contrario se crea algo que el designer no sabe resolver.
        _makeDefault = !HasDefaultForNewReport;
    }


    private void CancelCreate()
    {
        _creating = false;
    }


    private void NewReportChanged(
        ChangeEventArgs e)
    {
        _newReportId = e.Value?.ToString();
        _copyFromPresetId = null;
        _makeDefault = !HasDefaultForNewReport;

        RegenerateId();
    }


    private void NewNameChanged(
        ChangeEventArgs e)
    {
        _newName = e.Value?.ToString() ?? string.Empty;

        RegenerateId();
    }


    /// <summary>
    /// El id se propone a partir del report y del nombre, pero queda
    /// editable: una vez creado no se puede cambiar, porque es la clave del
    /// preset y el ámbito de su diccionario.
    /// </summary>
    private void RegenerateId()
    {
        if (string.IsNullOrWhiteSpace(_newName))
        {
            _newId = string.Empty;
            return;
        }

        var prefix =
            string.IsNullOrWhiteSpace(_newReportId)
                ? string.Empty
                : Slug(_newReportId) + "-";

        _newId = prefix + Slug(_newName);
    }


    private async Task CreatePresetAsync()
    {
        if (!CanCreate)
            return;

        _saving = true;

        try
        {
            var presetId = _newId.Trim();

            if (_presets.Any(x =>
                    string.Equals(
                        x.Id,
                        presetId,
                        StringComparison.OrdinalIgnoreCase)))
            {
                Toasts.Warning($"Ya existe un preset con el id '{presetId}'.");
                return;
            }

            var source =
                string.IsNullOrWhiteSpace(_copyFromPresetId)
                    ? null
                    : _presets.FirstOrDefault(x =>
                        string.Equals(
                            x.Id,
                            _copyFromPresetId,
                            StringComparison.OrdinalIgnoreCase));

            // Un preset en blanco nace con el tema de empresa por defecto; una
            // copia se queda con el tema (o la referencia) del original.
            var defaultTheme =
                source is null
                    ? await GetDefaultThemeAsync()
                    : null;

            var configuration =
                source is null
                    ? new ReportConfiguration
                    {
                        Id = presetId,
                        ReportId = _newReportId!,
                        Name = _newName.Trim(),
                        Version = 1,
                        ThemeId = defaultTheme?.Theme.Id
                    }
                    : Clone(source.Configuration);

            if (source is not null)
            {
                configuration.Id = presetId;
                configuration.ReportId = _newReportId!;
                configuration.Name = _newName.Trim();
                configuration.Version = 1;
            }

            var preset =
                new ReportPreset
                {
                    Id = presetId,
                    Version = 1,
                    Configuration = configuration,

                    Theme = source is null
                        ? defaultTheme?.Theme.Clone() ?? new ReportTheme()
                        : Clone(source.Theme)
                };

            var saved = await Toasts.RunApiAsync(
                () => RenderSetApi.SavePresetAsync(
                    CurrentTenant.Id,
                    presetId,
                    preset),
                errorTitle: "No se ha podido crear el preset");

            if (!saved)
                return;

            if (source is not null)
            {
                await CopyPresetResourcesAsync(
                    source,
                    preset);
            }

            if (_makeDefault || !HasDefaultForNewReport)
            {
                var assigned = await Toasts.RunApiAsync(
                    () => RenderSetApi.SaveAssignmentAsync(
                        CurrentTenant.Id,
                        new ReportPresetAssignment
                        {
                            ReportId = _newReportId!,
                            ContextType = null,
                            ContextKey = null,
                            PresetId = presetId
                        }),
                    errorTitle: "No se ha podido asignar el preset por defecto");

                if (!assigned)
                    return;
            }

            var reportId = _newReportId!;

            _creating = false;

            OpenDesigner(
                reportId,
                presetId);
        }
        catch (Exception exception)
        {
            Toasts.Error(
                ToastServiceExtensions.Describe(exception),
                "No se ha podido crear el preset");
        }
        finally
        {
            _saving = false;
        }
    }


    /// <summary>
    /// Al duplicar hay que llevarse también los textos propios del preset
    /// original: si no, la copia pierde en silencio lo que el cliente tenía
    /// personalizado.
    ///
    /// Antes se copiaban todos al preset nuevo, y la misma clave acababa
    /// repetida en cada preset (y había que traducirla en cada uno). Ahora
    /// lo que vale igual para los dos y no cambia a ningún otro preset del
    /// report se pasa al ámbito del report, que ambos heredan
    /// (ReportResourcePromotion). Sólo se copia lo que no se puede subir.
    /// </summary>
    private async Task CopyPresetResourcesAsync(
        ReportPreset source,
        ReportPreset target)
    {
        var sourceScope = ReportResourceScope.ForPreset(source.Id);
        var targetScope = ReportResourceScope.ForPreset(target.Id);

        var sourceResources =
            await RenderSetApi.GetResourcesAsync(
                CurrentTenant.Id,
                sourceScope);

        if (sourceResources.Count == 0)
            return;

        var reportId = target.Configuration.ReportId;

        var report =
            _reports.FirstOrDefault(x =>
                string.Equals(x.Id, reportId, StringComparison.OrdinalIgnoreCase));

        var copies =
            sourceResources
                .Select(x => new ReportResource
                {
                    Scope = targetScope,
                    Key = x.Key,
                    Culture = x.Culture,
                    Value = x.Value,
                    Source = x.Source,
                    Description = x.Description
                })
                .ToList();

        var promoted =
            new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        if (report is not null)
        {
            var plan =
                await PlanPromotionAsync(
                    report,
                    source,
                    target,
                    sourceResources,
                    copies);

            if (!plan.IsEmpty)
            {
                var writes =
                    plan.ReportWrites.Count == 0 ||
                    await Toasts.RunApiAsync(
                        () => RenderSetApi.SaveResourcesAsync(
                            CurrentTenant.Id,
                            plan.ReportWrites),
                        errorTitle: "No se han podido pasar los textos al report");

                if (writes)
                {
                    promoted.UnionWith(plan.PromotedKeys);

                    // Las copias del original sobran: ya las hereda del
                    // report. Del nuevo no hay nada que borrar todavía.
                    foreach (var (scope, key) in plan.Deletions.Where(x => x.Scope == sourceScope))
                    {
                        await Toasts.RunApiAsync(
                            () => RenderSetApi.DeleteResourceAsync(
                                CurrentTenant.Id,
                                scope,
                                key),
                            errorTitle: $"No se ha podido quitar '{key}' del preset original");
                    }
                }
            }
        }

        var remaining =
            copies
                .Where(x => !promoted.Contains(x.Key))
                .ToList();

        if (remaining.Count == 0)
            return;

        await Toasts.RunApiAsync(
            () => RenderSetApi.SaveResourcesAsync(
                CurrentTenant.Id,
                remaining),
            errorTitle: "No se han podido copiar los textos del preset");
    }


    /// <summary>
    /// El preset nuevo cuenta como si ya tuviera las copias: así el plan
    /// ve dos presets con el mismo texto y lo sube al report si no cambia a
    /// ningún otro.
    /// </summary>
    private async Task<ReportResourcePromotion.Plan> PlanPromotionAsync(
        Report report,
        ReportPreset source,
        ReportPreset target,
        IReadOnlyCollection<ReportResource> sourceResources,
        IReadOnlyCollection<ReportResource> copies)
    {
        var others =
            _presets
                .Where(x =>
                    string.Equals(x.Configuration.ReportId, report.Id, StringComparison.OrdinalIgnoreCase) &&
                    !string.Equals(x.Id, source.Id, StringComparison.OrdinalIgnoreCase) &&
                    !string.Equals(x.Id, target.Id, StringComparison.OrdinalIgnoreCase))
                .ToList();

        var resources =
            new Dictionary<string, IReadOnlyCollection<ReportResource>>(StringComparer.OrdinalIgnoreCase)
            {
                [source.Id] = sourceResources,
                [target.Id] = copies
            };

        foreach (var other in others)
        {
            resources[other.Id] =
                await RenderSetApi.GetResourcesAsync(
                    CurrentTenant.Id,
                    ReportResourceScope.ForPreset(other.Id));
        }

        var reportResources =
            await RenderSetApi.GetResourcesAsync(
                CurrentTenant.Id,
                ReportResourceScope.ForReport(report.Id));

        var presets =
            new[] { source, target }
                .Concat(others)
                .Select(x => new ReportResourcePromotion.PresetInfo(
                    x.Id,
                    x.Configuration.Name,
                    x.Configuration))
                .ToList();

        return ReportResourcePromotion.Build(
            report.Definition,
            presets,
            reportResources,
            resources,
            minHolders: 2,
            onlyKeys: sourceResources.Select(x => x.Key).ToList());
    }


    private void DuplicatePreset(
        string reportId,
        ReportPreset preset)
    {
        OpenCreator(reportId);

        _copyFromPresetId = preset.Id;
        _newName = $"{preset.Configuration.Name} (copia)";
        _makeDefault = false;

        RegenerateId();
    }


    // ------------------------------------------------------------ borrado

    /// <summary>
    /// El preset por defecto no se borra mientras haya otros: el report se
    /// quedaría sin preset al que recurrir. Si es el único, sí (el report
    /// vuelve a "sin presets").
    /// </summary>
    private bool CanDelete(
        PresetGroup group,
        ReportPreset preset) =>
        !IsDefaultPreset(group.Report.Id, preset.Id) ||
        group.Presets.Count == 1;


    private async Task DeletePresetAsync(
        Report report,
        ReportPreset preset)
    {
        var confirmed =
            await JS.InvokeAsync<bool>(
                "confirm",
                $"Se eliminará el preset '{preset.Configuration.Name}' y sus asignaciones. " +
                "Los documentos ya emitidos no cambian. ¿Continuar?");

        if (!confirmed)
            return;

        _saving = true;

        try
        {
            var deleted = await Toasts.RunApiAsync(
                () => RenderSetApi.DeletePresetAsync(
                    CurrentTenant.Id,
                    preset.Id),
                success: $"Preset '{preset.Configuration.Name}' eliminado.",
                errorTitle: "No se ha podido eliminar el preset");

            if (deleted)
                await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }


    // ----------------------------------------------------------- navegación

    private bool IsDefaultPreset(
        string reportId,
        string presetId)
    {
        return _defaultPresets.TryGetValue(
                   reportId,
                   out var defaultPresetId)
               &&
               string.Equals(
                   defaultPresetId,
                   presetId,
                   StringComparison.OrdinalIgnoreCase);
    }


    private const string AllReportsKey = "*";

    /// <summary>
    /// Menú lateral: todos los reports o uno, con cuántos presets tiene.
    /// </summary>
    private IReadOnlyList<SideNavItem> NavItems =>
        new[]
        {
            new SideNavItem(
                AllReportsKey,
                "Todos los reports",
                Count(_presets.Count),
                "fa-layer-group",
                "Vista",
                Accent: true)
        }
        .Concat(
            _reports
                .OrderBy(x => x.Name)
                .Select(report => new SideNavItem(
                    report.Id,
                    report.Name,
                    Count(_presets.Count(x =>
                        string.Equals(x.Configuration.ReportId, report.Id, StringComparison.OrdinalIgnoreCase))),
                    "fa-file-lines",
                    "Reports")))
        .ToList();

    private string SelectedNavKey =>
        string.IsNullOrWhiteSpace(_selectedReportId)
            ? AllReportsKey
            : _selectedReportId;

    private void NavSelected(
        string key) =>
        _selectedReportId =
            key == AllReportsKey
                ? null
                : key;

    private static string Count(
        int presets) =>
        presets switch
        {
            0 => "Sin presets",
            1 => "1 preset",
            _ => $"{presets} presets"
        };


    private void OpenReport(
        Report report)
    {
        Navigation.NavigateTo(
            $"/reports/{Uri.EscapeDataString(report.Id)}/designer");
    }


    private void OpenDesigner(
        string reportId,
        string presetId)
    {
        Navigation.NavigateTo(
            $"/reports/{Uri.EscapeDataString(reportId)}/designer/{Uri.EscapeDataString(presetId)}");
    }


    private void EditPreset(
        Report report,
        ReportPreset preset)
    {
        Navigation.NavigateTo(
            $"/presets/{Uri.EscapeDataString(report.Id)}/{Uri.EscapeDataString(preset.Id)}");
    }


    // --------------------------------------------------------------- utils

    private static T Clone<T>(
        T value)
    {
        return JsonSerializer.Deserialize<T>(
            JsonSerializer.Serialize(value, JsonOptions),
            JsonOptions)!;
    }


    /// <summary>
    /// Id legible y estable: sin acentos, sin espacios y en minúsculas.
    /// </summary>
    private static string Slug(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        var normalized =
            value
                .Trim()
                .ToLowerInvariant()
                .Normalize(NormalizationForm.FormD);

        var builder = new StringBuilder();

        var lastWasSeparator = false;

        foreach (var character in normalized)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(character) ==
                UnicodeCategory.NonSpacingMark)
            {
                continue;
            }

            if (char.IsLetterOrDigit(character))
            {
                builder.Append(character);
                lastWasSeparator = false;

                continue;
            }

            if (lastWasSeparator || builder.Length == 0)
                continue;

            builder.Append('-');
            lastWasSeparator = true;
        }

        return builder
            .ToString()
            .Trim('-');
    }


    private sealed record PresetGroup(
        Report Report,
        IReadOnlyCollection<ReportPreset> Presets);

    /// <summary>
    /// Tema de empresa marcado por defecto. Si no hay o no se puede leer, el
    /// preset nace con el tema base de siempre: no es motivo para fallar.
    /// </summary>
    private async Task<TenantReportTheme?> GetDefaultThemeAsync()
    {
        try
        {
            var themes =
                await RenderSetApi.GetThemesAsync(CurrentTenant.Id);

            return themes.FirstOrDefault(x => x.IsDefault);
        }
        catch (Exception)
        {
            return null;
        }
    }
