@page "/bundles"

@using Renderset.Core.Localization
@using Renderset.Core.Paging
@using Renderset.Core.Rendering
@using Renderset.Core.Reports
@using Renderset.Core.Sharing

@inject IRenderSetApi RenderSetApi
@inject ICurrentTenant CurrentTenant
@inject IToastService Toasts
@inject IJSRuntime JS

<PageTitle>Documentos compartidos - RenderSet</PageTitle>

<div class="page bundles-page">

    <header class="page-header">

        <div>
            <h1>Documentos compartidos</h1>

            <p>
                Consulta los documentos emitidos y agrúpalos en un único
                enlace para el cliente.
            </p>
        </div>

        <div class="page-actions">
            <a class="secondary-button"
               href="/bundles/settings">
                <i class="fa-solid fa-sliders"></i>
                Página pública
            </a>
        </div>

    </header>


    @if (_lastLink is not null)
    {
        <section class="bundle-link-card">

            <div class="bundle-link-heading">

                <i class="fa-solid fa-link"></i>

                <div>
                    <strong>Enlace listo: @_lastLink.Title</strong>
                    <small>
                        Caduca el @FormatDate(_lastLink.ExpiresAtUtc).
                        También lo tienes en la lista de bundles para abrirlo
                        o copiarlo cuando quieras.
                    </small>
                </div>

                <button type="button"
                        class="icon-button"
                        title="Cerrar"
                        @onclick="() => _lastLink = null">
                    <i class="fa-solid fa-xmark"></i>
                </button>

            </div>

            <div class="bundle-link-row">

                <input readonly
                       value="@_lastLink.Url"
                       onfocus="this.select()" />

                <button type="button"
                        class="secondary-button"
                        @onclick="() => CopyAsync(_lastLink.Url)">
                    <i class="fa-regular fa-copy"></i>
                    Copiar
                </button>

                <a class="primary-button"
                   href="@_lastLink.Url"
                   target="_blank"
                   rel="noopener">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    Abrir
                </a>

            </div>

        </section>
    }


    <div class="bundles-layout">

        @* ---------------------------------------------------- documentos *@

        <section class="editor-card bundles-documents">

            <header class="editor-card-header bundles-card-header">

                <h2>
                    Documentos emitidos
                    <span class="bundles-count">@CountLabel(_documents.Count, _documentsCursor)</span>
                </h2>

            </header>

            <div class="bundles-toolbar">

                <div class="bundles-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="search"
                           placeholder="Nombre de fichero o id"
                           @bind="_documentSearch"
                           @bind:event="oninput"
                           @onkeydown="DocumentSearchKeyDownAsync" />
                </div>

                <select value="@_reportFilter"
                        @onchange="ReportFilterChangedAsync">

                    <option value="">Todos los reports</option>

                    @foreach (var report in _reports)
                    {
                        <option value="@report.Id">@report.Name</option>
                    }

                </select>

                <input type="date"
                       title="Emitidos desde (incluido)"
                       @bind="_documentsFrom"
                       @bind:after="ReloadDocumentsAsync" />

                <input type="date"
                       title="Emitidos hasta (incluido)"
                       @bind="_documentsTo"
                       @bind:after="ReloadDocumentsAsync" />

                <button type="button"
                        class="secondary-button"
                        @onclick="ReloadDocumentsAsync">
                    Buscar
                </button>

            </div>

            @if (!DateRangeIsValid(_documentsFrom, _documentsTo))
            {
                <p class="bundles-inline-error">
                    La fecha "desde" es posterior a "hasta".
                </p>
            }

            @if (_loadingDocuments && _documents.Count == 0)
            {
                <div class="page-state">Cargando documentos...</div>
            }
            else if (_documents.Count == 0)
            {
                <div class="bundles-empty">
                    <i class="fa-regular fa-file-lines"></i>
                    <p>
                        No hay documentos con ese filtro. Los documentos
                        aparecen aquí al emitirlos con /api/render.
                    </p>
                </div>
            }
            else
            {
                <div class="bundles-table">

                    <div class="bundles-table-header">
                        <span></span>
                        <span>Documento</span>
                        <span>Report</span>
                        <span>Idioma</span>
                        <span>Emitido</span>
                        <span></span>
                    </div>

                    @foreach (var document in _documents)
                    {
                        var selected = IsSelected(document);

                        <div class="bundles-row @(selected ? "is-selected" : null)"
                             @key="document.Id">

                            <input type="checkbox"
                                   checked="@selected"
                                   title="Añadir al bundle"
                                   @onchange="() => ToggleSelection(document)" />

                            <div class="bundles-document">
                                <strong>@document.FileName</strong>
                                <code>@document.Id</code>
                            </div>

                            <span class="bundles-muted">@ReportName(document.ReportId)</span>

                            <span class="bundles-culture" title="@document.Culture">
                                <CultureFlagIcon Culture="@document.Culture"
                                                 Size="CultureFlagIcon.CultureFlagSize.Small" />
                                <span>@document.Culture</span>
                            </span>

                            <span class="bundles-muted">@FormatDate(document.CreatedAtUtc)</span>

                            <div class="bundles-row-actions">

                                <a class="icon-button"
                                   href="@ViewerUrl(document)"
                                   target="_blank"
                                   rel="noopener"
                                   title="Abrir el documento">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                </a>

                                <a class="icon-button"
                                   href="@(DocumentUrl(document) + "/pdf")"
                                   target="_blank"
                                   rel="noopener"
                                   title="@(document.HasPdf ? "Abrir el PDF" : "Generar y abrir el PDF")">
                                    <i class="fa-regular fa-file-pdf"></i>
                                </a>

                            </div>

                        </div>
                    }

                </div>

                <LoadMoreFooter Shown="_documents.Count"
                                Noun="documentos"
                                HasMore="_documentsCursor is not null"
                                Loading="_loadingDocuments"
                                OnLoadMore="LoadMoreDocumentsAsync" />
            }

        </section>


        @* ---------------------------------------------------- nuevo bundle *@

        <aside class="editor-card bundles-builder">

            <header class="editor-card-header bundles-card-header">
                <h2>
                    Nuevo bundle
                    <span class="bundles-count">@_selection.Count</span>
                </h2>
            </header>

            <div class="editor-card-body">

                @if (_selection.Count == 0)
                {
                    <p class="bundles-hint">
                        Marca documentos en la lista. Saldrán en el enlace en
                        el orden en que los marques; aquí puedes cambiarlo y
                        poner el nombre que verá el cliente.
                    </p>
                }
                else
                {
                    <ol class="bundles-selection">

                        @for (var i = 0; i < _selection.Count; i++)
                        {
                            var index = i;
                            var item = _selection[index];

                            <li @key="item.Document.Id">

                                <span class="bundles-position">@(index + 1)</span>

                                <input value="@item.DisplayName"
                                       title="@item.Document.FileName"
                                       placeholder="@DefaultDisplayName(item.Document)"
                                       @oninput="e => item.DisplayName = e.Value?.ToString() ?? string.Empty" />

                                <div class="bundles-selection-actions">

                                    <button type="button"
                                            class="icon-button"
                                            title="Subir"
                                            disabled="@(index == 0)"
                                            @onclick="() => Move(index, -1)">
                                        <i class="fa-solid fa-arrow-up"></i>
                                    </button>

                                    <button type="button"
                                            class="icon-button"
                                            title="Bajar"
                                            disabled="@(index == _selection.Count - 1)"
                                            @onclick="() => Move(index, 1)">
                                        <i class="fa-solid fa-arrow-down"></i>
                                    </button>

                                    <button type="button"
                                            class="icon-button"
                                            title="Quitar"
                                            @onclick="() => _selection.RemoveAt(index)">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>

                                </div>

                            </li>
                        }

                    </ol>
                }

                <div class="form-group">
                    <label>Título</label>
                    <input @bind="_title"
                           @bind:event="oninput"
                           maxlength="@DocumentBundleService.MaxTitleLength"
                           placeholder="Envío pedido 4512 - Gestamp Esmar" />
                </div>

                <div class="form-group">
                    <label>Mensaje</label>
                    <textarea rows="3"
                              @bind="_message"
                              @bind:event="oninput"
                              maxlength="@DocumentBundleService.MaxMessageLength"
                              placeholder="@MessagePlaceholder"></textarea>
                    <small>
                        Vacío usa el mensaje por defecto de la página pública.
                    </small>
                </div>

                <div class="form-group">
                    <label for="bundle-culture">Idioma de la página</label>
                    <select id="bundle-culture"
                            value="@_culture"
                            @onchange="e => _culture = e.Value?.ToString() ?? string.Empty">

                        <option value="">@AutomaticCultureLabel</option>

                        @foreach (var culture in _cultures)
                        {
                            <option value="@culture.Culture">
                                @CultureOptionLabel(culture)
                            </option>
                        }

                    </select>
                    <small>
                        Botones y avisos que ve el cliente. Los textos se
                        editan en el
                        <a href="@SharingDictionaryUrl">Diccionario</a>.
                    </small>
                </div>

                <div class="form-group">
                    <label>Caducidad (días)</label>
                    <input type="number"
                           min="1"
                           max="@MaxExpirationDays"
                           @bind="_expiresInDays"
                           placeholder="@DefaultExpirationDays" />
                    @if (!ExpirationIsValid)
                    {
                        <small class="bundles-error">
                            Entre 1 y @MaxExpirationDays días.
                        </small>
                    }
                    else
                    {
                        <small>Vacío: @DefaultExpirationDays días.</small>
                    }
                </div>

                <label class="bundles-check">
                    <input type="checkbox"
                           checked="@_allowDataDownload"
                           @onchange="e => _allowDataDownload = e.Value is true" />
                    <span>
                        <strong>Permitir descargar los datos</strong>
                        <small>
                            El cliente podrá exportar las tablas a CSV y bajarse
                            el JSON, como en el visor interno. Sólo en los
                            documentos emitidos con sus datos; sin marcar, los
                            datos se quitan de lo que se le sirve.
                        </small>
                    </span>
                </label>

                <button type="button"
                        class="primary-button bundles-create"
                        disabled="@(!CanCreate)"
                        @onclick="CreateAsync">
                    @if (_creating)
                    {
                        <i class="fa-solid fa-spinner fa-spin"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-link"></i>
                    }
                    Crear enlace
                </button>

            </div>

        </aside>

    </div>


    @* -------------------------------------------------------- bundles *@

    <section class="editor-card bundles-recent">

        <header class="editor-card-header bundles-card-header">

            <h2>
                Bundles
                <span class="bundles-count">@CountLabel(_bundles.Count, _bundlesCursor)</span>
            </h2>

        </header>

        <div class="bundles-toolbar is-bundles">

            <div class="bundles-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="search"
                       placeholder="Título, documento o id"
                       @bind="_bundleSearch"
                       @bind:event="oninput"
                       @onkeydown="BundleSearchKeyDownAsync" />
            </div>

            <select value="@(_bundleStatus?.ToString() ?? string.Empty)"
                    @onchange="BundleStatusChangedAsync">
                <option value="">Todos los estados</option>
                <option value="@DocumentBundleStatus.Active">Activos</option>
                <option value="@DocumentBundleStatus.Expired">Caducados</option>
                <option value="@DocumentBundleStatus.Revoked">Revocados</option>
            </select>

            <input type="date"
                   title="Creados desde (incluido)"
                   @bind="_bundlesFrom"
                   @bind:after="ReloadBundlesAsync" />

            <input type="date"
                   title="Creados hasta (incluido)"
                   @bind="_bundlesTo"
                   @bind:after="ReloadBundlesAsync" />

            <button type="button"
                    class="secondary-button"
                    @onclick="ReloadBundlesAsync">
                Buscar
            </button>

        </div>

        @if (!DateRangeIsValid(_bundlesFrom, _bundlesTo))
        {
            <p class="bundles-inline-error">
                La fecha "desde" es posterior a "hasta".
            </p>
        }

        @if (_bundles.Count == 0)
        {
            <div class="bundles-empty">
                <i class="fa-solid fa-link-slash"></i>
                <p>
                    @(_loadingBundles
                        ? "Cargando bundles..."
                        : "No hay bundles con ese filtro.")
                </p>
            </div>
        }
        else
        {
            <div class="bundles-table">

                <div class="bundles-table-header is-recent">
                    <span>Bundle</span>
                    <span>Estado</span>
                    <span>Caduca</span>
                    <span>Accesos</span>
                    <span></span>
                </div>

                @foreach (var bundle in _bundles)
                {
                    <div class="bundles-row is-recent"
                         @key="bundle.BundleId">

                        <div class="bundles-document">
                            <strong>@bundle.Title</strong>
                            <small>
                                <span class="bundles-culture is-inline" title="Idioma de la página">
                                    <CultureFlagIcon Culture="@bundle.Culture"
                                                     Size="CultureFlagIcon.CultureFlagSize.Small" />
                                    @bundle.Culture
                                </span>
                                @if (bundle.AllowDataDownload)
                                {
                                    <span class="bundles-data-badge" title="El cliente puede descargar los datos (CSV y JSON)">
                                        <i class="fa-solid fa-table"></i> Datos
                                    </span>
                                }
                                @FormatDate(bundle.CreatedAtUtc) ·
                                @(string.Join(" · ", bundle.Documents.Select(x => x.DisplayName)))
                            </small>
                        </div>

                        <span class="@($"bundles-status is-{bundle.Status.ToString().ToLowerInvariant()}")">
                            @StatusText(bundle.Status)
                        </span>

                        <span class="bundles-muted">@FormatDate(bundle.ExpiresAtUtc)</span>

                        <span class="bundles-muted">
                            @bundle.AccessCount
                            @if (bundle.LastAccessedAtUtc is { } last)
                            {
                                <small>último @FormatDate(last)</small>
                            }
                        </span>

                        <div class="bundles-row-actions">

                            @if (!string.IsNullOrWhiteSpace(bundle.Url))
                            {
                                <a class="icon-button"
                                   href="@bundle.Url"
                                   target="_blank"
                                   rel="noopener"
                                   title="@(bundle.Status == DocumentBundleStatus.Active
                                       ? "Abrir el enlace"
                                       : "Abrir el enlace (el cliente verá que no está disponible)")">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                </a>

                                <button type="button"
                                        class="icon-button"
                                        title="Copiar el enlace"
                                        @onclick="() => CopyAsync(bundle.Url)">
                                    <i class="fa-regular fa-copy"></i>
                                </button>
                            }
                            else
                            {
                                <span class="icon-button is-placeholder"
                                      title="Este enlace no se puede recuperar. Genera uno nuevo con el botón de al lado.">
                                    <i class="fa-solid fa-eye-slash"></i>
                                </span>
                            }

                            <button type="button"
                                    class="icon-button"
                                    title="Generar un enlace nuevo (el anterior deja de valer)"
                                    @onclick="() => RenewAsync(bundle)">
                                <i class="fa-solid fa-arrows-rotate"></i>
                            </button>

                            <button type="button"
                                    class="icon-button"
                                    title="Revocar el enlace"
                                    disabled="@(bundle.Status == DocumentBundleStatus.Revoked)"
                                    @onclick="() => RevokeAsync(bundle)">
                                <i class="fa-solid fa-ban"></i>
                            </button>

                        </div>

                    </div>
                }

            </div>

            <LoadMoreFooter Shown="_bundles.Count"
                            Noun="bundles"
                            HasMore="_bundlesCursor is not null"
                            Loading="_loadingBundles"
                            OnLoadMore="LoadMoreBundlesAsync" />
        }

    </section>

</div>


@code {

    private const int PageSize = 50;

    private readonly List<RenderedDocumentSummary> _documents = [];

    private readonly List<DocumentBundleResponse> _bundles = [];

    private readonly List<SelectedDocument> _selection = [];

    private IReadOnlyList<Report> _reports = [];

    private DocumentSharingSettingsResponse? _sharing;

    // Filtros de documentos
    private string _documentSearch = string.Empty;
    private string _reportFilter = string.Empty;
    private DateOnly? _documentsFrom;
    private DateOnly? _documentsTo;
    private string? _documentsCursor;
    private bool _loadingDocuments;

    // Filtros de bundles
    private string _bundleSearch = string.Empty;
    private DocumentBundleStatus? _bundleStatus;
    private DateOnly? _bundlesFrom;
    private DateOnly? _bundlesTo;
    private string? _bundlesCursor;
    private bool _loadingBundles;

    // Nuevo bundle
    private string _title = string.Empty;
    private string _message = string.Empty;
    private int? _expiresInDays;
    private bool _creating;

    /// <summary>
    /// Vacío = automático: el servicio usa el idioma del primer documento.
    /// </summary>
    private string _culture = string.Empty;

    /// <summary>
    /// Igual que "Incluir los datos" al generar: por defecto no se comparten.
    /// </summary>
    private bool _allowDataDownload;

    private IReadOnlyCollection<TenantCulture> _cultures = [];

    private CreatedLink? _lastLink;


    private int MaxExpirationDays =>
        _sharing?.MaxExpirationDays ?? 365;

    private int DefaultExpirationDays =>
        _sharing?.Settings.DefaultExpirationDays
        ?? _sharing?.SystemDefaultExpirationDays
        ?? 30;

    private string MessagePlaceholder =>
        string.IsNullOrWhiteSpace(_sharing?.Settings.DefaultMessage)
            ? "Adjuntamos la documentación del envío."
            : _sharing!.Settings.DefaultMessage!;

    private static string SharingDictionaryUrl =>
        $"resources?scope={Uri.EscapeDataString(ReportResourceScope.Sharing)}";

    private string AutomaticCultureLabel
    {
        get
        {
            var first =
                _selection.Count > 0
                    ? _selection[0].Document.Culture
                    : null;

            return string.IsNullOrWhiteSpace(first)
                ? "Automático (idioma del primer documento)"
                : $"Automático ({first}, el del primer documento)";
        }
    }

    private static string CultureOptionLabel(
        TenantCulture culture)
    {
        var flag = CultureFlag.For(culture.Culture);

        var name =
            $"{culture.DisplayName} · {culture.Culture}";

        return string.IsNullOrEmpty(flag)
            ? name
            : $"{flag} {name}";
    }

    private bool ExpirationIsValid =>
        _expiresInDays is null ||
        (_expiresInDays >= 1 && _expiresInDays <= MaxExpirationDays);

    private bool CanCreate =>
        !_creating &&
        _selection.Count > 0 &&
        !string.IsNullOrWhiteSpace(_title) &&
        ExpirationIsValid;


    protected override async Task OnInitializedAsync()
    {
        // Independientes entre sí: se piden a la vez.
        await Task.WhenAll(
            LoadReportsAsync(),
            LoadSharingAsync(),
            LoadCulturesAsync(),
            ReloadDocumentsAsync(),
            ReloadBundlesAsync());
    }


    // ------------------------------------------------------------ carga

    private async Task LoadReportsAsync()
    {
        var reports = await Toasts.RunAsync(
            () => RenderSetApi.GetReportsAsync(CurrentTenant.Id),
            errorTitle: "No se han podido cargar los reports");

        if (reports is not null)
            _reports = reports.OrderBy(x => x.Name).ToList();
    }

    private async Task LoadCulturesAsync()
    {
        var cultures = await Toasts.RunAsync(
            () => RenderSetApi.GetCulturesAsync(CurrentTenant.Id),
            errorTitle: "No se han podido cargar los idiomas");

        if (cultures is not null)
        {
            _cultures =
                cultures
                    .OrderByDescending(x => x.IsDefault)
                    .ThenBy(x => x.DisplayName, StringComparer.CurrentCultureIgnoreCase)
                    .ToList();
        }
    }

    private async Task LoadSharingAsync()
    {
        _sharing = await Toasts.RunAsync(
            () => RenderSetApi.GetSharingSettingsAsync(CurrentTenant.Id),
            errorTitle: "No se ha podido cargar la configuración de la página pública");
    }

    /// <summary>
    /// Primera página con los filtros actuales. Cambiar un filtro siempre
    /// empieza de cero: un cursor sólo vale para la consulta que lo generó.
    /// </summary>
    private Task ReloadDocumentsAsync() =>
        LoadDocumentsAsync(append: false);

    private Task LoadMoreDocumentsAsync() =>
        LoadDocumentsAsync(append: true);

    private async Task LoadDocumentsAsync(
        bool append)
    {
        if (!DateRangeIsValid(_documentsFrom, _documentsTo) ||
            (append && _documentsCursor is null))
        {
            return;
        }

        _loadingDocuments = true;

        try
        {
            var page = await Toasts.RunAsync(
                () => RenderSetApi.SearchDocumentsAsync(
                    CurrentTenant.Id,
                    NullIfBlank(_documentSearch),
                    NullIfBlank(_reportFilter),
                    StartOfDay(_documentsFrom),
                    StartOfNextDay(_documentsTo),
                    PageSize,
                    append ? _documentsCursor : null),
                errorTitle: "No se han podido cargar los documentos");

            if (page is null)
                return;

            if (!append)
                _documents.Clear();

            _documents.AddRange(page.Items);
            _documentsCursor = page.NextCursor;
        }
        finally
        {
            _loadingDocuments = false;
        }
    }

    private Task ReloadBundlesAsync() =>
        LoadBundlesAsync(append: false);

    private Task LoadMoreBundlesAsync() =>
        LoadBundlesAsync(append: true);

    private async Task LoadBundlesAsync(
        bool append)
    {
        if (!DateRangeIsValid(_bundlesFrom, _bundlesTo) ||
            (append && _bundlesCursor is null))
        {
            return;
        }

        _loadingBundles = true;

        try
        {
            var page = await Toasts.RunAsync(
                () => RenderSetApi.GetBundlesAsync(
                    CurrentTenant.Id,
                    NullIfBlank(_bundleSearch),
                    _bundleStatus,
                    StartOfDay(_bundlesFrom),
                    StartOfNextDay(_bundlesTo),
                    PageSize,
                    append ? _bundlesCursor : null),
                errorTitle: "No se han podido cargar los bundles");

            if (page is null)
                return;

            if (!append)
                _bundles.Clear();

            _bundles.AddRange(page.Items);
            _bundlesCursor = page.NextCursor;
        }
        finally
        {
            _loadingBundles = false;
        }
    }

    private async Task DocumentSearchKeyDownAsync(
        KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ReloadDocumentsAsync();
    }

    private async Task BundleSearchKeyDownAsync(
        KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ReloadBundlesAsync();
    }

    private async Task ReportFilterChangedAsync(
        ChangeEventArgs e)
    {
        _reportFilter = e.Value?.ToString() ?? string.Empty;

        await ReloadDocumentsAsync();
    }

    private async Task BundleStatusChangedAsync(
        ChangeEventArgs e)
    {
        _bundleStatus =
            Enum.TryParse<DocumentBundleStatus>(
                e.Value?.ToString(),
                out var status)
                ? status
                : null;

        await ReloadBundlesAsync();
    }


    // ------------------------------------------------------------ selección

    private bool IsSelected(
        RenderedDocumentSummary document) =>
        _selection.Any(x => x.Document.Id == document.Id);

    private void ToggleSelection(
        RenderedDocumentSummary document)
    {
        var existing =
            _selection.FirstOrDefault(x => x.Document.Id == document.Id);

        if (existing is not null)
        {
            _selection.Remove(existing);
            return;
        }

        _selection.Add(
            new SelectedDocument
            {
                Document = document
            });
    }

    private void Move(
        int index,
        int offset)
    {
        var target = index + offset;

        if (target < 0 || target >= _selection.Count)
            return;

        (_selection[index], _selection[target]) =
            (_selection[target], _selection[index]);
    }


    // ------------------------------------------------------------ acciones

    private async Task CreateAsync()
    {
        if (!CanCreate)
            return;

        _creating = true;

        try
        {
            var request =
                new CreateDocumentBundleRequest
                {
                    Title = _title.Trim(),
                    Message = NullIfBlank(_message),
                    ExpiresInDays = _expiresInDays,
                    Culture = NullIfBlank(_culture),
                    AllowDataDownload = _allowDataDownload,
                    Items = _selection
                        .Select(x => new CreateDocumentBundleItem
                        {
                            DocumentId = x.Document.Id,
                            DisplayName = NullIfBlank(x.DisplayName)
                        })
                        .ToList()
                };

            var created = await Toasts.RunApiAsync(
                () => RenderSetApi.CreateBundleAsync(
                    CurrentTenant.Id,
                    request),
                success: "Enlace creado.",
                errorTitle: "No se ha podido crear el bundle");

            if (created is null)
                return;

            ShowLink(created);

            _selection.Clear();
            _title = string.Empty;
            _message = string.Empty;
            _expiresInDays = null;
            _culture = string.Empty;
            _allowDataDownload = false;

            await ReloadBundlesAsync();
        }
        finally
        {
            _creating = false;
        }
    }

    private async Task RenewAsync(
        DocumentBundleResponse bundle)
    {
        var confirmed =
            await JS.InvokeAsync<bool>(
                "confirm",
                $"¿Generar un enlace nuevo para \"{bundle.Title}\"? El que tenga el cliente dejará de funcionar.");

        if (!confirmed)
            return;

        var renewed = await Toasts.RunApiAsync(
            () => RenderSetApi.RenewBundleLinkAsync(
                CurrentTenant.Id,
                bundle.BundleId,
                new RenewDocumentBundleLinkRequest()),
            success: "Enlace nuevo generado. El anterior ya no funciona.",
            errorTitle: "No se ha podido generar el enlace");

        if (renewed is null)
            return;

        ShowLink(renewed);

        await ReloadBundlesAsync();
    }

    private async Task RevokeAsync(
        DocumentBundleResponse bundle)
    {
        var confirmed =
            await JS.InvokeAsync<bool>(
                "confirm",
                $"¿Revocar el enlace de \"{bundle.Title}\"? El cliente dejará de poder abrirlo.");

        if (!confirmed)
            return;

        var revoked = await Toasts.RunApiAsync(
            () => RenderSetApi.RevokeBundleAsync(
                CurrentTenant.Id,
                bundle.BundleId),
            success: "Enlace revocado.",
            errorTitle: "No se ha podido revocar el enlace");

        if (revoked)
            await ReloadBundlesAsync();
    }

    private void ShowLink(
        DocumentBundleResponse bundle)
    {
        if (string.IsNullOrWhiteSpace(bundle.Url))
            return;

        _lastLink =
            new CreatedLink(
                bundle.Title,
                bundle.Url,
                bundle.ExpiresAtUtc);
    }

    /// <summary>
    /// El portapapeles del navegador sólo funciona en https o localhost. Si
    /// falla, el toast lo dice y el enlace sigue a mano en la tarjeta o con
    /// el botón de abrir.
    /// </summary>
    private async Task CopyAsync(
        string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return;

        await Toasts.RunAsync(
            async () => await JS.InvokeVoidAsync(
                "navigator.clipboard.writeText",
                url),
            success: "Enlace copiado.",
            errorTitle: "No se ha podido copiar al portapapeles");
    }


    // ------------------------------------------------------------ formato

    /// <summary>
    /// Las fechas del filtro son días locales del usuario. "Desde el 1" es
    /// desde las 00:00 locales del 1 y "hasta el 5" es hasta el inicio del
    /// 6, para que el día 5 entre entero.
    /// </summary>
    private static DateTimeOffset? StartOfDay(
        DateOnly? date) =>
        date is { } value
            ? new DateTimeOffset(
                DateTime.SpecifyKind(
                    value.ToDateTime(TimeOnly.MinValue),
                    DateTimeKind.Local))
            : null;

    private static DateTimeOffset? StartOfNextDay(
        DateOnly? date) =>
        StartOfDay(date?.AddDays(1));

    private static bool DateRangeIsValid(
        DateOnly? from,
        DateOnly? to) =>
        from is null || to is null || from <= to;

    private static string CountLabel(
        int shown,
        string? cursor) =>
        cursor is null
            ? shown.ToString()
            : $"{shown}+";

    private static string? NullIfBlank(
        string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? null
            : value.Trim();

    private string ReportName(
        string reportId) =>
        _reports.FirstOrDefault(x => x.Id == reportId)?.Name ?? reportId;

    /// <summary>
    /// A través de Web (/files): la API exige clave y un enlace del
    /// navegador no puede llevarla.
    /// </summary>
    private static string DocumentUrl(
        RenderedDocumentSummary document) =>
        $"/files/documents/{Uri.EscapeDataString(document.Id)}";

    /// <summary>
    /// Visor con el menú de imprimir, PDF, CSV y JSON.
    /// </summary>
    private static string ViewerUrl(
        RenderedDocumentSummary document) =>
        $"/documents/{Uri.EscapeDataString(document.Id)}";

    private static string DefaultDisplayName(
        RenderedDocumentSummary document) =>
        Path.GetFileNameWithoutExtension(document.FileName);

    private static string FormatDate(
        DateTime utc) =>
        DateTime.SpecifyKind(utc, DateTimeKind.Utc)
            .ToLocalTime()
            .ToString("dd/MM/yyyy HH:mm");

    private static string StatusText(
        DocumentBundleStatus status) =>
        status switch
        {
            DocumentBundleStatus.Active => "Activo",
            DocumentBundleStatus.Expired => "Caducado",
            DocumentBundleStatus.Revoked => "Revocado",
            _ => status.ToString()
        };


    private sealed class SelectedDocument
    {
        public required RenderedDocumentSummary Document { get; init; }

        /// <summary>
        /// Vacío deja que el servidor use el nombre del fichero.
        /// </summary>
        public string DisplayName { get; set; } = string.Empty;
    }

    private sealed record CreatedLink(
        string Title,
        string Url,
        DateTime ExpiresAtUtc);
}
