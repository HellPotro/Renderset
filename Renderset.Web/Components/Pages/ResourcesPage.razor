@page "/resources"

@using Renderset.Core.Localization
@using Renderset.Core.Persistence
@using Renderset.Core.Reports
@using Renderset.Core.Resources
@using Renderset.Core.Translations
@using Renderset.Core.Variables

@inject IRenderSetApi RenderSetApi
@inject ICurrentTenant CurrentTenant
@inject IJSRuntime JS
@inject IToastService Toasts

<PageTitle>Diccionario - RenderSet</PageTitle>

@*
    Diccionario: una fila por clave, una columna por idioma.

    Navegación a la izquierda en vez del desplegable de ámbitos:

      - Elementos comunes: el diccionario común del tenant (etiquetas
        compartidas, bloques, variables, numeración...) y los textos de la
        página pública de documentos compartidos.
      - Reports: cada report enseña en la misma tabla sus textos base y los
        de todos sus presets, marcados con su origen. Antes cada preset era
        un ámbito aparte y había que ir uno a uno para ver qué cambiaba.

    Los idiomas están en un solo sitio, la cabecera de cada columna: nombre,
    cobertura, ocultar y rellenar huecos. Los ocultos se vuelven a mostrar
    desde la barra de herramientas.
*@

<div class="dict">

    <header class="dict-header">

        <div>
            <h1>Diccionario</h1>
            <p>
                Textos del documento en cada idioma. Elige a la izquierda qué
                quieres traducir.
            </p>
        </div>

        <div class="dict-header-actions">

            <button type="button"
                    class="secondary-button"
                    disabled="@(_loading || _cultures.Count == 0)"
                    @onclick="ToggleNewKey">
                <i class="fa-solid fa-plus"></i>
                Nueva clave
            </button>

        </div>

    </header>


    <div class="dict-shell">

        @* ------------------------------------------------- navegación *@

        <SideNav Items="NavItems"
                 SelectedKey="@SelectedNavKey"
                 Selected="NavSelectedAsync"
                 AriaLabel="Qué diccionario"
                 SearchPlaceholder="Filtrar reports y diccionarios" />


        @* ------------------------------------------------- contenido *@

        <section class="dict-main">

            <div class="dict-main-head">

                <div>
                    <h2>@ViewTitle</h2>
                    <p>@ViewDescription</p>
                </div>

                @if (_reportId is not null && Origins.Count > 1)
                {
                    <div class="dict-origins" role="tablist" aria-label="Origen de los textos">

                        <button type="button"
                                class="@OriginClass(null)"
                                @onclick="() => _originFilter = null">
                            Todo
                            <span>@_matrix.Count</span>
                        </button>

                        @foreach (var origin in Origins)
                        {
                            <button type="button"
                                    class="@OriginClass(origin.Scope)"
                                    title="@origin.Hint"
                                    @onclick="() => _originFilter = origin.Scope">
                                <i class="fa-solid @origin.Icon"></i>
                                @origin.Label
                                <span>@_matrix.Count(x => x.Scope == origin.Scope)</span>
                            </button>
                        }

                    </div>
                }

            </div>


            @if (_promotion is { IsEmpty: false } promotion)
            {
                <div class="dict-promote">

                    <i class="fa-solid fa-layer-group"></i>

                    <div>
                        <strong>
                            @promotion.PromotedKeys.Count
                            @(promotion.PromotedKeys.Count == 1 ? "clave está repetida" : "claves están repetidas")
                            con el mismo texto en varios presets.
                        </strong>
                        <span>
                            Pasándolas al report quedan en una sola fila: se traducen una vez y valen
                            para todos sus presets. Lo que es distinto en algún preset se queda donde está.
                        </span>
                    </div>

                    <button type="button"
                            class="primary-button"
                            disabled="@_isBusy"
                            @onclick="PromoteAsync">
                        <i class="fa-solid fa-arrow-up"></i>
                        Pasar al report
                    </button>

                </div>
            }


            @if (_showNewKey)
            {
                <section class="dict-newkey">

                    <div class="form-group">
                        <label>Clave</label>
                        <input value="@_newKey"
                               @oninput="e => _newKey = e.Value?.ToString() ?? string.Empty"
                               placeholder="field.customer.name" />
                    </div>

                    @if (_reportId is not null && Origins.Count > 1)
                    {
                        <div class="form-group">
                            <label>Dónde</label>
                            <select value="@_newKeyScope"
                                    @onchange="e => _newKeyScope = e.Value?.ToString()">
                                @foreach (var origin in Origins)
                                {
                                    <option value="@origin.Scope">@origin.Label</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="form-group">
                        <label>Descripción</label>
                        <input value="@_newKeyDescription"
                               @oninput="e => _newKeyDescription = e.Value?.ToString() ?? string.Empty"
                               placeholder="Ayuda interna para quien traduce" />
                    </div>

                    <div class="dict-newkey-actions">

                        <button type="button"
                                class="secondary-button"
                                @onclick="ToggleNewKey">
                            Cancelar
                        </button>

                        <button type="button"
                                class="primary-button"
                                disabled="@string.IsNullOrWhiteSpace(_newKey)"
                                @onclick="AddKey">
                            Añadir
                        </button>

                    </div>

                </section>
            }


            <div class="dict-toolbar">

                <div class="dict-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input value="@_search"
                           @oninput="e => _search = e.Value?.ToString() ?? string.Empty"
                           placeholder="Filtrar por clave o por texto" />
                </div>

                <label class="dict-toggle">
                    <input type="checkbox"
                           checked="@_onlyPending"
                           @onchange="e => _onlyPending = e.Value is bool v && v" />
                    <span>Sólo con huecos</span>
                </label>

                @if (HiddenCultures.Count > 0)
                {
                    <div class="dict-hidden-langs">
                        <span>Ocultos:</span>

                        @foreach (var culture in HiddenCultures)
                        {
                            <button type="button"
                                    title="Mostrar la columna @culture.DisplayName"
                                    @onclick="() => ToggleCulture(culture)">
                                <CultureFlagIcon Culture="@culture.Culture"
                                                 Size="CultureFlagIcon.CultureFlagSize.Small" />
                                @culture.DisplayName
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        }
                    </div>
                }

                <span class="dict-count">
                    @Rows.Count() de @VisibleScopeRows.Count() claves
                </span>

                <button type="button"
                        class="secondary-button"
                        disabled="@(_isBusy || BaseCulture is null || _cultures.Count < 2)"
                        title="Traduce desde el idioma base todas las claves que falten en cualquier idioma"
                        @onclick="TranslateEverythingAsync">
                    <i class="fa-solid fa-language"></i>
                    Rellenar todos los huecos
                </button>

            </div>


            @if (_fillCulture is { } fill)
            {
                <div class="dict-fill">

                    <span class="dict-fill-title">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                        Rellenar los huecos de <strong>@fill.DisplayName</strong> desde
                    </span>

                    @foreach (var source in _cultures.Where(x => x.Culture != fill.Culture))
                    {
                        <span class="dict-fill-source">

                            <CultureFlagIcon Culture="@source.Culture"
                                             Size="CultureFlagIcon.CultureFlagSize.Small" />
                            @source.DisplayName

                            <button type="button"
                                    title="Traducir automáticamente (Azure)"
                                    disabled="@_isBusy"
                                    @onclick="() => TranslateMissingAsync(source.Culture, fill.Culture)">
                                <i class="fa-solid fa-language"></i>
                                Traducir
                            </button>

                            <button type="button"
                                    title="Copiar el texto tal cual"
                                    disabled="@_isBusy"
                                    @onclick="() => CopyMissingAsync(source.Culture, fill.Culture)">
                                <i class="fa-regular fa-copy"></i>
                                Copiar
                            </button>

                        </span>
                    }

                    <button type="button"
                            class="dict-fill-close"
                            title="Cerrar"
                            @onclick="() => _fillCulture = null">
                        <i class="fa-solid fa-xmark"></i>
                    </button>

                </div>
            }


            @if (_loading)
            {
                <div class="dict-state">
                    Cargando diccionario...
                </div>
            }
            else if (_cultures.Count == 0)
            {
                <div class="dict-state">
                    No hay idiomas configurados.
                    <a href="/idiomas">Añade al menos uno</a>
                    antes de traducir nada.
                </div>
            }
            else if (!VisibleScopeRows.Any())
            {
                <div class="dict-state">
                    @(_reportId is null
                        ? "Este diccionario no tiene ninguna clave todavía."
                        : "Este report no tiene textos propios todavía. Se crean al editar etiquetas en el diseñador.")
                </div>
            }
            else
            {
                <div class="dict-scroll">

                    <table class="dict-table">

                        <thead>
                            <tr>
                                <th class="dict-col-key">
                                    Clave
                                </th>

                                @foreach (var culture in _visibleCultures)
                                {
                                    var coverage = Coverage(culture.Culture);

                                    <th class="@(culture.IsDefault ? "dict-col-lang is-base" : "dict-col-lang")">

                                        <div class="dict-lang-head">

                                            <div class="dict-lang-name">
                                                <strong>
                                                    <CultureFlagIcon Culture="@culture.Culture"
                                                                     Size="CultureFlagIcon.CultureFlagSize.Small" />
                                                    @culture.DisplayName
                                                </strong>
                                                <code>@culture.Culture</code>
                                            </div>

                                            <div class="dict-lang-tools">

                                                @if (!culture.IsDefault)
                                                {
                                                    <button type="button"
                                                            class="@(_fillCulture?.Culture == culture.Culture ? "is-active" : null)"
                                                            title="Rellenar los huecos de @culture.DisplayName"
                                                            @onclick="() => ToggleFill(culture)">
                                                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                                                    </button>

                                                    <button type="button"
                                                            title="Ocultar esta columna"
                                                            @onclick="() => ToggleCulture(culture)">
                                                        <i class="fa-solid fa-eye-slash"></i>
                                                    </button>
                                                }

                                            </div>

                                        </div>

                                        <div class="dict-lang-coverage"
                                             title="@coverage% traducido">
                                            <span class="dict-lang-bar">
                                                <span style="width:@(coverage)%"></span>
                                            </span>
                                            <span>@(coverage)%</span>

                                            @if (culture.IsDefault)
                                            {
                                                <em>Idioma base</em>
                                            }
                                        </div>

                                    </th>
                                }

                                <th class="dict-col-actions"></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var group in Rows.GroupBy(GroupOf))
                            {
                                <tr class="dict-group @(group.Key.IsPreset ? "is-preset" : null)">
                                    <td colspan="@(_visibleCultures.Count + 2)">
                                        <i class="fa-solid @group.Key.Icon"></i>
                                        @group.Key.Label
                                        @if (!string.IsNullOrWhiteSpace(group.Key.Hint))
                                        {
                                            <small>@group.Key.Hint</small>
                                        }
                                    </td>
                                </tr>

                                @foreach (var row in group)
                                {
                                    <tr @key="RowId(row)" class="@(row.IsSystem && !HasAnyValue(row) ? "is-system" : null)">

                                        <td class="dict-col-key">
                                            <span class="dict-key-kind">@KindOf(row.Key)</span>
                                            <code>@row.Key</code>
                                            @if (!string.IsNullOrWhiteSpace(row.Description))
                                            {
                                                <small>@row.Description</small>
                                            }
                                        </td>

                                        @foreach (var culture in _visibleCultures)
                                        {
                                            var value = CellValue(row, culture.Culture);
                                            var dirty = IsDirty(row, culture.Culture);
                                            var machine = IsMachine(row, culture.Culture);

                                            <td class="dict-cell">

                                                <input class="@CellClass(value, dirty, machine)"
                                                       value="@value"
                                                       placeholder="@Placeholder(row, culture)"
                                                       @onchange="e => CellChanged(row, culture.Culture, e)" />

                                                @if (machine && !dirty)
                                                {
                                                    <span class="dict-machine"
                                                          title="Traducción automática sin revisar">
                                                        <i class="fa-solid fa-robot"></i>
                                                    </span>
                                                }

                                            </td>
                                        }

                                        <td class="dict-col-actions">

                                            @if (IsTokenOnly(row))
                                            {
                                                <span class="dict-token-only"
                                                      title="El texto es sólo una variable o un dato: no se traduce aquí ni cuenta para la cobertura.">
                                                    <i class="fa-solid fa-code"></i>
                                                </span>
                                            }

                                            @if (MissingCulturesOf(row).Count > 0)
                                            {
                                                <button type="button"
                                                        class="is-translate"
                                                        title="Traducir esta clave a los @MissingCulturesOf(row).Count idiomas que faltan"
                                                        disabled="@_isBusy"
                                                        @onclick="() => TranslateKeyEverywhereAsync(row)">
                                                    <i class="fa-solid fa-language"></i>
                                                </button>
                                            }

                                            @if (!row.IsSystem || HasAnyValue(row))
                                            {
                                                <button type="button"
                                                        class="is-delete"
                                                        title="Eliminar la clave en todos los idiomas"
                                                        @onclick="() => DeleteKeyAsync(row)">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            }

                                        </td>

                                    </tr>
                                }
                            }

                        </tbody>

                    </table>

                </div>
            }

        </section>

    </div>


    @if (_dirty.Count > 0)
    {
        <div class="dict-savebar">

            <span>
                @_dirty.Count @(_dirty.Count == 1 ? "cambio" : "cambios") sin guardar
            </span>

            <button type="button"
                    class="secondary-button"
                    @onclick="DiscardChanges">
                Descartar
            </button>

            <button type="button"
                    class="primary-button"
                    disabled="@_isBusy"
                    @onclick="SaveChangesAsync">
                <i class="fa-solid fa-check"></i>
                Guardar
            </button>

        </div>
    }

</div>


@code {

    /// <summary>
    /// Entrada directa desde otras pantallas: /resources?scope=invoice abre
    /// el report; ?scope=preset:x, el report de ese preset filtrado a él;
    /// ?scope=* o system:sharing, los comunes.
    /// </summary>
    [SupplyParameterFromQuery(Name = "scope")]
    public string? ScopeFromQuery { get; set; }

    /// <summary>
    /// Claves globales que el documento usa con un texto por defecto. Se
    /// enseñan aunque nadie las haya escrito, para poder traducirlas sin
    /// tener que saber cómo se llaman.
    /// </summary>
    private static readonly (string Key, string Default, string Description)[] SystemKeys =
    [
        (ReportTextKeys.TableTotal, "Total", "Etiqueta de la fila de totales de las tablas"),
        (ReportTextKeys.FooterPageNumber, "Página {page} de {pages}", "Numeración del pie: {page} es la página y {pages} el total")
    ];

    private const char DirtySeparator = '\u001f';

    private bool _loading = true;
    private bool _isBusy;

    /// <summary>
    /// Report abierto. Nulo = elementos comunes (<see cref="_commonScope"/>).
    /// </summary>
    private string? _reportId;

    private string _commonScope = ReportResourceScope.Global;

    /// <summary>
    /// Origen al que se filtra la tabla dentro de un report (su ámbito base o
    /// el de un preset). Nulo = todos.
    /// </summary>
    private string? _originFilter;

    private string _search = string.Empty;
    private bool _onlyPending;

    private bool _showNewKey;
    private string _newKey = string.Empty;
    private string? _newKeyScope;
    private string _newKeyDescription = string.Empty;

    private IReadOnlyCollection<Report> _reports = [];
    private IReadOnlyCollection<ReportPreset> _presets = [];
    private IReadOnlyCollection<TenantCulture> _cultures = [];

    /// <summary>
    /// Idiomas ocultos en la matriz. Con cinco idiomas la tabla se va de
    /// ancho y casi siempre se trabaja sobre uno o dos.
    /// </summary>
    private readonly HashSet<string> _hiddenCultures =
        new(StringComparer.OrdinalIgnoreCase);

    private List<TenantCulture> _visibleCultures = [];

    /// <summary>
    /// Idioma cuyo panel de relleno está abierto.
    /// </summary>
    private TenantCulture? _fillCulture;

    /// <summary>
    /// Matriz en memoria: una entrada por ámbito y clave, con el valor de
    /// cada cultura. La API devuelve filas sueltas (clave × cultura) por
    /// ámbito; pivotarlas aquí es lo que permite ver un idioma al lado de
    /// otro y el report junto a sus presets.
    /// </summary>
    private List<KeyRow> _matrix = [];

    /// <summary>
    /// Ediciones pendientes, por ámbito + clave + cultura. Se guardan todas
    /// juntas en un único PUT.
    /// </summary>
    private readonly Dictionary<string, string?> _dirty = new(StringComparer.OrdinalIgnoreCase);


    // ------------------------------------------------------------ vistas

    private sealed record Origin(
        string Scope,
        string Label,
        string Icon,
        string Hint,
        bool IsPreset);

    private IReadOnlyList<Origin> Origins { get; set; } = [];


    private IReadOnlyList<ReportPreset> PresetsOf(
        string reportId) =>
        _presets
            .Where(x => string.Equals(x.Configuration.ReportId, reportId, StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.Configuration.Name)
            .ToList();

    private Report? CurrentReport =>
        _reportId is null
            ? null
            : _reports.FirstOrDefault(x => string.Equals(x.Id, _reportId, StringComparison.OrdinalIgnoreCase));

    private string ViewTitle =>
        _reportId is null
            ? _commonScope == ReportResourceScope.Sharing
                ? "Página pública de documentos compartidos"
                : "Diccionario común del tenant"
            : CurrentReport?.Name ?? _reportId;

    private string ViewDescription =>
        _reportId is null
            ? _commonScope == ReportResourceScope.Sharing
                ? "Lo que ve el cliente al abrir un enlace: botones, avisos, caducidad."
                : "Vale para todos los reports: bloques, variables traducibles, totales y numeración. Un report o un preset puede pisarlo."
            : Origins.Count > 1
                ? $"Textos del report y de sus {Origins.Count - 1} preset(s). Lo de un preset pisa al report sólo en ese preset."
                : "Textos del report. Cuando un preset cambie una etiqueta, aparecerá aquí con su nombre.";

    private const string CommonKeyPrefix = "common:";
    private const string ReportKeyPrefix = "report:";

    /// <summary>
    /// Menú lateral: los dos diccionarios comunes y un elemento por report.
    /// </summary>
    private IReadOnlyList<SideNavItem> NavItems =>
        new[]
        {
            new SideNavItem(
                CommonKeyPrefix + ReportResourceScope.Global,
                "Común del tenant",
                "Bloques, variables, totales, numeración",
                "fa-globe",
                "Elementos comunes",
                Accent: true),

            new SideNavItem(
                CommonKeyPrefix + ReportResourceScope.Sharing,
                "Página pública",
                "Enlaces de documentos compartidos",
                "fa-share-nodes",
                "Elementos comunes",
                Accent: true)
        }
        .Concat(
            _reports
                .OrderBy(x => x.Name)
                .Select(report =>
                {
                    var presets = PresetsOf(report.Id).Count;

                    return new SideNavItem(
                        ReportKeyPrefix + report.Id,
                        report.Name,
                        presets == 0 ? "Sin presets" : presets == 1 ? "1 preset" : $"{presets} presets",
                        "fa-file-lines",
                        "Reports");
                }))
        .ToList();

    private string SelectedNavKey =>
        _reportId is null
            ? CommonKeyPrefix + _commonScope
            : ReportKeyPrefix + _reportId;

    private Task NavSelectedAsync(
        string key) =>
        key.StartsWith(ReportKeyPrefix, StringComparison.Ordinal)
            ? SelectReportAsync(key[ReportKeyPrefix.Length..])
            : SelectCommonAsync(key[CommonKeyPrefix.Length..]);

    private string OriginClass(
        string? scope) =>
        string.Equals(_originFilter, scope, StringComparison.OrdinalIgnoreCase)
            ? "dict-origin is-active"
            : "dict-origin";

    /// <summary>
    /// Filas del report/ámbito abierto, antes de buscar y filtrar huecos.
    /// </summary>
    private IEnumerable<KeyRow> VisibleScopeRows =>
        _originFilter is null
            ? _matrix
            : _matrix.Where(x => string.Equals(x.Scope, _originFilter, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<KeyRow> Rows =>
        VisibleScopeRows
            .Where(MatchesSearch)
            .Where(row => !_onlyPending || HasGaps(row))
            .OrderBy(x => OriginOrder(x.Scope))
            .ThenBy(x => KindOrder(x.Key))
            .ThenBy(x => x.Key, StringComparer.OrdinalIgnoreCase);

    private List<TenantCulture> HiddenCultures =>
        _cultures
            .Where(x => !IsVisible(x))
            .ToList();


    // ------------------------------------------------------------- carga

    protected override async Task OnInitializedAsync()
    {
        _loading = true;

        try
        {
            _reports =
                await RenderSetApi.GetReportsAsync(
                    CurrentTenant.Id);

            _presets =
                await RenderSetApi.GetPresetsAsync(
                    CurrentTenant.Id);

            _cultures =
                await RenderSetApi.GetCulturesAsync(
                    CurrentTenant.Id);

            RefreshVisibleCultures();

            ApplyScopeFromQuery();

            await LoadViewAsync();
        }
        catch (Exception exception)
        {
            Toasts.Error(
                ToastServiceExtensions.Describe(exception),
                "No se ha podido cargar el diccionario");
        }
        finally
        {
            _loading = false;
        }
    }


    private void ApplyScopeFromQuery()
    {
        var scope = ScopeFromQuery?.Trim();

        if (string.IsNullOrWhiteSpace(scope) ||
            scope == ReportResourceScope.Global)
        {
            return;
        }

        if (scope == ReportResourceScope.Sharing)
        {
            _commonScope = scope;
            return;
        }

        if (ReportResourceScope.IsPreset(scope))
        {
            var presetId = scope["preset:".Length..];

            var preset = _presets.FirstOrDefault(x =>
                string.Equals(x.Id, presetId, StringComparison.OrdinalIgnoreCase));

            if (preset is not null)
            {
                _reportId = preset.Configuration.ReportId;
                _originFilter = scope;
            }

            return;
        }

        if (_reports.Any(x => string.Equals(x.Id, scope, StringComparison.OrdinalIgnoreCase)))
            _reportId = scope;
    }


    private async Task SelectCommonAsync(
        string scope)
    {
        if (!await ConfirmDiscardAsync())
            return;

        _reportId = null;
        _commonScope = scope;
        _originFilter = null;

        await ReloadAsync();
    }


    private async Task SelectReportAsync(
        string reportId)
    {
        if (!await ConfirmDiscardAsync())
            return;

        _reportId = reportId;
        _originFilter = null;

        await ReloadAsync();
    }


    private async Task ReloadAsync()
    {
        _isBusy = true;

        try
        {
            await LoadViewAsync();
        }
        catch (Exception exception)
        {
            Toasts.Error(
                ToastServiceExtensions.Describe(exception),
                "No se ha podido cargar el diccionario");
        }
        finally
        {
            _isBusy = false;
        }
    }


    /// <summary>
    /// Carga los ámbitos de la vista: uno para los comunes; el del report y
    /// los de cada uno de sus presets para un report.
    /// </summary>
    private async Task LoadViewAsync()
    {
        _dirty.Clear();
        _fillCulture = null;
        _showNewKey = false;

        Origins = BuildOrigins();

        var loaded =
            await Task.WhenAll(
                Origins.Select(async origin =>
                    (origin.Scope,
                     Resources: await RenderSetApi.GetResourcesAsync(
                         CurrentTenant.Id,
                         origin.Scope))));

        _matrix =
            loaded
                .SelectMany(x =>
                    x.Resources
                        .GroupBy(r => r.Key, StringComparer.OrdinalIgnoreCase)
                        .Select(group => new KeyRow
                        {
                            Scope = x.Scope,
                            Key = group.Key,
                            Description =
                                group
                                    .Select(r => r.Description)
                                    .FirstOrDefault(d => !string.IsNullOrWhiteSpace(d)),
                            Values =
                                group
                                    .GroupBy(r => r.Culture, StringComparer.OrdinalIgnoreCase)
                                    .ToDictionary(
                                        g => g.Key,
                                        g => g.First(),
                                        StringComparer.OrdinalIgnoreCase)
                        }))
                .ToList();

        if (_reportId is null &&
            _commonScope == ReportResourceScope.Global)
        {
            AddSystemKeys();
        }

        if (_originFilter is not null &&
            Origins.All(x => !string.Equals(x.Scope, _originFilter, StringComparison.OrdinalIgnoreCase)))
        {
            _originFilter = null;
        }

        _promotion = BuildPromotion();
    }


    // ----------------------------------------------------- pasar al report

    /// <summary>
    /// Claves repetidas con el mismo texto en varios presets del report
    /// abierto, que pueden ir a una sola fila del report sin cambiar nada
    /// (ReportResourcePromotion). Nulo fuera de un report.
    /// </summary>
    private ReportResourcePromotion.Plan? _promotion;


    private ReportResourcePromotion.Plan? BuildPromotion()
    {
        if (_reportId is null || CurrentReport is not { } report)
            return null;

        var presets = PresetsOf(report.Id);

        if (presets.Count < 2)
            return null;

        IReadOnlyCollection<ReportResource> ResourcesOf(string scope) =>
            _matrix
                .Where(x => string.Equals(x.Scope, scope, StringComparison.OrdinalIgnoreCase))
                .SelectMany(x => x.Values.Values)
                .ToList();

        return ReportResourcePromotion.Build(
            report.Definition,
            presets
                .Select(x => new ReportResourcePromotion.PresetInfo(
                    x.Id,
                    x.Configuration.Name,
                    x.Configuration))
                .ToList(),
            ResourcesOf(ReportResourceScope.ForReport(report.Id)),
            presets.ToDictionary(
                x => x.Id,
                x => ResourcesOf(ReportResourceScope.ForPreset(x.Id)),
                StringComparer.OrdinalIgnoreCase));
    }


    private async Task PromoteAsync()
    {
        if (_promotion is not { IsEmpty: false } plan)
            return;

        if (!await ConfirmDiscardAsync())
            return;

        var confirmed =
            await JS.InvokeAsync<bool>(
                "confirm",
                $"Se pasarán {plan.PromotedKeys.Count} claves al report y se quitarán sus copias de " +
                "los presets. Los documentos se seguirán viendo igual. ¿Continuar?");

        if (!confirmed)
            return;

        _isBusy = true;

        try
        {
            // Primero el report y después las copias: si algo falla a
            // medias, el texto sigue estando en algún sitio.
            if (plan.ReportWrites.Count > 0)
            {
                var saved = await Toasts.RunApiAsync(
                    () => RenderSetApi.SaveResourcesAsync(
                        CurrentTenant.Id,
                        plan.ReportWrites),
                    errorTitle: "No se han podido pasar los textos al report");

                if (!saved)
                    return;
            }

            var failed = 0;

            foreach (var (scope, key) in plan.Deletions)
            {
                var deleted = await Toasts.RunApiAsync(
                    () => RenderSetApi.DeleteResourceAsync(
                        CurrentTenant.Id,
                        scope,
                        key),
                    errorTitle: $"No se ha podido quitar '{key}' de {scope}");

                if (!deleted)
                    failed++;
            }

            if (failed == 0)
                Toasts.Success($"{plan.PromotedKeys.Count} claves pasadas al report.");
            else
                Toasts.Warning($"Claves pasadas al report, pero {failed} copias no se han podido quitar de sus presets.");

            await LoadViewAsync();
        }
        catch (Exception exception)
        {
            Toasts.Error(ToastServiceExtensions.Describe(exception));
        }
        finally
        {
            _isBusy = false;
        }
    }


    private IReadOnlyList<Origin> BuildOrigins()
    {
        if (_reportId is null)
        {
            return
            [
                new Origin(
                    _commonScope,
                    _commonScope == ReportResourceScope.Sharing ? "Página pública" : "Común",
                    _commonScope == ReportResourceScope.Sharing ? "fa-share-nodes" : "fa-globe",
                    string.Empty,
                    IsPreset: false)
            ];
        }

        var origins = new List<Origin>
        {
            new(
                ReportResourceScope.ForReport(_reportId),
                "Base del report",
                "fa-file-lines",
                "Lo que sale en todos los presets salvo que alguno lo cambie",
                IsPreset: false)
        };

        origins.AddRange(
            PresetsOf(_reportId)
                .Select(preset => new Origin(
                    ReportResourceScope.ForPreset(preset.Id),
                    preset.Configuration.Name,
                    "fa-sliders",
                    $"Sólo en el preset {preset.Configuration.Name} ({preset.Id})",
                    IsPreset: true)));

        return origins;
    }


    private void AddSystemKeys()
    {
        foreach (var (key, _, description) in SystemKeys)
        {
            if (_matrix.Any(x => string.Equals(x.Key, key, StringComparison.OrdinalIgnoreCase)))
                continue;

            _matrix.Add(
                new KeyRow
                {
                    Scope = ReportResourceScope.Global,
                    Key = key,
                    Description = description,
                    IsSystem = true,
                    Values = new Dictionary<string, ReportResource>(StringComparer.OrdinalIgnoreCase)
                });
        }
    }


    // ----------------------------------------------------------- idiomas

    private bool IsVisible(
        TenantCulture culture) =>
        culture.IsDefault ||
        !_hiddenCultures.Contains(culture.Culture);


    /// <summary>
    /// El idioma base nunca se oculta: es la referencia desde la que se
    /// traduce y el texto de ayuda de las demás columnas.
    /// </summary>
    private void ToggleCulture(
        TenantCulture culture)
    {
        if (culture.IsDefault)
            return;

        if (!_hiddenCultures.Remove(culture.Culture))
            _hiddenCultures.Add(culture.Culture);

        if (_fillCulture?.Culture == culture.Culture)
            _fillCulture = null;

        RefreshVisibleCultures();
    }


    private void RefreshVisibleCultures() =>
        _visibleCultures =
            _cultures
                .OrderByDescending(x => x.IsDefault)
                .Where(IsVisible)
                .ToList();


    private void ToggleFill(
        TenantCulture culture) =>
        _fillCulture =
            _fillCulture?.Culture == culture.Culture
                ? null
                : culture;


    private TenantCulture? BaseCulture =>
        _cultures.FirstOrDefault(x => x.IsDefault)
        ?? _cultures.FirstOrDefault();


    // ------------------------------------------------------------ celdas

    private static string RowId(
        KeyRow row) =>
        $"{row.Scope}{DirtySeparator}{row.Key}";

    private static string DirtyKey(
        KeyRow row,
        string culture) =>
        $"{row.Scope}{DirtySeparator}{row.Key}{DirtySeparator}{culture}";

    private static (string Scope, string Key, string Culture) SplitDirtyKey(
        string dirtyKey)
    {
        var parts = dirtyKey.Split(DirtySeparator);

        return (parts[0], parts[1], parts[2]);
    }


    private string CellValue(
        KeyRow row,
        string culture)
    {
        if (_dirty.TryGetValue(DirtyKey(row, culture), out var pending))
            return pending ?? string.Empty;

        return row.Values.TryGetValue(culture, out var resource)
            ? resource.Value ?? string.Empty
            : string.Empty;
    }


    private static string? OriginalValue(
        KeyRow row,
        string culture) =>
        row.Values.TryGetValue(culture, out var resource) &&
        !string.IsNullOrWhiteSpace(resource.Value)
            ? resource.Value
            : null;


    private void CellChanged(
        KeyRow row,
        string culture,
        ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        var normalized = string.IsNullOrWhiteSpace(value)
            ? null
            : value.Trim();

        var dirtyKey = DirtyKey(row, culture);

        // Si vuelve al valor original deja de estar sucia: así el contador
        // de la barra de guardado no miente.
        if (string.Equals(OriginalValue(row, culture), normalized, StringComparison.Ordinal))
        {
            _dirty.Remove(dirtyKey);
            return;
        }

        _dirty[dirtyKey] = normalized;
    }


    private bool IsDirty(
        KeyRow row,
        string culture) =>
        _dirty.ContainsKey(DirtyKey(row, culture));


    private static bool IsMachine(
        KeyRow row,
        string culture) =>
        row.Values.TryGetValue(culture, out var resource) &&
        resource.Source == ReportResourceSource.Machine &&
        !string.IsNullOrWhiteSpace(resource.Value);


    private static string CellClass(
        string value,
        bool dirty,
        bool machine)
    {
        var classes = new List<string> { "dict-input" };

        if (string.IsNullOrWhiteSpace(value))
            classes.Add("is-empty");

        if (dirty)
            classes.Add("is-dirty");

        if (machine)
            classes.Add("is-machine");

        return string.Join(' ', classes);
    }


    /// <summary>
    /// Texto de ayuda de una celda vacía: en los otros idiomas, el original
    /// del idioma base (traducir sin verlo no se puede); en un preset, lo
    /// que hereda del report; en una clave de sistema, su texto por defecto.
    /// </summary>
    private string Placeholder(
        KeyRow row,
        TenantCulture culture)
    {
        var baseCulture = BaseCulture;

        if (!culture.IsDefault && baseCulture is not null)
        {
            var original = CellValue(row, baseCulture.Culture);

            if (!string.IsNullOrWhiteSpace(original))
                return original;
        }

        if (ReportResourceScope.IsPreset(row.Scope) && _reportId is not null)
        {
            var inherited =
                _matrix.FirstOrDefault(x =>
                    x.Scope == ReportResourceScope.ForReport(_reportId) &&
                    string.Equals(x.Key, row.Key, StringComparison.OrdinalIgnoreCase));

            if (inherited is not null)
            {
                var value = CellValue(inherited, culture.Culture);

                if (!string.IsNullOrWhiteSpace(value))
                    return $"Hereda: {value}";
            }
        }

        if (row.IsSystem)
        {
            var system = SystemKeys.FirstOrDefault(x => x.Key == row.Key);

            if (system.Key is not null)
                return $"Por defecto: {system.Default}";
        }

        return culture.IsDefault ? "Sin texto" : "Sin traducir";
    }


    // ----------------------------------------------------------- filtros

    private bool MatchesSearch(
        KeyRow row)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;

        if (Contains(row.Key) || Contains(row.Description))
            return true;

        return _visibleCultures.Any(culture =>
            Contains(CellValue(row, culture.Culture)));
    }


    private bool Contains(
        string? value) =>
        value?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true;


    private bool HasGaps(
        KeyRow row) =>
        _visibleCultures.Any(culture =>
            string.IsNullOrWhiteSpace(CellValue(row, culture.Culture)));


    private bool HasAnyValue(
        KeyRow row) =>
        _cultures.Any(culture =>
            !string.IsNullOrWhiteSpace(CellValue(row, culture.Culture)));


    private int OriginOrder(
        string scope)
    {
        var index = Origins
            .Select((origin, i) => (origin, i))
            .FirstOrDefault(x => string.Equals(x.origin.Scope, scope, StringComparison.OrdinalIgnoreCase))
            .i;

        return index;
    }


    /// <summary>
    /// Grupos de la tabla: en un report, uno por origen (base y cada
    /// preset); en los comunes, por tipo de clave.
    /// </summary>
    private GroupInfo GroupOf(
        KeyRow row)
    {
        if (_reportId is not null)
        {
            var origin =
                Origins.FirstOrDefault(x => string.Equals(x.Scope, row.Scope, StringComparison.OrdinalIgnoreCase));

            return origin is null
                ? new GroupInfo(row.Scope, "fa-folder", string.Empty, false)
                : new GroupInfo(
                    origin.IsPreset ? $"Preset · {origin.Label}" : origin.Label,
                    origin.Icon,
                    origin.Hint,
                    origin.IsPreset);
        }

        return new GroupInfo(KindGroup(row.Key), "fa-folder-open", string.Empty, false);
    }


    private sealed record GroupInfo(
        string Label,
        string Icon,
        string Hint,
        bool IsPreset);


    private static readonly (string Prefix, string Kind, string Group)[] Kinds =
    [
        ("section.", "Sección", "Secciones"),
        ("field.", "Campo", "Campos"),
        ("column.", "Columna", "Columnas de tabla"),
        ("header.", "Cabecera", "Cabecera y pie"),
        ("footer.", "Pie", "Cabecera y pie"),
        ("table.", "Tabla", "Tablas"),
        ("block.", "Bloque", "Bloques"),
        ("blockfield.", "Campo fijo", "Bloques"),
        ("variable.", "Variable", "Variables")
    ];

    private static string KindOf(
        string key) =>
        Kinds.FirstOrDefault(x => key.StartsWith(x.Prefix, StringComparison.OrdinalIgnoreCase)).Kind
        ?? "Otra";

    private static string KindGroup(
        string key) =>
        Kinds.FirstOrDefault(x => key.StartsWith(x.Prefix, StringComparison.OrdinalIgnoreCase)).Group
        ?? "Otras";

    private static int KindOrder(
        string key)
    {
        for (var i = 0; i < Kinds.Length; i++)
        {
            if (key.StartsWith(Kinds[i].Prefix, StringComparison.OrdinalIgnoreCase))
                return i;
        }

        return Kinds.Length;
    }


    /// <summary>
    /// Porcentaje traducido de lo que se ve, descontando las claves que no
    /// tienen nada que traducir (sólo una variable o un dato) y las de
    /// sistema sin escribir, que ya tienen su texto por defecto.
    /// </summary>
    private int Coverage(
        string culture)
    {
        var countable =
            VisibleScopeRows
                .Where(row => !IsTokenOnly(row))
                .Where(row => !row.IsSystem || HasAnyValue(row))
                .ToList();

        if (countable.Count == 0)
            return 0;

        var translated =
            countable.Count(row =>
                !string.IsNullOrWhiteSpace(CellValue(row, culture)));

        return (int)Math.Round(translated * 100d / countable.Count);
    }


    private static bool IsTokenOnly(
        KeyRow row) =>
        row.Values.Values.Any(x =>
            ReportVariableTemplate.IsOnlyTokens(x.Value));


    // ----------------------------------------------------------- guardado

    private async Task SaveChangesAsync()
    {
        if (_dirty.Count == 0)
            return;

        _isBusy = true;

        try
        {
            var resources =
                _dirty
                    .Select(entry =>
                    {
                        var (scope, key, culture) = SplitDirtyKey(entry.Key);

                        return new ReportResource
                        {
                            Scope = scope,
                            Key = key,
                            Culture = culture,
                            Value = entry.Value,

                            // Todo lo tocado a mano deja de ser automático.
                            Source = ReportResourceSource.Manual,

                            Description =
                                _matrix
                                    .FirstOrDefault(x =>
                                        x.Scope == scope &&
                                        string.Equals(x.Key, key, StringComparison.OrdinalIgnoreCase))
                                    ?.Description
                        };
                    })
                    .ToList();

            var saved = await Toasts.RunApiAsync(
                () => RenderSetApi.SaveResourcesAsync(
                    CurrentTenant.Id,
                    resources),
                success: $"{resources.Count} entradas guardadas.",
                errorTitle: "No se han podido guardar las traducciones");

            if (!saved)
                return;

            await LoadViewAsync();
        }
        catch (Exception exception)
        {
            Toasts.Error(ToastServiceExtensions.Describe(exception));
        }
        finally
        {
            _isBusy = false;
        }
    }


    private void DiscardChanges() =>
        _dirty.Clear();


    private async Task<bool> ConfirmDiscardAsync()
    {
        if (_dirty.Count == 0)
            return true;

        return await JS.InvokeAsync<bool>(
            "confirm",
            "Hay cambios sin guardar que se van a perder. ¿Continuar?");
    }


    // ------------------------------------------------------------ claves

    private void ToggleNewKey()
    {
        _showNewKey = !_showNewKey;
        _newKey = string.Empty;
        _newKeyDescription = string.Empty;
        _newKeyScope = _originFilter ?? Origins.FirstOrDefault()?.Scope;
    }


    private void AddKey()
    {
        var key = _newKey.Trim();
        var scope = _newKeyScope ?? Origins.FirstOrDefault()?.Scope ?? ReportResourceScope.Global;

        if (string.IsNullOrWhiteSpace(key))
            return;

        if (_matrix.Any(x =>
                x.Scope == scope &&
                string.Equals(x.Key, key, StringComparison.OrdinalIgnoreCase)))
        {
            Toasts.Error($"La clave '{key}' ya existe ahí.");
            return;
        }

        // La fila se añade en local y sólo viaja al servidor cuando se
        // escribe algún valor y se pulsa Guardar.
        _matrix.Add(
            new KeyRow
            {
                Scope = scope,
                Key = key,
                Description = string.IsNullOrWhiteSpace(_newKeyDescription)
                    ? null
                    : _newKeyDescription.Trim(),
                Values = new Dictionary<string, ReportResource>(StringComparer.OrdinalIgnoreCase)
            });

        ToggleNewKey();
    }


    private async Task DeleteKeyAsync(
        KeyRow row)
    {
        var confirmed =
            await JS.InvokeAsync<bool>(
                "confirm",
                $"Se eliminará '{row.Key}' en todos los idiomas. ¿Continuar?");

        if (!confirmed)
            return;

        // Una fila nueva que aún no se ha guardado sólo existe aquí.
        if (row.Values.Count == 0)
        {
            _matrix.Remove(row);

            foreach (var culture in _cultures)
                _dirty.Remove(DirtyKey(row, culture.Culture));

            return;
        }

        var deleted = await Toasts.RunApiAsync(
            () => RenderSetApi.DeleteResourceAsync(
                CurrentTenant.Id,
                row.Scope,
                row.Key),
            success: "Clave eliminada.",
            errorTitle: "No se ha podido eliminar la clave");

        if (deleted)
            await LoadViewAsync();
    }


    // -------------------------------------------------------- traducción

    /// <summary>
    /// Idiomas en los que esta clave no tiene texto todavía. Una clave que
    /// es sólo un marcador no cuenta: su texto sale de la variable.
    /// </summary>
    private List<string> MissingCulturesOf(
        KeyRow row)
    {
        var baseCulture = BaseCulture;

        if (baseCulture is null)
            return [];

        var source = CellValue(row, baseCulture.Culture);

        if (string.IsNullOrWhiteSpace(source) ||
            ReportVariableTemplate.IsOnlyTokens(source))
        {
            return [];
        }

        return _cultures
            .Where(x =>
                !x.IsDefault &&
                string.IsNullOrWhiteSpace(CellValue(row, x.Culture)))
            .Select(x => x.Culture)
            .ToList();
    }


    /// <summary>
    /// Ámbitos sobre los que actúan "rellenar huecos": los que se están
    /// viendo (todo el report con sus presets, o el origen filtrado).
    /// </summary>
    private IReadOnlyList<string> TargetScopes =>
        _originFilter is null
            ? Origins.Select(x => x.Scope).ToList()
            : [_originFilter];


    private async Task TranslateKeyEverywhereAsync(
        KeyRow row)
    {
        await TranslateGapsAsync(
            MissingCulturesOf(row),
            [row.Scope],
            [row.Key],
            $"'{row.Key}'");
    }


    private async Task TranslateEverythingAsync()
    {
        var targets =
            _cultures
                .Where(x => !x.IsDefault)
                .Select(x => x.Culture)
                .ToList();

        await TranslateGapsAsync(
            targets,
            TargetScopes,
            keys: null,
            what: "lo que estás viendo");
    }


    private async Task TranslateGapsAsync(
        IReadOnlyCollection<string> targets,
        IReadOnlyCollection<string> scopes,
        IReadOnlyCollection<string>? keys,
        string what)
    {
        var baseCulture = BaseCulture;

        if (baseCulture is null || targets.Count == 0 || scopes.Count == 0)
            return;

        if (!await ConfirmDiscardAsync())
            return;

        _isBusy = true;

        try
        {
            var translated = 0;
            var failed = 0;

            // Un ámbito o un idioma que falla no aborta los demás: lo normal
            // es que sea un problema de ese par de idiomas, no del lote.
            foreach (var scope in scopes)
            {
                foreach (var target in targets)
                {
                    var result =
                        await Toasts.RunApiAsync(
                            () => RenderSetApi.TranslateMissingResourcesAsync(
                                CurrentTenant.Id,
                                new TranslateMissingReportResourcesRequest
                                {
                                    Scope = scope,
                                    SourceCulture = baseCulture.Culture,
                                    TargetCulture = target,
                                    IncludeEmptyValues = true,
                                    OverwriteExistingValues = false,
                                    Keys = keys?.ToList()
                                }),
                            errorTitle: $"No se ha podido traducir a {target}");

                    if (result is null)
                    {
                        failed++;
                        continue;
                    }

                    translated += result.Translated;
                    failed += result.Failed;
                }
            }

            Toasts.Success(
                $"Traducidas {translated} claves de {what} desde " +
                $"{baseCulture.DisplayName}. Revisa las marcadas como automáticas.");

            if (failed > 0)
                Toasts.Warning($"{failed} traducciones no se han podido aplicar.");

            await LoadViewAsync();
        }
        catch (Exception exception)
        {
            Toasts.Error(ToastServiceExtensions.Describe(exception));
        }
        finally
        {
            _isBusy = false;
        }
    }


    private async Task CopyMissingAsync(
        string sourceCulture,
        string targetCulture)
    {
        if (!await ConfirmDiscardAsync())
            return;

        _isBusy = true;

        try
        {
            var created = 0;
            var skipped = 0;

            foreach (var scope in TargetScopes)
            {
                var result = await Toasts.RunApiAsync(
                    () => RenderSetApi.CopyMissingResourcesAsync(
                        CurrentTenant.Id,
                        new CopyMissingReportResourcesRequest
                        {
                            Scope = scope,
                            SourceCulture = sourceCulture,
                            TargetCulture = targetCulture,
                            CopyValue = true
                        }),
                    errorTitle: "No se han podido copiar las claves pendientes");

                if (result is null)
                    continue;

                created += result.Created;
                skipped += result.Skipped;
            }

            Toasts.Success(
                $"Copiadas {created} claves de {sourceCulture} a {targetCulture} " +
                $"({skipped} ya tenían texto).");

            await LoadViewAsync();
        }
        catch (Exception exception)
        {
            Toasts.Error(ToastServiceExtensions.Describe(exception));
        }
        finally
        {
            _isBusy = false;
        }
    }


    private async Task TranslateMissingAsync(
        string sourceCulture,
        string targetCulture)
    {
        if (!await ConfirmDiscardAsync())
            return;

        _isBusy = true;

        try
        {
            var translated = 0;
            var failed = 0;
            string? provider = null;

            foreach (var scope in TargetScopes)
            {
                var result =
                    await Toasts.RunApiAsync(
                        () => RenderSetApi.TranslateMissingResourcesAsync(
                            CurrentTenant.Id,
                            new TranslateMissingReportResourcesRequest
                            {
                                Scope = scope,
                                SourceCulture = sourceCulture,
                                TargetCulture = targetCulture,
                                IncludeEmptyValues = true,
                                OverwriteExistingValues = false
                            }),
                        errorTitle: "No se han podido traducir las claves pendientes");

                if (result is null)
                    continue;

                translated += result.Translated;
                failed += result.Failed;
                provider ??= result.Provider;
            }

            Toasts.Success(
                $"Traducidas {translated} claves" +
                (provider is null ? "" : $" con {provider}") +
                ". Revisa las marcadas como automáticas.");

            if (failed > 0)
                Toasts.Warning($"{failed} claves fallaron.");

            await LoadViewAsync();
        }
        catch (Exception exception)
        {
            Toasts.Error(ToastServiceExtensions.Describe(exception));
        }
        finally
        {
            _isBusy = false;
        }
    }


    // ------------------------------------------------------------- tipos

    private sealed class KeyRow
    {
        public required string Scope { get; init; }

        public required string Key { get; init; }

        public string? Description { get; init; }

        /// <summary>
        /// Clave de sistema que todavía no existe: se enseña para poder
        /// traducirla, con su texto por defecto como ayuda.
        /// </summary>
        public bool IsSystem { get; init; }

        public required Dictionary<string, ReportResource> Values { get; init; }
    }
