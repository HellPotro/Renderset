@ApiService_HostAddress = http://localhost:5351
@tenantId = oranauto
@reportId = albaran
@presetId = albaran-default

### Generar un documento con datos ya jerárquicos
# fileName admite variables del tenant y rutas del documento, por ejemplo
# factura-{{data.numeroFactura}}.html (aquí va literal para no chocar con la
# interpolación de este fichero .http)
POST {{ApiService_HostAddress}}/api/render/{{tenantId}}
Content-Type: application/json
{
  "reportId": "{{reportId}}",
  "presetId": "{{presetId}}",
  "context": {
    "culture": "it-IT"
  },
  "output": {
    "format": "Html",
    "fileName": "factura-060098.html"
  },
  "data": {
