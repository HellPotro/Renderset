<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      netstandard2.0 es lo que permite instalar el paquete en un WinForms de
      .NET Framework 4.6.1 en adelante, que es el escenario real, y también en
      .NET 6, 8 o 10. Un solo target: no hay nada en net8 que este cliente
      aproveche.
    -->
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Renderset.Client</PackageId>
    <!--
      2.0: se alinea con la API real (tenant en la ruta, POST /render/{tenant}/file,
      /validate, documentos y enlaces compartidos). Rompe con 1.x: Create pide
      el tenant y desaparecen los lotes y la clave de idempotencia, que el
      servidor no implementa.
    -->
    <Version>2.0.0</Version>
    <Authors>Renderset</Authors>
    <Description>
      Cliente para generar documentos con RenderSet desde cualquier
      aplicación .NET (también .NET Framework 4.6.1+ y WinForms). Envía el
      resultado de un IDataReader o un DataTable tal cual, recibe el PDF y
      crea enlaces para compartir. Sin dependencias.
    </Description>
    <PackageTags>renderset;pdf;reporting;documents;erp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

	<PropertyGroup>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>Renderset.Client.snk</AssemblyOriginatorKeyFile>
	</PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Renderset.Tests" Key="002400000480000094000000060200000024000052534131000400000100010061e861a07cfce5
7b05ad3050e2a4a73c60a6845e950603272dbfbd3e66dccd143b008b317e683ac729ed1f4216e7
d32aefa1e7242ec8dae0dd61b489ecc84ca13ca76b219baf3390e19b78e9f7ba4ea60c776b52b3
f4b640fbcb7c641bd50d7fc1d82d915ec15e1969c92a6ba95e88657ba8eedbd13a80110b8197cd
16ca9fbd" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Sin PackageReference a propósito. Arrastrar System.Text.Json a un
    WinForms antiguo significa pelearse con binding redirects y con la
    versión de System.Memory que ya tuviera el proyecto. Para el poco JSON
    que se escribe, no compensa: un paquete que no se instala sin una tarde
    de redirects no lo instala nadie.
  -->

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Reference Include="System.Data" />
  </ItemGroup>

</Project>
